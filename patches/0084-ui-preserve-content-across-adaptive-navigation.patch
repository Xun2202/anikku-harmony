+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotSame
+import org.junit.jupiter.api.Assertions.assertSame
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import tachiyomi.presentation.core.components.material.LocalBrowsingBottomPadding
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeAdaptiveContentTest {
+    @Test
+    fun `tab composition and scroll survive moves into and out of a subcomposed navigation host`() = runComposeUiTest {
+        val wide = mutableStateOf(false)
+        val owner = Any()
+        lateinit var list: LazyListState
+        lateinit var scope: CoroutineScope
+        var token: Any? = null
+        var mounts = 0
+        var disposals = 0
+        setContent {
+            val caption = if (wide.value) "rail" else "bottom"
+            val body = rememberNavigationContent(owner) {
+                val state = rememberLazyListState(20, 7)
+                val identity = remember { Any() }
+                val coroutineScope = rememberCoroutineScope()
+                SideEffect {
+                    list = state
+                    token = identity
+                    scope = coroutineScope
+                }
+                DisposableEffect(Unit) {
+                    mounts++
+                    onDispose { disposals++ }
+                }
+                Column(Modifier.fillMaxSize()) {
+                    Text("$caption:${LocalBrowsingBottomPadding.current.value.toInt()}", Modifier.testTag("navigation-caption"))
+                    LazyColumn(Modifier.fillMaxSize(), state = state) {
+                        items(2000) { Box(Modifier.fillMaxWidth().height(80.dp)) }
+                    }
+                }
+            }
+            CompositionLocalProvider(LocalBrowsingBottomPadding provides if (wide.value) 0.dp else 48.dp) {
+                Box(Modifier.requiredSize(if (wide.value) 720.dp else 360.dp, 640.dp)) {
+                    if (wide.value) {
+                        // Like the rail scaffold, this host owns a separate layout subcomposition.
+                        SubcomposeLayout { constraints ->
+                            val children = subcompose("body") { body() }.map { it.measure(constraints) }
+                            layout(constraints.maxWidth, constraints.maxHeight) {
+                                children.forEach { it.placeRelative(0, 0) }
+                            }
+                        }
+                    } else {
+                        Box(Modifier.fillMaxSize()) { body() }
+                    }
+                }
+            }
+        }
+        waitForIdle()
+        lateinit var originalList: LazyListState
+        var originalToken: Any? = null
+        runOnIdle {
+            originalList = list
+            originalToken = token
+            scope.launch { list.scrollToItem(37, 9) }
+        }
+        waitForIdle()
+        repeat(6) { index ->
+            runOnIdle { wide.value = index % 2 == 0 }
+            waitForIdle()
+            onNodeWithTag("navigation-caption").assertTextEquals(if (wide.value) "rail:0" else "bottom:48")
+            runOnIdle {
+                assertSame(originalList, list)
+                assertSame(originalToken, token)
+                assertEquals(37, list.firstVisibleItemIndex)
+                assertEquals(9, list.firstVisibleItemScrollOffset)
+                assertEquals(1, mounts)
+                assertEquals(0, disposals, "Changing navigation hosts must not dispose the tab body")
+            }
+        }
+    }
+
+    @Test
+    fun `a different navigation owner starts a fresh body`() = runComposeUiTest {
+        val owner = mutableStateOf(Any())
+        var identity: Any? = null
+        var disposals = 0
+        setContent {
+            val body = rememberNavigationContent(owner.value) {
+                val token = remember { Any() }
+                SideEffect { identity = token }
+                DisposableEffect(Unit) { onDispose { disposals++ } }
+                Box(Modifier.requiredSize(40.dp, 40.dp))
+            }
+            body()
+        }
+        waitForIdle()
+        var original: Any? = null
+        runOnIdle {
+            original = identity
+            owner.value = Any()
+        }
+        waitForIdle()
+        runOnIdle {
+            assertNotSame(original, identity)
+            assertEquals(1, disposals)
+        }
+    }
+}
