+package tachiyomi.presentation.core.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.key
+import androidx.compose.runtime.movableContentOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+
+/** Move the same tab body between adaptive navigation hosts, preserving its composition. */
+@Composable
+fun rememberNavigationContent(owner: Any, content: @Composable () -> Unit): @Composable () -> Unit = key(owner) {
+    val currentContent by rememberUpdatedState(content)
+    remember { movableContentOf { currentContent() } }
+}
