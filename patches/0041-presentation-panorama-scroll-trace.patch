+/**
+ * Harmony: event log for panorama grid scrolling, appended to the crash log dump.
+ *
+ * One line per touch release, fling start / end, scroll request, viewport correction and grid
+ * enter / leave. Nothing is written per frame unless a frame consumed less than it asked for.
+ * Velocities are px/s, distances px, times ms.
+ */
+object PanoramaScrollTrace {
+
+    private const val CAPACITY = 400
+
+    private val lines = ArrayDeque<String>(CAPACITY)
+    private val lock = Any()
+    private val timeFormat = SimpleDateFormat("HH:mm:ss.SSS", Locale.US)
+    private val gridIds = AtomicInteger(0)
+
+    internal fun nextGridId(): Int = gridIds.incrementAndGet()
+
+    fun log(gridId: Int, message: String) {
+        val timestamp = synchronized(timeFormat) { timeFormat.format(Date()) }
+        val entry = "$timestamp g$gridId $message"
+        synchronized(lock) {
+            if (lines.size >= CAPACITY) lines.removeFirst()
+            lines.addLast(entry)
+        }
+    }
+
+    fun snapshot(): List<String> = synchronized(lock) { lines.toList() }
+
+    internal fun clearForTest() = synchronized(lock) { lines.clear() }
+}
+
+/**
+ * Observes the touch stream without consuming it. Logs, per gesture: move count, the gap between
+ * the last move and the release (Compose's tracker reports 0 when it exceeds 40 ms), the tracker's
+ * velocity and the velocity of the last 100 ms of samples.
+ */
+internal fun Modifier.panoramaTouchTrace(gridId: Int): Modifier = pointerInput(gridId) {
+    awaitPointerEventScope {
+        val tracker = VelocityTracker()
+        val times = LongArray(TOUCH_SAMPLES)
+        val ys = FloatArray(TOUCH_SAMPLES)
+        var count = 0
+        var moves = 0
+        var downY = 0f
+        var active = false
+        while (true) {
+            val event = awaitPointerEvent(PointerEventPass.Initial)
+            val change = event.changes.firstOrNull() ?: continue
+            when {
+                event.type == PointerEventType.Press && !active -> {
+                    active = true
+                    tracker.resetTracking()
+                    tracker.addPosition(change.uptimeMillis, change.position)
+                    moves = 0
+                    downY = change.position.y
+                    times[0] = change.uptimeMillis
+                    ys[0] = change.position.y
+                    count = 1
+                    PanoramaScrollTrace.log(gridId, "down pointers=${event.changes.size}")
+                }
+                active && event.type == PointerEventType.Move -> {
+                    moves++
+                    change.historical.forEach { tracker.addPosition(it.uptimeMillis, it.position) }
+                    tracker.addPosition(change.uptimeMillis, change.position)
+                    val slot = count % TOUCH_SAMPLES
+                    times[slot] = change.uptimeMillis
+                    ys[slot] = change.position.y
+                    count++
+                }
+                active && event.type == PointerEventType.Release && event.changes.none { it.pressed } -> {
+                    active = false
+                    val lastMove = times[(count - 1) % TOUCH_SAMPLES]
+                    val gap = change.uptimeMillis - lastMove
+                    tracker.addPosition(change.uptimeMillis, change.position)
+                    val trackerVy = tracker.calculateVelocity().y
+                    var recentVy = 0f
+                    val newest = (count - 1) % TOUCH_SAMPLES
+                    val available = minOf(count, TOUCH_SAMPLES)
+                    for (back in 1 until available) {
+                        val slot = (count - 1 - back) % TOUCH_SAMPLES
+                        val dt = times[newest] - times[slot]
+                        if (dt >= RECENT_WINDOW_MS || back == available - 1) {
+                            if (dt > 0) recentVy = (ys[newest] - ys[slot]) * 1000f / dt
+                            break
+                        }
+                    }
+                    PanoramaScrollTrace.log(
+                        gridId,
+                        "up moves=$moves dy=${(change.position.y - downY).roundToInt()} " +
+                            "gapLastMove=${gap}ms trackerV=${trackerVy.roundToInt()} " +
+                            "recentV=${recentVy.roundToInt()} consumed=${change.isConsumed}",
+                    )
+                }
+            }
+        }
+    }
+}
+
+/**
+ * Wraps the grid's fling so the log shows how each fling ended. Scrolling itself is unchanged:
+ * every delta goes to [inner]'s scope as before.
+ */
+internal class TracedFlingBehavior(
+    private val inner: FlingBehavior,
+    private val gridId: Int,
+    private val state: PanoramaMasonryState,
+) : FlingBehavior {
+
+    override suspend fun ScrollScope.performFling(initialVelocity: Float): Float {
+        val outer = this
+        val start = System.nanoTime()
+        var last = start
+        var maxGapNs = 0L
+        var frames = 0
+        var travelled = 0f
+        val traced = object : ScrollScope {
+            override fun scrollBy(pixels: Float): Float {
+                val now = System.nanoTime()
+                if (frames > 0) maxGapNs = maxOf(maxGapNs, now - last)
+                last = now
+                frames++
+                val before = state.scrollOffset
+                val consumed = outer.scrollBy(pixels)
+                travelled += consumed
+                if (abs(pixels - consumed) > 0.5f) {
+                    PanoramaScrollTrace.log(
+                        gridId,
+                        "short frame asked=${pixels.roundToInt()} got=${consumed.roundToInt()} " +
+                            "offset=${before.roundToInt()} max=${state.maxScroll.roundToInt()}",
+                    )
+                }
+                return consumed
+            }
+        }
+        PanoramaScrollTrace.log(
+            gridId,
+            "fling start v=${initialVelocity.roundToInt()} offset=${state.scrollOffset.roundToInt()} " +
+                "max=${state.maxScroll.roundToInt()}",
+        )
+        val outcome: String
+        val left: Float
+        try {
+            left = with(inner) { traced.performFling(initialVelocity) }
+            outcome = if (abs(left) > 1f) "stopped" else "done"
+        } catch (e: CancellationException) {
+            logFlingEnd("cancelled", 0f, start, frames, travelled, maxGapNs)
+            throw e
+        }
+        logFlingEnd(outcome, left, start, frames, travelled, maxGapNs)
+        return left
+    }
+
+    private fun logFlingEnd(outcome: String, left: Float, start: Long, frames: Int, travelled: Float, maxGapNs: Long) {
+        PanoramaScrollTrace.log(
+            gridId,
+            "fling $outcome left=${left.roundToInt()} dist=${travelled.roundToInt()} frames=$frames " +
+                "ms=${(System.nanoTime() - start) / 1_000_000} maxGap=${maxGapNs / 1_000_000}ms " +
+                "offset=${state.scrollOffset.roundToInt()} max=${state.maxScroll.roundToInt()}",
+        )
+    }
+}
+
+private const val TOUCH_SAMPLES = 32
+private const val RECENT_WINDOW_MS = 100L
