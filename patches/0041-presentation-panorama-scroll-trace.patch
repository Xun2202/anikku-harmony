+    @Test
+    fun `the scroll trace records the release and how the fling ended`() {
+        PanoramaScrollTrace.clearForTest()
+        coast(fastScroller = false)
+        val lines = PanoramaScrollTrace.snapshot()
+        println("FLING_TRACE normal\n" + lines.joinToString("\n"))
+        val up = lines.indexOfFirst { " up moves=" in it }
+        val start = lines.indexOfFirst { " fling start v=" in it }
+        val done = lines.indexOfFirst { " fling done " in it }
+        assertTrue(up >= 0 && start > up && done > start, lines.joinToString("\n"))
+    }
+
+    @Test
+    fun `the scroll trace names a jump that cancels the fling`() {
+        PanoramaScrollTrace.clearForTest()
+        runComposeUiTest { coastWithJump() }
+        val lines = PanoramaScrollTrace.snapshot()
+        println("FLING_TRACE jump\n" + lines.joinToString("\n"))
+        val jump = lines.indexOfFirst { " scrollToOffset " in it }
+        val cancelled = lines.indexOfFirst { " fling cancelled " in it }
+        assertTrue(jump >= 0 && cancelled > jump, lines.joinToString("\n"))
+    }
+
+    @Test
