+package eu.kanade.presentation.library.components
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import tachiyomi.presentation.core.components.PanoramaMasonryContentEpoch
+
+class PanoramaCoverShapesTest {
+    @BeforeEach
+    fun reset() {
+        PanoramaCoverShapes.resetForTest()
+        PanoramaCoverShapes.snapshotDispatcher = ImmediateSnapshotDispatcher
+    }
+
+    @Test
+    fun `same band put does not bump the layout epoch`() {
+        val epoch = PanoramaMasonryContentEpoch.intValue
+        PanoramaCoverShapes.put(1L, 0.50f)
+        PanoramaCoverShapes.put(1L, 0.62f)
+        assertEquals(epoch, PanoramaMasonryContentEpoch.intValue)
+        assertEquals(0.62f, PanoramaCoverShapes.committedRatio(1L))
+        assertTrue(committedCoverIsWide(1L))
+    }
+
+    @Test
+    fun `a cross band commit bumps the layout epoch once the grid settles`() {
+        PanoramaCoverShapes.put(2L, 0.50f)
+        val epoch = PanoramaMasonryContentEpoch.intValue
+        val token = Any()
+        PanoramaCoverShapes.setGridScrolling(token, scrolling = true)
+        PanoramaCoverShapes.put(2L, 1.60f)
+        assertEquals(epoch, PanoramaMasonryContentEpoch.intValue)
+        assertTrue(committedCoverIsWide(2L))
+
+        PanoramaCoverShapes.setGridScrolling(token, scrolling = false)
+        assertEquals(epoch + 1, PanoramaMasonryContentEpoch.intValue)
+        assertFalse(committedCoverIsWide(2L))
+        assertEquals(1.60f, PanoramaCoverShapes.committedRatio(2L))
+    }
+
+    @Test
+    fun `put on a background thread does not write snapshot state`() {
+        val posted = ArrayList<() -> Unit>()
+        PanoramaCoverShapes.snapshotDispatcher = object : PanoramaSnapshotDispatcher {
+            override fun isOwnerThread(): Boolean = false
+
+            override fun post(block: () -> Unit) {
+                posted.add(block)
+            }
+        }
+        val epoch = PanoramaMasonryContentEpoch.intValue
+        val worker = Thread {
+            PanoramaCoverShapes.put(3L, 1.70f)
+        }
+        worker.start()
+        worker.join()
+        assertEquals(epoch, PanoramaMasonryContentEpoch.intValue)
+        assertTrue(committedCoverIsWide(3L))
+        assertTrue(posted.isNotEmpty())
+        posted.forEach { it() }
+        assertEquals(epoch + 1, PanoramaMasonryContentEpoch.intValue)
+        assertFalse(committedCoverIsWide(3L))
+    }
+}
+
+private object ImmediateSnapshotDispatcher : PanoramaSnapshotDispatcher {
+    override fun isOwnerThread(): Boolean = true
+
+    override fun post(block: () -> Unit) {
+        block()
+    }
+}
