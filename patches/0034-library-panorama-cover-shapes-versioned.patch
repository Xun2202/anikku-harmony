+    internal fun postToOwner(block: () -> Unit) {
+        val scope = synchronized(gate) { persistScope }
+        if (scope != null) {
+            scope.launch(Dispatchers.Main.immediate) { block() }
+        } else {
+            synchronized(gate) { earlyFlush.add(block) }
+        }
+    }
+
+    private fun scheduleFlush() {
+        synchronized(gate) {
+            if (flushQueued) return
+            flushQueued = true
+        }
+        val dispatcher = snapshotDispatcher
+        if (dispatcher.isOwnerThread()) {
+            runFlush()
+        } else {
+            dispatcher.post { runFlush() }
+        }
+    }
+
+    private fun runFlush() {
+        val bump = synchronized(gate) {
+            flushQueued = false
+            applyPending(scrollingGrids.isEmpty())
+        }
+        // Harmony: one epoch for the whole batch. Same-band edits do not reach this write.
+        if (bump) PanoramaMasonryContentEpoch.intValue++
+    }
+
+    /** Caller holds [gate]. Returns whether a wide/tall band changed. */
+    private fun applyPending(settled: Boolean): Boolean {
+        var bump = false
+        val ids = ArrayList(pendingIds)
+        pendingIds.clear()
+        for (id in ids) {
+            val known = learnt[id] ?: continue
+            val current = committed[id]
+            if (current == null) {
+                committed[id] = known
+                if (!sameBand(known, WIDE_COVER_RATIO)) bump = true
+            } else if (sameBand(current, known)) {
+                committed[id] = known
+            } else if (settled) {
+                committed[id] = known
+                pendingCross.remove(id)
+                bump = true
+            } else {
+                pendingCross[id] = known
             }
         }
+        if (settled && pendingCross.isNotEmpty()) {
+            for ((id, ratio) in pendingCross) {
+                val current = committed[id]
+                if (current == null || !sameBand(current, ratio)) bump = true
+                committed[id] = ratio
+            }
+            pendingCross.clear()
+        }
+        return bump
+    }
+
+    private fun sameBand(left: Float, right: Float): Boolean {
+        return (left <= RatioSwitchToPanorama) == (right <= RatioSwitchToPanorama)
     }
 
