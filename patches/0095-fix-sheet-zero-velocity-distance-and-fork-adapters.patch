+/** Native snapping ignores its positional threshold at exactly zero velocity; keep a slow held drag usable. */
+private class SheetFlingBehavior(
+    private val state: AnchoredDraggableState<Int>,
+    private val delegate: FlingBehavior,
+    private val threshold: (Float) -> Float,
+) : FlingBehavior {
+    override suspend fun ScrollScope.performFling(initialVelocity: Float): Float {
+        if (initialVelocity != 0f) return with(delegate) { performFling(initialVelocity) }
+        val start = state.offset
+        val first = state.anchors.minPosition()
+        val last = state.anchors.maxPosition()
+        if (!start.isFinite() || !first.isFinite() || !last.isFinite()) return 0f
+        val target = if (start - first >= threshold(last - first)) last else first
+        if (abs(target - start) <= 0.5f) return 0f
+        var previous = 0f
+        animate(0f, target - start, animationSpec = SheetMotion) { value, _ ->
+            scrollBy(value - previous)
+            previous = value
+        }
+        return 0f
+    }
+}
