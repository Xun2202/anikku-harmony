+    /** The caller has already checked every existing file with [prepareFinalTarget]. */
+    suspend fun copyStagedVideo(staged: UniFile, directory: UniFile, onProgress: (Long) -> Unit) {
+        val name = staged.name ?: throw IOException("Staged video has no filename")
+        val bytes = staged.length()
+        if (bytes <= 0L) throw IOException("Staged video length cannot be verified")
+        val previous = directory.findFile(name)
+        if (previous?.length() == bytes) {
+            onProgress(bytes)
+            return
+        }
+        val marker = directory.findFile(FINAL_COPY_MARKER) ?: directory.createFile(FINAL_COPY_MARKER)
+            ?: throw IOException("Cannot mark the video as still saving")
+        if (marker.name != FINAL_COPY_MARKER || marker.isDirectory) throw IOException("Cannot mark the video as still saving")
+
+        // A partial prefix can be recreated from the staged file. The staged file remains until
+        // final verification and registration, including when the provider stops partway through.
+        previous?.let(::deleteRequired)
+        val target = directory.createFile(name) ?: throw IOException("Cannot create final video")
+        if (target.name != name || target.length() != 0L) throw IOException("Storage provider returned an unexpected final video")
+
+        val coroutine = currentCoroutineContext()
+        val copied = staged.openInputStream().use { input -> streamCopy(input, target, { coroutine.ensureActive() }, onProgress) }
+        if (copied != bytes || target.length() != bytes) throw IOException("Final video length could not be verified. The staged video was preserved")
+        onProgress(copied)
+    }
+
+    private fun streamCopy(input: InputStream, target: UniFile, checkActive: () -> Unit, onProgress: (Long) -> Unit): Long {
+        val buffer = ByteArray(256 * 1024)
+        var copied = 0L
+        var reported = 0L
+        target.openOutputStream().use { output ->
+            while (true) {
+                checkActive()
+                val count = input.read(buffer)
+                if (count < 0) break
+                if (count == 0) throw IOException("Could not read staged video")
+                output.write(buffer, 0, count)
+                copied += count
+                if (copied - reported >= 16 * 1024 * 1024) {
+                    reported = copied
+                    onProgress(copied)
+                }
+            }
+        }
+        return copied
+    }
+
