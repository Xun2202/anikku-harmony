+    fun select(queue: List<Download>, sourceLimit: Int, perSourceLimit: Int): List<Download> {
+        val pending = queue.filter { it.status.value <= Download.State.DOWNLOADING.value }
+        val saving = pending.filter(Download::isSaving)
+        val savingOutputs = saving.mapTo(hashSetOf()) { it.source to outputKey(it) }
+        // Storage writes run one at a time. Reserve one extra job for that work and retain the
+        // network allowance of writers waiting their turn, bounding the amount of pending media.
+        val waitingForStorage = saving.drop(1).groupingBy { it.source }.eachCount()
+        val transfers = pending.filter { !it.isSaving && (savingOutputs.isEmpty() || (it.source to outputKey(it)) !in savingOutputs) }.groupBy { it.source }
+        val freeSourceSlots = (sourceLimit.coerceIn(1, 10) - waitingForStorage.size).coerceAtLeast(0)
+        val allowedSources = waitingForStorage.keys + transfers.keys.filterNot { it in waitingForStorage }.take(freeSourceSlots)
+        val perSource = perSourceLimit.coerceIn(1, 3)
+        return saving + transfers.filterKeys { it in allowedSources }.flatMap { (source, downloads) ->
+            val available = (perSource - waitingForStorage.getOrDefault(source, 0)).coerceAtLeast(0)
+            downloads.asSequence().distinctBy(::outputKey).take(available).toList()
         }
+    }
 
