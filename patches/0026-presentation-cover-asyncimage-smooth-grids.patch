@@ -227,3 +218,33 @@ internal const val RatioSwitchToPanorama = 0.75f
 
 internal val CoverPlaceholderColor = Color(0x1F888888)
 internal val CoverPlaceholderOnBgColor = Color(0x8F888888)
+
+// Harmony -->
+private enum class CoverStatus { Loading, Success, Error }
+
+/**
+ * Memory and disk cache hits land within a few frames. A spinner shown at once would flash in
+ * every cell of a fling and animate each frame while it is up.
+ */
+@Composable
+private fun DelayedLoadingIndicator(
+    color: Color,
+    strokeWidth: Dp,
+    modifier: Modifier = Modifier,
+) {
+    var visible by remember { mutableStateOf(false) }
+    LaunchedEffect(Unit) {
+        delay(LoadingIndicatorDelay)
+        visible = true
+    }
+    if (visible) {
+        CircularProgressIndicator(
+            color = color,
+            strokeWidth = strokeWidth,
+            modifier = modifier,
+        )
+    }
+}
+
+private val LoadingIndicatorDelay = 400.milliseconds
+// Harmony <--
