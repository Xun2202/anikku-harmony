+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.WindowInsetsSides
+import androidx.compose.foundation.layout.displayCutout
+import androidx.compose.foundation.layout.ime
+import androidx.compose.foundation.layout.only
+import androidx.compose.foundation.layout.systemBars
+import androidx.compose.foundation.layout.tappableElement
+import androidx.compose.foundation.layout.union
+import androidx.compose.runtime.Composable
+
+/** Let the page draw behind the bottom gesture handle, while the keyboard and system buttons keep their space. */
+@Composable
+fun webViewContentInsets(): WindowInsets =
+    WindowInsets.systemBars.only(WindowInsetsSides.Horizontal + WindowInsetsSides.Top)
+        .union(WindowInsets.tappableElement)
+        .union(WindowInsets.displayCutout)
+        .union(WindowInsets.ime)
diff --git a/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeWebViewInsetsTest.kt b/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeWebViewInsetsTest.kt
