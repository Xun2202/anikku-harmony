+++ b/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeWebViewInsetsTest.kt
@@ -0,0 +1,93 @@
+package tachiyomi.presentation.core.components.material
+
+import android.graphics.Insets
+import android.view.DisplayCutout
+import android.view.View
+import android.view.WindowInsets
+import android.webkit.WebView
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.size
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.viewinterop.AndroidView
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class NavigationChromeWebViewInsetsTest {
+    @Test
+    fun `page reaches gesture edge and responds to keyboard buttons and cutouts`() = runComposeUiTest {
+        lateinit var host: View
+        setContent {
+            host = LocalView.current
+            MaterialTheme {
+                Box(Modifier.size(360.dp, 480.dp).testTag("viewport")) {
+                    Scaffold(contentWindowInsets = webViewContentInsets()) { padding ->
+                        Box(Modifier.fillMaxSize().padding(padding)) {
+                            AndroidView(factory = { WebView(it) }, modifier = Modifier.fillMaxSize().testTag("web"))
+                        }
+                    }
+                }
+            }
+        }
+        val viewport = onNodeWithTag("viewport").fetchSemanticsNode().boundsInRoot
+        val gesture = Insets.of(0, 0, 0, 24)
+
+        fun show(
+            navigation: Insets = gesture,
+            tappable: Insets = Insets.NONE,
+            keyboard: Insets = Insets.NONE,
+            cutout: Insets = Insets.NONE,
+        ) {
+            val insets = WindowInsets.Builder()
+                .setInsets(WindowInsets.Type.statusBars(), Insets.of(0, 20, 0, 0))
+                .setInsets(WindowInsets.Type.navigationBars(), navigation)
+                .setInsets(WindowInsets.Type.tappableElement(), tappable)
+                .setInsets(WindowInsets.Type.ime(), keyboard)
+                .setDisplayCutout(DisplayCutout(cutout, null, null, null, null))
+                .setVisible(WindowInsets.Type.systemBars() or WindowInsets.Type.tappableElement(), true)
+                .setVisible(WindowInsets.Type.ime(), keyboard != Insets.NONE)
+                .build()
+            runOnIdle { host.dispatchApplyWindowInsets(insets) }
+            waitForIdle()
+        }
+
+        fun assertPage(bottom: Int, left: Int = 0, right: Int = 0) {
+            val page = onNodeWithTag("web").fetchSemanticsNode().boundsInRoot
+            assertEquals(viewport.left + left, page.left, 0.5f)
+            assertEquals(viewport.top + 20, page.top, 0.5f)
+            assertEquals(viewport.right - right, page.right, 0.5f)
+            assertEquals(viewport.bottom - bottom, page.bottom, 0.5f)
+        }
+
+        show()
+        assertPage(bottom = 0)
+        show(keyboard = Insets.of(0, 0, 0, 164))
+        assertPage(bottom = 164)
+        show()
+        assertPage(bottom = 0)
+        val buttons = Insets.of(0, 0, 0, 48)
+        show(navigation = buttons, tappable = buttons)
+        assertPage(bottom = 48)
+        val sideButtons = Insets.of(0, 0, 48, 0)
+        show(navigation = sideButtons, tappable = sideButtons, cutout = Insets.of(18, 0, 0, 0))
+        assertPage(bottom = 0, left = 18, right = 48)
+        show(cutout = Insets.of(0, 0, 0, 12))
+        assertPage(bottom = 12)
+    }
+}
