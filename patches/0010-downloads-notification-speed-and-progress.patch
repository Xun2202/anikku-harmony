@@ -0,0 +1,70 @@
+package eu.kanade.tachiyomi.data.download
+
+import android.os.SystemClock
+import okio.Buffer
+import okio.BufferedSource
+import okio.ForwardingSource
+import okio.buffer
+
+/**
+ * Sliding-window download speed for the download queue notification.
+ *
+ * Every byte the downloader receives is reported through [addBytes] (or by reading through
+ * [countingInto]); [bytesPerSecond] averages the last [WINDOW_SECONDS] whole seconds, so the value
+ * is stable at the 1 Hz the notification is refreshed with and drops to zero within a few seconds of
+ * a stall. Shared by the HarmonyOS builds of Mihon and Anikku so that both notifications read the same.
+ */
+object DownloadSpeedMeter {
+
+    private const val BUCKETS = 8
+    private const val WINDOW_SECONDS = 3
+
+    private val lock = Any()
+    private val bucketBytes = LongArray(BUCKETS)
+    private val bucketSecond = LongArray(BUCKETS) { -1L }
+
+    fun addBytes(bytes: Long) {
+        if (bytes <= 0) return
+        val second = SystemClock.elapsedRealtime() / 1000
+        synchronized(lock) {
+            val index = (second % BUCKETS).toInt()
+            if (bucketSecond[index] != second) {
+                bucketSecond[index] = second
+                bucketBytes[index] = 0
+            }
+            bucketBytes[index] += bytes
+        }
+    }
+
+    /** Bytes per second averaged over the last whole seconds; the current, partial second is excluded. */
+    fun bytesPerSecond(): Long {
+        val now = SystemClock.elapsedRealtime() / 1000
+        synchronized(lock) {
+            var sum = 0L
+            for (second in (now - WINDOW_SECONDS) until now) {
+                val index = (second % BUCKETS).toInt()
+                if (bucketSecond[index] == second) sum += bucketBytes[index]
+            }
+            return sum / WINDOW_SECONDS
+        }
+    }
+
+    fun reset() {
+        synchronized(lock) {
+            bucketSecond.fill(-1L)
+            bucketBytes.fill(0L)
+        }
+    }
+
+    /** Wraps a source so that everything read from it is counted by this meter. */
+    fun BufferedSource.countingInto(meter: DownloadSpeedMeter): BufferedSource {
+        val delegate = this
+        return object : ForwardingSource(delegate) {
+            override fun read(sink: Buffer, byteCount: Long): Long {
+                val read = super.read(sink, byteCount)
+                if (read > 0) meter.addBytes(read)
+                return read
+            }
+        }.buffer()
+    }
+}
