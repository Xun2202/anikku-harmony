+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import okhttp3.Headers.Companion.headersOf
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.jupiter.api.Assertions.assertArrayEquals
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+import java.util.concurrent.ConcurrentLinkedQueue
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class NavigationChromeDownloadHlsGapTest {
+    @TempDir
+    lateinit var cache: File
+
+    @Test
+    fun `later fragments finish and refresh requests only the remaining holes in order`() = runTest {
+        val source = Source(14) { pass, segment ->
+            if ((segment == 4 && pass == 1) || (segment == 8 && pass <= 2)) 403 else 200
+        }
+        val gaps = mutableListOf<Int?>()
+        val times = mutableListOf<Long>()
+        val prepared = DownloadHlsSegments.withAuthorizationRecovery(
+            transfer = { source.transfer(cache, it) },
+            refresh = {
+                gaps += it.missingSegments
+                times += testScheduler.currentTime
+                assertFalse(cache.walk().any { file -> file.name == "input.m3u8" })
+            },
+        )
+        assertEquals(listOf(2, 1), gaps)
+        assertEquals(listOf(8_000L, 32_000L), times)
+        assertEquals((1..14).toList(), source.requested(1))
+        assertEquals(listOf(4, 8), source.requested(2))
+        assertEquals(listOf(8), source.requested(3))
+        verifyOutput(prepared)
+    }
+
+    @Test
+    fun `persistent denial preserves every other fragment for a later resume`() = runTest {
+        val available = AtomicBoolean(false)
+        val source = Source(18) { _, segment -> if (segment == 6 && !available.get()) 403 else 200 }
+        val failure = runCatching {
+            DownloadHlsSegments.withAuthorizationRecovery(transfer = { source.transfer(cache, it) }, refresh = {})
+        }.exceptionOrNull() as DownloadHlsSegments.Failure
+        assertEquals(403, failure.httpStatus)
+        assertEquals(6, failure.segmentNumber)
+        assertEquals(1, failure.missingSegments)
+        assertEquals(17, cache.walk().count { it.extension == "ts" })
+        assertFalse(cache.walk().any { it.name == "input.m3u8" })
+        assertEquals(listOf(6), source.requested(2))
+        assertEquals(listOf(6), source.requested(3))
+
+        available.set(true)
+        val resumed = source.transfer(cache, false)
+        assertEquals(listOf(6), source.requested(4))
+        verifyOutput(resumed)
+    }
+
+    @Test
+    fun `widespread refusal waits before one refresh and stops probing the playlist`() = runTest {
+        val source = Source(150) { _, _ -> 403 }
+        val times = mutableListOf<Long>()
+        val failure = runCatching {
+            DownloadHlsSegments.withAuthorizationRecovery(
+                transfer = { source.transfer(cache, it) },
+                refresh = { times += testScheduler.currentTime },
+            )
+        }.exceptionOrNull() as DownloadHlsSegments.Failure
+        assertEquals(listOf(8_000L), times)
+        assertEquals(403, failure.httpStatus)
+        assertNull(failure.missingSegments)
+        for (pass in 1..2) {
+            val attempted = source.requested(pass)
+            assertTrue(attempted.size in 5..6)
+            assertEquals(150, attempted.last())
+        }
+        assertTrue(source.requested(3).isEmpty())
+        assertFalse(cache.walk().any { it.extension == "ts" || it.name == "input.m3u8" })
+    }
+
+    @Test
+    fun `a cluster of neighbouring refusals does not stop reachable fragments beyond it`() = runTest {
+        val source = Source(45) { pass, segment -> if (pass <= 2 && segment in 6..12) 403 else 200 }
+        val gaps = mutableListOf<Int?>()
+        val prepared = DownloadHlsSegments.withAuthorizationRecovery(
+            transfer = { source.transfer(cache, it) },
+            refresh = { gaps += it.missingSegments },
+        )
+        assertEquals(listOf(7, 7), gaps)
+        assertEquals((1..45).toList(), source.requested(1))
+        assertEquals((6..12).toList(), source.requested(2))
+        assertEquals((6..12).toList(), source.requested(3))
+        verifyOutput(prepared)
+    }
+
+    @Test
+    fun `a new burst after sustained verified progress can recover during the same download`() = runTest {
+        val source = Source(60) { pass, segment ->
+            if ((pass == 1 && segment >= 6) || (pass == 2 && segment >= 36)) 403 else 200
+        }
+        val refreshes = mutableListOf<DownloadHlsSegments.Failure>()
+        var alreadyCached = emptySet<Int>()
+        val prepared = DownloadHlsSegments.withAuthorizationRecovery(
+            transfer = { source.transfer(cache, it) },
+            refresh = {
+                refreshes += it
+                alreadyCached = cache.walk().filter { file -> file.extension == "ts" }.map { file -> file.nameWithoutExtension.toInt() + 1 }.toSet()
+            },
+        )
+        assertEquals(2, refreshes.size)
+        assertTrue(refreshes[1].newSegments >= 16)
+        assertTrue(source.requested(3).none { it in alreadyCached })
+        verifyOutput(prepared)
+    }
+
+    @Test
+    fun `recurring refusals have an overall ceiling even when some data keeps arriving`() = runTest {
+        var refreshes = 0
+        val failure = runCatching {
+            DownloadHlsSegments.withAuthorizationRecovery(
+                transfer = { throw DownloadHlsSegments.Failure("burst", 403, 40, newSegments = 20) },
+                refresh = { refreshes++ },
+            )
+        }.exceptionOrNull() as DownloadHlsSegments.Failure
+        assertEquals(403, failure.httpStatus)
+        assertEquals(6, refreshes)
+    }
+
+    @Test
+    fun `pausing during a refusal cooldown cancels the pending refresh`() = runTest {
+        var transfers = 0
+        var refreshes = 0
+        val job = launch {
+            DownloadHlsSegments.withAuthorizationRecovery(
+                transfer = {
+                    transfers++
+                    throw DownloadHlsSegments.Failure("synthetic refusal", 403, 4, missingSegments = 1)
+                },
+                refresh = { refreshes++ },
+            )
+        }
+        runCurrent()
+        advanceTimeBy(7_999L)
+        job.cancelAndJoin()
+        assertEquals(1, transfers)
+        assertEquals(0, refreshes)
+    }
+
+    private suspend fun verifyOutput(prepared: DownloadHlsSegments.Prepared) {
+        val output = File(cache, "offline.ts")
+        DownloadHlsSegments.writeTransportStream(prepared, output) {}
+        val expected = ByteArray(prepared.segments * FRAGMENT_BYTES) { byte ->
+            if (byte % 188 == 0) 0x47 else (byte / FRAGMENT_BYTES + 1).toByte()
+        }
+        assertArrayEquals(expected, output.readBytes())
+    }
+
+    private class Source(size: Int, status: (Int, Int) -> Int) {
+        private val pass = AtomicInteger()
+        private val calls = ConcurrentLinkedQueue<Pair<Int, Int>>()
+        private val manifest = buildString {
+            appendLine("#EXTM3U")
+            for (segment in 1..size) {
+                appendLine("#EXTINF:4,")
+                appendLine("/segment?url=$segment")
+            }
+            appendLine("#EXT-X-ENDLIST")
+        }.toByteArray()
+        private val client = OkHttpClient.Builder().addInterceptor { chain ->
+            val request = chain.request()
+            val response = Response.Builder().request(request).protocol(Protocol.HTTP_1_1).message("fixture")
+            if (request.url.encodedPath == "/m3u8") {
+                pass.incrementAndGet()
+                response.code(200).body(manifest.toResponseBody()).build()
+            } else {
+                val segment = checkNotNull(request.url.queryParameter("url")).toInt()
+                calls.add(pass.get() to segment)
+                val code = status(pass.get(), segment)
+                val bytes = if (code == 200) {
+                    ByteArray(FRAGMENT_BYTES) { if (it % 188 == 0) 0x47 else segment.toByte() }
+                } else {
+                    byteArrayOf()
+                }
+                response.code(code).body(bytes.toResponseBody()).build()
+            }
+        }.build()
+
+        fun requested(attempt: Int): List<Int> = calls.filter { it.first == attempt }.map { it.second }.sorted()
+
+        suspend fun transfer(cache: File, fresh: Boolean): DownloadHlsSegments.Prepared = checkNotNull(
+            DownloadHlsSegments.prepare(client, "MissAV", "http://localhost:1234/m3u8", headersOf(), cache, fresh) {},
+        )
+    }
+
+    private companion object {
+        const val FRAGMENT_BYTES = 188 * 4
+    }
+}
