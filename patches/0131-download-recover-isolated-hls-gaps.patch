+    private class SegmentPass(
+        private val pending: List<Int>,
+        private val smallRepair: Boolean,
+        private val onFirstGap: (Int) -> Unit,
+    ) {
+        private var front = 0
+        private var end = pending.size
+        private var distant: Int? = null
+        private var first: Failure? = null
+        private var count = 0
+        private var consecutive = 0
+        private var newSegments = 0
+
+        @Synchronized
+        fun nextSegment(): Int? {
+            if (front == end) return null
+            if (smallRepair || consecutive < MAX_CONSECUTIVE_DENIALS) return pending[front++]
+            // Adjacent failures can belong to a single bad range. Check one distant missing
+            // fragment before stopping. Only its worker continues while this check is pending.
+            if (distant != null) return null
+            return pending[--end].also { distant = it }
+        }
+
+        @Synchronized
+        fun completed(index: Int) {
+            if (index == distant) distant = null
+            consecutive = 0
+            newSegments++
+        }
+
+        @Synchronized
+        fun defer(index: Int, failure: Failure) {
+            if (first == null) {
+                first = failure
+                onFirstGap(checkNotNull(failure.segmentNumber))
+            }
+            count++
+            consecutive++
+            if (index == distant) {
+                distant = null
+                if (consecutive >= MAX_CONSECUTIVE_DENIALS) {
+                    val earliest = checkNotNull(first)
+                    throw Failure(
+                        "${earliest.message}; consecutive=$consecutive distant=${index + 1}",
+                        403,
+                        earliest.segmentNumber,
+                        newSegments = newSegments,
+                    )
+                }
+            }
+        }
+
+        fun requireComplete() {
+            val failed = first ?: return
+            throw Failure("${failed.message}; $count missing", 403, failed.segmentNumber, count, newSegments)
+        }
+    }
