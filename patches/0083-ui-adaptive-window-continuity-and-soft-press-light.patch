+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.ui.graphics.Color
+import kotlin.math.exp
+
+/** Shared sampled Gaussian mixture: bright contact, broad faint tail, no white plateau. */
+internal val capsuleGlowStops: Array<Pair<Float, Color>> = Array(65) { index ->
+    val radius = index / 64f
+    val squared = radius * radius
+    val edge = 0.78f * exp(-18f) + 0.10f * exp(-5f)
+    val alpha = (0.78f * exp(-18f * squared) + 0.10f * exp(-5f * squared) - edge)
+        .coerceAtLeast(0f)
+    radius to Color.White.copy(alpha = alpha)
+}
