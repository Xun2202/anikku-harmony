+package tachiyomi.presentation.core.components
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Test
+
+class NavigationChromeFrameCommitTest {
+    private class Target : FrameCommitTarget {
+        override var available = true
+        val callbacks = mutableListOf<Runnable>()
+        var removals = 0
+        override fun register(callback: Runnable) {
+            callbacks += callback
+        }
+        override fun unregister(callback: Runnable) {
+            removals++
+            callbacks.remove(callback)
+        }
+    }
+
+    @Test
+    fun `draw sampling is throttled and a missing commit cannot accumulate callbacks`() {
+        val target = Target()
+        var now = 1_000_000L
+        val probe = FrameCommitProbe(target) { now }
+        probe.onDraw(now)
+        repeat(200) { probe.onDraw(now + it * 11_000_000L) }
+        assertEquals(1, target.callbacks.size)
+        now += 2_000_000_000L
+        assertEquals(2_000_000_000L, probe.snapshot().pendingNanos)
+        now += 5_000_000L
+        target.callbacks.removeAt(0).run()
+        assertEquals(1L, probe.snapshot().committed)
+        assertEquals(2_005_000_000L, probe.snapshot().maxNanos)
+        probe.onDraw(now)
+        val second = target.callbacks.removeAt(0)
+        now += 4_000_000L
+        second.run()
+        probe.onDraw(now)
+        assertEquals(2L, probe.snapshot().requested, "No third sample inside the 500 ms interval")
+        assertEquals(4_000_000L, probe.snapshot().lastNanos)
+        assertEquals(2_005_000_000L, probe.snapshot().maxNanos)
+    }
+
+    @Test
+    fun `stop unregisters outstanding work and an already queued callback is inert`() {
+        val target = Target()
+        var now = 1_000_000L
+        val probe = FrameCommitProbe(target) { now }
+        probe.onDraw(now)
+        val queued = target.callbacks.single()
+        probe.stop()
+        probe.stop()
+        now += 10_000_000L
+        queued.run()
+        probe.onDraw(now + 2_000_000_000L)
+        assertEquals(1, target.removals)
+        assertEquals(0L, probe.snapshot().committed)
+        assertEquals(-1L, probe.snapshot().pendingNanos)
+        assertEquals(0, target.callbacks.size)
+    }
+
+    @Test
+    fun `unsupported hardware has no callback and does not force drawing`() {
+        val target = Target().apply { available = false }
+        val probe = FrameCommitProbe(target) { 1L }
+        probe.onDraw(1L)
+        probe.onDraw(1_000_000_001L)
+        assertFalse(probe.snapshot().available)
+        assertEquals(0L, probe.snapshot().requested)
+        assertEquals(0, target.callbacks.size)
+        probe.stop()
+        assertEquals(0, target.removals)
+    }
+}
