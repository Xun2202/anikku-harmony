@@ -0,0 +1,128 @@
+package tachiyomi.presentation.core.components
+
+import android.annotation.TargetApi
+import android.os.Build
+import android.view.View
+import android.view.ViewTreeObserver
+import java.lang.ref.WeakReference
+import java.util.Locale
+
+internal interface FrameCommitTarget {
+    val available: Boolean
+    fun register(callback: Runnable)
+    fun unregister(callback: Runnable)
+}
+
+internal data class FrameCommitSnapshot(
+    val available: Boolean,
+    val requested: Long,
+    val committed: Long,
+    val lastNanos: Long,
+    val maxNanos: Long,
+    val pendingNanos: Long,
+    val errors: Long,
+)
+
+/** Passive, at most 2 Hz, single-outstanding submission callback. Never requests a frame. */
+class FrameCommitProbe internal constructor(
+    private val target: FrameCommitTarget,
+    private val clock: () -> Long,
+) {
+    constructor(view: View) : this(ViewCommitTarget(view), System::nanoTime)
+
+    private val lock = Any()
+
+    @Volatile private var closed = false
+
+    @Volatile private var pending: Runnable? = null
+    private var nextSample = 0L
+    private var requestedAt = 0L
+    private var available = false
+    private var requested = 0L
+    private var committed = 0L
+    private var lastNanos = -1L
+    private var maxNanos = -1L
+    private var errors = 0L
+
+    fun onDraw(nowNanos: Long) {
+        if (closed || pending != null || nowNanos < nextSample) return
+        synchronized(lock) {
+            if (closed || pending != null) return
+            nextSample = nowNanos + 500_000_000L
+            available = target.available
+            if (!available) return
+            requestedAt = nowNanos
+            requested++
+            val callback = object : Runnable {
+                override fun run() {
+                    val arrived = clock()
+                    synchronized(lock) {
+                        if (closed || pending !== this) return
+                        lastNanos = (arrived - requestedAt).coerceAtLeast(0L)
+                        maxNanos = maxOf(maxNanos, lastNanos)
+                        committed++
+                        pending = null
+                    }
+                }
+            }
+            pending = callback
+            try {
+                target.register(callback)
+            } catch (_: RuntimeException) {
+                if (pending === callback) pending = null
+                errors++
+            }
+        }
+    }
+
+    fun stop() {
+        val callback = synchronized(lock) {
+            closed = true
+            pending.also { pending = null }
+        }
+        if (callback != null) runCatching { target.unregister(callback) }
+    }
+
+    internal fun snapshot(): FrameCommitSnapshot = synchronized(lock) {
+        FrameCommitSnapshot(
+            available,
+            requested,
+            committed,
+            lastNanos,
+            maxNanos,
+            if (pending == null) -1L else (clock() - requestedAt).coerceAtLeast(0L),
+            errors,
+        )
+    }
+
+    /** Submission is not display presentation, GPU completion, or presented FPS. */
+    fun summary(): String {
+        val sample = snapshot()
+        fun ms(value: Long): String = if (value < 0L) "n/a" else String.format(Locale.US, "%.2f", value / 1_000_000.0)
+        return "available=${sample.available} requested=${sample.requested} committed=${sample.committed} " +
+            "draw_to_submit_callback_ms=${ms(sample.lastNanos)} max_ms=${ms(sample.maxNanos)} " +
+            "pending_ms=${ms(sample.pendingNanos)} errors=${sample.errors}"
+    }
+}
+
+private class ViewCommitTarget(view: View) : FrameCommitTarget {
+    private val view = WeakReference(view)
+    private var owner = WeakReference<ViewTreeObserver>(null)
+    override val available: Boolean get() = Build.VERSION.SDK_INT >= 29 && view.get()?.isHardwareAccelerated == true
+
+    @TargetApi(29)
+    override fun register(callback: Runnable) {
+        val observer = checkNotNull(view.get()).viewTreeObserver
+        owner = WeakReference(observer)
+        observer.registerFrameCommitCallback(callback)
+    }
+
+    @TargetApi(29)
+    override fun unregister(callback: Runnable) {
+        val original = owner.get()
+        if (original?.isAlive == true) original.unregisterFrameCommitCallback(callback)
+        val current = view.get()?.viewTreeObserver
+        if (current !== original && current?.isAlive == true) current.unregisterFrameCommitCallback(callback)
+        owner.clear()
+    }
+}
