+    private fun holeReport(layout: PanoramaMasonryLayout): HoleReport {
+        val bottoms = IntArray(layout.laneCount)
+        var wasteArea = 0L
+        var itemArea = 0L
+        var maxGap = 0
+        var upwardSteps = 0
+        var maxUpward = 0
+        var skippedLeftPair = 0
+        var previousY = Int.MIN_VALUE
+        for (rect in layout.rects) {
+            if (previousY != Int.MIN_VALUE && rect.y < previousY) {
+                upwardSteps++
+                maxUpward = maxOf(maxUpward, previousY - rect.y)
+            }
+            previousY = rect.y
+            itemArea += rect.width.toLong() * rect.height
+            val occupied = panoramaLaneSpan(rect.span, layout.laneCount)
+            if (occupied >= 2) {
+                val top = maxOf(bottoms[rect.lane], bottoms[rect.lane + 1])
+                check(rect.y == top) { "replay diverged at ${rect.index}" }
+                val shorter = if (bottoms[rect.lane] <= bottoms[rect.lane + 1]) rect.lane else rect.lane + 1
+                val gap = top - bottoms[shorter]
+                wasteArea += gap.toLong() * layout.laneWidths[shorter]
+                maxGap = maxOf(maxGap, gap)
+                if (panoramaReadingPair(bottoms, rect.height) != rect.lane) skippedLeftPair++
+                val next = top + rect.height + layout.verticalSpacing
+                bottoms[rect.lane] = next
+                bottoms[rect.lane + 1] = next
+            } else if (rect.fullLine) {
+                val y = bottoms.maxOrNull() ?: 0
+                val next = y + rect.height + layout.verticalSpacing
+                for (lane in bottoms.indices) bottoms[lane] = next
+            } else {
+                check(rect.y == bottoms[rect.lane]) { "replay diverged at ${rect.index}" }
+                bottoms[rect.lane] = rect.y + rect.height + layout.verticalSpacing
+            }
+        }
+        return HoleReport(
+            wasteArea = wasteArea,
+            itemArea = itemArea,
+            footprint = layout.contentWidth.toLong() * layout.contentHeight,
+            maxGap = maxGap,
+            upwardSteps = upwardSteps,
+            maxUpward = maxUpward,
+            skippedLeftPair = skippedLeftPair,
+            contentHeight = layout.contentHeight,
+        )
+    }
