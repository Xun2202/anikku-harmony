 /**
- * @param heightOf item height for the width it would occupy in that lane, or the full content
- * width when the item is a full line. Cover height depends on the lane width; a one pixel
- * remainder can change it by a pixel, so the lane is chosen with that lane's own height.
+ * Lanes a span actually occupies. A wide cover stays in one lane when there is nowhere to span.
+ */
+fun panoramaLaneSpan(span: PanoramaSpan, laneCount: Int): Int {
+    return when (span) {
+        PanoramaSpan.FullLine -> laneCount.coerceAtLeast(1)
+        PanoramaSpan.SingleLane -> 1
+        // Harmony: two lanes only when a third exists, so a 2-column screen does not stretch one cover across the row.
+        PanoramaSpan.TwoLanesWhenRoomy -> if (laneCount >= 3) 2 else 1
+    }
+}
+
+/**
+ * Left lane of the adjacent pair whose top is within the recess limit.
+ * A pair's top is the deeper of the two lane bottoms. Exactly half is still eligible.
+ */
+fun panoramaReadingPair(bottoms: IntArray, itemHeight: Int): Int {
+    val pairs = bottoms.size - 1
+    require(pairs >= 1) { "a two-lane cell needs two columns" }
+    val limit = pairRecessLimit(bottoms, pairs, itemHeight)
+    for (index in 0 until pairs) {
+        if (pairTop(bottoms, index).toDouble() <= limit) return index
+    }
+    return 0
+}
+
+/**
+ * Left lane of the eligible pair that wastes the least area in its shorter lane.
+ * Ties stay on the leftmost pair. [laneWidths] are the column widths, not the spanned width.
+ */
+fun panoramaLeastWastePair(bottoms: IntArray, laneWidths: IntArray, itemHeight: Int): Int {
+    val pairs = bottoms.size - 1
+    require(pairs >= 1) { "a two-lane cell needs two columns" }
+    val limit = pairRecessLimit(bottoms, pairs, itemHeight)
+    var chosen = 0
+    var leastWaste = Long.MAX_VALUE
+    var found = false
+    for (index in 0 until pairs) {
+        val top = pairTop(bottoms, index)
+        if (top.toDouble() > limit) continue
+        val shorter = if (bottoms[index] <= bottoms[index + 1]) index else index + 1
+        val waste = (top - bottoms[shorter]).toLong() * laneWidths[shorter]
+        if (!found || waste < leastWaste) {
+            found = true
+            chosen = index
+            leastWaste = waste
+        }
+    }
+    return chosen
+}
+
+private fun pairTop(bottoms: IntArray, left: Int): Int {
+    return maxOf(bottoms[left], bottoms[left + 1])
+}
+
+private fun pairRecessLimit(bottoms: IntArray, pairs: Int, itemHeight: Int): Double {
+    var shortest = pairTop(bottoms, 0)
+    for (index in 1 until pairs) {
+        val top = pairTop(bottoms, index)
+        if (top < shortest) shortest = top
+    }
+    return shortest.toDouble() + itemHeight * PANORAMA_RECESS_FRACTION
+}
