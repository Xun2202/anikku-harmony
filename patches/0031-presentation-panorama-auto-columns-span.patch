+
+    private fun fillRgbRect(
+        rgb: ByteArray,
+        imageWidth: Int,
+        imageHeight: Int,
+        x: Int,
+        y: Int,
+        rectWidth: Int,
+        rectHeight: Int,
+        color: Int,
+    ) {
+        val red = (color shr 16 and 0xFF).toByte()
+        val green = (color shr 8 and 0xFF).toByte()
+        val blue = (color and 0xFF).toByte()
+        val left = x.coerceAtLeast(0)
+        val top = y.coerceAtLeast(0)
+        val right = (x + rectWidth).coerceAtMost(imageWidth)
+        val bottom = (y + rectHeight).coerceAtMost(imageHeight)
+        for (row in top until bottom) {
+            var offset = (row * imageWidth + left) * 3
+            repeat(right - left) {
+                rgb[offset] = red
+                rgb[offset + 1] = green
+                rgb[offset + 2] = blue
+                offset += 3
+            }
+        }
+    }
+
+    /** Filter 0 on every row, one IDAT, zlib wrapper from [Deflater]. */
+    private fun writeRgbPng(file: File, width: Int, height: Int, rgb: ByteArray) {
+        val rowStride = width * 3
+        val raw = ByteArray(height * (1 + rowStride))
+        var source = 0
+        var dest = 0
+        repeat(height) {
+            raw[dest] = 0
+            dest += 1
+            rgb.copyInto(raw, dest, source, source + rowStride)
+            source += rowStride
+            dest += rowStride
+        }
+        val compressed = ByteArrayOutputStream()
+        val deflater = Deflater()
+        try {
+            deflater.setInput(raw)
+            deflater.finish()
+            val buffer = ByteArray(8 * 1024)
+            while (!deflater.finished()) {
+                val count = deflater.deflate(buffer)
+                compressed.write(buffer, 0, count)
+            }
+        } finally {
+            deflater.end()
+        }
+        file.outputStream().buffered().use { out ->
+            out.write(PNG_SIGNATURE)
+            writePngChunk(out, "IHDR", pngIhdr(width, height))
+            writePngChunk(out, "IDAT", compressed.toByteArray())
+            writePngChunk(out, "IEND", ByteArray(0))
+        }
+    }
+
+    private fun pngIhdr(width: Int, height: Int): ByteArray {
+        val data = ByteArray(13)
+        writeIntAt(data, 0, width)
+        writeIntAt(data, 4, height)
+        data[8] = 8
+        data[9] = 2
+        return data
+    }
+
+    private fun writePngChunk(out: OutputStream, type: String, data: ByteArray) {
+        val typeBytes = type.toByteArray(Charsets.US_ASCII)
+        writePngInt(out, data.size)
+        out.write(typeBytes)
+        out.write(data)
+        val crc = CRC32()
+        crc.update(typeBytes)
+        crc.update(data)
+        writePngInt(out, crc.value.toInt())
+    }
+
+    private fun writePngInt(out: OutputStream, value: Int) {
+        out.write(value ushr 24)
+        out.write(value ushr 16)
+        out.write(value ushr 8)
+        out.write(value)
+    }
+
+    private fun writeIntAt(data: ByteArray, offset: Int, value: Int) {
+        data[offset] = (value ushr 24).toByte()
+        data[offset + 1] = (value ushr 16).toByte()
+        data[offset + 2] = (value ushr 8).toByte()
+        data[offset + 3] = value.toByte()
+    }
+
+    private fun wideMask(count: Int, fraction: Double, seed: Long): BooleanArray {
+        val random = Random(seed)
+        return BooleanArray(count) { random.nextDouble() < fraction }
+    }
+
+    private fun tallHeight(width: Int): Int = (width * 1.5 + 40.0).roundToInt()
+
+    private fun wideHeight(width: Int): Int = (width / 1.5 + 40.0).roundToInt()
+
+    private fun percent(fraction: Double): String = "${(fraction * 100).roundToInt()}%"
+
+    private fun fmt(value: Double): String = "%.2f%%".format(value)
+
+    private class HoleReport(
+        val wasteArea: Long,
+        val itemArea: Long,
+        val footprint: Long,
+        val maxGap: Int,
+        val upwardSteps: Int,
+        val maxUpward: Int,
+        val skippedLeftPair: Int,
+        val contentHeight: Int,
+    ) {
+        val holePercent: Double
+            get() = if (itemArea + wasteArea == 0L) 0.0 else wasteArea * 100.0 / (itemArea + wasteArea)
+
+        val footprintPercent: Double
+            get() = if (footprint == 0L) 0.0 else wasteArea * 100.0 / footprint
+    }
