+    var options by remember { mutableStateOf<List<Int>?>(null) }
+    var failed by remember { mutableStateOf(false) }
+    var selected by remember { mutableStateOf(download.selectedQualityHeight) }
+    LaunchedEffect(attempt) {
+        failed = false
+        options = null
+        try {
+            options = loadQualities(download)
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            failed = true
+        }
+    }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(AMR.strings.harmony_download_change_quality)) },
+        text = {
+            val heights = options
+            when {
+                failed -> Text(stringResource(AMR.strings.harmony_download_quality_load_failed))
+                heights == null -> Text(stringResource(MR.strings.loading))
+                heights.isEmpty() -> Text(stringResource(AMR.strings.harmony_download_quality_empty))
+                else -> Column(Modifier.verticalScroll(rememberScrollState()).selectableGroup()) {
+                    heights.forEach { height ->
+                        Row(
+                            modifier = Modifier.fillMaxWidth().heightIn(min = 48.dp)
+                                .selectable(selected == height, role = Role.RadioButton, onClick = { selected = height }),
+                            verticalAlignment = Alignment.CenterVertically,
+                        ) {
+                            RadioButton(selected = selected == height, onClick = null)
+                            Text("${height}p", Modifier.padding(start = 12.dp))
+                        }
+                    }
+                }
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(MR.strings.action_cancel)) }
+        },
+        confirmButton = {
+            if (failed) {
+                TextButton(onClick = { attempt++ }) { Text(stringResource(MR.strings.action_retry)) }
+            } else {
+                val choice = selected
+                TextButton(
+                    enabled = choice != null && options?.contains(choice) == true,
+                    onClick = { if (choice != null) onConfirm(choice) },
+                ) { Text(stringResource(AMR.strings.harmony_download_restart)) }
+            }
+        },
+    )
+}
