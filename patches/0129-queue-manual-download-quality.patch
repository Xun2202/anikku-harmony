+    /** Existing releases stored segments directly under root. Keep that track usable when switching back. */
+    fun markOriginalQuality(root: File, height: Int?) {
+        val owner = File(root, "original-quality")
+        if (owner.exists()) return
+        if (!root.isDirectory && !root.mkdirs()) throw IOException("Cannot open segment cache")
+        val tmp = File(root, "original-quality.tmp")
+        tmp.writeText((height ?: 0).toString())
+        if (!tmp.renameTo(owner)) throw IOException("Cannot save segment cache quality")
+    }
+
+    fun cacheForQuality(root: File, height: Int?): File {
+        val owner = File(root, "original-quality")
+        if (!owner.isFile || owner.readText() == (height ?: 0).toString()) return root
+        return File(root, "quality-${height ?: 0}")
     }
 
