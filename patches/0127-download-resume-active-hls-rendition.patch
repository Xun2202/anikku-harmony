+    @Test
+    fun `two workers can report neighbouring refused segments in either order`() = runTest {
+        for ((first, second) in listOf(511 to 512, 512 to 511, 511 to 520)) {
+            var transfers = 0
+            var refreshes = 0
+            var alternates = 0
+            val result = runCatching {
+                DownloadHlsSegments.withAuthorizationRecovery(
+                    transfer = {
+                        when (++transfers) {
+                            1 -> throw DownloadHlsSegments.Failure("denied", 403, first)
+                            2 -> throw DownloadHlsSegments.Failure("denied", 403, second)
+                            else -> "complete"
+                        }
+                    },
+                    refresh = { refreshes++ },
+                    selectAlternate = {
+                        alternates++
+                        true
+                    },
+                )
+            }
+            assertEquals(1, refreshes)
+            if (second == 520) {
+                assertEquals(0, alternates)
+                assertTrue(result.exceptionOrNull() is DownloadHlsSegments.Failure)
+            } else {
+                assertEquals(1, alternates)
+                assertEquals("complete", result.getOrThrow())
+            }
+        }
+    }
+
+    @Test
+    fun `a cut off source list is read once more and a persistent refusal remains terminal`() = runTest {
+        val truncated = IOException("truncated compressed response", EOFException())
+        var reads = 0
+        val result = DownloadHlsSegments.readSourceList {
+            if (++reads == 1) throw truncated
+            "complete list"
+        }
+        assertEquals("complete list", result)
+        assertEquals(2, reads)
+        for (error in listOf(truncated, DownloadHlsSegments.Failure("denied", 403))) {
+            var attempts = 0
+            val failure = runCatching {
+                DownloadHlsSegments.readSourceList<Unit> {
+                    attempts++
+                    throw error
+                }
+            }.exceptionOrNull()
+            assertEquals(error, failure)
+            assertEquals(if (error === truncated) 2 else 1, attempts)
+        }
+    }
+
