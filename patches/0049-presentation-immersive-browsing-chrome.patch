         state.heightOffset = 0f
         state.contentOffset = 0f
     }
-    return TopAppBarDefaults.enterAlwaysScrollBehavior(state = state, canScroll = { currentEnabled })
+    val delegate = TopAppBarDefaults.enterAlwaysScrollBehavior(state = state, canScroll = { currentEnabled })
+    return remember(delegate) { BrowsingTopAppBarScrollBehavior(delegate) }
+}
+
+/** Own the full header height, including system inset, tabs and source filters. */
+internal class BrowsingTopAppBarScrollBehavior(
+    delegate: TopAppBarScrollBehavior,
+) : TopAppBarScrollBehavior by delegate {
+    private val heights = mutableMapOf<Any, Int>()
+
+    fun updateHeight(key: Any, height: Int) {
+        if (heights[key] == height) return
+        val fraction = state.collapsedFraction
+        if (height == 0) heights.remove(key) else heights[key] = height
+        state.heightOffsetLimit = -heights.values.sum().toFloat()
+        state.heightOffset = state.heightOffsetLimit * fraction
+    }
+}
+
+internal val LocalBrowsingChrome = staticCompositionLocalOf<BrowsingTopAppBarScrollBehavior?> { null }
+
+/** The surrounding layout collapses browsing headers; don't collapse TopAppBar a second time. */
+fun TopAppBarScrollBehavior?.toolbarScrollBehavior(): TopAppBarScrollBehavior? =
+    takeUnless { it is BrowsingTopAppBarScrollBehavior }
+
+/** Tabs may live next to a pager, but still share the header's scroll distance and visible fraction. */
+@Composable
+fun BrowsingNavigationChrome(content: @Composable () -> Unit) {
+    val behavior = LocalBrowsingChrome.current
+    if (behavior == null) {
+        content()
+        return
+    }
+    val key = remember(behavior) { Any() }
+    DisposableEffect(behavior, key) {
+        onDispose { behavior.updateHeight(key, 0) }
+    }
+    Layout(
+        modifier = Modifier.clipToBounds(),
+        content = { Box { content() } },
+    ) { measurables, constraints ->
+        val child = measurables.single().measure(constraints.copy(minHeight = 0, maxHeight = Constraints.Infinity))
+        behavior.updateHeight(key, child.height)
+        val hiddenHeight = (child.height * behavior.state.collapsedFraction).roundToInt()
+        layout(child.width, child.height - hiddenHeight) {
+            child.placeRelative(0, -hiddenHeight)
+        }
+    }
 }
 
