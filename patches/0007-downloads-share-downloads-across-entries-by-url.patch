+    // Harmony -->
+    /**
+     * A finished download that lives under another entry of the same source but holds the same
+     * episode url, e.g. one video that was favourited into several XvXun folders.
+     */
+    data class SharedDownload(val anime: Anime, val episode: Episode)
+
+    /**
+     * For every episode of [anime] that is not downloaded itself, looks for a downloaded episode
+     * with the same url under another entry of the same source.
+     *
+     * @return episode id to the download that can be played instead.
+     */
+    suspend fun findSharedDownloads(anime: Anime, episodes: List<Episode>): Map<Long, SharedDownload> {
+        if (!downloadPreferences.shareDownloadsAcrossEntries().get()) return emptyMap()
+        if (anime.isLocal()) return emptyMap()
+
+        val candidates = episodes.filter { episode ->
+            episode.url.isNotBlank() &&
+                !isChapterDownloaded(episode.name, episode.scanlator, anime.ogTitle, anime.source)
+        }
+        if (candidates.isEmpty()) return emptyMap()
+
+        val othersByUrl = chapterRepository.getChaptersByUrls(candidates.map { it.url })
+            .filter { it.mangaId != anime.id }
+            .groupBy { it.url }
+        if (othersByUrl.isEmpty()) return emptyMap()
+
+        // Plain collections, not a Sequence: mapNotNull must stay inline so getManga.await can suspend.
+        val otherAnimes = othersByUrl.values.flatten()
+            .map { it.mangaId }
+            .distinct()
+            .mapNotNull { getManga.await(it) }
+            .filter { it.source == anime.source }
+            .associateBy { it.id }
+        if (otherAnimes.isEmpty()) return emptyMap()
+
+        return buildMap {
+            for (episode in candidates) {
+                val shared = othersByUrl[episode.url].orEmpty().firstNotNullOfOrNull { other ->
+                    val otherAnime = otherAnimes[other.mangaId] ?: return@firstNotNullOfOrNull null
+                    val downloaded = isChapterDownloaded(
+                        other.name,
+                        other.scanlator,
+                        otherAnime.ogTitle,
+                        otherAnime.source,
+                    )
+                    if (downloaded) SharedDownload(otherAnime, other) else null
+                }
+                if (shared != null) put(episode.id, shared)
+            }
+        }
+    }
+
+    suspend fun findSharedDownload(anime: Anime, episode: Episode): SharedDownload? {
+        return findSharedDownloads(anime, listOf(episode))[episode.id]
+    }
+
+    /**
+     * Like [buildVideo], but when the episode itself is not downloaded, plays the download of the
+     * same url that another entry of the same source holds (see [findSharedDownloads]).
+     */
+    suspend fun buildVideoOrShared(source: Source, anime: Anime, episode: Episode): Video {
+        if (isChapterDownloaded(episode.name, episode.scanlator, anime.ogTitle, anime.source)) {
+            return buildVideo(source, anime, episode)
+        }
+        val shared = findSharedDownload(anime, episode) ?: return buildVideo(source, anime, episode)
+        return buildVideo(source, shared.anime, shared.episode)
+    }
+    // Harmony <--
+
     /**
      * Returns the amount of downloaded chapters.
      */
