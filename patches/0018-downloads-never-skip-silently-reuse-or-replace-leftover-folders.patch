+    /**
+     * Harmony: handles an episode folder that already exists on disk although the download
+     * cache did not list the episode as downloaded.
+     *
+     * A video still waiting in the `_tmp` directory means the move into the final folder was
+     * interrupted; the final copy is then only trusted when it has the same size.
+     *
+     * @return true when the existing folder holds a complete video and has been registered as
+     * downloaded; false when there was nothing on disk or the leftover was removed so the
+     * download can start from scratch (reusing whatever is left in the `_tmp` directory).
+     */
+    private suspend fun reuseOrRemoveExistingEpisode(download: Download, animeDir: UniFile, episodeDirname: String): Boolean {
+        val existing = provider
+            .getValidChapterDirNames(download.episode.name, download.episode.scanlator)
+            .firstNotNullOfOrNull { animeDir.findFile(it) }
+            ?: return false
+        val name = existing.name ?: return false
+
+        val videos = existing.listFiles().orEmpty().filterNot { it.name == NOMEDIA_FILE || it.extension == "tmp" }
+        val tmpDir = animeDir.findFile(episodeDirname + TMP_DIR_SUFFIX)
+        val pendingVideos = tmpDir?.listFiles().orEmpty().filterNot { it.extension == "tmp" }
+        val video = videos.singleOrNull()
+        val complete = video != null && video.length() > 0 &&
+            (pendingVideos.isEmpty() || pendingVideos.any { it.length() == video.length() })
+
+        if (complete) {
+            logcat(LogPriority.INFO) {
+                "'${download.episode.name}' already on disk as '$name' (${video!!.length()} bytes); registering it as downloaded"
+            }
+            DiskUtil.createNoMediaFile(existing, context)
+            cache.addChapter(name, animeDir, download.anime)
+            // Whatever an earlier attempt left in the temporary directory is no longer needed.
+            tmpDir?.delete()
+            return true
+        }
+
+        logcat(LogPriority.WARN) {
+            "Removing incomplete leftover '$name' of '${download.episode.name}' " +
+                "(${videos.size} file(s), ${pendingVideos.size} pending in $TMP_DIR_SUFFIX)"
+        }
+        if (!existing.delete()) {
+            throw IOException(context.stringResource(AMR.strings.harmony_download_leftover_delete_failed, name))
+        }
+        return false
+    }
+
