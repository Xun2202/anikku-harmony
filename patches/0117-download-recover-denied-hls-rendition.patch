+    @Test
+    fun `repeated segment 169 denial retries uncached then completes a separate lower rendition`() = withCache { cache ->
+        val deniedRequests = Collections.synchronizedList(mutableListOf<String?>())
+        val alternateTs = TS.copyOf().apply { this[1] = 1 }
+        val client = OkHttpClient.Builder().addInterceptor { chain ->
+            val request = chain.request()
+            val route = request.url.queryParameter("url").orEmpty()
+            if (request.url.encodedPath == "/m3u8") {
+                val manifest = buildString {
+                    appendLine("#EXTM3U")
+                    repeat(170) { index ->
+                        appendLine("#EXTINF:4,")
+                        appendLine("/segment?url=$route-${index + 1}")
+                    }
+                    appendLine("#EXT-X-ENDLIST")
+                }
+                response(chain, manifest.toByteArray())
+            } else if (route == "1080-169") {
+                deniedRequests += request.header("Cache-Control")
+                response(chain, byteArrayOf(), 403)
+            } else {
+                response(chain, if (route.startsWith("720-")) alternateTs else TS)
+            }
+        }.build()
+        val source = mockk<AnimeSource>()
+        val highest = Video(videoUrl = "$URL&quality=1080", videoTitle = "1080p", initialized = true)
+        val lower = Video(videoUrl = "$URL&quality=720", videoTitle = "720p", initialized = true)
+        val unavailable = Video(videoUrl = highest.videoUrl, videoTitle = "900p", initialized = true)
+        val hosters = listOf(Hoster(videoList = listOf(highest, lower, unavailable)))
+        var rendition = "1080"
+        var refreshes = 0
+        val complete = DownloadHlsSegments.withAuthorizationRecovery(
+            transfer = { forceNetwork ->
+                DownloadHlsSegments.prepare(client, "MissAV", "http://localhost:1234/m3u8?url=$rendition", headersOf(), cache, forceNetwork) {}!!
+            },
+            refresh = {
+                assertEquals(169, it.segmentNumber)
+                refreshes++
+            },
+            selectAlternate = {
+                assertEquals(169, it.segmentNumber)
+                val next = DownloadQualitySelector.pickLower(source, hosters, highest) { candidate ->
+                    DownloadHlsSegments.isLocalManifest(candidate.videoUrl)
+                }!!
+                assertEquals(lower.videoUrl, next.videoUrl)
+                rendition = checkNotNull(DownloadQualitySelector.heightOf(next)).toString()
+                true
+            },
+        )
+
+        assertEquals(1, refreshes)
+        assertEquals(listOf(null, "no-cache"), deniedRequests)
+        assertEquals(170, complete.segments)
+        assertEquals(680_000L, complete.durationMillis)
+        val original = cache.listFiles()!!.single { it != complete.directory }
+        assertTrue(File(original, "00000.ts").readBytes().contentEquals(TS))
+        assertFalse(File(original, "00168.ts").exists())
+        val output = File(cache, "offline.ts")
+        DownloadHlsSegments.writeTransportStream(complete, output) {}
+        assertTrue(output.readBytes().contentEquals(ByteArray(170 * alternateTs.size) { alternateTs[it % alternateTs.size] }))
+    }
+
     private fun client(): OkHttpClient = OkHttpClient.Builder().addInterceptor { chain ->
         response(chain, if (chain.request().url.encodedPath == "/m3u8") MANIFEST.toByteArray() else TS)
     }.build()
