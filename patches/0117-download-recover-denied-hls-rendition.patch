+    suspend fun <T> withAuthorizationRecovery(
+        transfer: suspend (forceNetwork: Boolean) -> T,
+        refresh: suspend (Failure) -> Unit,
+        selectAlternate: suspend (Failure) -> Boolean,
+    ): T {
+        val first = try {
+            return transfer(false)
+        } catch (failure: Failure) {
+            if (failure.httpStatus != 401 && failure.httpStatus != 403) throw failure
+            failure
+        }
+        refresh(first)
+        try {
+            return transfer(true)
+        } catch (failure: Failure) {
+            if (failure.httpStatus != 403 || failure.segmentNumber == null ||
+                failure.segmentNumber != first.segmentNumber || !selectAlternate(failure)
+            ) {
+                throw failure
+            }
+        }
+        return transfer(false)
+    }
