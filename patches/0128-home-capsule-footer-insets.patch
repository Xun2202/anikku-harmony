+private val CapsuleTopSpace = 2.dp
+
+@Composable
+private fun navigationCapsuleOuterGap(windowInsets: WindowInsets): Dp {
+    val density = LocalDensity.current
+    val gap = navigationCapsuleGap(
+        windowInsets.getBottom(density).toFloat(),
+        WindowInsets.tappableElement.getBottom(density).toFloat(),
+        density.density,
+    )
+    return with(density) { gap.toDp() }
+}
+
+/** Lists need the full capsule footprint on their first layout, including when restoring a scroll position. */
+@Composable
+fun navigationCapsuleReservedHeight(
+    contentHeight: Dp,
+    windowInsets: WindowInsets = WindowInsets.navigationBars.only(WindowInsetsSides.Bottom),
+): Dp = CapsuleTopSpace + contentHeight + navigationCapsuleOuterGap(windowInsets)
+
 /** One refractive glass body. Selection is expressed by the words, never a second framed surface. */
