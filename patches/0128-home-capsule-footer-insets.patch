+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.windowInsetsPadding
+import androidx.compose.foundation.lazy.rememberLazyListState
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.hasScrollToIndexAction
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performScrollToIndex
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+import tachiyomi.presentation.core.components.FastScrollLazyColumn
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class NavigationChromeCapsuleFooterTest {
+    @Test
+    fun `last action clears the capsule on return and after insets change`() = runComposeUiTest {
+        val settingsOpen = mutableStateOf(false)
+        val height = mutableIntStateOf(48)
+        var expectedGap = 0f
+        setContent {
+            val list = rememberLazyListState()
+            MaterialTheme {
+                if (!settingsOpen.value) {
+                    val reserved = navigationCapsuleReservedHeight(height.intValue.dp, WindowInsets(bottom = 24.dp))
+                    // The parent has already removed eight dp from the viewport.
+                    expectedGap = with(LocalDensity.current) { (reserved - 8.dp).toPx() }
+                    CompositionLocalProvider(LocalBrowsingBottomPadding provides reserved) {
+                        Box(Modifier.windowInsetsPadding(WindowInsets(bottom = 8.dp))) {
+                            Scaffold(contentWindowInsets = WindowInsets(bottom = 16.dp)) { padding ->
+                                FastScrollLazyColumn(
+                                    modifier = Modifier.fillMaxSize().testTag("viewport"),
+                                    state = list,
+                                    contentPadding = padding,
+                                ) {
+                                    items(40) { Box(Modifier.fillMaxWidth().height(48.dp).testTag("row-$it")) }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        fun checkFooter() {
+            val viewport = onNodeWithTag("viewport").fetchSemanticsNode().boundsInRoot
+            val last = onNodeWithTag("row-39").fetchSemanticsNode().boundsInRoot
+            assertEquals(expectedGap, viewport.bottom - last.bottom, 1.5f)
+        }
+        onNode(hasScrollToIndexAction()).performScrollToIndex(39)
+        checkFooter()
+        runOnIdle { settingsOpen.value = true }
+        waitForIdle()
+        runOnIdle { settingsOpen.value = false }
+        checkFooter()
+        for (next in listOf(64, 48)) {
+            runOnIdle { height.intValue = next }
+            onNode(hasScrollToIndexAction()).performScrollToIndex(39)
+            checkFooter()
+        }
+    }
+}
