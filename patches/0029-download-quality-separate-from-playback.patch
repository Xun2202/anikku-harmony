--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/download/DownloadQualitySelector.kt
@@ -0,0 +1,108 @@
+package eu.kanade.tachiyomi.data.download
+
+import eu.kanade.tachiyomi.animesource.AnimeSource
+import eu.kanade.tachiyomi.animesource.model.Hoster
+import eu.kanade.tachiyomi.animesource.model.Video
+import eu.kanade.tachiyomi.ui.player.controls.components.sheets.HosterState
+import eu.kanade.tachiyomi.ui.player.loader.EpisodeLoader
+import eu.kanade.tachiyomi.ui.player.loader.HosterLoader
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.withContext
+import logcat.LogPriority
+import tachiyomi.core.common.util.system.logcat
+
+/**
+ * Chooses the video for a queued episode that has none yet, by the download quality setting
+ * instead of the source's playback preference (`preferred` / `sortVideos`), so downloads can be
+ * sharper than what is streamed.
+ *
+ * The height comes from [Video.resolution] or from the title ("1080p", "1920x1080", "4K").
+ * Videos without a height (e.g. "MP4 High", "HLS (auto)") are only used when no video has one.
+ */
+object DownloadQualitySelector {
+    const val FOLLOW_SOURCE = "follow"
+    const val HIGHEST = "highest"
+    val HEIGHTS = listOf(2160, 1440, 1080, 720, 480, 360)
+
+    /** @return the resolved video, or null to fall back to [HosterLoader.getBestVideo]. */
+    suspend fun pick(source: AnimeSource, hosters: List<Hoster>, quality: String): Video? {
+        val limit = when (quality) {
+            FOLLOW_SOURCE -> return null
+            HIGHEST -> Int.MAX_VALUE
+            else -> quality.toIntOrNull() ?: return null
+        }
+        val candidates = withContext(Dispatchers.IO) {
+            hosters.map { async { EpisodeLoader.loadHosterVideos(source, it) } }.awaitAll()
+        }
+            .filterIsInstance<HosterState.Ready>()
+            .flatMap { it.videoList }
+            .filter { it.videoUrl.isNotEmpty() || !it.initialized }
+
+        for (video in rank(candidates, limit)) {
+            val resolved = HosterLoader.getResolvedVideo(source, video)
+            if (resolved?.videoUrl?.isNotEmpty() == true) {
+                logcat(LogPriority.INFO) { "Download quality $quality: picked '${video.videoTitle}'" }
+                return resolved
+            }
+        }
+        return null
+    }
+
+    /**
+     * Best first: the tallest video not above [limit], then the shortest above it, then videos
+     * without a height. Ties keep the source's order, preferred videos first.
+     */
+    fun rank(videos: List<Video>, limit: Int): List<Video> {
+        return videos.withIndex()
+            .sortedWith(
+                compareBy<IndexedValue<Video>> { sortKey(it.value, limit).first }
+                    .thenBy { sortKey(it.value, limit).second }
+                    .thenByDescending { it.value.bitrate ?: 0 }
+                    .thenByDescending { it.value.preferred }
+                    .thenBy { it.index },
+            )
+            .map { it.value }
+    }
+
+    private fun sortKey(video: Video, limit: Int): Pair<Int, Int> {
+        val height = heightOf(video)
+        return when {
+            height != null && height <= limit -> 0 to -height
+            height != null -> 1 to height
+            else -> 2 to -labelScore(video.videoTitle, preferSmall = limit <= SMALL_LIMIT)
+        }
+    }
+
+    fun heightOf(video: Video): Int? {
+        video.resolution?.takeIf { it > 0 }?.let { return it }
+        val title = video.videoTitle
+        DIMENSIONS.find(title)?.let { return it.groupValues[1].toInt() }
+        HEIGHT.find(title)?.let { return it.groupValues[1].toInt() }
+        return when {
+            K4.containsMatchIn(title) -> 2160
+            K2.containsMatchIn(title) -> 1440
+            else -> null
+        }
+    }
+
+    private fun labelScore(title: String, preferSmall: Boolean): Int {
+        val score = when {
+            HIGH.containsMatchIn(title) -> 2
+            AUTO.containsMatchIn(title) -> 1
+            LOW.containsMatchIn(title) -> -1
+            else -> 0
+        }
+        return if (preferSmall && score != 1) -score else score
+    }
+
+    private const val SMALL_LIMIT = 480
+    private val DIMENSIONS = Regex("""\b\d{3,4}\s*[x×]\s*(\d{3,4})\b""")
+    private val HEIGHT = Regex("""(?<!\d)(\d{3,4})\s*[pPiI](?![a-zA-Z])""")
+    private val K4 = Regex("""(?i)(?<![a-z0-9])(4k|uhd)(?![a-z0-9])""")
+    private val K2 = Regex("""(?i)(?<![a-z0-9])2k(?![a-z0-9])""")
+    private val HIGH = Regex("""(?i)\b(high|best|source|original)\b|高清|超清|原画|蓝光""")
+    private val AUTO = Regex("""(?i)\b(auto|default)\b|自动""")
+    private val LOW = Regex("""(?i)\b(low|sd)\b|流畅|标清""")
+}
