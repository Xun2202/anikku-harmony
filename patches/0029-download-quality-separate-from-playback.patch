@@ -0,0 +1,57 @@
+package eu.kanade.tachiyomi.data.download
+
+import eu.kanade.tachiyomi.animesource.model.Video
+import io.kotest.matchers.shouldBe
+import org.junit.jupiter.api.Test
+
+class DownloadQualitySelectorTest {
+
+    private fun video(title: String, preferred: Boolean = false, resolution: Int? = null) =
+        Video(videoUrl = "https://example.org/$title", videoTitle = title, preferred = preferred, resolution = resolution)
+
+    private val hls = listOf(
+        video("HLS 480p - 1.20 MB/s", preferred = true),
+        video("HLS 1080p - 4.10 MB/s"),
+        video("HLS 720p - 2.50 MB/s"),
+        video("MP4 High"),
+        video("MP4 Low"),
+    )
+
+    private fun titles(videos: List<Video>) = videos.map { it.videoTitle.substringBefore(" -") }
+
+    @Test
+    fun highestIgnoresThePlaybackPreference() {
+        titles(DownloadQualitySelector.rank(hls, Int.MAX_VALUE)) shouldBe
+            listOf("HLS 1080p", "HLS 720p", "HLS 480p", "MP4 High", "MP4 Low")
+    }
+
+    @Test
+    fun capTakesTheTallestNotAboveThenTheShortestAbove() {
+        titles(DownloadQualitySelector.rank(hls, 720)) shouldBe
+            listOf("HLS 720p", "HLS 480p", "HLS 1080p", "MP4 High", "MP4 Low")
+        titles(DownloadQualitySelector.rank(hls, 360)).first() shouldBe "HLS 480p"
+    }
+
+    @Test
+    fun videosWithoutHeightRankByLabel() {
+        val mp4 = listOf(video("MP4 Low"), video("HLS (auto)"), video("MP4 High"))
+        titles(DownloadQualitySelector.rank(mp4, Int.MAX_VALUE)) shouldBe listOf("MP4 High", "HLS (auto)", "MP4 Low")
+        titles(DownloadQualitySelector.rank(mp4, 480)) shouldBe listOf("MP4 Low", "HLS (auto)", "MP4 High")
+    }
+
+    @Test
+    fun heightComesFromResolutionOrTitle() {
+        DownloadQualitySelector.heightOf(video("whatever", resolution = 1440)) shouldBe 1440
+        DownloadQualitySelector.heightOf(video("1920x1080 · 3 MB")) shouldBe 1080
+        DownloadQualitySelector.heightOf(video("Source 4K")) shouldBe 2160
+        DownloadQualitySelector.heightOf(video("720P60")) shouldBe 720
+        DownloadQualitySelector.heightOf(video("1500 kbps")) shouldBe null
+        DownloadQualitySelector.heightOf(video("MP4 High")) shouldBe null
+    }
+
+    @Test
+    fun equalHeightsKeepPreferredFirst() {
+        val same = listOf(video("Mirror A 1080p"), video("Mirror B 1080p", preferred = true))
+        titles(DownloadQualitySelector.rank(same, Int.MAX_VALUE)) shouldBe listOf("Mirror B 1080p", "Mirror A 1080p")
+    }
+}
