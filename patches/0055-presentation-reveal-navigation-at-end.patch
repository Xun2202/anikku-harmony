diff --git a/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/BrowsingScrollGeometry.kt b/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/BrowsingScrollGeometry.kt
index 1f804ad69..ed06160c1 100644
--- a/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/BrowsingScrollGeometry.kt
+++ b/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/BrowsingScrollGeometry.kt
@@ -16,3 +16,23 @@ internal fun browsingTrackInset(padding: Float, chromeHeight: Float, hidden: Flo
     if (chromeHeight <= 0f || padding + 1f < chromeHeight) return padding
     return (padding - chromeHeight + max(systemInset, chromeHeight * (1f - hidden))).coerceAtMost(padding)
 }
+
+/** Bring both controls back with the real trailing spacer, including the system bottom inset. */
+internal fun browsingTrailingHiddenFraction(animated: Float, remaining: Float?, bottomHeight: Float): Float =
+    if (remaining == null || bottomHeight <= 0f) {
+        animated
+    } else {
+        min(animated, (remaining / bottomHeight).coerceIn(0f, 1f))
+    }
+
+/** Unknown tail geometry must never be mistaken for the end of a not-yet-measured list. */
+internal fun browsingTrailingRemaining(
+    terminalVisible: Boolean,
+    lastItemBottom: Int,
+    afterPadding: Int,
+    viewportEnd: Int,
+): Float = if (terminalVisible) {
+    (lastItemBottom + afterPadding - viewportEnd).coerceAtLeast(0).toFloat()
+} else {
+    Float.POSITIVE_INFINITY
+}
