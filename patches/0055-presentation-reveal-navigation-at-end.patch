+    @Test
+    fun `programmatic end reveals both bars and leaving end keeps them visible`() = runComposeUiTest {
+        lateinit var chrome: BrowsingNavigationBarState
+        lateinit var scope: CoroutineScope
+        val listState = LazyListState(initialFirstVisibleItemIndex = 10)
+        var headerY = 0f
+        var bottomY = 0f
+        var bottomHeight = 0
+        setContent {
+            MaterialTheme {
+                scope = rememberCoroutineScope()
+                chrome = rememberBrowsingNavigationBarState(enabled = true, resetKey = Unit)
+                CompositionLocalProvider(
+                    LocalBrowsingNavigationBarState provides chrome,
+                    LocalBrowsingBottomPadding provides 72.dp,
+                ) {
+                    Box(Modifier.fillMaxSize()) {
+                        Scaffold(
+                            topBarScrollBehavior = rememberBrowsingTopAppBarScrollBehavior(),
