+                            FastScrollLazyColumn(
+                                modifier = Modifier.fillMaxSize().testTag("tail-viewport"),
+                                state = listState,
+                                contentPadding = padding,
+                            ) {
+                                items(30) { Box(Modifier.fillMaxWidth().height(80.dp)) }
+                            }
+                        }
+                        BrowsingChromeOverlay(
+                            state = chrome,
+                            atBottom = true,
+                            modifier = Modifier.align(Alignment.BottomCenter),
+                        ) {
+                            Box(
+                                Modifier.fillMaxWidth().height(72.dp).onGloballyPositioned {
+                                    bottomY = it.positionInRoot().y
+                                    bottomHeight = it.size.height
+                                },
+                            )
+                        }
+                    }
+                }
+            }
+        }
