+        val viewport = onNodeWithTag("tail-viewport").fetchSemanticsNode().boundsInRoot
+        runOnIdle {
+            chrome.beginGesture()
+            chrome.nestedScrollConnection.onPostScroll(Offset(0f, -20f), Offset.Zero, NestedScrollSource.UserInput)
+        }
