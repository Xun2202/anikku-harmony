     fun reset() {
         tracker.reset()
         leadingOffset = null
+        trailingRemaining = null
         updateVisibility(true)
     }
 
+    internal fun revealAtEnd() {
+        tracker.revealAtEnd()
+        updateVisibility(true)
+        // The trailing spacer has already revealed both bars. Settle the backing animation too,
+        // so an immediate reversal cannot uncover an old hidden value when the tail cap is removed.
+        animationDurationMillis = 0
+    }
+
+    private fun atEnd() = trailingRemaining?.invoke()?.let { it <= 0.5f } == true
+
     private fun canHide() = enabled() && pinnedOwners.isEmpty()
 
     val nestedScrollConnection = object : NestedScrollConnection {
         override fun onPreScroll(available: Offset, source: NestedScrollSource): Offset {
             if (canHide()) {
-                updateVisibility(tracker.onPreScroll(available.x, available.y, source == NestedScrollSource.UserInput))
+                if (atEnd()) {
+                    revealAtEnd()
+                } else {
+                    updateVisibility(
+                        tracker.onPreScroll(
+                            available.x,
+                            available.y,
+                            source == NestedScrollSource.UserInput,
+                        ),
+                    )
+                }
             }
             return Offset.Zero
         }
 
         override fun onPostScroll(consumed: Offset, available: Offset, source: NestedScrollSource): Offset {
             if (canHide()) {
-                updateVisibility(tracker.onPostScroll(consumed.x, consumed.y, source == NestedScrollSource.UserInput))
+                if (atEnd()) {
+                    revealAtEnd()
+                } else {
+                    updateVisibility(
+                        tracker.onPostScroll(consumed.x, consumed.y, source == NestedScrollSource.UserInput),
+                    )
+                }
             }
             // Never consume drag or velocity, or move the content on behalf of the controls.
             return Offset.Zero
