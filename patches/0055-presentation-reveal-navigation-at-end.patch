 /** Each scroll event selects the active pager page; offscreen precomposed pages never drive the header. */
 @Composable
-fun Modifier.observeBrowsingLeadingScroll(leadingOffset: () -> Float): Modifier {
+fun Modifier.observeBrowsingLeadingScroll(
+    trailingRemaining: (() -> Float)? = null,
+    leadingOffset: () -> Float,
+): Modifier {
     val chrome = LocalBrowsingChrome.current?.chrome ?: return this
     val currentOffset by rememberUpdatedState(leadingOffset)
+    val currentTail by rememberUpdatedState(trailingRemaining)
     val activeSource = remember(chrome) { { currentOffset() } }
+    val activeTail = remember(chrome) { { currentTail?.invoke() ?: Float.POSITIVE_INFINITY } }
+    fun activate() {
+        chrome.leadingOffset = activeSource
+        chrome.trailingRemaining = activeTail
+    }
+    LaunchedEffect(chrome, activeSource, activeTail) {
+        snapshotFlow { chrome.leadingOffset === activeSource && activeTail() <= 0.5f }
+            .distinctUntilChanged()
+            .collect { atEnd -> if (atEnd) chrome.revealAtEnd() }
+    }
     DisposableEffect(chrome, activeSource) {
-        onDispose { if (chrome.leadingOffset === activeSource) chrome.leadingOffset = null }
+        onDispose {
+            if (chrome.leadingOffset === activeSource) {
+                chrome.leadingOffset = null
+                chrome.trailingRemaining = null
+            }
+        }
     }
     val connection = remember(chrome, activeSource) {
         object : NestedScrollConnection {
             override fun onPreScroll(available: Offset, source: NestedScrollSource): Offset {
-                if (kotlin.math.abs(available.y) > kotlin.math.abs(available.x)) chrome.leadingOffset = activeSource
+                if (kotlin.math.abs(available.y) > kotlin.math.abs(available.x)) activate()
                 return Offset.Zero
             }
             override fun onPostScroll(consumed: Offset, available: Offset, source: NestedScrollSource): Offset {
-                if (kotlin.math.abs(consumed.y) > kotlin.math.abs(consumed.x)) chrome.leadingOffset = activeSource
+                if (kotlin.math.abs(consumed.y) > kotlin.math.abs(consumed.x)) activate()
                 return Offset.Zero
             }
         }
     }
-    return nestedScroll(connection)
+    return onGloballyPositioned { coordinates ->
+        // A programmatic jump may precede any touch. Only a page actually intersecting the
+        // clipped window can become the initial owner; precomposed offscreen pages cannot.
+        val bounds = coordinates.boundsInWindow()
+        if (chrome.leadingOffset == null && bounds.width > 0f && bounds.height > 0f) activate()
+    }.nestedScroll(connection)
 }
 
 private class FrozenBrowsingTrack(var insets: Pair<Dp, Dp>? = null)
