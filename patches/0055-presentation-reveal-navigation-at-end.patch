+
+    @Test
+    fun `trailing spacer brings both bars back including the real bottom inset`() {
+        assertEquals(1f, browsingTrailingHiddenFraction(1f, Float.POSITIVE_INFINITY, 72f))
+        assertEquals(1f, browsingTrailingHiddenFraction(1f, 100f, 72f))
+        assertEquals(0.5f, browsingTrailingHiddenFraction(1f, 36f, 72f))
+        assertEquals(0f, browsingTrailingHiddenFraction(1f, 0f, 72f))
+        assertEquals(0.2f, browsingTrailingHiddenFraction(0.2f, 36f, 72f))
+        assertEquals(1f, browsingTrailingHiddenFraction(1f, 0f, 0f))
+    }
+
+    @Test
+    fun `terminal geometry counts after padding and never treats an unknown tail as end`() {
+        assertEquals(Float.POSITIVE_INFINITY, browsingTrailingRemaining(false, 450, 72, 500))
+        assertEquals(22f, browsingTrailingRemaining(true, 450, 72, 500))
+        assertEquals(0f, browsingTrailingRemaining(true, 428, 72, 500))
+        assertEquals(0f, browsingTrailingRemaining(true, 200, 72, 500))
+    }
+
+    @Test
+    fun `reaching end overrides a hide without unlocking the current gesture`() {
+        val tracker = NavigationChromeScrollTracker()
+        tracker.beginGesture()
+        assertFalse(tracker.onPostScroll(0f, -20f, true))
+        tracker.revealAtEnd()
+        assertTrue(tracker.visible)
+        assertTrue(tracker.onPostScroll(0f, -100f, true))
+        tracker.endGesture()
+        tracker.beginGesture()
+        assertTrue(tracker.onPreScroll(0f, 20f, true))
+        assertFalse(tracker.onPostScroll(0f, -20f, true))
+    }
 }
