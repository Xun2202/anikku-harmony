@@ -0,0 +1,81 @@
+package tachiyomi.presentation.core.components
+
+import androidx.compose.runtime.MonotonicFrameClock
+import androidx.compose.runtime.withFrameNanos
+import kotlinx.coroutines.runBlocking
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import kotlin.coroutines.cancellation.CancellationException
+
+class NavigationChromeFlingClockTest {
+    private class Source(val raw: LongArray, val arrivals: LongArray) : MonotonicFrameClock {
+        var calls = 0
+        var now = 0L
+        override suspend fun <R> withFrameNanos(onFrame: (Long) -> R): R {
+            val i = calls++
+            now = arrivals[i]
+            return onFrame(raw[i])
+        }
+    }
+
+    @Test
+    fun `healthy display clocks and accelerated virtual clocks keep their exact timestamps`() {
+        for (period in listOf(16_666_667L, 11_111_111L, 8_333_333L)) {
+            val raw = LongArray(12) { 1_000_000_000L + it * period }
+            // Test clocks deliberately run faster than wall time.
+            val source = Source(raw, LongArray(12) { 5_000L + it * 100_000L })
+            val clock = FlingFrameClock(source, nanoTime = { source.now })
+            val delivered = runBlocking(clock) { List(12) { withFrameNanos { it } } }
+            assertEquals(raw.toList(), delivered)
+            assertEquals(12, source.calls)
+            assertFalse(clock.corrected)
+        }
+    }
+
+    @Test
+    fun `repeated and one nanosecond clamped timestamps progress by actual arrivals until fling ends`() {
+        val start = 1_000_000_000L
+        val source = Source(
+            longArrayOf(start, start + 11_000_000L, start + 11_000_001L, start - 10L, start + 90_000_000L),
+            LongArray(5) { 20_000_000L + it * 11_000_000L },
+        )
+        val clock = FlingFrameClock(source, nanoTime = { source.now })
+        val delivered = runBlocking(clock) { List(5) { withFrameNanos { it } } }
+        assertEquals(List(5) { start + it * 11_000_000L }, delivered)
+        assertTrue(clock.corrected)
+        assertEquals(5, source.calls, "The wrapper must not request extra frames")
+    }
+
+    @Test
+    fun `real callback pauses advance elapsed time without assuming a fixed refresh rate`() {
+        val source = Source(longArrayOf(100L, 100L, 100L), longArrayOf(1L, 11_000_001L, 51_000_001L))
+        val clock = FlingFrameClock(source, nanoTime = { source.now })
+        val delivered = runBlocking(clock) { List(3) { withFrameNanos { it } } }
+        assertEquals(listOf(100L, 11_000_100L, 51_000_100L), delivered)
+    }
+
+    @Test
+    fun `correction is confined to one fling and parent cancellation propagates`() {
+        val bad = Source(longArrayOf(100L, 100L), longArrayOf(1L, 11_000_001L))
+        val corrected = FlingFrameClock(bad, nanoTime = { bad.now })
+        runBlocking(corrected) { repeat(2) { withFrameNanos { it } } }
+        assertTrue(corrected.corrected)
+        val good = Source(longArrayOf(200L, 11_000_200L), longArrayOf(1L, 11_000_001L))
+        val fresh = FlingFrameClock(good, nanoTime = { good.now })
+        assertEquals(listOf(200L, 11_000_200L), runBlocking(fresh) { List(2) { withFrameNanos { it } } })
+        assertFalse(fresh.corrected)
+        val cancellation = CancellationException("finger interrupted")
+        val cancelled = object : MonotonicFrameClock {
+            override suspend fun <R> withFrameNanos(onFrame: (Long) -> R): R = throw cancellation
+        }
+        var caught: CancellationException? = null
+        try {
+            runBlocking(FlingFrameClock(cancelled)) { withFrameNanos { it } }
+        } catch (error: CancellationException) {
+            caught = error
+        }
+        assertEquals(cancellation, caught)
+    }
+}
