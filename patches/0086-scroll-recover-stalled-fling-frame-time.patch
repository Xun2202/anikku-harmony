+package tachiyomi.presentation.core.components
+
+import androidx.compose.runtime.MonotonicFrameClock
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.withContext
+
+/**
+ * Keep the platform clock while it progresses. A repeated/clamped frame stamp can leave the
+ * millisecond-based Android spline at the same position even though another frame arrived.
+ * Once that happens, advance this fling by monotonic arrival time until it ends. The original
+ * frame callbacks still drive the animation; no timer, frame-rate assumption or decay change.
+ */
+internal class FlingFrameClock(
+    private val parent: MonotonicFrameClock,
+    private val nanoTime: () -> Long = System::nanoTime,
+    private val sample: ((raw: Long, delivered: Long, arrival: Long, corrected: Boolean) -> Unit)? = null,
+) : MonotonicFrameClock {
+    private var previousRaw = Long.MIN_VALUE
+    private var previousArrival = 0L
+    private var previousDelivered = 0L
+    private var anchorArrival = 0L
+    private var anchorDelivered = 0L
+    internal var corrected = false
+        private set
+
+    override suspend fun <R> withFrameNanos(onFrame: (frameTimeNanos: Long) -> R): R =
+        parent.withFrameNanos { raw ->
+            val arrival = nanoTime()
+            val first = previousRaw == Long.MIN_VALUE
+            if (!first && !corrected) {
+                val rawDelta = raw - previousRaw
+                val arrivalDelta = arrival - previousArrival
+                // Healthy 60/90/120 Hz clocks and virtual test clocks remain unchanged.
+                // BroadcastFrameClock may clamp repeated timestamps to a 1 ns increment.
+                if (rawDelta <= 0L || (rawDelta < 1_000_000L && arrivalDelta >= 4_000_000L)) {
+                    corrected = true
+                    anchorArrival = previousArrival
+                    anchorDelivered = previousDelivered
+                }
+            }
+            val delivered = if (corrected) {
+                (anchorDelivered + (arrival - anchorArrival).coerceAtLeast(0L)).coerceAtLeast(previousDelivered + 1L)
+            } else {
+                raw
+            }
+            previousRaw = raw
+            previousArrival = arrival
+            previousDelivered = delivered
+            sample?.invoke(raw, delivered, arrival, corrected)
+            onFrame(delivered)
+        }
+}
+
+internal suspend fun <T> withFlingFrameClock(tail: Long, block: suspend () -> T): T {
+    val parent = currentCoroutineContext()[MonotonicFrameClock] ?: return block()
+    val observer: ((Long, Long, Long, Boolean) -> Unit)? = if (tail == 0L) {
+        null
+    } else {
+        { raw, delivered, arrival, corrected -> FlingTailTrace.frame(tail, arrival, raw, delivered, corrected) }
+    }
+    return withContext(FlingFrameClock(parent, sample = observer)) { block() }
+}
