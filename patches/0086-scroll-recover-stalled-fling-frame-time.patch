+import androidx.compose.runtime.MonotonicFrameClock
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeFlingClockUiTest {
+    private class Frames(private val quantized: Boolean) : MonotonicFrameClock {
+        var elapsed = 0L
+        override suspend fun <R> withFrameNanos(onFrame: (Long) -> R): R {
+            elapsed += 11_111_111L
+            val stamp = if (quantized) elapsed / 16_666_667L * 16_666_667L else elapsed
+            return onFrame(1_000_000_000_000L + stamp)
+        }
+    }
+
+    @Test
+    fun `real default spline reproduces zero motion with quantized stamps and recovers its smooth tail`() = runComposeUiTest {
+        lateinit var native: FlingBehavior
+        setContent { native = ScrollableDefaults.flingBehavior() }
+        runOnIdle {
+            fun fling(quantized: Boolean, repair: Boolean): List<Float> {
+                val frames = Frames(quantized)
+                val clock = if (repair) FlingFrameClock(frames, nanoTime = { frames.elapsed }) else frames
+                val deltas = mutableListOf<Float>()
+                val scope = object : ScrollScope {
+                    override fun scrollBy(pixels: Float): Float {
+                        deltas += pixels
+                        return pixels
+                    }
+                }
+                runBlocking(clock) { with(native) { scope.performFling(12_000f) } }
+                return deltas
+            }
+            val healthy = fling(quantized = false, repair = false)
+            val faulty = fling(quantized = true, repair = false)
+            val repaired = fling(quantized = true, repair = true)
+            assertTrue(faulty.takeLast(64).count { it == 0f } >= 12)
+            assertTrue(repaired.takeLast(64).count { it == 0f } <= 2)
+            assertEquals(healthy.sumOf { it.toDouble() }, repaired.sumOf { it.toDouble() }, 0.01)
+            assertTrue(repaired.all { it >= 0f })
+        }
+    }
+
+    @Test
+    fun `placement diagnostics follow scrolling even when the parent draw is cached`() = runComposeUiTest {
+        val state = PanoramaMasonryState()
+        lateinit var scope: CoroutineScope
+        setContent {
+            scope = rememberCoroutineScope()
+            PanoramaMasonry(PanoramaColumns.Fixed(2), Modifier.requiredSize(400.dp, 500.dp), state = state) {
+                items(count = 100, key = { it }, height = { PanoramaCellHeight.Fixed(120.dp) }) {
+                    Box(Modifier.fillMaxWidth().height(120.dp))
+                }
+            }
+        }
+        runOnIdle {
+            FlingTailTrace.startRecording()
+            FlingTailTrace.begin(state.traceId, 1000f, System.nanoTime())
+        }
+        try {
+            for (offset in listOf(120f, 240f, 360f)) {
+                runOnIdle { scope.launch { state.scrollToOffset(offset) } }
+                waitForIdle()
+                runOnIdle {
+                    val trace = FlingTailTrace.snapshot().single()
+                    assertTrue(trace.placementCount > 0)
+                    assertEquals(offset.toLong(), trace.placements[trace.placements.size - 4])
+                }
+            }
+        } finally {
+            runOnIdle { FlingTailTrace.stopRecording() }
+        }
+    }
+}
