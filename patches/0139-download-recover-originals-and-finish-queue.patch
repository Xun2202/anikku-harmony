     private fun BigDecimal.toMillis(): Long = movePointRight(3).setScale(0, RoundingMode.HALF_UP).longValueExact()
 
+    private suspend fun recoverOriginals(
+        client: OkHttpClient,
+        original: List<LocalPart>,
+        times: LongArray,
+        headers: Headers,
+        probes: List<Int>,
+        state: ProgressState,
+        onDenied: (Int, Long, HttpUrl) -> Unit,
+        onIntact: (Int) -> Unit,
+    ): Set<Int> = coroutineScope {
+        val remaining = ArrayDeque(probes)
+        val restored = mutableSetOf<Int>()
+        var consecutiveDenials = 0
+        repeat(minOf(SEGMENT_WORKERS, probes.size)) {
+            launch {
+                while (true) {
+                    val i = synchronized(remaining) {
+                        if (probes.size > 32 && remaining.isNotEmpty() && consecutiveDenials >= MAX_CONSECUTIVE_DENIALS * 2) {
+                            throw Failure("原画质连续被拒，还有 ${remaining.size} 片待核对。已下载分片会保留，可稍后继续。")
+                        }
+                        remaining.removeFirstOrNull()
+                    } ?: break
+                    val part = original[i]
+                    try {
+                        fetchPart(client, part, headers, true, state, onIntact = { onIntact(i + 1) }) { onDenied(i + 1, times[i], it) }
+                    } catch (error: IOException) {
+                        if (!unavailable(error)) throw error
+                        markUnavailable(part.file)
+                        synchronized(remaining) {
+                            consecutiveDenials = if (error is Failure && error.httpStatus == 403) consecutiveDenials + 1 else 0
+                        }
+                        continue
+                    }
+                    synchronized(remaining) {
+                        consecutiveDenials = 0
+                        restored += i
+                    }
+                    state.complete(part.file.length(), part.segment.millis)
+                }
+            }
+        }
+        restored
+    }
+
+    private suspend fun fetchPart(
+        client: OkHttpClient,
+        part: LocalPart,
+        mediaHeaders: Headers,
+        checkPackets: Boolean,
+        state: ProgressState,
+        onIntact: () -> Unit,
+        onDenied: (HttpUrl) -> Unit,
+    ) {
+        val (segment, file) = part
+        val context = currentCoroutineContext()
+        val rejected = File(file.parentFile, "${file.name}.invalid")
+        val partial = File(file.parentFile, "${file.name}.part")
+        val upstream = if (checkPackets && segment.url.queryParameter("key") == null) {
+            segment.url.queryParameter("url")?.toHttpUrlOrNull()
+        } else {
+            null
+        }
+        HlsRepairResponseInterceptor.during(upstream, File(file.parentFile, "${file.name}.source.part")) { original ->
+            fetch(client, Request.Builder().url(segment.url).headers(mediaHeaders).build()) { response ->
+                if (!response.isSuccessful) throw segmentFailure(response, onDenied)
+                val expected = response.body.contentLength()
+                var count = 0L
+                partial.outputStream().use { output ->
+                    response.body.byteStream().use { input ->
+                        val buffer = ByteArray(32 * 1024)
+                        while (true) {
+                            context.ensureActive()
+                            val read = input.read(buffer)
+                            if (read < 0) break
+                            count += read
+                            state.received(read.toLong())
+                            output.write(buffer, 0, read)
+                        }
+                    }
+                }
+                if (count == 0L || (expected >= 0 && expected != count)) throw EOFException("Incomplete HLS TS segment")
+                if (!checkPackets && !validTs(partial)) throw InvalidMedia("Invalid or incomplete HLS TS segment")
+            }
+            if (checkPackets) {
+                if (DownloadHlsRepairTransport.restoreIntactResponse(partial, original())) onIntact()
+                if (!DownloadHlsRepairTransport.packetized(partial)) throw InvalidMedia("来源返回的分片不完整，其他分片已保留")
+            }
+            context.ensureActive()
+            if (!partial.renameTo(file)) throw Failure("Cannot finalize HLS segment cache")
+            if (checkPackets && rejected.exists()) rejected.delete()
+        }
+    }
+
+    private fun unavailable(error: IOException) = error is InvalidMedia || (error is Failure && error.httpStatus in setOf(403, 404, 410))
+
+    private fun unavailableMarker(file: File) = File(file.parentFile, "${file.name}.unavailable")
+
+    private fun markUnavailable(file: File) {
+        // A scheduling hint only. Explicit original-quality retries always fetch the original again.
+        try {
+            unavailableMarker(file).createNewFile()
+        } catch (_: IOException) {
+            // A later repair can recheck this original if the hint was not saved.
+        }
+    }
+
     private fun segmentFailure(response: Response, onDeniedMedia: (HttpUrl) -> Unit): Failure {
         val code = response.code
         if (code != 401 && code != 403 && code != 404) return Failure("HLS segment HTTP $code", code)
