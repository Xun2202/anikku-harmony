+    /** Lower fragments needed to cover one original, including when their boundaries differ. */
+    fun covering(times: LongArray, start: Long, end: Long): IntRange {
+        if (start < times.first() - BOUNDARY_TOLERANCE_MS || end > times.last() + BOUNDARY_TOLERANCE_MS) return IntRange.EMPTY
+        val first = alignedBoundary(times, start) ?: (-times.binarySearch(start) - 2)
+        val after = alignedBoundary(times, end) ?: (-times.binarySearch(end) - 1)
+        return first.coerceAtLeast(0) until after.coerceAtMost(times.lastIndex)
+    }
+
     private fun alignedBoundary(times: LongArray, at: Long): Int? {
         val found = times.binarySearch(at)
         if (found >= 0) return found
