+    @Test
+    fun `an interrupted original read never switches quality and a recovered original can finish without donors`() = runTest {
+        val paths = ConcurrentLinkedQueue<String>()
+        val ts = ByteArray(188 * 4) {
+            if (it % 188 == 0) {
+                0x47
+            } else if (it % 188 == 3) {
+                0x10
+            } else {
+                4
+            }
+        }
+        var truncated = false
+        val client = OkHttpClient.Builder().addInterceptor { chain ->
+            val req = chain.request()
+            val reply = Response.Builder().request(req).protocol(Protocol.HTTP_1_1).message("test")
+            if (req.url.encodedPath == "/m3u8") {
+                val track = req.url.queryParameter("track")
+                reply.code(200).body("#EXTM3U\n#EXTINF:4,\n/segment?url=https://example.test/$track/0\n#EXTINF:4,\n/segment?url=https://example.test/$track/1\n#EXT-X-ENDLIST\n".toResponseBody()).build()
+            } else {
