+// Harmony -->
+/** Auto column width for the panorama grid; a 3:2 cover at this width is as tall as a 2:3 cover at 128 dp is wide. */
+private val PanoramaGridMinColumnWidth = 168.dp
+
+/**
+ * Cover orientation (height / width) by manga id, kept for the process lifetime so a cell keeps
+ * its shape when it scrolls back into view instead of jumping from book to panorama once the
+ * image is decoded again. In panorama mode an unknown cover is assumed wide, since that is what
+ * the mode is for.
+ */
+private val coverRatios = ConcurrentHashMap<Long, Float>()
+
+/** height / width of a 16:9 thumbnail, the common shape of video covers. */
+private const val WIDE_COVER_RATIO = 9f / 16f
+
+@Composable
+private fun rememberCoverRatio(mangaId: Long, usePanoramaCover: Boolean): MutableFloatState {
+    val ratio = remember(mangaId) {
+        mutableFloatStateOf(coverRatios[mangaId] ?: if (usePanoramaCover) WIDE_COVER_RATIO else 1f)
+    }
+    LaunchedEffect(mangaId) {
+        snapshotFlow { ratio.floatValue }
+            .drop(1)
+            .collect { coverRatios[mangaId] = it }
+    }
+    return ratio
+}
