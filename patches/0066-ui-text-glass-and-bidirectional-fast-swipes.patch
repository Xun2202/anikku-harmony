+
+private class CapsuleTextLayout {
+    var result: TextLayoutResult? = null
+}
+
+/** Center each word independently of its counter; Difference ink responds to the actual glass below. */
+@Composable
+internal fun RowScope.CapsuleNavigationLabel(
+    selected: Boolean,
+    onClick: () -> Unit,
+    label: String,
+    index: Int?,
+    modifier: Modifier,
+    badge: (@Composable () -> Unit)?,
+) {
+    val preview = LocalCapsulePreview.current
+    val active = if (index != null && preview != null) index == preview else selected
+    val emphasis by animateFloatAsState(if (active) 1f else 0f, tween(160), label = "capsuleWord")
+    val style = MaterialTheme.typography.labelLarge.copy(
+        fontSize = 16.sp,
+        lineHeight = 20.sp,
+        fontWeight = if (active) FontWeight.SemiBold else FontWeight.Medium,
+    )
+    val measurer = rememberTextMeasurer()
+    val savedLayout = remember { CapsuleTextLayout() }
+    val ink = MaterialTheme.colorScheme.onSurface
+    val outline = MaterialTheme.colorScheme.surface.copy(alpha = 0.35f)
+    val inverse = Build.VERSION.SDK_INT >= 29
+    Layout(
+        modifier = modifier.weight(1f).fillMaxHeight().selectable(
+            selected = selected,
+            interactionSource = remember { MutableInteractionSource() },
+            indication = null,
+            role = Role.Tab,
+            onClick = onClick,
+        ),
+        content = {
+            Canvas(
+                Modifier.semantics { text = AnnotatedString(label) }
+                    .graphicsLayer {
+                        scaleX = 1f + 0.025f * emphasis
+                        scaleY = scaleX
+                    },
+            ) {
+                savedLayout.result?.let {
+                    drawText(it, color = outline, drawStyle = Stroke(1.dp.toPx()))
+                    drawText(
+                        it,
+                        color = (if (inverse) Color.White else ink).copy(alpha = 0.62f + 0.38f * emphasis),
+                        blendMode = if (inverse) BlendMode.Difference else BlendMode.SrcOver,
+                    )
+                }
+            }
+            Box { badge?.invoke() }
+        },
+    ) { measurables, constraints ->
+        val text = measurer.measure(
+            label,
+            style,
+            overflow = TextOverflow.Ellipsis,
+            maxLines = 1,
+            constraints = Constraints(maxWidth = (constraints.maxWidth - 8.dp.roundToPx()).coerceAtLeast(0)),
+        )
+        savedLayout.result = text
+        val word = measurables[0].measure(Constraints.fixed(text.size.width, text.size.height))
+        val counter = measurables[1].measure(constraints.copy(minWidth = 0, minHeight = 0))
+        val width = constraints.maxWidth
+        val height = constraints.maxHeight
+        layout(width, height) {
+            val left = (width - word.width) / 2
+            word.placeRelative(left, (height - word.height) / 2)
+            counter.placeRelative(
+                (left + word.width + 2.dp.roundToPx()).coerceAtMost(width - counter.width).coerceAtLeast(0),
+                2.dp.roundToPx(),
+            )
+        }
+    }
+}
