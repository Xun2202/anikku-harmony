+
+/** Bend the already sampled backdrop only; labels are a separate, sharp sibling layer. */
+@Composable
+internal fun Modifier.capsuleRefraction(size: IntSize, radius: Float): Modifier {
+    if (Build.VERSION.SDK_INT < 33 || !LocalView.current.isHardwareAccelerated || size.width <= 0 || size.height <= 0) {
+        return this
+    }
+    val effect = remember(size, radius) {
+        runCatching { CapsuleRefraction33.effect(size, radius) }.getOrElse {
+            Log.w("NavigationCapsule", "Refraction unavailable; retaining the blurred glass surface", it)
+            null
+        }
+    }
+    return if (effect == null) this else graphicsLayer { renderEffect = effect }
+}
+
+@TargetApi(33)
+internal object CapsuleRefraction33 {
+    // A curved edge samples a displaced background, with directional Fresnel light at its rim.
+    // There is no per-tab shape, second background capture, or perpetual animation.
+    const val SOURCE = """
+        uniform shader backdrop;
+        uniform float2 resolution;
+        uniform float cornerRadius;
+
+        half4 main(float2 xy) {
+            float2 halfSize = resolution * 0.5;
+            float radius = clamp(cornerRadius, 1.0, halfSize.y);
+            float2 p = xy - halfSize;
+            float2 q = abs(p) - (halfSize - float2(radius));
+            float edgeDistance = length(max(q, float2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
+            float2 normal = normalize(max(q, float2(0.001))) * sign(p);
+            float edge = 1.0 - smoothstep(0.0, max(3.0, resolution.y * 0.24), -edgeDistance);
+            float bend = resolution.y * 0.10 * edge * edge;
+            float2 samplePoint = halfSize + p * 0.985 - normal * bend;
+            samplePoint = clamp(samplePoint, float2(0.5), resolution - float2(0.5));
+            half4 color = backdrop.eval(samplePoint);
+            float direction = dot(normal, normalize(float2(-0.55, -0.83)));
+            float shine = 0.14 * edge * edge * (0.4 + 0.6 * max(direction, 0.0));
+            color.rgb = mix(color.rgb, half3(1.0), half(shine));
+            color.rgb *= half(1.0 - 0.05 * edge * max(-direction, 0.0));
+            return color;
+        }
+    """
+
+    fun shader(size: IntSize, radius: Float): RuntimeShader = RuntimeShader(SOURCE).apply {
+        setFloatUniform("resolution", size.width.toFloat(), size.height.toFloat())
+        setFloatUniform("cornerRadius", radius)
+    }
+
+    fun effect(size: IntSize, radius: Float): RenderEffect {
+        val input = shader(size, radius)
+        return android.graphics.RenderEffect.createRuntimeShaderEffect(input, "backdrop").asComposeRenderEffect()
+    }
+}
