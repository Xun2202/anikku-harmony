@@ -0,0 +1,41 @@
+package tachiyomi.presentation.core.components.material
+
+import android.graphics.Bitmap
+import android.graphics.BitmapShader
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Shader
+import androidx.compose.ui.unit.IntSize
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+/** Compile and execute the actual AGSL optics with native Skia, independently of a hardware View. */
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+@Config(sdk = [34])
+class NavigationChromeGlassShaderTest {
+    @Test
+    fun `glass bends backdrop stripes at its rim while retaining the center content`() {
+        val source = Bitmap.createBitmap(320, 48, Bitmap.Config.ARGB_8888)
+        for (y in 0 until source.height) {
+            for (x in 0 until source.width) source.setPixel(x, y, if (y / 4 % 2 == 0) Color.RED else Color.BLUE)
+        }
+        val shader = CapsuleRefraction33.shader(IntSize(320, 48), 24f).apply {
+            setInputShader("backdrop", BitmapShader(source, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP))
+        }
+        val output = Bitmap.createBitmap(320, 48, Bitmap.Config.ARGB_8888)
+        Canvas(output).drawRect(0f, 0f, 320f, 48f, Paint().apply { this.shader = shader })
+        assertEquals(source.getPixel(160, 24), output.getPixel(160, 24))
+        val rim = output.getPixel(160, 1)
+        assertTrue(Color.blue(rim) > Color.red(rim), "The rim must sample a displaced blue stripe, not merely tint red")
+        assertEquals(255, Color.alpha(rim))
+        source.recycle()
+        output.recycle()
+    }
+}
