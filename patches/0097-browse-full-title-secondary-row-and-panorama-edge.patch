+import androidx.compose.ui.input.nestedscroll.NestedScrollSource
+import androidx.compose.ui.input.nestedscroll.nestedScroll
+import androidx.compose.ui.layout.onGloballyPositioned
+import androidx.compose.ui.layout.positionInRoot
+import androidx.compose.ui.platform.LocalConfiguration
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performTouchInput
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.Velocity
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import tachiyomi.presentation.core.components.FastScrollPanoramaMasonry
+import tachiyomi.presentation.core.components.PanoramaCellHeight
+import tachiyomi.presentation.core.components.PanoramaColumns
+import tachiyomi.presentation.core.components.PanoramaMasonry
+import tachiyomi.presentation.core.components.PanoramaMasonryScope
+import tachiyomi.presentation.core.components.PanoramaMasonryState
+import tachiyomi.presentation.core.components.rememberPanoramaMasonryState
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromePanoramaHeaderTest {
+    @Test
+    fun `source panorama inertia brings its two-row header back without a blank band`() = assertCoastToStart(false)
+
+    @Test
+    fun `library panorama keeps the same return behavior after moving observation into the viewport`() = assertCoastToStart(true)
+
+    private fun assertCoastToStart(fastScroller: Boolean) = runComposeUiTest {
+        lateinit var chrome: BrowsingNavigationBarState
+        lateinit var grid: PanoramaMasonryState
+        lateinit var scope: CoroutineScope
+        var headerBottom = 0f
+        var firstCoverTop = 0f
+        var releaseOffset = Float.NaN
+        var releaseVelocity = 0f
+        setContent {
+            val config = Configuration(LocalConfiguration.current).apply {
+                screenWidthDp = 400
+                screenHeightDp = 600
+            }
+            CompositionLocalProvider(LocalConfiguration provides config, LocalDensity provides Density(1f)) {
+                chrome = rememberBrowsingNavigationBarState(enabled = true, resetKey = Unit)
+                scope = rememberCoroutineScope()
+                grid = rememberPanoramaMasonryState()
+                Box(Modifier.requiredSize(400.dp, 600.dp)) {
+                    CompositionLocalProvider(LocalBrowsingNavigationBarState provides chrome) {
+                        Scaffold(
+                            topBarScrollBehavior = rememberBrowsingTopAppBarScrollBehavior(),
+                            contentWindowInsets = WindowInsets(0),
+                            topBar = {
+                                Column(Modifier.onGloballyPositioned { headerBottom = it.positionInRoot().y + it.size.height }) {
+                                    NavigationTopAppBar(title = { Text("插件作品") }, windowInsets = WindowInsets(0))
+                                    Box(Modifier.fillMaxWidth().height(browsingSecondaryRowHeight())) { Text("热门  最近更新") }
+                                }
+                            },
+                        ) { padding ->
+                            val covers: PanoramaMasonryScope.() -> Unit = {
+                                items(100, key = { it }, height = { PanoramaCellHeight.Fixed(100.dp) }) { index ->
+                                    Box(
+                                        Modifier.fillMaxWidth().height(100.dp).onGloballyPositioned {
+                                            if (index == 0) firstCoverTop = it.positionInRoot().y
+                                        },
+                                    )
+                                }
+                            }
+                            val probe = remember(grid) {
+                                object : NestedScrollConnection {
+                                    override suspend fun onPreFling(available: Velocity): Velocity {
+                                        releaseOffset = grid.scrollOffset
+                                        releaseVelocity = available.y
+                                        return Velocity.Zero
+                                    }
+                                }
+                            }
+                            val modifier = Modifier.fillMaxSize().testTag("panorama").nestedScroll(probe)
+                            if (fastScroller) {
+                                FastScrollPanoramaMasonry(columns = PanoramaColumns.Fixed(2), state = grid, modifier = modifier, contentPadding = padding, content = covers)
+                            } else {
+                                PanoramaMasonry(columns = PanoramaColumns.Fixed(2), state = grid, modifier = modifier, contentPadding = padding, content = covers)
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        runOnIdle { scope.launch { grid.scrollToOffset(400f) } }
+        waitForIdle()
+        runOnIdle {
+            chrome.nestedScrollConnection.onPostScroll(Offset(0f, -40f), Offset.Zero, NestedScrollSource.UserInput)
+            assertFalse(chrome.visible)
+        }
+        waitForIdle()
+        onNodeWithTag("panorama").performTouchInput {
+            down(Offset(center.x, height * 0.25f))
+            repeat(4) { moveBy(Offset(0f, 45f), delayMillis = 15) }
+            up()
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(releaseOffset > 100f, "The return must reach the start by inertia after release: $releaseOffset")
+            assertTrue(releaseVelocity > 1000f, "The pointer release must retain its return velocity: $releaseVelocity")
+            assertEquals(0f, grid.scrollOffset, 0.5f)
+            assertTrue(chrome.visible)
+            assertEquals(0f, chrome.hiddenFraction, 0.01f)
+            assertEquals(firstCoverTop, headerBottom, 1f, "The revealed header must fill its content spacer")
+            scope.launch { grid.scrollToOffset(300f) }
+        }
+        waitForIdle()
+        runOnIdle { assertEquals(0f, chrome.hiddenFraction, 0.01f, "Leaving the start must not restore an old hidden target") }
+    }
+}
