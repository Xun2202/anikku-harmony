+package tachiyomi.presentation.core.components.material
+
+import android.content.res.Configuration
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.requiredSize
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.lazy.grid.GridCells
+import androidx.compose.foundation.lazy.grid.rememberLazyGridState
+import androidx.compose.foundation.lazy.rememberLazyListState
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.material3.FilterChip
+import androidx.compose.material3.Text
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.input.nestedscroll.NestedScrollSource
+import androidx.compose.ui.layout.onGloballyPositioned
+import androidx.compose.ui.platform.LocalConfiguration
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.test.performClick
+import androidx.compose.ui.test.performScrollTo
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import tachiyomi.presentation.core.components.FastScrollLazyColumn
+import tachiyomi.presentation.core.components.FastScrollLazyVerticalGrid
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeBrowseHeaderTest {
+    @Test
+    fun `compact source title and filters fit one common toolbar and filters remain reachable`() = runComposeUiTest {
+        var height = 0
+        var clicked = false
+        setContent {
+            val config = Configuration(LocalConfiguration.current).apply {
+                screenWidthDp = 400
+                screenHeightDp = 600
+            }
+            CompositionLocalProvider(LocalConfiguration provides config, LocalDensity provides Density(1f)) {
+                Column(Modifier.requiredSize(400.dp, 200.dp)) {
+                    NavigationTopAppBar(
+                        title = {
+                            BrowsingToolbarTitle(title = { Text("插件作品") }) {
+                                BrowsingFilterRow(rememberScrollState()) {
+                                    listOf("热门", "最新", "我的长名称搜索", "筛选").forEach { label ->
+                                        FilterChip(selected = false, onClick = { clicked = label == "筛选" }, label = { Text(label) })
+                                    }
+                                }
+                            }
+                        },
+                        navigationIcon = { Box(Modifier.size(40.dp)) },
+                        actions = { repeat(3) { Box(Modifier.size(40.dp)) } },
+                        windowInsets = WindowInsets(0),
+                        modifier = Modifier.onGloballyPositioned { height = it.size.height },
+                    )
+                }
+            }
+        }
+        runOnIdle { assertEquals(40, height) }
+        onNodeWithText("筛选").performScrollTo().performClick()
+        runOnIdle { assertTrue(clicked) }
+    }
+
+    @Test
+    fun `list returning to first item commits revealed navigation beyond the spacer`() = assertLeadingBoundary(false)
+
+    @Test
+    fun `grid returning to first row commits revealed navigation beyond the spacer`() = assertLeadingBoundary(true)
+
+    private fun assertLeadingBoundary(grid: Boolean) = runComposeUiTest {
+        lateinit var chrome: BrowsingNavigationBarState
+        lateinit var scope: CoroutineScope
+        lateinit var jump: suspend (Int) -> Unit
+        setContent {
+            CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                chrome = rememberBrowsingNavigationBarState(enabled = true, resetKey = Unit)
+                scope = rememberCoroutineScope()
+                Box(Modifier.requiredSize(400.dp, 600.dp)) {
+                    CompositionLocalProvider(LocalBrowsingNavigationBarState provides chrome) {
+                        Scaffold(
+                            topBarScrollBehavior = rememberBrowsingTopAppBarScrollBehavior(),
+                            topBar = { Box(Modifier.height(40.dp)) },
+                        ) { padding ->
+                            if (grid) {
+                                val scroll = rememberLazyGridState(initialFirstVisibleItemIndex = 20)
+                                jump = { scroll.scrollToItem(it) }
+                                FastScrollLazyVerticalGrid(columns = GridCells.Fixed(2), state = scroll, contentPadding = padding) {
+                                    items(100) { Box(Modifier.height(80.dp)) }
+                                }
+                            } else {
+                                val scroll = rememberLazyListState(initialFirstVisibleItemIndex = 20)
+                                jump = { scroll.scrollToItem(it) }
+                                FastScrollLazyColumn(state = scroll, contentPadding = padding) {
+                                    items(100) { Box(Modifier.height(80.dp)) }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        runOnIdle {
+            chrome.nestedScrollConnection.onPostScroll(Offset(0f, -40f), Offset.Zero, NestedScrollSource.UserInput)
+            assertFalse(chrome.visible)
+        }
+        waitForIdle()
+        runOnIdle { scope.launch { jump(0) } }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(chrome.visible)
+            assertEquals(0f, chrome.hiddenFraction, 0.01f)
+            scope.launch { jump(20) }
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(chrome.visible, "Leaving the spacer must not restore an old hidden target")
+            assertEquals(0f, chrome.hiddenFraction, 0.01f)
+        }
+    }
+}
