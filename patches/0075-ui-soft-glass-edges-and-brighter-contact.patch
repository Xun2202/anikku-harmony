@@ -34,7 +34,7 @@ internal fun Modifier.browsingGlassBackground(state: BrowsingNavigationBarState,
         style = HazeStyle(
             backgroundColor = surface,
             tint = HazeTint(surface.copy(alpha = tint)),
-            blurRadius = if (thin) 10.dp else 18.dp,
+            blurRadius = if (thin) 7.dp else 18.dp,
             noiseFactor = if (thin) 0.005f else 0.03f,
             fallbackTint = HazeTint(surface.copy(alpha = fallback)),
         ),
diff --git a/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/CapsuleNavigationLabel.kt b/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/CapsuleNavigationLabel.kt
