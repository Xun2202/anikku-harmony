@@ -81,7 +81,7 @@ internal object CapsuleRefraction33 {
             samplePoint = clamp(samplePoint, float2(0.5), resolution - float2(0.5));
             half4 color = backdrop.eval(samplePoint);
             float direction = dot(normal, normalize(float2(-0.55, -0.83)));
