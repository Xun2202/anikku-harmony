+    @Synchronized
+    internal fun getRecoveryDir(mangaDir: UniFile, episodeId: Long): UniFile {
+        val root = mangaDir.parentFile?.parentFile
+            ?: throw IOException("Cannot locate the download root for the recovery copy")
+        val backupRoot = root.createDirectory(".anikku-recovery")
+            ?.takeIf { it.isDirectory && it.name == ".anikku-recovery" }
+            ?: throw IOException("Cannot create the download recovery directory")
+        DiskUtil.createNoMediaFile(backupRoot, null)
+        val name = episodeId.toString()
+        return backupRoot.createDirectory(name)?.takeIf { it.isDirectory && it.name == name }
+            ?: throw IOException("Cannot create the episode recovery directory")
+    }
