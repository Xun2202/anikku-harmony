+    /** A known matching copy can be merged. A different copy must be backed up before saving. */
+    suspend fun prepareFinalTarget(
+        directory: UniFile,
+        staged: UniFile,
+        filename: String,
+        preserveConflict: suspend (UniFile) -> Unit,
+    ) {
+        val existing = videos(directory, filename)
+        if (existing.isEmpty()) return
+        val video = existing.singleOrNull()
+            ?: throw IOException("Multiple final video files were preserved. Inspect the directory before retrying")
+        val bytes = video.length()
+        val stagedBytes = staged.length()
+        if (video.name == staged.name && bytes in 0L..stagedBytes) {
+            val prefix = bytes.takeIf { it < stagedBytes }
+            val identical = video.openInputStream().use { a ->
+                staged.openInputStream().use { b -> streamsEqual(a, b, prefixBytes = prefix) }
+            }
+            if (identical) return
+        }
+        currentCoroutineContext().ensureActive()
+        preserveConflict(video)
+    }
+
+    /** Keep the previous bytes in a recovery directory outside the indexed downloads. */
+    suspend fun preserveConflictingVideo(video: UniFile, recovery: UniFile) {
+        val name = video.name ?: throw IOException("Existing video has no filename")
+        val bytes = video.length()
+        if (bytes <= 0L) throw IOException("Existing video length cannot be verified. Original files were preserved")
+
+        // Recover a prior successful backup when cancellation or a provider error kept it in place.
+        var backupName = name
+        var suffix = 1
+        var backup = recovery.findFile(backupName)
+        while (backup != null && (backup.isDirectory || !sameContents(video, backup))) {
+            backupName = "${suffix++}-$name"
+            backup = recovery.findFile(backupName)
+        }
+        if (backup == null) {
+            val target = recovery.createFile(backupName)
+                ?: throw IOException("Cannot create a backup of the existing video. Original files were preserved")
+            if (target.name != backupName || target.length() != 0L) {
+                throw IOException("Storage provider returned an unexpected backup file. Original files were preserved")
+            }
+            try {
+                val copied = video.openInputStream().use { input ->
+                    target.openOutputStream().use { output -> input.copyTo(output, 256 * 1024) }
+                }
+                if (copied != bytes || !sameContents(video, target)) throw IOException("Backup video bytes could not be verified")
+            } catch (failure: Exception) {
+                runCatching { deleteRequired(target) }.exceptionOrNull()?.let(failure::addSuppressed)
+                throw failure
+            }
+        }
+        currentCoroutineContext().ensureActive()
+        if (!video.delete()) throw IOException("The previous video was backed up, but the storage provider refused to move it")
+    }
+
