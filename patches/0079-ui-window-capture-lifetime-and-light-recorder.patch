+/** Main-thread draw observer. Stopping during dispatch defers removal, never delivery. */
+class DrawPerfObserver(private val view: View, private val onDraw: (Long) -> Unit) {
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private var listener: ViewTreeObserver.OnDrawListener? = null
+    private var observer: ViewTreeObserver? = null
+    private var dispatching = false
+    private var running = false
+    private var registration = 0L
+    private val attachment = object : View.OnAttachStateChangeListener {
+        override fun onViewAttachedToWindow(v: View) = requestBind()
+        override fun onViewDetachedFromWindow(v: View) {
+            registration++
+            unbind()
+        }
+    }
+
+    fun start() {
+        if (running) return
+        running = true
+        view.addOnAttachStateChangeListener(attachment)
+        requestBind()
+    }
+
+    private fun requestBind() {
+        val token = ++registration
+        unbind()
+        if (dispatching) mainHandler.post { bind(token) } else bind(token)
+    }
+
+    private fun bind(token: Long, retry: Boolean = true) {
+        if (!running || token != registration) return
+        val owner = view.viewTreeObserver
+        val callback = object : ViewTreeObserver.OnDrawListener {
+            override fun onDraw() {
+                if (!running || token != registration || listener !== this) return
+                dispatching = true
+                try {
+                    this@DrawPerfObserver.onDraw(System.nanoTime())
+                } finally {
+                    dispatching = false
+                }
+            }
+        }
+        observer = owner
+        listener = callback
+        try {
+            owner.addOnDrawListener(callback)
+        } catch (_: IllegalStateException) {
+            observer = null
+            listener = null
+            if (retry) mainHandler.post { bind(token, retry = false) }
+        }
+    }
+
+    fun stop() {
+        running = false
+        registration++
+        view.removeOnAttachStateChangeListener(attachment)
+        unbind()
+    }
+
+    private fun unbind() {
+        val callback = listener ?: return
+        val owner = observer
+        listener = null
+        observer = null
+        val remove = Runnable {
+            if (owner?.isAlive == true) owner.removeOnDrawListener(callback)
+            val current = view.viewTreeObserver
+            if (current !== owner && current.isAlive) current.removeOnDrawListener(callback)
+        }
+        if (dispatching) {
+            mainHandler.post(remove)
+        } else {
+            try {
+                remove.run()
+            } catch (_: IllegalStateException) {
+                // Another listener may be dispatching this same tree. Do not depend on the
+                // View reattaching to execute cleanup after a fold or Activity replacement.
+                mainHandler.post(remove)
+            }
+        }
+    }
+}
