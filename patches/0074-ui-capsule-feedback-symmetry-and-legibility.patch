+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.animation.core.Animatable
+import androidx.compose.animation.core.FastOutSlowInEasing
+import androidx.compose.animation.core.tween
+import androidx.compose.runtime.Stable
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.launch
+
+/** Quick taps still reach a visible peak; the held and released material follows one easing family. */
+@Stable
+internal class CapsuleTouchFeedback {
+    private val strength = Animatable(0f)
+    private var motion: Job? = null
+    val value: Float get() = strength.value
+
+    fun press(scope: CoroutineScope) {
+        motion?.cancel()
+        motion = scope.launch { strength.animateTo(1f, tween(80, easing = FastOutSlowInEasing)) }
+    }
+
+    fun release(scope: CoroutineScope, completePulse: Boolean) {
+        motion?.cancel()
+        motion = scope.launch {
+            if (completePulse) {
+                if (strength.value < 1f) strength.animateTo(1f, tween(70, easing = FastOutSlowInEasing))
+                strength.animateTo(1f, tween(40, easing = FastOutSlowInEasing))
+            }
+            strength.animateTo(0f, tween(320, easing = FastOutSlowInEasing))
+        }
+    }
+}
