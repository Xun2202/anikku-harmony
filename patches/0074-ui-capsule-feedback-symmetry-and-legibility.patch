+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.size
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.CoroutineScope
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class NavigationChromeCapsuleFeedbackTest {
+    @Test
+    fun `a very short tap reaches a visible peak and fades gradually`() = runComposeUiTest {
+        val feedback = CapsuleTouchFeedback()
+        lateinit var scope: CoroutineScope
+        setContent {
+            scope = rememberCoroutineScope()
+            Box(Modifier.size(100.dp))
+        }
+        mainClock.autoAdvance = false
+        runOnIdle {
+            feedback.press(scope)
+            feedback.release(scope, completePulse = true)
+        }
+        mainClock.advanceTimeBy(112)
+        runOnIdle { assertTrue(feedback.value > 0.9f, "A tap released before the attack finishes still has a visible pulse") }
+        mainClock.advanceTimeBy(80)
+        runOnIdle { assertTrue(feedback.value > 0.25f, "The release must not disappear immediately") }
+        mainClock.advanceTimeBy(400)
+        runOnIdle { assertEquals(0f, feedback.value, 0.001f) }
+    }
+
+    @Test
+    fun `a new press cancels the old fading tail and stays bright while held`() = runComposeUiTest {
+        val feedback = CapsuleTouchFeedback()
+        lateinit var scope: CoroutineScope
+        setContent {
+            scope = rememberCoroutineScope()
+            Box(Modifier.size(100.dp))
+        }
+        mainClock.autoAdvance = false
+        runOnIdle { feedback.press(scope) }
+        mainClock.advanceTimeBy(112)
+        runOnIdle { feedback.release(scope, completePulse = false) }
+        mainClock.advanceTimeBy(64)
+        runOnIdle {
+            assertTrue(feedback.value > 0.6f)
+            feedback.press(scope)
+        }
+        mainClock.advanceTimeBy(500)
+        runOnIdle {
+            assertEquals(1f, feedback.value, 0.001f)
+            feedback.release(scope, completePulse = false)
+        }
+        mainClock.advanceTimeBy(400)
+        runOnIdle { assertEquals(0f, feedback.value, 0.001f) }
+    }
+}
