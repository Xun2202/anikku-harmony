 .../core/components/PanoramaMasonryLayout.kt  | 55 +++++---------
 .../components/PanoramaAutoColumnsTest.kt     | 75 +++++++++++++++++++
 .../components/PanoramaMasonryLayoutTest.kt   | 21 +++---
 4 files changed, 105 insertions(+), 56 deletions(-)
