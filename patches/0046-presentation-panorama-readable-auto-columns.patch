-private const val PANORAMA_SHAPED_REFERENCE_AREA_DP2 = 459.0 * 552.0
+/** The preferred single-lane cover height, before the cell's horizontal padding is added. */
+private const val PANORAMA_SHAPED_COVER_HEIGHT_DP = 234.0
 private const val PANORAMA_SHAPED_MIN_LANE_DP = 104.0
-private const val PANORAMA_SHAPED_MAX_LANE_DP = 240.0
+private const val PANORAMA_SHAPED_MAX_LANE_DP = 324.0
 private const val PANORAMA_SHAPED_CHROME_DP = 8.0
-private const val PANORAMA_SHAPED_TIE_DP = 0.05
 private const val PANORAMA_SHAPED_MAX_LANES = 12
 
 /**
  * Lane count for [PanoramaColumns.Shaped].
  *
- * [gridWidthPx] is the lane area plus horizontal content padding. [gridHeightPx] is the measured
- * height and is ignored when [heightBounded] is false. Sizes are pixels; [density] is px per dp.
- * The target lane is `clamp(sqrt(area / heightOverWidth) + 8 dp, 104 dp, 240 dp)`, where
- * `area = 23064 dp^2 * max(1, sqrt(gridArea / (459 * 552 dp^2)))`.
+ * [gridWidthPx] is the lane area plus horizontal content padding. Sizes are pixels; [density] is
+ * px per dp. [gridHeightPx] and [heightBounded] are retained for callers but do not affect the
+ * count: a keyboard or toolbar changing the grid's height must not resize covers at the same width.
+ * A lane is at most `clamp(234 dp / heightOverWidth + 8 dp, 104 dp, 324 dp)` wide. Narrower lanes
+ * are added only while they remain at least 104 dp wide. Covers no taller than they are wide use
+ * at least two lanes when both can fit, so a compact window does not leave one oversized cover.
  */
 fun panoramaShapedLaneCount(
     gridWidthPx: Int,
@@ -148,29 +139,19 @@ fun panoramaShapedLaneCount(
     density: Float,
     heightBounded: Boolean,
 ): Int {
-    if (heightOverWidth <= 0f || density <= 0f) return 1
+    if (!heightOverWidth.isFinite() || heightOverWidth <= 0f || !density.isFinite() || density <= 0f) return 1
     val available = gridWidthPx - horizontalPaddingPx
     if (available <= 0) return 1
     val densityDp = density.toDouble()
-    val scale = if (!heightBounded || gridHeightPx <= 0) {
-        1.0
-    } else {
-        val reference = PANORAMA_SHAPED_REFERENCE_AREA_DP2 * densityDp * densityDp
-        val gridArea = gridWidthPx.toDouble() * gridHeightPx.toDouble()
-        sqrt(gridArea / reference).coerceAtLeast(1.0)
-    }
-    val area = PANORAMA_SHAPED_ANCHOR_AREA_DP2 * densityDp * densityDp * scale
     val minLane = PANORAMA_SHAPED_MIN_LANE_DP * densityDp
-    val maxLane = PANORAMA_SHAPED_MAX_LANE_DP * densityDp
-    val ideal = (sqrt(area / heightOverWidth.toDouble()) + PANORAMA_SHAPED_CHROME_DP * densityDp)
-        .coerceIn(minLane, maxLane)
-    return panoramaNearestLaneCount(
-        availablePx = available,
-        spacingPx = spacingPx,
-        idealPx = ideal,
-        minLanePx = minLane,
-        tiePx = PANORAMA_SHAPED_TIE_DP * densityDp,
-    )
+    val maxLane = (PANORAMA_SHAPED_COVER_HEIGHT_DP / heightOverWidth.toDouble() + PANORAMA_SHAPED_CHROME_DP)
+        .coerceIn(PANORAMA_SHAPED_MIN_LANE_DP, PANORAMA_SHAPED_MAX_LANE_DP) * densityDp
+    for (lanes in 1 until PANORAMA_SHAPED_MAX_LANES) {
+        if (lanes == 1 && heightOverWidth <= 1f && panoramaLaneWidth(available, spacingPx, 2) >= minLane) continue
+        if (panoramaLaneWidth(available, spacingPx, lanes) <= maxLane) return lanes
+        if (panoramaLaneWidth(available, spacingPx, lanes + 1) < minLane) return lanes
+    }
+    return PANORAMA_SHAPED_MAX_LANES
 }
 
