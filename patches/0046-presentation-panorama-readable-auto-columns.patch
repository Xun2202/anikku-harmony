diff --git a/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaMasonry.kt b/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaMasonry.kt
index 2db5ef0..267595f 100644
--- a/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaMasonry.kt
+++ b/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaMasonry.kt
@@ -85,13 +85,9 @@ sealed interface PanoramaColumns {
      * Columns whose width tracks one cover shape.
      *
      * [heightOverWidth] is the cover box, not a measured bitmap: 3/2 for a tall cover and 2/3
-     * for a wide one. The target lane keeps that cover near a constant area, and grows with the
-     * square root of this grid's own area. Lane count is whichever column width is closest to
-     * that target.
-     *
-     * Harmony: the area is the measured grid (lane area plus horizontal content padding, times
-     * the measured height). An unbounded height uses scale 1. A tie within 0.05 dp keeps the
-     * smaller count, and a column narrower than 104 dp is not a candidate.
+     * for a wide one. Column count follows available width and readable cover dimensions;
+     * viewport height does not change the count when bars, search or the keyboard appear.
+     * Lanes remain at least 104 dp wide, with a compact two-column floor for wide covers.
      */
     data class Shaped(
         val heightOverWidth: Float,
