+    /**
+     * Harmony: drops the graphics-layer error spam 卓易通 writes into the app's logcat and
+     * counts what was dropped, so the dump still says how noisy the session was.
+     */
+    private fun filterNoise(lines: Sequence<String>): Pair<List<String>, Map<String, Int>> {
+        val kept = mutableListOf<String>()
+        val filtered = sortedMapOf<String, Int>()
+        lines.forEach { line ->
+            val marker = HARMONY_NOISE_MARKERS.firstOrNull { it in line }
+            if (marker == null) {
+                kept += line
+            } else {
+                filtered[marker] = (filtered[marker] ?: 0) + 1
+            }
+        }
+        return kept to filtered
+    }
+
+    private fun logcatHeader(filteredCounts: Map<String, Int>): String {
+        if (filteredCounts.isEmpty()) return "--- Logcat ---"
+        val total = filteredCounts.values.sum()
+        val detail = filteredCounts.entries.joinToString(", ") { (marker, count) -> "$marker ×$count" }
+        return "--- Logcat ($total 卓易通 graphics-layer lines filtered: $detail) ---"
+    }
+
