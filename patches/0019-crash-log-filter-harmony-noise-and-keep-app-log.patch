+package eu.kanade.tachiyomi.util.system
+
+import logcat.LogPriority
+import logcat.LogcatLogger
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * Harmony: keeps the last few hundred lines the app itself logged through `logcat {}`.
+ *
+ * On 卓易通 the system side of the process floods logcat with graphics-layer errors
+ * (`BLASTBufferQueue`, `SurfaceDelegator`, ...) that push the app's own lines out of the
+ * logcat buffer within minutes, so a crash log dump taken later shows none of them.
+ * This buffer only ever sees what the app logged, and is appended to the dump.
+ */
+object HarmonyLogBuffer : LogcatLogger {
+
+    private const val CAPACITY = 600
+
+    private val lines = ArrayDeque<String>(CAPACITY)
+    private val lock = Any()
+    private val timeFormat = SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS", Locale.US)
+
+    override fun isLoggable(priority: LogPriority): Boolean = priority >= LogPriority.DEBUG
+
+    override fun log(priority: LogPriority, tag: String, message: String) {
+        val timestamp = synchronized(timeFormat) { timeFormat.format(Date()) }
+        val entry = "$timestamp ${priority.name.first()} $tag: $message"
+        synchronized(lock) {
+            if (lines.size >= CAPACITY) lines.removeFirst()
+            lines.addLast(entry)
+        }
+    }
+
+    fun snapshot(): List<String> = synchronized(lock) { lines.toList() }
+}
