+import java.util.concurrent.ConcurrentHashMap
+
+// Harmony -->
+/** Auto column width for a panorama grid; a 3:2 cover at this width is as tall as a 2:3 cover at 128 dp is wide. */
+internal val PanoramaGridMinColumnWidth = 168.dp
+
+/** Auto column width of the book-shaped grids. Panorama mode does not use it. */
+private val BookGridMinColumnWidth = 128.dp
+
+/**
+ * [GridCells] that still lays out like the book grids, and also keeps the raw column count.
+ * [GridCells.Fixed.count] is not readable, and auto columns arrive as [GridCells.Adaptive] with
+ * [BookGridMinColumnWidth], which is too narrow for a 3:2 cover.
+ *
+ * @param columnCount 0 means auto.
+ */
+@Immutable
+internal data class CountedGridCells(
+    val columnCount: Int,
+) : GridCells {
+    override fun Density.calculateCrossAxisCellSizes(availableSize: Int, spacing: Int): List<Int> {
+        val delegate = if (columnCount == 0) {
+            GridCells.Adaptive(BookGridMinColumnWidth)
+        } else {
+            GridCells.Fixed(columnCount)
+        }
+        return with(delegate) { calculateCrossAxisCellSizes(availableSize, spacing) }
+    }
+}
+
+internal fun libraryGridCells(columnCount: Int): GridCells = CountedGridCells(columnCount)
+
+internal fun panoramaStaggeredColumns(columnCount: Int): StaggeredGridCells {
+    return if (columnCount == 0) {
+        StaggeredGridCells.Adaptive(PanoramaGridMinColumnWidth)
+    } else {
+        StaggeredGridCells.Fixed(columnCount)
+    }
+}
+
+/**
+ * Column spec for a panorama grid.
+ * Callers that still pass a plain [GridCells] (season selection) use the same library column
+ * preference those cells were built from.
+ */
+@Composable
+internal fun GridCells.panoramaStaggeredColumns(): StaggeredGridCells {
+    val orientation = LocalConfiguration.current.orientation
+    val columnCount = (this as? CountedGridCells)?.columnCount ?: libraryColumnCount(orientation)
+    return panoramaStaggeredColumns(columnCount)
+}
+
+private fun libraryColumnCount(orientation: Int): Int {
+    val preferences = Injekt.get<LibraryPreferences>()
+    val landscape = orientation == Configuration.ORIENTATION_LANDSCAPE
+    return if (landscape) {
+        preferences.landscapeColumns().get()
+    } else {
+        preferences.portraitColumns().get()
+    }
+}
+
+/**
+ * Cover orientation (height / width) by manga id, kept for the process lifetime so a cell keeps
+ * its shape when it scrolls back into view instead of jumping from book to panorama once the
+ * image is decoded again. In panorama mode an unknown cover is assumed wide, since that is what
+ * the mode is for.
+ */
+private val coverRatios = ConcurrentHashMap<Long, Float>()
+
+/** height / width of a 16:9 thumbnail, the common shape of video covers. */
+private const val WIDE_COVER_RATIO = 9f / 16f
