+/** One distance to the physical left, right and bottom edges, not two distances at the bottom. */
+internal fun navigationCapsuleGap(bottomInset: Float, tappableInset: Float, density: Float): Float {
+    // Gesture insets describe a reserved band, not the visible handle. A bounded optical adjustment
+    // keeps the capsule above the handle without reproducing the whole band's decorative whitespace.
+    // Button navigation is interactive throughout its band and keeps the complete inset.
+    val reserved = if (tappableInset > 0f) maxOf(bottomInset, tappableInset) else (bottomInset - 4f * density)
+    return maxOf(20f * density, reserved)
+}
+
+internal data class CapsuleCornerRadii(
+    val topLeft: Float,
+    val topRight: Float,
+    val bottomRight: Float,
+    val bottomLeft: Float,
+)
+
+/** Offset each screen corner by the same margin; do not force both lower corners to half-height. */
+internal fun navigationCapsuleCorners(
+    height: Float,
+    gap: Float,
+    screenLeftRadius: Float,
+    screenRightRadius: Float,
+): CapsuleCornerRadii {
+    val left = (screenLeftRadius - gap).coerceIn(0f, height)
+    val right = (screenRightRadius - gap).coerceIn(0f, height)
+    return CapsuleCornerRadii(
+        topLeft = minOf(height / 2f, height - left),
+        topRight = minOf(height / 2f, height - right),
+        bottomRight = right,
+        bottomLeft = left,
+    )
+}
