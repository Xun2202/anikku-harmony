+
+class NavigationChromeCapsuleGeometryTest {
+    @Test
+    fun `Pura sized screenshot profile uses equal 55px margins instead of 33px sides and 66px bottom`() {
+        val density = 2.75f
+        val gap = navigationCapsuleGap(66f, 0f, density)
+        assertEquals(55f, gap)
+        assertTrue(gap < 66f)
+        val corners = navigationCapsuleCorners(132f, gap, 110f, 110f)
+        assertEquals(110f, gap + corners.bottomLeft)
+        assertEquals(110f, gap + corners.bottomRight)
+        assertTrue(corners.topLeft + corners.bottomLeft <= 132f)
+    }
+
+    @Test
+    fun `reported asymmetric lower screen corners remain concentric and fit the capsule height`() {
+        val corners = navigationCapsuleCorners(48f, 20f, 56f, 32f)
+        assertEquals(56f, 20f + corners.bottomLeft)
+        assertEquals(32f, 20f + corners.bottomRight)
+        assertTrue(corners.topLeft + corners.bottomLeft <= 48f)
+        assertTrue(corners.topRight + corners.bottomRight <= 48f)
+    }
+
+    @Test
+    fun `button navigation retains its full interactive band and zero inset hosts get a bounded margin`() {
+        assertEquals(48f, navigationCapsuleGap(48f, 48f, 1f))
+        assertEquals(20f, navigationCapsuleGap(0f, 0f, 1f))
+        assertEquals(36f, navigationCapsuleGap(40f, 0f, 1f))
+        val corners = navigationCapsuleCorners(48f, 20f, 100f, 8f)
+        assertTrue(corners.topLeft + corners.bottomLeft <= 48f)
+        assertEquals(0f, corners.bottomRight)
+    }
+}
