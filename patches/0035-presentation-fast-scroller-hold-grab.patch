+
+/** Hit width. The drawn thumb stays [ThumbThickness]; the remainder lies toward the content. */
+private val ThumbTouchWidth = 32.dp
+
+/**
+ * Drawn thumb stays [ThumbThickness] by [ThumbLength]. The hit rectangle is at least
+ * [ThumbTouchWidth] wide and the extra space is on the start side, toward the content.
+ * [endInset] keeps whatever gap the caller already had between the thumb and the end edge.
+ *
+ * Pointer modifiers are omitted unless [touchEnabled]. An invisible thumb must not sit
+ * on top of the content and take its clicks or scrolls. [touchEnabled] stays true for the
+ * whole press and drag, so a fade to 0 cannot detach the gesture mid-pointer.
+ */
+@Composable
+private fun HarmonyScrollerThumb(
+    offsetY: Float,
+    alpha: Float,
+    thumbColor: Color,
+    endInset: Dp,
+    touchEnabled: Boolean,
+    pressState: ThumbPressedState,
+    interactionSource: MutableInteractionSource,
+    onDragDelta: (Float) -> Unit,
+    excludeSystemGestures: Boolean,
+) {
+    val dragState = rememberDraggableState(onDragDelta)
+    Box(
+        modifier = Modifier
+            .offset { IntOffset(0, offsetY.roundToInt()) }
+            .harmonyThumbTouch(
+                enabled = touchEnabled,
+                pressState = pressState,
+                interactionSource = interactionSource,
+                state = dragState,
+                excludeSystemGestures = excludeSystemGestures,
+            )
+            .height(ThumbLength)
+            .width(ThumbTouchWidth + endInset)
+            .padding(end = endInset),
+        contentAlignment = Alignment.CenterEnd,
+    ) {
+        Box(
+            modifier = Modifier
+                .width(ThumbThickness)
+                .height(ThumbLength)
+                .alpha(alpha)
+                .background(color = thumbColor, shape = ThumbShape),
+        )
+    }
+}
+
+@Composable
+private fun rememberThumbPressed(): ThumbPressedState = remember { ThumbPressedState() }
+
+private class ThumbPressedState {
+    var pressed by mutableStateOf(false)
+}
+
+/**
+ * Records a finger that is down on the thumb without waiting for touch slop.
+ *
+ * Overlapping siblings are all hit-tested. The scroller is placed after the content, so
+ * this node is dispatched first, but the content is still in the hit path. [draggable]
+ * with `startDragImmediately` consumes the down in the initial pass and then consumes
+ * moves, which is what stops the content scroller from taking the same pointer. This
+ * tracker also consumes the down (not the moves) so a tap under the thumb cannot fire
+ * if the drag modifier is ever ordered after the content in that pass.
+ *
+ * [waitForUpOrCancellation] is not used. It treats a consumed move as a cancel, and the
+ * draggable consumes every move while `startDragImmediately` is set, which would clear
+ * [ThumbPressedState.pressed] while the finger is still down and let the thumb fade out.
+ */
+private fun Modifier.harmonyThumbTouch(
+    enabled: Boolean,
+    pressState: ThumbPressedState,
+    interactionSource: MutableInteractionSource,
+    state: DraggableState,
+    excludeSystemGestures: Boolean,
+): Modifier {
+    if (!enabled) return this
+    return this
+        .pointerInput(pressState) {
+            awaitEachGesture {
+                val down = awaitFirstDown(
+                    requireUnconsumed = false,
+                    pass = PointerEventPass.Initial,
+                )
+                pressState.pressed = true
+                down.consume()
+                try {
+                    while (awaitPointerEvent().changes.fastAny { it.pressed }) {
+                        // Consumption by draggable is expected. Only a real up ends the press.
+                    }
+                } finally {
+                    pressState.pressed = false
+                }
+            }
+        }
+        .draggable(
+            state = state,
+            orientation = Orientation.Vertical,
+            interactionSource = interactionSource,
+            startDragImmediately = true,
+        )
+        .then(
+            if (excludeSystemGestures) {
+                Modifier.systemGestureExclusion()
+            } else {
+                Modifier
+            },
+        )
+}
+
+/**
+ * Runs the upstream fade, but never while the thumb is pressed or dragging.
+ *
+ * The hit target is removed at alpha 0. A finger that is held still does not emit
+ * [scrolled][kotlinx.coroutines.flow.MutableSharedFlow], so the visibility timer would
+ * otherwise detach [harmonyThumbTouch] and the same pointer would scroll the content
+ * backwards. After release, [fade] runs from the start (its own delay included).
+ */
+private suspend fun Animatable<Float, AnimationVector1D>.holdOpaqueWhileThumbGrabbed(
+    held: () -> Boolean,
+    thumbAllowed: () -> Boolean,
+    fade: suspend Animatable<Float, AnimationVector1D>.() -> Unit,
+) {
+    if (!thumbAllowed()) {
+        if (held()) {
+            snapTo(1f)
+            awaitThumbNotHeld(held)
+        }
+        if (!held()) {
+            animateTo(0f, animationSpec = ImmediateFadeOutAnimationSpec)
+        }
+        return
+    }
+    snapTo(1f)
+    while (true) {
+        awaitThumbNotHeld(held)
+        if (fadeUnlessThumbGrabbed(held, fade)) return
+        snapTo(1f)
+    }
+}
+
+private suspend fun awaitThumbNotHeld(held: () -> Boolean) {
+    if (held()) {
+        snapshotFlow { held() }.first { !it }
+    }
+}
+
+/** @return true when [fade] finished, false when the thumb was grabbed and the fade was cancelled. */
+private suspend fun Animatable<Float, AnimationVector1D>.fadeUnlessThumbGrabbed(
+    held: () -> Boolean,
+    fade: suspend Animatable<Float, AnimationVector1D>.() -> Unit,
+): Boolean {
+    return coroutineScope {
+        val fadeFinished = CompletableDeferred<Boolean>()
+        val animation = launch {
+            this@fadeUnlessThumbGrabbed.fade()
+            fadeFinished.complete(true)
+        }
+        val grab = launch {
+            snapshotFlow { held() }.first { it }
+            fadeFinished.complete(false)
+        }
+        try {
+            fadeFinished.await()
+        } finally {
+            animation.cancel()
+            grab.cancel()
+        }
+    }
+}
