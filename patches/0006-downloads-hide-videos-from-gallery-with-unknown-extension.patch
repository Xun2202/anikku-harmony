+    // Harmony -->
+    /**
+     * Renames every downloaded video so it matches [DownloadPreferences.hideDownloadedVideosFromGallery]:
+     * adds [Downloader.HIDDEN_VIDEO_SUFFIX] to recognised video files, or strips it again.
+     * Directory names are untouched, so the download cache stays valid.
+     *
+     * @return the number of files that were renamed.
+     */
+    suspend fun applyGalleryVisibilityToDownloads(): Int {
+        val hide = downloadPreferences.hideDownloadedVideosFromGallery().get()
+        val suffix = Downloader.HIDDEN_VIDEO_SUFFIX
+        var renamed = 0
+        val sourceDirs = storageManager.getDownloadsDirectory()?.listFiles().orEmpty().filter { it.isDirectory }
+        for (sourceDir in sourceDirs) {
+            for (mangaDir in sourceDir.listFiles().orEmpty().filter { it.isDirectory }) {
+                for (chapterDir in mangaDir.listFiles().orEmpty().filter { it.isDirectory }) {
+                    if (chapterDir.name.orEmpty().endsWith(Downloader.TMP_DIR_SUFFIX)) continue
+                    for (file in chapterDir.listFiles().orEmpty().filter { it.isFile }) {
+                        val name = file.name ?: continue
+                        val newName = when {
+                            hide && !name.endsWith(suffix) && "video" in file.type.orEmpty() -> name + suffix
+                            !hide && name.endsWith(suffix) -> name.removeSuffix(suffix)
+                            else -> continue
+                        }
+                        try {
+                            file.renameToOrCopy(newName)
+                            renamed++
+                        } catch (e: Exception) {
+                            logcat(LogPriority.ERROR, e) { "Could not rename downloaded video $name" }
+                        }
+                    }
+                }
+            }
+        }
+        return renamed
+    }
+    // Harmony <--
