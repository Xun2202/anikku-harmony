+package tachiyomi.presentation.core.components.material
+
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class NavigationChromeScrollTrackerTest {
+    @Test
+    fun `browse forward hides and a short reverse drag reveals navigation`() {
+        val state = NavigationChromeScrollTracker(24f, 8f)
+        assertTrue(state.onScroll(-12f, 0f, true))
+        assertFalse(state.onScroll(-12f, 0f, true))
+        assertFalse(state.onScroll(4f, 0f, true))
+        assertTrue(state.onScroll(4f, 0f, true))
+    }
+
+    @Test
+    fun `flings horizontal gestures and unscrollable content do not hide navigation`() {
+        val state = NavigationChromeScrollTracker(24f, 8f)
+        assertTrue(state.onScroll(-100f, 0f, false))
+        assertTrue(state.onScroll(0f, 0f, true))
+        assertTrue(state.onScroll(0f, -100f, true))
+    }
+
+    @Test
+    fun `direction changes reset travel and reaching the top restores navigation`() {
+        val state = NavigationChromeScrollTracker(24f, 8f)
+        assertTrue(state.onScroll(-20f, 0f, true))
+        assertTrue(state.onScroll(2f, 0f, true))
+        assertTrue(state.onScroll(-10f, 0f, true))
+        assertFalse(state.onScroll(-14f, 0f, true))
+        assertTrue(state.onScroll(0f, 1f, true))
+    }
+
+    @Test
+    fun `changing tabs or entering an action mode can restore navigation`() {
+        val state = NavigationChromeScrollTracker(24f, 8f)
+        assertFalse(state.onScroll(-30f, 0f, true))
+        state.reset()
+        assertTrue(state.visible)
+        assertTrue(state.onScroll(-10f, 0f, true))
+    }
+}
