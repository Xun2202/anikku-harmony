@@ -0,0 +1,33 @@
+package tachiyomi.presentation.core.components.material
+
+/** Direction hysteresis for navigation chrome; flings and unconsumed end overscroll never hide it. */
+internal class NavigationChromeScrollTracker(
+    private val hideDistance: Float,
+    private val showDistance: Float,
+) {
+    var visible: Boolean = true
+        private set
+    private var travel = 0f
+
+    fun reset() {
+        visible = true
+        travel = 0f
+    }
+
+    fun onScroll(consumedY: Float, availableY: Float, userInput: Boolean): Boolean {
+        if (!userInput) return visible
+        if (consumedY == 0f) {
+            if (availableY > 0f) reset()
+            return visible
+        }
+        if (travel * consumedY < 0f) travel = 0f
+        travel += consumedY
+        if (visible && travel <= -hideDistance) {
+            visible = false
+            travel = 0f
+        } else if (!visible && travel >= showDistance) {
+            reset()
+        }
+        return visible
+    }
+}
