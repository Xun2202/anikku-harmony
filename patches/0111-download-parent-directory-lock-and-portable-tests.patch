+    /** Minimal HTTP/1.1 fixture using only APIs present in Android's unit-test bootclasspath. */
+    private class LoopbackHttpServer : Closeable {
+        private val listener = ServerSocket(0, 8, InetAddress.getByName("127.0.0.1"))
+        private val executor = Executors.newFixedThreadPool(4)
+        private val sockets = ConcurrentHashMap.newKeySet<Socket>()
+        private val closed = AtomicBoolean()
+        val failures = ConcurrentLinkedQueue<Throwable>()
+        val port: Int get() = listener.localPort
+        lateinit var handler: (String) -> ByteArray
+        private val acceptor = Thread {
+            while (!closed.get()) {
+                try {
+                    val socket = listener.accept()
+                    socket.soTimeout = 4000
+                    sockets.add(socket)
+                    executor.execute {
+                        try {
+                            socket.use {
+                                val reader = it.getInputStream().bufferedReader(Charsets.US_ASCII)
+                                val request = reader.readLine() ?: error("Missing HTTP request")
+                                var lines = 0
+                                while (true) {
+                                    val line = reader.readLine() ?: error("Incomplete HTTP headers")
+                                    if (line.isEmpty()) break
+                                    check(++lines <= 100)
+                                }
+                                val body = handler(request.split(' ')[1])
+                                val header = "HTTP/1.1 200 OK\r\nContent-Length: ${body.size}\r\nConnection: close\r\n\r\n"
+                                it.getOutputStream().use { output ->
+                                    output.write(header.toByteArray(Charsets.US_ASCII))
+                                    output.write(body)
+                                    output.flush()
+                                }
+                            }
+                        } catch (error: Exception) {
+                            if (!closed.get()) failures.add(error)
+                        } finally {
+                            sockets.remove(socket)
+                        }
+                    }
+                } catch (error: SocketException) {
+                    if (!closed.get()) failures.add(error)
+                    break
+                }
+            }
+        }.apply {
+            name = "queue-hls-loopback-test"
+            isDaemon = true
+        }
+
+        fun start() = acceptor.start()
+
+        override fun close() {
+            closed.set(true)
+            listener.close()
+            sockets.forEach { runCatching { it.close() } }
+            acceptor.join(3000)
+            executor.shutdownNow()
+            executor.awaitTermination(3, TimeUnit.SECONDS)
+        }
+    }
+
