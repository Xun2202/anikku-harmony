+    @Test
+    fun `concurrent directory setup shares one source and manga directory`() {
+        val root = mockk<UniFile>()
+        val sourceDirectory = mockk<UniFile>()
+        val mangaDirectory = mockk<UniFile>()
+        val storage = mockk<StorageManager> {
+            every { getDownloadsDirectory() } returns root
+        }
+        val provider = DownloadProvider(mockk<Context>(), storage, mockk<LocalSourceFileSystem>())
+        val source = source(1, "Any source")
+        every { source.toString() } returns "Any source"
+        val firstInsideCreate = CountDownLatch(1)
+        val releaseCreate = CountDownLatch(1)
+        val secondCalling = CountDownLatch(1)
+        val duplicateCreate = CountDownLatch(1)
+        val sourceExists = AtomicBoolean()
+        val mangaExists = AtomicBoolean()
+        val sourceCreates = AtomicInteger()
+        val mangaCreates = AtomicInteger()
+        // Model UniFile's unsynchronized find-then-create window, without Android SAF.
+        every { root.createDirectory("Any source") } answers {
+            if (!sourceExists.get()) {
+                val count = sourceCreates.incrementAndGet()
+                if (count == 1) {
+                    firstInsideCreate.countDown()
+                    check(releaseCreate.await(5, TimeUnit.SECONDS))
+                } else {
+                    duplicateCreate.countDown()
+                }
+                sourceExists.set(true)
+            }
+            sourceDirectory
+        }
+        every { sourceDirectory.createDirectory("Same title") } answers {
+            if (!mangaExists.get()) {
+                mangaCreates.incrementAndGet()
+                mangaExists.set(true)
+            }
+            mangaDirectory
+        }
+        val executor = Executors.newFixedThreadPool(2)
+        try {
+            val first = executor.submit<UniFile> { provider.getMangaDir("Same title", source).getOrThrow() }
+            assertTrue(firstInsideCreate.await(3, TimeUnit.SECONDS))
+            val second = executor.submit<UniFile> {
+                secondCalling.countDown()
+                provider.getMangaDir("Same title", source).getOrThrow()
+            }
+            assertTrue(secondCalling.await(3, TimeUnit.SECONDS))
+            assertFalse(duplicateCreate.await(150, TimeUnit.MILLISECONDS))
+            assertFalse(second.isDone)
+            releaseCreate.countDown()
+            assertSame(mangaDirectory, first.get(3, TimeUnit.SECONDS))
+            assertSame(mangaDirectory, second.get(3, TimeUnit.SECONDS))
+            assertEquals(1, sourceCreates.get())
+            assertEquals(1, mangaCreates.get())
+        } finally {
+            releaseCreate.countDown()
+            executor.shutdownNow()
+            executor.awaitTermination(3, TimeUnit.SECONDS)
+        }
+    }
