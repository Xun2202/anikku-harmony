+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.foundation.pager.PagerState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.Stable
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.snapshotFlow
+import androidx.compose.runtime.staticCompositionLocalOf
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlin.math.abs
+
+private val LocalBrowsingPagerPage = staticCompositionLocalOf<BrowsingPagerPageScope?> { null }
+
+/** Let a page's edge reveal the shared controls in proportion to its visible width. */
+@Composable
+fun BrowsingPagerPage(state: PagerState, page: Int, content: @Composable () -> Unit) {
+    val scope = remember(state, page) { BrowsingPagerPageScope(state, page) }
+    CompositionLocalProvider(LocalBrowsingPagerPage provides scope, content = content)
+}
+
+@Stable
+internal class BrowsingPagerPageScope(private val state: PagerState, private val page: Int) {
+    val weight: Float get() = (1f - abs(state.currentPage + state.currentPageOffsetFraction - page)).coerceIn(0f, 1f)
+    val isSettled: Boolean
+        get() = !state.isScrollInProgress && state.currentPage == page && state.currentPageOffsetFraction == 0f
+}
+
+@Stable
+internal class BrowsingPagerViewport(
+    private val page: BrowsingPagerPageScope,
+    val leadingOffset: () -> Float,
+    val trailingRemaining: () -> Float,
+) {
+    val isSettled: Boolean get() = page.isSettled
+
+    fun hiddenFraction(headerHeight: Float, bottomHeight: Float): Float {
+        val weight = page.weight
+        // Do not read unmeasured/offscreen geometry or let prefetch change visibility.
+        if (weight <= 0f) return 1f
+        val edge = browsingTrailingHiddenFraction(
+            browsingLeadingHiddenFraction(1f, leadingOffset(), headerHeight),
+            trailingRemaining(),
+            bottomHeight,
+        )
+        return 1f - (1f - edge) * weight
+    }
+}
+
+@Composable
+internal fun rememberBrowsingPagerViewport(
+    chrome: BrowsingNavigationBarState,
+    leadingOffset: () -> Float,
+    trailingRemaining: () -> Float,
+): BrowsingPagerViewport? {
+    val page = LocalBrowsingPagerPage.current ?: return null
+    val viewport = remember(page, leadingOffset, trailingRemaining) {
+        BrowsingPagerViewport(page, leadingOffset, trailingRemaining)
+    }
+    DisposableEffect(chrome, viewport) {
+        chrome.pagerViewports.add(viewport)
+        onDispose { chrome.pagerViewports.remove(viewport) }
+    }
+    LaunchedEffect(chrome, viewport) {
+        snapshotFlow { viewport.isSettled }.distinctUntilChanged().collect { settled ->
+            if (settled) {
+                chrome.leadingOffset = leadingOffset
+                chrome.trailingRemaining = trailingRemaining
+            }
+        }
+    }
+    return viewport
+}
