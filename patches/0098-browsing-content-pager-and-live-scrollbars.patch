+import androidx.compose.ui.unit.dp
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import tachiyomi.presentation.core.components.FastScrollLazyColumn
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeContentViewportTest {
+    @Test
+    fun `reveal moves viewed content with controls without changing lazy geometry or scroll position`() = runComposeUiTest {
+        val hidden = mutableFloatStateOf(1f)
+        lateinit var list: LazyListState
+        var originY = 0f
+        lateinit var cover: LayoutCoordinates
+        var viewportHeight = 0
+        setContent {
+            CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                val chrome = remember {
+                    BrowsingNavigationBarState(enabled = { true }).apply {
+                        headerHeightPx = 100f
+                        animation = hidden
+                    }
+                }
+                list = remember { LazyListState(20) }
+                CompositionLocalProvider(LocalBrowsingChrome provides BrowsingTopAppBarScrollBehavior(androidx.compose.material3.TopAppBarDefaults.pinnedScrollBehavior(), chrome)) {
+                    FastScrollLazyColumn(
+                        modifier = Modifier.requiredSize(400.dp, 600.dp),
+                        state = list,
+                        contentPadding = PaddingValues(top = 100.dp, bottom = 40.dp),
+                    ) {
+                        items(100) { index ->
+                            Box(
+                                Modifier.fillMaxWidth().height(60.dp).onGloballyPositioned {
+                                    if (index == 20) {
+                                        cover = it
+                                        viewportHeight = list.layoutInfo.viewportSize.height
+                                    }
+                                },
+                            )
+                        }
+                    }
+                }
+            }
+        }
+        runOnIdle {
+            originY = cover.positionInRoot().y
+            hidden.floatValue = 0.5f
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(originY + 50f, cover.positionInRoot().y, 0.5f)
+            assertEquals(20, list.firstVisibleItemIndex)
+            assertEquals(0, list.firstVisibleItemScrollOffset)
+            assertEquals(600, viewportHeight)
+            hidden.floatValue = 0f
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(originY + 100f, cover.positionInRoot().y, 0.5f)
+            assertEquals(20, list.firstVisibleItemIndex)
+            hidden.floatValue = 1f
+        }
+        waitForIdle()
+        runOnIdle { assertEquals(originY, cover.positionInRoot().y, 0.5f) }
+    }
+
+    @Test
+    fun `edge spacers are not duplicated and trailing content remains reachable`() {
+        assertEquals(0f, browsingContentProtectionOffset(100f, 0f, 0f, Float.POSITIVE_INFINITY))
+        assertEquals(20f, browsingContentProtectionOffset(100f, 0f, 20f, Float.POSITIVE_INFINITY))
+        assertEquals(50f, browsingContentProtectionOffset(100f, 0.5f, Float.POSITIVE_INFINITY, Float.POSITIVE_INFINITY))
+        assertEquals(0f, browsingContentProtectionOffset(100f, 1f, Float.POSITIVE_INFINITY, Float.POSITIVE_INFINITY))
+        assertEquals(15f, browsingContentProtectionOffset(100f, 0f, Float.POSITIVE_INFINITY, 15f))
+        assertEquals(0f, browsingContentProtectionOffset(100f, 0f, Float.POSITIVE_INFINITY, 0f))
+    }
+
+    @Test
+    fun `compact status trim keeps cutout and never creates negative insets`() {
+        assertEquals(22, compactToolbarStatusInset(24, 0, 2))
+        assertEquals(24, compactToolbarStatusInset(24, 24, 2))
+        assertEquals(0, compactToolbarStatusInset(0, 0, 2))
+    }
+}
