+import androidx.compose.foundation.layout.requiredSize
+import androidx.compose.foundation.lazy.LazyListState
+import androidx.compose.foundation.pager.HorizontalPager
+import androidx.compose.foundation.pager.PagerState
+import androidx.compose.foundation.pager.rememberPagerState
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.input.nestedscroll.NestedScrollSource
+import androidx.compose.ui.layout.onGloballyPositioned
+import androidx.compose.ui.layout.positionInRoot
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performTouchInput
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.dp
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import tachiyomi.presentation.core.components.FastScrollLazyColumn
+import tachiyomi.presentation.core.components.rememberFrameTimeProtectedPagerFlingBehavior
+import kotlin.math.abs
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromePagerTransitionTest {
+    @Test
+    fun `incoming top reveals both bars during held drag and cancellation restores hidden old page`() =
+        assertPagerTransition(incomingAtTop = true)
+
+    @Test
+    fun `incoming deep page does not force chrome open during held drag or cancellation`() =
+        assertPagerTransition(incomingAtTop = false)
+
+    private fun assertPagerTransition(incomingAtTop: Boolean) = runComposeUiTest {
+        lateinit var chrome: BrowsingNavigationBarState
+        lateinit var pager: PagerState
+        lateinit var lists: List<LazyListState>
+        var headerY = 0f
+        var bottomY = 0f
+        setContent {
+            CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                chrome = rememberBrowsingNavigationBarState(enabled = true, resetKey = Unit)
+                pager = rememberPagerState { 3 }
+                lists = remember { listOf(LazyListState(20), LazyListState(if (incomingAtTop) 0 else 20), LazyListState()) }
+                CompositionLocalProvider(LocalBrowsingNavigationBarState provides chrome) {
+                    Scaffold(
+                        modifier = Modifier.requiredSize(400.dp, 600.dp),
+                        topBarScrollBehavior = rememberBrowsingTopAppBarScrollBehavior(),
+                        contentWindowInsets = WindowInsets(0),
+                        topBar = {
+                            Box(Modifier.fillMaxWidth().height(100.dp).onGloballyPositioned { headerY = it.positionInRoot().y })
+                        },
+                        bottomBar = {
+                            BrowsingChromeOverlay(chrome, atBottom = true) {
+                                Box(Modifier.fillMaxWidth().height(40.dp).onGloballyPositioned { bottomY = it.positionInRoot().y })
+                            }
+                        },
+                    ) { padding ->
+                        HorizontalPager(
+                            state = pager,
+                            beyondViewportPageCount = 1,
+                            flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(pager),
+                            modifier = Modifier.fillMaxSize().testTag("pager"),
+                        ) { page ->
+                            BrowsingPagerPage(pager, page) {
+                                FastScrollLazyColumn(state = lists[page], contentPadding = padding, modifier = Modifier.fillMaxSize()) {
+                                    items(100) { Box(Modifier.fillMaxWidth().height(60.dp)) }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        runOnIdle { chrome.nestedScrollConnection.onPostScroll(Offset(0f, -40f), Offset.Zero, NestedScrollSource.UserInput) }
+        waitForIdle()
+        runOnIdle {
+            assertFalse(chrome.visible)
+            assertEquals(1f, chrome.hiddenFraction, 0.01f, "An offscreen top page must not reveal chrome")
+        }
+        onNodeWithTag("pager").performTouchInput {
+            down(Offset(360f, 300f))
+            repeat(4) { moveBy(Offset(-70f, 0f), delayMillis = 30) }
+        }
+        waitForIdle()
+        runOnIdle {
+            val progress = pager.currentPage + pager.currentPageOffsetFraction
+            assertTrue(progress in 0.5f..0.9f, "The finger must remain down beyond the halfway point: $progress")
+            assertTrue(pager.isScrollInProgress)
+            assertEquals(0, pager.settledPage, "Persistence must keep the old category until settling")
+            assertFalse(chrome.visible, "A partial incoming edge must not overwrite the old hidden target")
+            val expected = if (incomingAtTop) 1f - progress else 1f
+            assertEquals(expected, chrome.hiddenFraction, 0.02f)
+            assertEquals(-100f * expected, headerY, 1.5f)
+            assertEquals(560f + 40f * expected, bottomY, 1.5f)
+            assertTrue(abs(headerY) > 1f, "Held paging must interpolate rather than snap the header")
+        }
+        onNodeWithTag("pager").performTouchInput {
+            repeat(4) { moveBy(Offset(58f, 0f), delayMillis = 40) }
+            advanceEventTime(200)
+            up()
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(0, pager.settledPage)
+            assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+            assertFalse(chrome.visible)
+            assertEquals(1f, chrome.hiddenFraction, 0.01f, "Cancelling must restore the old hidden chrome")
+            assertEquals(20, lists[0].firstVisibleItemIndex)
+        }
+        onNodeWithTag("pager").performTouchInput {
+            down(Offset(360f, 300f))
+            repeat(4) { moveBy(Offset(-78f, 0f), delayMillis = 40) }
+            advanceEventTime(200)
+            up()
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(1, pager.settledPage)
+            assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+            assertEquals(incomingAtTop, chrome.visible)
+            assertEquals(if (incomingAtTop) 0f else 1f, chrome.hiddenFraction, 0.01f)
+            assertEquals(if (incomingAtTop) 0 else 20, lists[1].firstVisibleItemIndex)
+            assertEquals(20, lists[0].firstVisibleItemIndex)
+        }
+    }
+}
