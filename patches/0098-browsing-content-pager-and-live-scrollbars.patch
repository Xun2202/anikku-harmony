+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.lazy.LazyListState
+import androidx.compose.foundation.lazy.grid.LazyGridState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.dp
+import kotlin.math.ceil
+
+/** Description/header height alone must not enable a chapter fast scroller on a short detail page. */
+@Composable
+fun rememberChapterScrollbarAllowed(state: LazyListState, chapterCount: Int): () -> Boolean {
+    val count = rememberUpdatedState(chapterCount)
+    val density = LocalDensity.current
+    val rowHeight = with(density) { 56.dp.toPx() } * density.fontScale.coerceAtLeast(1f)
+    return remember(state, rowHeight) {
+        { chapterScrollbarUseful(count.value, 1, state.layoutInfo.viewportSize.height, rowHeight) }
+    }
+}
+
+@Composable
+fun rememberChapterScrollbarAllowed(state: LazyGridState, chapterCount: Int, columns: Int): () -> Boolean {
+    val count = rememberUpdatedState(chapterCount)
+    val requestedColumns = rememberUpdatedState(columns)
+    val density = LocalDensity.current
+    val rowHeight = with(density) { 56.dp.toPx() } * density.fontScale.coerceAtLeast(1f)
+    val adaptiveWidth = with(density) { 128.dp.toPx() }
+    return remember(state, rowHeight, adaptiveWidth) {
+        {
+            val viewport = state.layoutInfo.viewportSize
+            val fittedColumns = requestedColumns.value.takeIf { it > 0 }
+                ?: (viewport.width / adaptiveWidth).toInt().coerceAtLeast(1)
+            chapterScrollbarUseful(count.value, fittedColumns, viewport.height, rowHeight)
+        }
+    }
+}
+
+internal fun chapterScrollbarUseful(count: Int, columns: Int, viewportHeight: Int, minimumRowHeight: Float): Boolean =
+    viewportHeight > 0 && ceil(count.toDouble() / columns.coerceAtLeast(1)) * minimumRowHeight > viewportHeight * 2.0
