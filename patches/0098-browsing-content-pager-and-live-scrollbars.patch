+package tachiyomi.presentation.core.components
+
+import androidx.compose.runtime.mutableFloatStateOf
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.runComposeUiTest
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeFastScrollerProgressTest {
+    @Test
+    fun `append correction is continuous while real scrolling stays immediate`() = runComposeUiTest {
+        val progress = mutableFloatStateOf(0.6f)
+        val count = mutableIntStateOf(100)
+        var rendered = 0f
+        setContent { rendered = rememberFastScrollerProgress(progress.floatValue, count.intValue, false, true) }
+        mainClock.autoAdvance = false
+        runOnIdle {
+            count.intValue = 200
+            progress.floatValue = 0.3f
+        }
+        mainClock.advanceTimeByFrame()
+        runOnIdle { assertEquals(0.6f, rendered, 0.01f) }
+        mainClock.advanceTimeBy(80)
+        var before = 0f
+        runOnIdle {
+            assertTrue(rendered in 0.31f..0.59f)
+            before = rendered
+            progress.floatValue += 0.05f
+        }
+        mainClock.advanceTimeByFrame()
+        runOnIdle { assertTrue(rendered > before, "actual scroll must not wait for the append animation") }
+        mainClock.advanceTimeBy(300)
+        runOnIdle { assertEquals(0.35f, rendered, 0.001f) }
+    }
+
+    @Test
+    fun `drag travel freezes only input conversion while held and refreshes after release`() = runComposeUiTest {
+        val travel = mutableFloatStateOf(500f)
+        val held = mutableStateOf(false)
+        var conversion = 0f
+        setContent { conversion = rememberFastScrollerDragTravel(travel.floatValue, held.value) }
+        runOnIdle {
+            assertEquals(500f, conversion)
+            held.value = true
+        }
+        waitForIdle()
+        runOnIdle { travel.floatValue = 400f }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(500f, conversion)
+            held.value = false
+        }
+        waitForIdle()
+        runOnIdle { assertEquals(400f, conversion) }
+    }
+
+    @Test
+    fun `short chapter details stay quiet and useful range follows viewport and actual columns`() {
+        assertFalse(chapterScrollbarUseful(10, 1, 600, 56f))
+        assertFalse(chapterScrollbarUseful(30, 2, 600, 56f))
+        assertTrue(chapterScrollbarUseful(30, 1, 600, 56f))
+        assertFalse(chapterScrollbarUseful(30, 1, 1000, 56f))
+        assertTrue(chapterScrollbarUseful(300, 3, 1000, 56f))
+        assertFalse(chapterScrollbarUseful(300, 1, 0, 56f))
+    }
+}
