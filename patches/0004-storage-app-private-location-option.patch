+    // Harmony -->
+    /**
+     * One-tap alternative to the folder picker: store everything in the app-specific external
+     * directory, which bypasses the Storage Access Framework (broken for ffmpeg output and
+     * renameDocument on HarmonyOS ZhuoyiTong) and is never indexed by gallery apps.
+     */
+    @Composable
+    private fun getAppPrivateStoragePref(
+        storagePreferences: StoragePreferences,
+    ): Preference.PreferenceItem.TextPreference {
+        val context = LocalContext.current
+        val storagePref = storagePreferences.baseStorageDirectory()
+        val storageDir by storagePref.collectAsState()
+        val privateDir = remember { appPrivateStorageDirectory(context) }
+        val isActive = remember(storageDir) { isAppPrivateStorage(context, storageDir) }
+
+        return Preference.PreferenceItem.TextPreference(
+            title = stringResource(AMR.strings.pref_storage_use_app_private),
+            subtitle = if (isActive) {
+                stringResource(AMR.strings.pref_storage_use_app_private_active)
+            } else {
+                stringResource(AMR.strings.pref_storage_use_app_private_summary, privateDir.absolutePath)
+            },
+            enabled = !isActive,
+            onClick = { useAppPrivateStorage(context, storagePref) },
+        )
+    }
+    // Harmony <--
+
     @Composable
     private fun getBackupAndRestoreGroup(backupPreferences: BackupPreferences): Preference.PreferenceGroup {
