+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.io.path.createTempDirectory
+
+class NavigationChromeDownloadQueueConcurrencyTest {
+    @Test
+    fun `every source name supports two or three videos independently of source slots`() {
+        val sources = listOf(source(1, "MissAV"), source(2, "Any anime source"), source(3, "Other source"))
+        val queue = sources.flatMapIndexed { index, source -> (1..4).map { download(source, index * 10L + it) } }
+        assertEquals(4, DownloadQueueConcurrency.select(queue, 2, 2).size)
+        assertEquals(listOf(2, 2), DownloadQueueConcurrency.select(queue, 2, 2).groupBy { it.source }.values.map { it.size })
+        assertEquals(3, DownloadQueueConcurrency.select(queue, 1, 3).size)
+        assertEquals(9, DownloadQueueConcurrency.select(queue, 3, 3).size)
+        sources.forEach { source ->
+            assertEquals(3, DownloadQueueConcurrency.select(queue.filter { it.source === source }, 1, 3).size)
+        }
+    }
+
+    @Test
+    fun `failed and completed items do not consume source or video slots`() {
+        val failedSource = source(1, "Failed source")
+        val runningSource = source(2, "Ordinary source")
+        val failed = download(failedSource, 1).apply { fail("test failure") }
+        val completed = download(runningSource, 2).apply { status = Download.State.DOWNLOADED }
+        val first = download(runningSource, 3)
+        val second = download(runningSource, 4).apply { status = Download.State.DOWNLOADING }
+        assertEquals(listOf(first, second), DownloadQueueConcurrency.select(listOf(failed, completed, first, second), 1, 2))
+    }
+
+    @Test
+    fun `limits are bounded and selection retains queue order within each source`() {
+        val source = source(1, "Generic source")
+        val queue = (1L..5).map { download(source, it) }
+        assertEquals(queue.take(1), DownloadQueueConcurrency.select(queue, 0, 0))
+        assertEquals(queue.take(3), DownloadQueueConcurrency.select(queue, 99, 99))
+    }
+
+    @Test
+    fun `repeated updates and mutable Video changes never launch an episode twice`() = runBlocking {
+        val owner = SupervisorJob()
+        val scope = CoroutineScope(owner + Dispatchers.IO)
+        val workers = DownloadQueueConcurrency.Workers()
+        val source = source(1, "Unrelated source")
+        val queue = listOf(download(source, 1), download(source, 2))
+        val launches = AtomicInteger()
+        val start: (Download) -> Job = { download ->
+            scope.launch(start = CoroutineStart.UNDISPATCHED) {
+                launches.incrementAndGet()
+                download.status = Download.State.DOWNLOADING
+                awaitCancellation()
+            }
+        }
+        try {
+            workers.update(queue, start)
+            queue.first().video = Video(videoUrl = "http://127.0.0.1/first", videoTitle = "720p")
+            workers.update(queue, start)
+            queue.first().video = Video(videoUrl = "http://127.0.0.1/second", videoTitle = "1080p")
+            workers.update(queue.toList(), start)
+            assertEquals(2, launches.get())
+        } finally {
+            workers.update(emptyList(), start)
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `lowering the limit waits for blocking IO then restores QUEUE before a safe restart`() = runBlocking {
+        val owner = SupervisorJob()
+        val scope = CoroutineScope(owner + Dispatchers.IO)
+        val workers = DownloadQueueConcurrency.Workers()
+        val source = source(1, "Any source")
+        val first = download(source, 1)
+        val second = download(source, 2)
+        val entered = CountDownLatch(1)
+        val restarted = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val launches = AtomicInteger()
+        val writing = AtomicInteger()
+        val maximum = AtomicInteger()
+        lateinit var firstWriter: Job
+        val start: (Download) -> Job = { download ->
+            if (download === first) {
+                scope.launch(start = CoroutineStart.UNDISPATCHED) {
+                    download.status = Download.State.DOWNLOADING
+                    awaitCancellation()
+                }
+            } else {
+                val generation = launches.incrementAndGet()
+                scope.launch {
+                    download.status = Download.State.DOWNLOADING
+                    maximum.accumulateAndGet(writing.incrementAndGet()) { previous, current -> maxOf(previous, current) }
+                    try {
+                        if (generation == 1) {
+                            entered.countDown()
+                            check(release.await(5, TimeUnit.SECONDS))
+                        } else {
+                            restarted.countDown()
+                            awaitCancellation()
+                        }
+                    } finally {
+                        writing.decrementAndGet()
+                    }
+                }.also { if (generation == 1) firstWriter = it }
+            }
+        }
+        try {
+            workers.update(listOf(first, second), start)
+            assertTrue(entered.await(3, TimeUnit.SECONDS))
+            val lowering = launch(Dispatchers.Default) { workers.update(listOf(first), start) }
+            withTimeout(3000) { while (!firstWriter.isCancelled) yield() }
+            assertFalse(lowering.isCompleted)
+            assertEquals(Download.State.DOWNLOADING, second.status)
+            assertEquals(1, launches.get())
+            release.countDown()
+            withTimeout(3000) { lowering.join() }
+            assertEquals(0, writing.get())
+            assertEquals(Download.State.QUEUE, second.status)
+            workers.update(listOf(first, second), start)
+            assertEquals(2, launches.get())
+            assertTrue(restarted.await(3, TimeUnit.SECONDS))
+            assertEquals(1, writing.get())
+            assertEquals(1, maximum.get())
+        } finally {
+            release.countDown()
+            workers.update(emptyList(), start)
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `one failed video is replaced while its surviving sibling keeps the same job`() = runBlocking {
+        val owner = SupervisorJob()
+        val scope = CoroutineScope(owner + Dispatchers.IO)
+        val workers = DownloadQueueConcurrency.Workers()
+        val source = source(1, "Generic source")
+        val queue = (1L..3).map { download(source, it) }
+        val failFirst = CompletableDeferred<Unit>()
+        val failed = CompletableDeferred<Unit>()
+        val counts = ConcurrentHashMap<Long, AtomicInteger>()
+        val jobs = ConcurrentHashMap<Long, Job>()
+        val start: (Download) -> Job = { download ->
+            scope.launch(start = CoroutineStart.UNDISPATCHED) {
+                counts.computeIfAbsent(download.episode.id) { AtomicInteger() }.incrementAndGet()
+                download.status = Download.State.DOWNLOADING
+                if (download === queue.first()) {
+                    failFirst.await()
+                    download.fail("synthetic HTTP failure")
+                    failed.complete(Unit)
+                } else {
+                    awaitCancellation()
+                }
+            }.also { jobs[download.episode.id] = it }
+        }
+        try {
+            workers.update(DownloadQueueConcurrency.select(queue, 1, 2), start)
+            val sibling = jobs.getValue(2)
+            failFirst.complete(Unit)
+            withTimeout(3000) { failed.await() }
+            workers.update(DownloadQueueConcurrency.select(queue, 1, 2), start)
+            assertTrue(sibling.isActive)
+            assertEquals(sibling, jobs.getValue(2))
+            assertEquals(listOf(1, 1, 1), queue.map { counts.getValue(it.episode.id).get() })
+            assertEquals(Download.State.ERROR, queue.first().status)
+        } finally {
+            workers.update(emptyList(), start)
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `different episode IDs targeting the same output are serialized`() {
+        val source = source(1, "Any source")
+        val first = download(source, 1, animeTitle = "Same/title", episodeTitle = "Same/episode")
+        val conflict = download(source, 2, animeTitle = "Same:title", episodeTitle = "Same:episode")
+        val different = download(source, 3)
+        val queue = listOf(first, conflict, different)
+        assertEquals(listOf(first, different), DownloadQueueConcurrency.select(queue, 1, 3))
+        first.status = Download.State.DOWNLOADED
+        assertEquals(listOf(conflict, different), DownloadQueueConcurrency.select(queue, 1, 3))
+    }
+
+    @Test
+    fun `two scheduled downloads concurrently fetch real loopback HLS into separate episode caches`() = runBlocking {
+        val root = createTempDirectory("queue-hls-http-").toFile()
+        val owner = SupervisorJob()
+        val scope = CoroutineScope(owner + Dispatchers.IO)
+        val workers = DownloadQueueConcurrency.Workers()
+        val executor = Executors.newFixedThreadPool(4)
+        val server = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        val activeEpisodes = mutableMapOf<String, Int>()
+        val seenEpisodes = mutableSetOf<String>()
+        val bothEntered = CountDownLatch(2)
+        val overlap = AtomicBoolean()
+        val manifestCalls = AtomicInteger()
+        val segmentCalls = AtomicInteger()
+        val client = OkHttpClient.Builder().callTimeout(5, TimeUnit.SECONDS).build()
+        val prepared = ConcurrentHashMap<Long, DownloadHlsSegments.Prepared>()
+        val failures = ConcurrentHashMap<Long, Throwable>()
+        val jobs = mutableListOf<Job>()
+        val start: (Download) -> Job = { download ->
+            scope.launch {
+                download.status = Download.State.DOWNLOADING
+                try {
+                    val result = DownloadHlsSegments.prepare(
+                        client = client,
+                        sourceName = download.source.name,
+                        url = "http://127.0.0.1:${server.address.port}/m3u8?episode=${download.episode.id}",
+                        headers = headersOf(),
+                        cacheRoot = File(root, "episode-${download.episode.id}"),
+                        onProgress = {},
+                    ) ?: error("Expected supported synthetic HLS")
+                    prepared[download.episode.id] = result
+                    download.status = Download.State.DOWNLOADED
+                } catch (error: Exception) {
+                    failures[download.episode.id] = error
+                    download.fail("Synthetic HTTP integration failed")
+                }
+            }.also(jobs::add)
+        }
+        server.executor = executor
+        server.createContext("/m3u8") { exchange ->
+            manifestCalls.incrementAndGet()
+            val id = exchange.requestURI.rawQuery.substringAfter("episode=")
+            val body = buildString {
+                appendLine("#EXTM3U")
+                repeat(2) { index ->
+                    appendLine("#EXTINF:1.0,")
+                    appendLine("/segment?url=$id-$index")
+                }
+                appendLine("#EXT-X-ENDLIST")
+            }.toByteArray()
+            exchange.use {
+                it.sendResponseHeaders(200, body.size.toLong())
+                it.responseBody.use { output -> output.write(body) }
+            }
+        }
+        server.createContext("/segment") { exchange ->
+            segmentCalls.incrementAndGet()
+            val episode = exchange.requestURI.rawQuery.substringAfter("url=").substringBefore('-')
+            synchronized(activeEpisodes) {
+                activeEpisodes[episode] = activeEpisodes.getOrDefault(episode, 0) + 1
+                if (seenEpisodes.add(episode)) bothEntered.countDown()
+                if (activeEpisodes.size == 2) overlap.set(true)
+            }
+            try {
+                bothEntered.await(3, TimeUnit.SECONDS)
+                exchange.use {
+                    it.sendResponseHeaders(200, TS.size.toLong())
+                    it.responseBody.use { output -> output.write(TS) }
+                }
+            } finally {
+                synchronized(activeEpisodes) {
+                    val remaining = activeEpisodes.getValue(episode) - 1
+                    if (remaining == 0) activeEpisodes.remove(episode) else activeEpisodes[episode] = remaining
+                }
+            }
+        }
+        try {
+            server.start()
+            val source = source(1, "MissAV")
+            val queue = listOf(download(source, 1), download(source, 2))
+            workers.update(DownloadQueueConcurrency.select(queue, 1, 2), start)
+            withTimeout(12_000) { jobs.forEach { it.join() } }
+            assertTrue(failures.isEmpty(), failures.values.joinToString { it.toString() })
+            assertTrue(overlap.get(), "Two episode jobs must fetch segments at the same time")
+            assertEquals(2, manifestCalls.get())
+            assertEquals(4, segmentCalls.get())
+            assertEquals(2, prepared.size)
+            assertNotEquals(prepared.getValue(1).directory, prepared.getValue(2).directory)
+            queue.forEach { download ->
+                val result = prepared.getValue(download.episode.id)
+                assertEquals(Download.State.DOWNLOADED, download.status)
+                assertEquals(2L * TS.size, result.bytes)
+                assertEquals(2000L, result.durationMillis)
+                assertTrue(result.input.readText().startsWith("ffconcat version 1.0"))
+                val files = result.directory.listFiles().orEmpty().filter { it.extension == "ts" }
+                assertEquals(2, files.size)
+                assertTrue(files.all { it.readBytes().contentEquals(TS) })
+            }
+        } finally {
+            workers.update(emptyList(), start)
+            owner.cancelAndJoin()
+            server.stop(0)
+            executor.shutdownNow()
+            executor.awaitTermination(3, TimeUnit.SECONDS)
+            client.dispatcher.executorService.shutdownNow()
+            client.connectionPool.evictAll()
+            root.deleteRecursively()
+        }
+    }
+
+    private fun source(sourceId: Long, sourceName: String): HttpSource = mockk {
+        every { id } returns sourceId
+        every { name } returns sourceName
+    }
+
+    private fun download(
+        source: HttpSource,
+        episodeId: Long,
+        animeTitle: String = "Anime $episodeId",
+        episodeTitle: String = "Episode $episodeId",
+    ): Download {
+        val anime = mockk<Anime> {
+            every { id } returns episodeId
+            every { ogTitle } returns animeTitle
+        }
+        val episode = mockk<Episode> {
+            every { id } returns episodeId
+            every { name } returns episodeTitle
+        }
+        return Download(source, anime, episode).apply { status = Download.State.QUEUE }
+    }
+
+    private companion object {
+        val TS = ByteArray(188 * 4) { if (it % 188 == 0) 0x47 else 0 }
+    }
+}
