+package eu.kanade.tachiyomi.data.download
+
+import eu.kanade.tachiyomi.data.download.model.Download
+import eu.kanade.tachiyomi.util.storage.DiskUtil
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+
+/** Source slots and per-source video slots are separate limits. */
+internal object DownloadQueueConcurrency {
+    fun select(queue: List<Download>, sourceLimit: Int, perSourceLimit: Int): List<Download> = queue
+        .filter { it.status.value <= Download.State.DOWNLOADING.value }
+        .groupBy { it.source }
+        .values
+        .take(sourceLimit.coerceIn(1, 10))
+        .flatMap { downloads ->
+            val count = perSourceLimit.coerceIn(1, 3)
+            // Distinct database episodes can resolve to the same storage/cache filename.
+            downloads.asSequence()
+                .distinctBy { DiskUtil.buildValidFilename(it.anime.ogTitle) to DiskUtil.buildValidFilename(it.episode.name) }
+                .take(count)
+                .toList()
+        }
+
+    /** Reconcile by immutable episode id; a reduced limit pauses excess jobs before replacements. */
+    class Workers {
+        private val jobs = mutableMapOf<Long, Pair<Download, Job>>()
+
+        suspend fun update(active: List<Download>, launch: (Download) -> Job) {
+            val activeIds = active.mapTo(mutableSetOf()) { it.episode.id }
+            val stopped = jobs.filterKeys { it !in activeIds }
+            stopped.forEach { (id, running) ->
+                running.second.cancel()
+                // Blocking HTTP/copy/native cleanup must close before this id can write again.
+                withContext(NonCancellable) { running.second.join() }
+                if (running.first.status == Download.State.DOWNLOADING) running.first.status = Download.State.QUEUE
+                jobs.remove(id)
+            }
+            currentCoroutineContext().ensureActive()
+            active.forEach { download ->
+                if (download.episode.id !in jobs) jobs[download.episode.id] = download to launch(download)
+            }
+        }
+    }
+}
