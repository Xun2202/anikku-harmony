+    @Test
+    fun `append matches a full layout and does not count as a structural change`() {
+        val head = intArrayOf(252, 112, 112, 252)
+        val tail = intArrayOf(112, 252, 112, 112)
+        val all = head + tail
+        val cache = PanoramaMasonryLayoutCache()
+        val first = cache.layout(
+            count = head.size,
+            isFullLine = { false },
+            heightOf = { index, _ -> head[index] },
+            laneWidths = intArrayOf(100, 100),
+            verticalSpacing = 4,
+            horizontalSpacing = 4,
+            rtl = false,
+        )
+        assertFalse(cache.structuralChange)
+        val appended = cache.layout(
+            count = all.size,
+            isFullLine = { false },
+            heightOf = { index, _ -> all[index] },
+            laneWidths = intArrayOf(100, 100),
+            verticalSpacing = 4,
+            horizontalSpacing = 4,
+            rtl = false,
+        )
+        assertFalse(cache.structuralChange)
+        val full = layoutFixed(all, lanes = 2, spacing = 4)
+        assertEquals(full.contentHeight, appended.contentHeight)
+        assertEquals(full.rects.map { it.lane }, appended.rects.map { it.lane })
+        assertEquals(full.rects.map { it.y }, appended.rects.map { it.y })
+        assertEquals(first.rects.map { it.y }, appended.rects.take(head.size).map { it.y })
+    }
+
+    @Test
+    fun `a height change replaces the layout`() {
+        val cache = PanoramaMasonryLayoutCache()
+        cache.layout(
+            count = 2,
+            isFullLine = { false },
+            heightOf = { _, _ -> 100 },
+            laneWidths = intArrayOf(50, 50),
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+            rtl = false,
+        )
+        cache.layout(
+            count = 2,
+            isFullLine = { false },
+            heightOf = { index, _ -> if (index == 0) 180 else 100 },
+            laneWidths = intArrayOf(50, 50),
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+            rtl = false,
+        )
+        assertTrue(cache.structuralChange)
+    }
