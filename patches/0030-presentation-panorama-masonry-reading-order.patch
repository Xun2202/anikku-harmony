+package tachiyomi.presentation.core.components
+
+import kotlin.math.roundToInt
+
+/**
+ * A lane stays eligible when its bottom is within half the incoming item of the shortest lane.
+ * The item is placed in the leftmost eligible lane, so a column that is only slightly shorter
+ * does not steal the next cell and leave a hole on the left.
+ *
+ * Exactly half is still eligible: the item moves only when the recess is more than half.
+ */
+const val PANORAMA_RECESS_FRACTION = 0.5
+
+/**
+ * Cover cell chrome from [eu.kanade.presentation.library.components.MangaCompactGridItem] and
+ * [eu.kanade.presentation.library.components.MangaComfortableGridItem].
+ *
+ * The selectable box pads 4 dp on every edge. The cover is [fillMaxWidth] + [aspectRatio]:
+ * wide (height/width <= 0.75, unknown starts at 9/16) uses 3/2, tall uses 2/3.
+ * Compact draws the title over the cover, so the cell is the padding plus the cover.
+ * Comfortable adds the title block: padding 4 dp and two lines at 18 sp (`minLines` = 2).
+ */
+const val PANORAMA_CELL_PADDING_DP = 4
+const val PANORAMA_TITLE_PADDING_DP = 4
+const val PANORAMA_TITLE_LINE_SP = 18
+const val PANORAMA_TITLE_LINES = 2
+
+enum class PanoramaSpan {
+    SingleLane,
+    FullLine,
+}
+
+class PanoramaMasonryRect(
+    val index: Int,
+    val lane: Int,
+    val x: Int,
+    val y: Int,
+    val width: Int,
+    val height: Int,
+    val fullLine: Boolean,
+)
+
+class PanoramaMasonryLayout(
+    val laneWidths: IntArray,
+    val laneOffsets: IntArray,
+    val verticalSpacing: Int,
+    val horizontalSpacing: Int,
+    val rtl: Boolean,
+    val rects: List<PanoramaMasonryRect>,
+    /** Bottom of each lane after its last item, including the spacing that follows that item. */
+    val laneBottoms: IntArray,
+    /** Max item bottom. Spacing after the last item of a lane is not included. */
+    val contentHeight: Int,
+) {
+    val laneCount: Int
+        get() = laneWidths.size
+
+    val contentWidth: Int
+        get() = contentWidthOf(laneWidths, horizontalSpacing)
+}
+
+class PanoramaAnchor(
+    val index: Int,
+    val key: Any,
+    /** Item top minus the viewport top. Negative when the item is scrolled partly off the top. */
+    val offsetFromViewportTop: Int,
+)
+
+/**
+ * Lane count of [androidx.compose.foundation.lazy.staggeredgrid.StaggeredGridCells.Adaptive].
+ */
+fun staggeredLaneCountAdaptive(availableSize: Int, spacing: Int, minSize: Int): Int {
+    if (minSize <= 0) return 1
+    return maxOf((availableSize + spacing) / (minSize + spacing), 1)
+}
+
+/**
+ * Column widths of [androidx.compose.foundation.lazy.staggeredgrid.StaggeredGridCells.Fixed]
+ * and Adaptive. Remainder pixels go to the first lanes.
+ */
+fun staggeredLaneWidths(availableSize: Int, laneCount: Int, spacing: Int): IntArray {
+    require(laneCount > 0) { "grid with no columns" }
+    val gridSizeWithoutSpacing = availableSize - spacing * (laneCount - 1)
+    val slotSize = gridSizeWithoutSpacing / laneCount
+    val remainingPixels = gridSizeWithoutSpacing % laneCount
+    return IntArray(laneCount) { index ->
+        if (slotSize < 0) {
+            0
+        } else {
+            slotSize + if (index < remainingPixels) 1 else 0
+        }
+    }
+}
+
+fun panoramaReadingLane(bottoms: IntArray, itemHeight: Int): Int {
+    var shortest = bottoms[0]
+    for (index in 1 until bottoms.size) {
+        val bottom = bottoms[index]
+        if (bottom < shortest) shortest = bottom
+    }
+    val limit = shortest.toDouble() + itemHeight * PANORAMA_RECESS_FRACTION
+    for (index in bottoms.indices) {
+        if (bottoms[index].toDouble() <= limit) return index
+    }
+    return 0
+}
+
+/**
+ * @param heightOf item height for the width it would occupy in that lane, or the full content
+ * width when the item is a full line. Cover height depends on the lane width; a one pixel
+ * remainder can change it by a pixel, so the lane is chosen with that lane's own height.
+ */
+fun layoutPanoramaMasonry(
+    count: Int,
+    isFullLine: (Int) -> Boolean,
+    heightOf: (index: Int, widthPx: Int) -> Int,
+    laneWidths: IntArray,
+    verticalSpacing: Int,
+    horizontalSpacing: Int,
+    rtl: Boolean = false,
+): PanoramaMasonryLayout {
+    val laneCount = laneWidths.size
+    require(laneCount > 0)
+    val offsets = laneOffsets(laneWidths, horizontalSpacing, rtl)
+    val contentWidth = contentWidthOf(laneWidths, horizontalSpacing)
+    val bottoms = IntArray(laneCount)
+    val rects = ArrayList<PanoramaMasonryRect>(count)
+    var contentHeight = 0
+    for (index in 0 until count) {
+        val rect = placeItem(
+            index = index,
+            fullLine = isFullLine(index),
+            heightOf = heightOf,
+            laneWidths = laneWidths,
+            offsets = offsets,
+            bottoms = bottoms,
+            contentWidth = contentWidth,
+            verticalSpacing = verticalSpacing,
+        )
+        rects.add(rect)
+        val bottom = rect.y + rect.height
+        if (bottom > contentHeight) contentHeight = bottom
+    }
+    return PanoramaMasonryLayout(
+        laneWidths = laneWidths.copyOf(),
+        laneOffsets = offsets,
+        verticalSpacing = verticalSpacing,
+        horizontalSpacing = horizontalSpacing,
+        rtl = rtl,
+        rects = rects,
+        laneBottoms = bottoms,
+        contentHeight = contentHeight,
+    )
+}
+
+/**
+ * Continues [previous] with items appended after it. Existing rectangles are reused.
+ */
+fun appendPanoramaMasonry(
+    previous: PanoramaMasonryLayout,
+    count: Int,
+    isFullLine: (Int) -> Boolean,
+    heightOf: (index: Int, widthPx: Int) -> Int,
+): PanoramaMasonryLayout {
+    val rects = ArrayList<PanoramaMasonryRect>(count)
+    rects.addAll(previous.rects)
+    val bottoms = previous.laneBottoms.copyOf()
+    var contentHeight = previous.contentHeight
+    val contentWidth = previous.contentWidth
+    for (index in previous.rects.size until count) {
+        val rect = placeItem(
+            index = index,
+            fullLine = isFullLine(index),
+            heightOf = heightOf,
+            laneWidths = previous.laneWidths,
+            offsets = previous.laneOffsets,
+            bottoms = bottoms,
+            contentWidth = contentWidth,
+            verticalSpacing = previous.verticalSpacing,
+        )
+        rects.add(rect)
+        val bottom = rect.y + rect.height
+        if (bottom > contentHeight) contentHeight = bottom
+    }
+    return PanoramaMasonryLayout(
+        laneWidths = previous.laneWidths,
+        laneOffsets = previous.laneOffsets,
+        verticalSpacing = previous.verticalSpacing,
+        horizontalSpacing = previous.horizontalSpacing,
+        rtl = previous.rtl,
+        rects = rects,
+        laneBottoms = bottoms,
+        contentHeight = contentHeight,
+    )
+}
+
+/**
+ * Remembers a layout and appends when only the tail grew. A lane-width change, a height change,
+ * or a shorter list replaces the whole layout and reports [structuralChange].
+ */
+class PanoramaMasonryLayoutCache {
+    private var layout: PanoramaMasonryLayout? = null
+    private var laneWidths: IntArray = IntArray(0)
+    private var verticalSpacing: Int = Int.MIN_VALUE
+    private var horizontalSpacing: Int = Int.MIN_VALUE
+    private var rtl: Boolean = false
+
+    var structuralChange: Boolean = false
+        private set
+
+    fun layout(
+        count: Int,
+        isFullLine: (Int) -> Boolean,
+        heightOf: (index: Int, widthPx: Int) -> Int,
+        laneWidths: IntArray,
+        verticalSpacing: Int,
+        horizontalSpacing: Int,
+        rtl: Boolean,
+    ): PanoramaMasonryLayout {
+        val previous = layout
+        val sameGeometry = previous != null &&
+            verticalSpacing == this.verticalSpacing &&
+            horizontalSpacing == this.horizontalSpacing &&
+            rtl == this.rtl &&
+            this.laneWidths.contentEquals(laneWidths)
+        val reusable = sameGeometry &&
+            count >= previous.rects.size &&
+            prefixUnchanged(previous, isFullLine, heightOf)
+        val result = when {
+            reusable && count == previous.rects.size -> {
+                structuralChange = false
+                previous
+            }
+            reusable -> {
+                structuralChange = false
+                appendPanoramaMasonry(previous, count, isFullLine, heightOf)
+            }
+            else -> {
+                structuralChange = previous != null
+                layoutPanoramaMasonry(
+                    count = count,
+                    isFullLine = isFullLine,
+                    heightOf = heightOf,
+                    laneWidths = laneWidths,
+                    verticalSpacing = verticalSpacing,
+                    horizontalSpacing = horizontalSpacing,
+                    rtl = rtl,
+                )
+            }
+        }
+        this.layout = result
+        this.laneWidths = result.laneWidths
+        this.verticalSpacing = verticalSpacing
+        this.horizontalSpacing = horizontalSpacing
+        this.rtl = rtl
+        return result
+    }
+
+    private fun prefixUnchanged(
+        previous: PanoramaMasonryLayout,
+        isFullLine: (Int) -> Boolean,
+        heightOf: (index: Int, widthPx: Int) -> Int,
+    ): Boolean {
+        for (rect in previous.rects) {
+            if (isFullLine(rect.index) != rect.fullLine) return false
+            if (heightOf(rect.index, rect.width) != rect.height) return false
+        }
+        return true
+    }
+}
+
+/**
+ * First item, in index order, whose bottom is past the viewport top.
+ */
+fun captureViewportAnchor(
+    rects: List<PanoramaMasonryRect>,
+    keys: List<Any>,
+    scroll: Int,
+    topPadding: Int,
+): PanoramaAnchor? {
+    for (rect in rects) {
+        val top = topPadding + rect.y
+        val bottom = top + rect.height
+        if (bottom > scroll) {
+            val key = keys.getOrElse(rect.index) { rect.index }
+            return PanoramaAnchor(
+                index = rect.index,
+                key = key,
+                offsetFromViewportTop = top - scroll,
+            )
+        }
+    }
+    return null
+}
+
+/**
+ * Scroll that puts [anchor] at the same offset from the viewport top after a relayout.
+ * The anchor is found by key, then by index.
+ */
+fun scrollOffsetForAnchor(
+    anchor: PanoramaAnchor,
+    rects: List<PanoramaMasonryRect>,
+    keys: List<Any>,
+    topPadding: Int,
+    maxScroll: Int,
+): Int {
+    if (rects.isEmpty()) return 0
+    var index = -1
+    for (candidate in keys.indices) {
+        if (keys[candidate] == anchor.key) {
+            index = candidate
+            break
+        }
+    }
+    if (index !in rects.indices) {
+        index = anchor.index.coerceIn(0, rects.lastIndex)
+    }
+    val top = topPadding + rects[index].y
+    return (top - anchor.offsetFromViewportTop).coerceIn(0, maxScroll)
+}
+
+/**
+ * Height of a panorama cover cell. [laneWidthPx] is the column width, including the 4 dp
+ * padding on each side of the cover. Wide covers use aspect 3/2, tall covers 2/3.
+ */
+fun panoramaCoverCellHeightPx(
+    laneWidthPx: Int,
+    wide: Boolean,
+    titleBelow: Boolean,
+    cellPaddingPx: Int,
+    titlePaddingPx: Int,
+    titleLineHeightPx: Int,
+    titleLines: Int = PANORAMA_TITLE_LINES,
+): Int {
+    val innerWidth = (laneWidthPx - cellPaddingPx * 2).coerceAtLeast(0)
+    val cover = if (wide) {
+        (innerWidth * 2.0 / 3.0).roundToInt()
+    } else {
+        (innerWidth * 3.0 / 2.0).roundToInt()
+    }
+    var height = cellPaddingPx * 2 + cover
+    if (titleBelow) {
+        height += titlePaddingPx * 2 + titleLineHeightPx * titleLines
+    }
+    return height
+}
+
+private fun placeItem(
+    index: Int,
+    fullLine: Boolean,
+    heightOf: (index: Int, widthPx: Int) -> Int,
+    laneWidths: IntArray,
+    offsets: IntArray,
+    bottoms: IntArray,
+    contentWidth: Int,
+    verticalSpacing: Int,
+): PanoramaMasonryRect {
+    if (fullLine) {
+        var y = bottoms[0]
+        for (lane in 1 until bottoms.size) {
+            if (bottoms[lane] > y) y = bottoms[lane]
+        }
+        val height = heightOf(index, contentWidth).coerceAtLeast(0)
+        val next = y + height + verticalSpacing
+        for (lane in bottoms.indices) {
+            bottoms[lane] = next
+        }
+        return PanoramaMasonryRect(
+            index = index,
+            lane = 0,
+            x = 0,
+            y = y,
+            width = contentWidth,
+            height = height,
+            fullLine = true,
+        )
+    }
+    val (lane, height) = chooseLane(bottoms) { laneIndex ->
+        heightOf(index, laneWidths[laneIndex])
+    }
+    val y = bottoms[lane]
+    bottoms[lane] = y + height + verticalSpacing
+    return PanoramaMasonryRect(
+        index = index,
+        lane = lane,
+        x = offsets[lane],
+        y = y,
+        width = laneWidths[lane],
+        height = height,
+        fullLine = false,
+    )
+}
+
+private fun chooseLane(bottoms: IntArray, heightForLane: (Int) -> Int): Pair<Int, Int> {
+    val probe = heightForLane(0).coerceAtLeast(0)
+    var lane = panoramaReadingLane(bottoms, probe)
+    val atLane = heightForLane(lane).coerceAtLeast(0)
+    if (atLane != probe) {
+        lane = panoramaReadingLane(bottoms, atLane)
+    }
+    return lane to heightForLane(lane).coerceAtLeast(0)
+}
+
+private fun laneOffsets(laneWidths: IntArray, spacing: Int, rtl: Boolean): IntArray {
+    val offsets = IntArray(laneWidths.size)
+    if (!rtl) {
+        var x = 0
+        for (index in laneWidths.indices) {
+            offsets[index] = x
+            x += laneWidths[index]
+            if (index < laneWidths.lastIndex) x += spacing
+        }
+        return offsets
+    }
+    var x = contentWidthOf(laneWidths, spacing)
+    for (index in laneWidths.indices) {
+        x -= laneWidths[index]
+        offsets[index] = x
+        x -= spacing
+    }
+    return offsets
+}
+
+private fun contentWidthOf(laneWidths: IntArray, spacing: Int): Int {
+    if (laneWidths.isEmpty()) return 0
+    var width = 0
+    for (lane in laneWidths) width += lane
+    width += spacing * (laneWidths.size - 1)
+    return width.coerceAtLeast(0)
+}
