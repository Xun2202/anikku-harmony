+    @Test
+    fun `column change keeps the anchor item at the same viewport offset`() {
+        val heights = intArrayOf(252, 112, 112, 252, 112, 252, 112, 112)
+        val before = layoutFixed(heights, lanes = 2, spacing = 4)
+        val keys = List(heights.size) { it }
+        val topPadding = 20
+        // Item 3 (y = 256) sits 15 px above the viewport top.
+        val scroll = topPadding + 256 + 15
+        val anchor = captureViewportAnchor(before.rects, keys, scroll, topPadding)
+        assertEquals(3, anchor!!.index)
+        assertEquals(-15, anchor.offsetFromViewportTop)
+
+        val after = layoutFixed(heights, lanes = 4, spacing = 4)
+        val maxScroll = 10_000
+        val restored = scrollOffsetForAnchor(anchor, after.rects, keys, topPadding, maxScroll)
+        val newTop = topPadding + after.rects[3].y
+        assertEquals(newTop - anchor.offsetFromViewportTop, restored)
+        assertEquals(-15, newTop - restored)
+    }
+
+    @Test
+    fun `anchor follows a key when the item moves to another index`() {
+        val rects = listOf(
+            rect(index = 0, y = 0, height = 100),
