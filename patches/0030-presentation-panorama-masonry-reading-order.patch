+/**
+ * Ratios the panorama grid has committed to drawing. The masonry and the cells both read this,
+ * so a shape that is still waiting for the grid to settle does not change a lane height.
+ * Unknown covers commit as 9/16, which is on the wide side of 0.75.
+ */
+private const val WIDE_COVER_RATIO = 9f / 16f
+
+private val committedRatios = mutableStateMapOf<Long, Float>()
+
+internal fun committedCoverIsWide(mangaId: Long): Boolean {
+    val ratio = committedRatios[mangaId] ?: WIDE_COVER_RATIO
+    return ratio <= RatioSwitchToPanorama
+}
+
+internal fun panoramaCommittedRatio(mangaId: Long, known: Float?, settled: Boolean): Float {
+    val fallback = known ?: WIDE_COVER_RATIO
+    val current = committedRatios[mangaId]
+    if (current == null) {
+        committedRatios[mangaId] = fallback
+        return fallback
+    }
+    if (known == null || known == current) return current
+    val sameBand = (known <= RatioSwitchToPanorama) == (current <= RatioSwitchToPanorama)
+    if (sameBand || settled) {
+        committedRatios[mangaId] = known
+        return known
+    }
+    return current
+}
