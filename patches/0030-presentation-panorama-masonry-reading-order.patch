+/**
+ * Columns for [PanoramaMasonry]. The counts match [androidx.compose.foundation.lazy.staggeredgrid.StaggeredGridCells].
+ */
+@Stable
+sealed interface PanoramaColumns {
+    /** Exactly [count] columns. Remainder pixels go to the first columns. */
+    data class Fixed(val count: Int) : PanoramaColumns
+
+    /** As many columns as fit at [minSize], same formula as StaggeredGridCells.Adaptive. */
+    data class Adaptive(val minSize: Dp) : PanoramaColumns
+}
+
+/**
+ * Height the masonry can resolve without measuring the cell, except [Measure].
+ * Cells are constrained to the resolved height and clipped, so the slot matches what is drawn.
+ */
+@Stable
+sealed interface PanoramaCellHeight {
+    /** Panorama cover. [wide] is the committed shape (height/width <= 0.75). */
+    data class Cover(val wide: Boolean, val titleBelow: Boolean) : PanoramaCellHeight
+
+    data class Fixed(val height: Dp) : PanoramaCellHeight
+
+    /** Full-line rows whose height is not known up front (search bar, section title). */
+    data object Measure : PanoramaCellHeight
+}
+
+@Stable
+class PanoramaMasonryState {
+    internal val scrollableState: ScrollableState = ScrollableState { delta ->
+        val max = maxScroll
+        val next = (scrollOffset + delta).coerceIn(0f, max)
+        val consumed = next - scrollOffset
+        if (consumed != 0f) scrollOffset = next
+        consumed
+    }
+
+    internal val layoutCache = PanoramaMasonryLayoutCache()
+
+    var scrollOffset by mutableFloatStateOf(0f)
+        internal set
+
+    var maxScroll by mutableFloatStateOf(0f)
+        internal set
+
+    var viewportHeight by mutableIntStateOf(0)
+        internal set
+
+    var contentHeight by mutableIntStateOf(0)
+        internal set
+
+    var afterContentPadding by mutableIntStateOf(0)
+        internal set
+
+    var firstVisibleItemIndex by mutableIntStateOf(0)
+        internal set
+
+    var firstVisibleItemScrollOffset by mutableIntStateOf(0)
+        internal set
+
+    var canScrollForward by mutableStateOf(false)
+        internal set
+
+    var canScrollBackward by mutableStateOf(false)
+        internal set
+
+    /**
+     * Bumped by [requestScrollToItem] so the next measure observes the request.
+     * Read during measure.
+     */
+    internal var scrollRequest by mutableIntStateOf(0)
+
+    internal var pendingIndex: Int = -1
+    internal var pendingOffset: Int = 0
+    internal var pendingRestoreIndex: Int = Int.MIN_VALUE
+    internal var pendingRestoreOffset: Int = 0
+    internal var lastAnchor: PanoramaAnchor? = null
+    internal var lastKeys: List<Any>? = null
+
+    val isScrollInProgress: Boolean
+        get() = scrollableState.isScrollInProgress
+
+    fun requestScrollToItem(index: Int, scrollOffset: Int = 0) {
+        pendingIndex = index
+        pendingOffset = scrollOffset
+        scrollRequest++
+    }
+
+    suspend fun scrollToItem(index: Int, scrollOffset: Int = 0) {
+        scrollableState.scroll(MutatePriority.UserInput) {
+            requestScrollToItem(index, scrollOffset)
+            withFrameNanos { }
+        }
+    }
+
+    /**
+     * Jumps to an absolute content offset. Used by the fast scroller, which already knows the
+     * content height. The frame wait keeps [isScrollInProgress] true long enough for the
+     * panorama shape settle timer to treat the drag as scrolling.
+     */
+    suspend fun scrollToOffset(offsetPx: Float) {
+        scrollableState.scroll(MutatePriority.UserInput) {
+            scrollOffset = offsetPx.coerceIn(0f, maxScroll)
+            withFrameNanos { }
+        }
+    }
+}
+
+@Composable
+fun rememberPanoramaMasonryState(): PanoramaMasonryState {
+    val savedIndex = rememberSaveable { mutableIntStateOf(Int.MIN_VALUE) }
+    val savedOffset = rememberSaveable { mutableIntStateOf(0) }
+    val state = remember {
+        PanoramaMasonryState().also {
+            if (savedIndex.intValue != Int.MIN_VALUE) {
+                it.pendingRestoreIndex = savedIndex.intValue
+                it.pendingRestoreOffset = savedOffset.intValue
+            }
+        }
+    }
+    SideEffect {
+        val anchor = state.lastAnchor
+        if (anchor != null && state.pendingRestoreIndex == Int.MIN_VALUE) {
+            if (savedIndex.intValue != anchor.index) savedIndex.intValue = anchor.index
+            if (savedOffset.intValue != anchor.offsetFromViewportTop) {
+                savedOffset.intValue = anchor.offsetFromViewportTop
+            }
+        }
+    }
+    return state
+}
+
+interface PanoramaMasonryScope {
+    fun item(
+        key: Any? = null,
+        contentType: Any? = null,
+        span: PanoramaSpan = PanoramaSpan.SingleLane,
+        height: PanoramaCellHeight,
+        content: @Composable () -> Unit,
+    )
+
+    fun items(
+        count: Int,
+        key: ((index: Int) -> Any)? = null,
+        contentType: (index: Int) -> Any? = { null },
+        span: (index: Int) -> PanoramaSpan = { PanoramaSpan.SingleLane },
+        height: (index: Int) -> PanoramaCellHeight,
+        itemContent: @Composable (index: Int) -> Unit,
+    )
+}
+
+@Composable
+fun PanoramaMasonry(
+    columns: PanoramaColumns,
+    modifier: Modifier = Modifier,
+    state: PanoramaMasonryState = rememberPanoramaMasonryState(),
+    contentPadding: PaddingValues = PaddingValues(0.dp),
+    verticalSpacing: Dp = 0.dp,
+    horizontalSpacing: Dp = 0.dp,
+    userScrollEnabled: Boolean = true,
+    content: PanoramaMasonryScope.() -> Unit,
+) {
+    val latestContent = rememberUpdatedState(content)
+    val flingBehavior = ScrollableDefaults.flingBehavior()
+    val args = rememberUpdatedState(
+        MasonryMeasureArgs(
+            columns = columns,
+            contentPadding = contentPadding,
+            verticalSpacing = verticalSpacing,
+            horizontalSpacing = horizontalSpacing,
+        ),
+    )
+    LazyLayout(
+        modifier = modifier
+            .semantics {
+                if (userScrollEnabled) {
+                    // scrollBy is provided by scrollableArea. The axis range is the real offset:
+                    // every rectangle is known, so this is not the lazy list's estimate.
+                    verticalScrollAxisRange = ScrollAxisRange(
+                        value = { state.scrollOffset },
+                        maxValue = { state.maxScroll },
+                    )
+                }
+            }
+            .scrollableArea(
+                state = state.scrollableState,
+                orientation = Orientation.Vertical,
+                enabled = userScrollEnabled,
+                flingBehavior = flingBehavior,
+            ),
+        itemProvider = {
+            PanoramaItemProvider(PanoramaIntervalContent(latestContent.value))
+        },
+    ) { constraints ->
+        measureMasonry(
+            constraints = constraints,
+            state = state,
+            args = args.value,
+            content = latestContent.value,
+        )
+    }
+}
+
+@Composable
+fun FastScrollPanoramaMasonry(
+    columns: PanoramaColumns,
+    modifier: Modifier = Modifier,
+    state: PanoramaMasonryState = rememberPanoramaMasonryState(),
+    thumbAllowed: () -> Boolean = { true },
+    thumbColor: Color = MaterialTheme.colorScheme.primary,
+    contentPadding: PaddingValues = PaddingValues(0.dp),
+    topContentPadding: Dp = Dp.Hairline,
+    bottomContentPadding: Dp = Dp.Hairline,
+    endContentPadding: Dp = Dp.Hairline,
+    verticalSpacing: Dp = 0.dp,
+    horizontalSpacing: Dp = 0.dp,
+    userScrollEnabled: Boolean = true,
+    content: PanoramaMasonryScope.() -> Unit,
+) {
+    VerticalMasonryFastScroller(
+        state = state,
+        modifier = modifier,
+        thumbAllowed = thumbAllowed,
+        thumbColor = thumbColor,
+        topContentPadding = topContentPadding,
+        bottomContentPadding = bottomContentPadding,
+        endContentPadding = endContentPadding,
+    ) {
+        PanoramaMasonry(
+            columns = columns,
+            state = state,
+            contentPadding = contentPadding,
+            verticalSpacing = verticalSpacing,
+            horizontalSpacing = horizontalSpacing,
+            userScrollEnabled = userScrollEnabled,
+            content = content,
+        )
+    }
+}
+
+private class MasonryMeasureArgs(
+    val columns: PanoramaColumns,
+    val contentPadding: PaddingValues,
+    val verticalSpacing: Dp,
+    val horizontalSpacing: Dp,
+)
+
+private fun LazyLayoutMeasureScope.measureMasonry(
+    constraints: Constraints,
+    state: PanoramaMasonryState,
+    args: MasonryMeasureArgs,
+    content: PanoramaMasonryScope.() -> Unit,
+): MeasureResult {
+    // Subscribes this measure to scroll-to-item requests.
+    state.scrollRequest
+
+    val intervals = PanoramaIntervalContent(content)
+    val count = intervals.itemCount
+    val direction = layoutDirection
+    val padding = args.contentPadding
+    val left = padding.calculateLeftPadding(direction).roundToPx()
+    val right = padding.calculateRightPadding(direction).roundToPx()
+    val topPad = padding.calculateTopPadding().roundToPx()
+    val bottomPad = padding.calculateBottomPadding().roundToPx()
+    val available = if (constraints.hasBoundedWidth) {
+        (constraints.maxWidth - left - right).coerceAtLeast(0)
+    } else {
+        0
+    }
+    val horizontalPx = args.horizontalSpacing.roundToPx()
+    val verticalPx = args.verticalSpacing.roundToPx()
+    val laneCount = when (val columns = args.columns) {
+        is PanoramaColumns.Fixed -> columns.count.coerceAtLeast(1)
+        is PanoramaColumns.Adaptive -> staggeredLaneCountAdaptive(
+            availableSize = available,
+            spacing = horizontalPx,
+            minSize = columns.minSize.roundToPx(),
+        )
+    }
+    val laneWidths = staggeredLaneWidths(available, laneCount, horizontalPx)
+    val cellPadding = PANORAMA_CELL_PADDING_DP.dp.roundToPx()
+    val titlePadding = PANORAMA_TITLE_PADDING_DP.dp.roundToPx()
+    val titleLine = PANORAMA_TITLE_LINE_SP.sp.roundToPx()
+    val measuredPlaceables = HashMap<Int, List<Placeable>>(4)
+
+    fun heightOf(index: Int, widthPx: Int): Int {
+        return when (val spec = intervals.heightAt(index)) {
+            is PanoramaCellHeight.Cover -> panoramaCoverCellHeightPx(
+                laneWidthPx = widthPx,
+                wide = spec.wide,
+                titleBelow = spec.titleBelow,
+                cellPaddingPx = cellPadding,
+                titlePaddingPx = titlePadding,
+                titleLineHeightPx = titleLine,
+            )
+            is PanoramaCellHeight.Fixed -> spec.height.roundToPx()
+            PanoramaCellHeight.Measure -> {
+                measuredPlaceables[index]?.let { places ->
+                    return places.maxOfOrNull { it.height } ?: 0
+                }
+                val places = compose(index).map { measurable ->
+                    measurable.measure(Constraints(minWidth = widthPx, maxWidth = widthPx))
+                }
+                measuredPlaceables[index] = places
+                places.maxOfOrNull { it.height } ?: 0
+            }
+        }
+    }
+
+    val masonry = if (laneCount == 0 || count == 0) {
+        state.layoutCache.layout(
+            count = 0,
+            isFullLine = { false },
+            heightOf = { _, _ -> 0 },
+            laneWidths = if (laneWidths.isEmpty()) intArrayOf(0) else laneWidths,
+            verticalSpacing = verticalPx,
+            horizontalSpacing = horizontalPx,
+            rtl = direction == LayoutDirection.Rtl,
+        )
+    } else {
+        state.layoutCache.layout(
+            count = count,
+            isFullLine = { index -> intervals.spanAt(index) == PanoramaSpan.FullLine },
+            heightOf = { index, widthPx -> heightOf(index, widthPx) },
+            laneWidths = laneWidths,
+            verticalSpacing = verticalPx,
+            horizontalSpacing = horizontalPx,
+            rtl = direction == LayoutDirection.Rtl,
+        )
+    }
+
+    val keys = ArrayList<Any>(masonry.rects.size)
+    for (rect in masonry.rects) {
+        keys.add(intervals.getKey(rect.index))
+    }
+    val viewport = if (constraints.hasBoundedHeight) constraints.maxHeight else 0
+    val total = topPad + masonry.contentHeight + bottomPad
+    val maxScroll = (total - viewport).coerceAtLeast(0).toFloat()
+    var scroll = state.scrollOffset
+    val structural = state.layoutCache.structuralChange || keysChanged(state.lastKeys, keys)
+    if (state.pendingIndex >= 0 && masonry.rects.isNotEmpty()) {
+        val index = state.pendingIndex.coerceIn(0, masonry.rects.lastIndex)
+        val top = topPad + masonry.rects[index].y
+        scroll = (top + state.pendingOffset).toFloat()
+        state.pendingIndex = -1
+    } else if (state.pendingRestoreIndex != Int.MIN_VALUE && masonry.rects.isNotEmpty()) {
+        scroll = scrollOffsetForAnchor(
+            anchor = PanoramaAnchor(
+                index = state.pendingRestoreIndex,
+                key = state.pendingRestoreIndex,
+                offsetFromViewportTop = state.pendingRestoreOffset,
+            ),
+            rects = masonry.rects,
+            keys = keys,
+            topPadding = topPad,
+            maxScroll = maxScroll.toInt(),
+        ).toFloat()
+        state.pendingRestoreIndex = Int.MIN_VALUE
+    } else if (structural) {
+        val anchor = state.lastAnchor
+        if (anchor != null) {
+            scroll = scrollOffsetForAnchor(
+                anchor = anchor,
+                rects = masonry.rects,
+                keys = keys,
+                topPadding = topPad,
+                maxScroll = maxScroll.toInt(),
+            ).toFloat()
+        }
+    }
+    scroll = scroll.coerceIn(0f, maxScroll)
+    if (state.scrollOffset != scroll) state.scrollOffset = scroll
+    state.maxScroll = maxScroll
+    state.viewportHeight = viewport
+    state.contentHeight = total
+    state.afterContentPadding = bottomPad
+
+    val scrollPx = scroll.roundToInt()
+    val anchor = captureViewportAnchor(masonry.rects, keys, scrollPx, topPad)
+    state.lastAnchor = anchor
+    state.lastKeys = keys
+    if (anchor != null && anchor.index in masonry.rects.indices) {
+        val top = topPad + masonry.rects[anchor.index].y
+        state.firstVisibleItemIndex = anchor.index
+        state.firstVisibleItemScrollOffset = (scrollPx - top).coerceAtLeast(0)
+    } else {
+        state.firstVisibleItemIndex = 0
+        state.firstVisibleItemScrollOffset = 0
+    }
+    state.canScrollBackward = scroll > 0.5f
+    state.canScrollForward = scroll < maxScroll - 0.5f
+
+    val prefetch = viewport / 2
+    val windowStart = scrollPx - prefetch
+    val windowEnd = scrollPx + viewport + prefetch
+    val placed = ArrayList<Pair<PanoramaMasonryRect, List<Placeable>>>(16)
+    for (rect in masonry.rects) {
+        val top = topPad + rect.y
+        val bottom = top + rect.height
+        if (bottom <= windowStart || top >= windowEnd) continue
+        val placeables = measuredPlaceables[rect.index] ?: compose(rect.index).map { measurable ->
+            measurable.measure(
+                Constraints(
+                    minWidth = rect.width,
+                    maxWidth = rect.width,
+                    minHeight = rect.height,
+                    maxHeight = rect.height,
+                ),
+            )
+        }
+        placed.add(rect to placeables)
+    }
+
+    val layoutWidth = if (constraints.hasBoundedWidth) constraints.maxWidth else available + left + right
+    val layoutHeight = if (constraints.hasBoundedHeight) constraints.maxHeight else total.coerceAtLeast(0)
+    return layout(layoutWidth, layoutHeight) {
+        for ((rect, placeables) in placed) {
+            val x = left + rect.x
+            val y = topPad + rect.y - scrollPx
+            for (placeable in placeables) {
+                placeable.place(x, y)
+            }
+        }
+    }
+}
+
+private fun keysChanged(previous: List<Any>?, keys: List<Any>): Boolean {
+    if (previous == null) return false
+    val shared = minOf(previous.size, keys.size)
+    for (index in 0 until shared) {
+        if (previous[index] != keys[index]) return true
+    }
+    return false
+}
+
+private class PanoramaIntervalContent(
+    content: PanoramaMasonryScope.() -> Unit,
+) : PanoramaMasonryScope, LazyLayoutIntervalContent<PanoramaInterval>() {
+    override val intervals = MutableIntervalList<PanoramaInterval>()
+
+    init {
+        apply(content)
+    }
+
+    override fun item(
+        key: Any?,
+        contentType: Any?,
+        span: PanoramaSpan,
+        height: PanoramaCellHeight,
+        content: @Composable () -> Unit,
+    ) {
+        items(
+            count = 1,
+            key = key?.let { itemKey -> { itemKey } },
+            contentType = { contentType },
+            span = { span },
+            height = { height },
+            itemContent = { content() },
+        )
+    }
+
+    override fun items(
+        count: Int,
+        key: ((index: Int) -> Any)?,
+        contentType: (index: Int) -> Any?,
+        span: (index: Int) -> PanoramaSpan,
+        height: (index: Int) -> PanoramaCellHeight,
+        itemContent: @Composable (index: Int) -> Unit,
+    ) {
+        intervals.addInterval(
+            count,
+            PanoramaInterval(
+                key = key,
+                type = contentType,
+                span = span,
+                height = height,
+                item = itemContent,
+            ),
+        )
+    }
+
+    fun spanAt(index: Int): PanoramaSpan {
+        return withInterval(index) { local, interval -> interval.span(local) }
+    }
+
+    fun heightAt(index: Int): PanoramaCellHeight {
+        return withInterval(index) { local, interval -> interval.height(local) }
+    }
+}
+
+private class PanoramaInterval(
+    override val key: ((index: Int) -> Any)?,
+    override val type: (index: Int) -> Any?,
+    val span: (index: Int) -> PanoramaSpan,
+    val height: (index: Int) -> PanoramaCellHeight,
+    val item: @Composable (index: Int) -> Unit,
+) : LazyLayoutIntervalContent.Interval
+
+private class PanoramaItemProvider(
+    private val intervals: PanoramaIntervalContent,
+) : LazyLayoutItemProvider {
+    override val itemCount: Int
+        get() = intervals.itemCount
+
+    @Composable
+    override fun Item(index: Int, key: Any) {
+        Box(Modifier.clipToBounds()) {
+            intervals.withInterval(index) { local, interval ->
+                interval.item(local)
+            }
+        }
+    }
+
+    override fun getContentType(index: Int): Any? = intervals.getContentType(index)
+
+    override fun getKey(index: Int): Any = intervals.getKey(index)
+
+    override fun getIndex(key: Any): Int {
+        for (index in 0 until itemCount) {
+            if (getKey(index) == key) return index
+        }
+        return -1
+    }
+}
