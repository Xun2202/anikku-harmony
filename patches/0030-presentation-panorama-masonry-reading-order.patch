+
+class PanoramaMasonryLayoutTest {
+    @Test
+    fun `slight recess stays in the left lane`() {
+        // Left 252, right 244. Next wide cell is 112; half is 56, and 8 is not enough to move.
+        assertEquals(0, panoramaReadingLane(intArrayOf(252, 244), 112))
+    }
+
+    @Test
+    fun `a recess past half the item moves to that lane`() {
+        // Right lane is 80 shorter than the left. 80 > 56, so the wide cell goes right.
+        assertEquals(1, panoramaReadingLane(intArrayOf(252, 172), 112))
+    }
+
+    @Test
+    fun `four lanes pick the leftmost lane inside the limit`() {
+        // shortest 70, limit 126. Lane 2 (80) is inside it and is left of the shortest lane.
+        assertEquals(2, panoramaReadingLane(intArrayOf(300, 290, 80, 70), 112))
+    }
+
+    @Test
+    fun `a deep recess in the last lane is the only eligible one`() {
+        assertEquals(3, panoramaReadingLane(intArrayOf(300, 290, 280, 40), 112))
+    }
+
+    @Test
+    fun `reading order trace for a tall and wide mix`() {
+        val heights = intArrayOf(252, 112, 112, 252, 112, 252, 112, 112)
