+    @Test
+    fun `cover cell height follows the grid padding and the two aspect ratios`() {
+        // Lane 100, padding 4: inner 92. Wide 3/2 -> round(92 * 2 / 3) = 61. Compact = 8 + 61.
+        assertEquals(69, panoramaCoverCellHeightPx(100, wide = true, titleBelow = false, 4, 4, 18))
+        // Tall 2/3 -> round(92 * 3 / 2) = 138. Compact = 8 + 138.
+        assertEquals(146, panoramaCoverCellHeightPx(100, wide = false, titleBelow = false, 4, 4, 18))
+        // Comfortable adds title padding 8 and two 18 px lines.
+        assertEquals(113, panoramaCoverCellHeightPx(100, wide = true, titleBelow = true, 4, 4, 18))
+        assertEquals(190, panoramaCoverCellHeightPx(100, wide = false, titleBelow = true, 4, 4, 18))
+    }
+
+    private fun layoutFixed(heights: IntArray, lanes: Int, spacing: Int): PanoramaMasonryLayout {
+        return layoutPanoramaMasonry(
+            count = heights.size,
+            isFullLine = { false },
+            heightOf = { index, _ -> heights[index] },
+            laneWidths = IntArray(lanes) { 100 },
+            verticalSpacing = spacing,
+            horizontalSpacing = spacing,
+        )
+    }
+
+    private fun rect(index: Int, y: Int, height: Int): PanoramaMasonryRect {
+        return PanoramaMasonryRect(
+            index = index,
+            lane = 0,
+            x = 0,
+            y = y,
+            width = 10,
+            height = height,
+            fullLine = false,
+        )
+    }
