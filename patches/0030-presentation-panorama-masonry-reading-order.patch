+        )
+        val anchor = PanoramaAnchor(index = 5, key = "manga", offsetFromViewportTop = -8)
+        val scroll = scrollOffsetForAnchor(
+            anchor = anchor,
+            rects = rects,
+            keys = listOf("other", "manga"),
+            topPadding = 0,
+            maxScroll = 500,
+        )
+        assertEquals(40 - (-8), scroll)
