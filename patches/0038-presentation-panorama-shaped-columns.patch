@@ -112,6 +114,100 @@ fun panoramaTieredMinSize(windowSize: Int, breakpoint: Int, compactMin: Int, exp
     return if (windowSize < breakpoint) compactMin else expandedMin
 }
 
+/**
+ * (132 - 8)^2 * 1.5. Cover area of a 132 dp tall column: the cover is the lane minus 4 dp of
+ * padding on each side, and a tall cover is 3/2 as tall as it is wide.
+ */
+private const val PANORAMA_SHAPED_ANCHOR_AREA_DP2 = 23064.0
+
+/**
+ * Folded portrait grid, 459 x 552 dp. The window is 459 x 672; about 120 dp of that is the
+ * top and bottom bars, so the reference is the grid's own area.
+ */
+private const val PANORAMA_SHAPED_REFERENCE_AREA_DP2 = 459.0 * 552.0
+private const val PANORAMA_SHAPED_MIN_LANE_DP = 104.0
+private const val PANORAMA_SHAPED_MAX_LANE_DP = 240.0
+private const val PANORAMA_SHAPED_CHROME_DP = 8.0
+private const val PANORAMA_SHAPED_TIE_DP = 0.05
+private const val PANORAMA_SHAPED_MAX_LANES = 12
+
+/**
+ * Lane count for [PanoramaColumns.Shaped].
+ *
+ * [gridWidthPx] is the lane area plus horizontal content padding. [gridHeightPx] is the measured
+ * height and is ignored when [heightBounded] is false. Sizes are pixels; [density] is px per dp.
+ * The target lane is `clamp(sqrt(area / heightOverWidth) + 8 dp, 104 dp, 240 dp)`, where
+ * `area = 23064 dp^2 * max(1, sqrt(gridArea / (459 * 552 dp^2)))`.
+ */
+fun panoramaShapedLaneCount(
+    gridWidthPx: Int,
+    gridHeightPx: Int,
+    horizontalPaddingPx: Int,
+    spacingPx: Int,
+    heightOverWidth: Float,
+    density: Float,
+    heightBounded: Boolean,
+): Int {
+    if (heightOverWidth <= 0f || density <= 0f) return 1
+    val available = gridWidthPx - horizontalPaddingPx
+    if (available <= 0) return 1
+    val densityDp = density.toDouble()
+    val scale = if (!heightBounded || gridHeightPx <= 0) {
+        1.0
+    } else {
+        val reference = PANORAMA_SHAPED_REFERENCE_AREA_DP2 * densityDp * densityDp
+        val gridArea = gridWidthPx.toDouble() * gridHeightPx.toDouble()
+        sqrt(gridArea / reference).coerceAtLeast(1.0)
+    }
+    val area = PANORAMA_SHAPED_ANCHOR_AREA_DP2 * densityDp * densityDp * scale
+    val minLane = PANORAMA_SHAPED_MIN_LANE_DP * densityDp
+    val maxLane = PANORAMA_SHAPED_MAX_LANE_DP * densityDp
+    val ideal = (sqrt(area / heightOverWidth.toDouble()) + PANORAMA_SHAPED_CHROME_DP * densityDp)
+        .coerceIn(minLane, maxLane)
+    return panoramaNearestLaneCount(
+        availablePx = available,
+        spacingPx = spacingPx,
+        idealPx = ideal,
+        minLanePx = minLane,
+        tiePx = PANORAMA_SHAPED_TIE_DP * densityDp,
+    )
+}
+
+/**
+ * Column count whose lane width is closest to [idealPx].
+ *
+ * Harmony: a tie within [tiePx] keeps the smaller count. A candidate narrower than [minLanePx]
+ * is not eligible (one column always is). The search stops at 12 columns.
+ */
+fun panoramaNearestLaneCount(
+    availablePx: Int,
+    spacingPx: Int,
+    idealPx: Double,
+    minLanePx: Double,
+    tiePx: Double,
+): Int {
+    if (availablePx <= 0) return 1
+    // Harmony: scanning upward, so a tie within tiePx never replaces the smaller count.
+    var bestLanes = 1
+    var bestDistance = abs(panoramaLaneWidth(availablePx, spacingPx, 1) - idealPx)
+    for (lanes in 1..PANORAMA_SHAPED_MAX_LANES) {
+        val lane = panoramaLaneWidth(availablePx, spacingPx, lanes)
+        if (lanes > 1 && lane < minLanePx) break
+        val distance = abs(lane - idealPx)
+        val closer = distance < bestDistance - tiePx
+        val tieKeepsFewer = abs(distance - bestDistance) <= tiePx && lanes < bestLanes
+        if (closer || tieKeepsFewer) {
+            bestLanes = lanes
+            bestDistance = distance
+        }
+    }
+    return bestLanes
+}
+
+private fun panoramaLaneWidth(availablePx: Int, spacingPx: Int, lanes: Int): Double {
+    return (availablePx - spacingPx * (lanes - 1)).toDouble() / lanes
+}
