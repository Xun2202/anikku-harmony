+    private fun checkShaped(
+        gridWidth: Int,
+        gridHeight: Int,
+        heightOverWidth: Float,
+        lanes: Int,
+        lane: Double,
+    ) {
+        assertEquals(lanes, shapedLanes(gridWidth, gridHeight, heightOverWidth, heightBounded = true))
+        val available = gridWidth - 16
+        val actual = (available - 4 * (lanes - 1)).toDouble() / lanes
+        assertEquals(lane, actual, 0.001)
+    }
+
+    private fun shapedLanes(
+        gridWidth: Int,
+        gridHeight: Int,
+        heightOverWidth: Float,
+        heightBounded: Boolean,
+    ): Int {
+        return panoramaShapedLaneCount(
+            gridWidthPx = gridWidth,
+            gridHeightPx = gridHeight,
+            horizontalPaddingPx = 16,
+            spacingPx = 4,
+            heightOverWidth = heightOverWidth,
+            density = 1f,
+            heightBounded = heightBounded,
+        )
+    }
+
     private fun uniformGrid(count: Int): Pair<PanoramaMasonryLayout, List<Long>> {
         val layout = layoutPanoramaMasonry(
             count = count,
