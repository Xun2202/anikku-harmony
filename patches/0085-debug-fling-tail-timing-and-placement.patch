+package tachiyomi.presentation.core.components
+
+import java.util.Locale
+
+/** Passive tail diagnostics. No frame callbacks, snapshot reads, or per-frame text allocation. */
+object FlingTailTrace {
+    private const val FLINGS = 16
+    private const val BASELINE_FLINGS = 4
+    private const val ROWS = 64
+    private const val WIDTH = 5
+    private const val FINAL_DRAW_GRACE_NS = 100_000_000L
+    private val lock = Any()
+    private val sessions = ArrayDeque<Session>(FLINGS)
+    private var serial = 0L
+    private var current: Session? = null
+
+    @Volatile
+    var enabled: Boolean = false
+        private set
+
+    fun startRecording() = synchronized(lock) {
+        sessions.clear()
+        current = null
+        enabled = true
+    }
+
+    fun stopRecording() = synchronized(lock) {
+        enabled = false
+        current = null
+        sessions.clear()
+    }
+
+    internal fun begin(grid: Int, velocity: Float, now: Long): Long = synchronized(lock) {
+        if (!enabled) return@synchronized 0L
+        val session = Session(++serial, grid, velocity, now)
+        if (sessions.size == FLINGS) sessions.removeAt(BASELINE_FLINGS)
+        sessions.addLast(session)
+        current = session
+        session.id
+    }
+
+    internal fun step(id: Long, now: Long, asked: Float, consumed: Float, offset: Float) = synchronized(lock) {
+        val session = current
+        if (!enabled || session == null || session.id != id || session.ended != 0L) return@synchronized
+        session.steps.append(now, asked.toRawBits().toLong(), consumed.toRawBits().toLong(), offset.toRawBits().toLong(), 0L)
+    }
+
+    internal fun draw(grid: Int, now: Long, offset: Int, width: Int, height: Int, drawNanos: Long = 0L) = synchronized(lock) {
+        val session = current
+        if (!enabled || session == null || session.grid != grid) return@synchronized
+        if (session.ended != 0L && now - session.ended > FINAL_DRAW_GRACE_NS) return@synchronized
+        session.draws.append(now, offset.toLong(), width.toLong(), height.toLong(), drawNanos)
+    }
+
+    internal fun end(id: Long, now: Long, outcome: String) = synchronized(lock) {
+        val session = current
+        if (!enabled || session == null || session.id != id || session.ended != 0L) return@synchronized
+        session.ended = now
+        session.outcome = outcome
+    }
+
+    internal fun snapshot(): List<FlingTailSnapshot> = synchronized(lock) {
+        sessions.map {
+            FlingTailSnapshot(it.id, it.grid, it.velocity, it.started, it.ended, it.outcome, it.steps.count, it.draws.count, it.steps.snapshot(), it.draws.snapshot())
+        }
+    }
+
+    /** Called only at export, on the writer thread. Times share the report's monotonic origin. */
+    fun report(originNanos: Long): String = buildString {
+        val captured = snapshot()
+        appendLine()
+        appendLine("## Fling tail samples (format 1)")
+        appendLine("# Last 64 steps and grid draw calls per fling; first 4 and latest 12 flings. Earlier rows may be omitted.")
+        appendLine("# Step asked/consumed are scroll deltas in px; offset is the float state after scrollBy.")
+        appendLine("# Draw offset is the integer used to place cells; draw_wall_ms is inclusive CPU wall time, not GPU completion/presentation.")
+        appendLine("# dt is between adjacent retained calls of the same kind; first retained dt is n/a.")
+        appendLine("# step speed is inferred from asked/dt, not the decay model's instantaneous velocity.")
+        fun number(value: Double) = String.format(Locale.US, "%.3f", value)
+        for (session in captured) {
+            appendLine(
+                "tail_fling id=${session.id} grid=${session.grid} start_ms=${number((session.started - originNanos) / 1e6)} " +
+                    "end_ms=${if (session.ended == 0L) "n/a" else number((session.ended - originNanos) / 1e6)} " +
+                    "initial_px_s=${number(session.velocity.toDouble())} outcome=${session.outcome} " +
+                    "steps_total=${session.stepCount} draws_total=${session.drawCount}",
+            )
+            for ((kind, rows) in listOf("step" to session.steps, "draw" to session.draws)) {
+                for (row in rows.indices step WIDTH) {
+                    val time = rows[row]
+                    val dt = if (row == 0) 0L else time - rows[row - WIDTH]
+                    val timing = "at_ms=${number((time - originNanos) / 1e6)} elapsed_ms=${number((time - session.started) / 1e6)} " +
+                        "dt_ms=${if (dt <= 0L) "n/a" else number(dt / 1e6)}"
+                    if (kind == "step") {
+                        val asked = Float.fromBits(rows[row + 1].toInt())
+                        appendLine(
+                            "tail_step id=${session.id} $timing asked_px=${number(asked.toDouble())} " +
+                                "consumed_px=${number(Float.fromBits(rows[row + 2].toInt()).toDouble())} " +
+                                "offset_px=${number(Float.fromBits(rows[row + 3].toInt()).toDouble())} " +
+                                "speed_estimate_px_s=${if (dt <= 0L) "n/a" else number(asked * 1e9 / dt)}",
+                        )
+                    } else {
+                        appendLine("tail_draw id=${session.id} $timing placed_offset_px=${rows[row + 1]} viewport_px=${rows[row + 2]}x${rows[row + 3]} draw_wall_ms=${number(rows[row + 4] / 1e6)}")
+                    }
+                }
+            }
+        }
+    }
+
+    private class Session(val id: Long, val grid: Int, val velocity: Float, val started: Long) {
+        var ended = 0L
+        var outcome = "active"
+        val steps = TailRows()
+        val draws = TailRows()
+    }
+
+    private class TailRows {
+        private val values = LongArray(ROWS * WIDTH)
+        var count = 0
+            private set
+
+        fun append(a: Long, b: Long, c: Long, d: Long, e: Long) {
+            val row = (count++ % ROWS) * WIDTH
+            values[row] = a
+            values[row + 1] = b
+            values[row + 2] = c
+            values[row + 3] = d
+            values[row + 4] = e
+        }
+
+        fun snapshot(): LongArray {
+            val size = minOf(count, ROWS)
+            val first = count - size
+            return LongArray(size * WIDTH) { index -> values[((first + index / WIDTH) % ROWS) * WIDTH + index % WIDTH] }
+        }
+    }
+}
+
+internal data class FlingTailSnapshot(
+    val id: Long,
+    val grid: Int,
+    val velocity: Float,
+    val started: Long,
+    val ended: Long,
+    val outcome: String,
+    val stepCount: Int,
+    val drawCount: Int,
+    val steps: LongArray,
+    val draws: LongArray,
+)
