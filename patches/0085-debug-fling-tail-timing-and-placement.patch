+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.gestures.FlingBehavior
+import androidx.compose.foundation.gestures.ScrollScope
+import kotlinx.coroutines.runBlocking
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class NavigationChromeFlingTailTest {
+    @AfterEach
+    fun stop() = FlingTailTrace.stopRecording()
+
+    @Test
+    fun `disabled recorder retains no samples and old fling cannot write into a new recording`() {
+        FlingTailTrace.stopRecording()
+        assertEquals(0L, FlingTailTrace.begin(1, 500f, 1L))
+        assertTrue(FlingTailTrace.snapshot().isEmpty())
+        FlingTailTrace.startRecording()
+        val old = FlingTailTrace.begin(1, 500f, 10L)
+        FlingTailTrace.stopRecording()
+        assertFalse(FlingTailTrace.enabled)
+        assertTrue(FlingTailTrace.snapshot().isEmpty())
+        FlingTailTrace.startRecording()
+        val next = FlingTailTrace.begin(1, 500f, 20L)
+        FlingTailTrace.step(old, 21L, 3f, 3f, 3f)
+        FlingTailTrace.end(old, 22L, "cancelled")
+        FlingTailTrace.step(next, 23L, 2f, 2f, 2f)
+        assertEquals(1, FlingTailTrace.snapshot().single().stepCount)
+        assertEquals("active", FlingTailTrace.snapshot().single().outcome)
+    }
+
+    @Test
+    fun `tail wrap preserves chronological last 64 steps and draws with independent totals`() {
+        FlingTailTrace.startRecording()
+        val id = FlingTailTrace.begin(2, 500f, 1L)
+        repeat(200) { i ->
+            FlingTailTrace.step(id, 100L + i, 0.25f, 0.25f, i / 4f)
+            FlingTailTrace.draw(2, 1000L + i, i, 1264, 1848)
+        }
+        val captured = FlingTailTrace.snapshot().single()
+        assertEquals(200, captured.stepCount)
+        assertEquals(200, captured.drawCount)
+        assertEquals(64 * 5, captured.steps.size)
+        assertEquals(236L, captured.steps.first())
+        assertEquals(1136L, captured.draws.first())
+        assertEquals(1199L, captured.draws[captured.draws.size - 5])
+        assertTrue(FlingTailTrace.report(1L).contains("dt_ms=n/a"))
+    }
+
+    @Test
+    fun `final placement can draw after decay ends without charging an idle gap to the tail`() {
+        FlingTailTrace.startRecording()
+        val id = FlingTailTrace.begin(1, 100f, 1L)
+        FlingTailTrace.end(id, 1_000_000L, "done")
+        FlingTailTrace.draw(1, 11_000_000L, 17, 1264, 1848)
+        FlingTailTrace.draw(1, 2_000_000_000L, 17, 1264, 1848)
+        FlingTailTrace.step(id, 3_000_000_000L, 1f, 1f, 18f)
+        val captured = FlingTailTrace.snapshot().single()
+        assertEquals(1, captured.drawCount)
+        assertEquals(0, captured.stepCount)
+        assertEquals("done", captured.outcome)
+        assertEquals(17L, captured.draws[1])
+    }
+
+    @Test
+    fun `fractional scroll values and actual integer placement remain distinguishable`() {
+        FlingTailTrace.startRecording()
+        val id = FlingTailTrace.begin(1, 100f, 1_000_000L)
+        FlingTailTrace.step(id, 2_000_000L, 0.25f, 0.125f, 100_000.125f)
+        FlingTailTrace.draw(3, 3_000_000L, 5, 9, 9)
+        FlingTailTrace.draw(1, 4_000_000L, 100_000, 1264, 1848, 18_000_000L)
+        val captured = FlingTailTrace.snapshot().single()
+        assertEquals(0.25f, Float.fromBits(captured.steps[1].toInt()))
+        assertEquals(0.125f, Float.fromBits(captured.steps[2].toInt()))
+        assertEquals(100_000.125f, Float.fromBits(captured.steps[3].toInt()))
+        assertEquals(1, captured.drawCount)
+        val text = FlingTailTrace.report(1_000_000L)
+        assertTrue(text.contains("offset_px=100000.125"))
+        assertTrue(text.contains("placed_offset_px=100000 viewport_px=1264x1848"))
+        assertTrue(text.contains("speed_estimate_px_s=n/a"))
+        assertTrue(text.contains("draw_wall_ms=18.000"))
+    }
+
+    @Test
+    fun `recordings retain at most 16 flings and exported snapshots are detached`() {
+        FlingTailTrace.startRecording()
+        repeat(20) { i ->
+            val id = FlingTailTrace.begin(i, 100f, 1L + i)
+            FlingTailTrace.step(id, 30L + i, 1f, 1f, i.toFloat())
+        }
+        val captured = FlingTailTrace.snapshot()
+        assertEquals(16, captured.size)
+        assertEquals(listOf(0, 1, 2, 3), captured.take(4).map { it.grid })
+        assertEquals(8, captured[4].grid)
+        captured.last().steps[0] = -1L
+        assertEquals(49L, FlingTailTrace.snapshot().last().steps[0])
+    }
+
+    @Test
+    fun `tracing forwards the original fling velocity deltas consumption and remaining velocity`() = runBlocking {
+        FlingTailTrace.startRecording()
+        val state = PanoramaMasonryState()
+        state.scrollOffset = 10f
+        val requested = listOf(4f, -2f, 0.125f)
+        val observed = mutableListOf<Float>()
+        val consumed = mutableListOf<Float>()
+        val inner = object : FlingBehavior {
+            override suspend fun ScrollScope.performFling(initialVelocity: Float): Float {
+                assertEquals(123f, initialVelocity)
+                requested.forEach { consumed += scrollBy(it) }
+                return 3f
+            }
+        }
+        val scope = object : ScrollScope {
+            override fun scrollBy(pixels: Float): Float {
+                observed += pixels
+                val accepted = pixels / 2f
+                state.scrollOffset += accepted
+                return accepted
+            }
+        }
+        val remaining = with(TracedFlingBehavior(inner, state.traceId, state)) { scope.performFling(123f) }
+        assertEquals(3f, remaining)
+        assertEquals(requested, observed)
+        assertEquals(requested.map { it / 2f }, consumed)
+        assertEquals(11.0625f, state.scrollOffset)
+        assertEquals(3, FlingTailTrace.snapshot().single().stepCount)
+        assertEquals("stopped", FlingTailTrace.snapshot().single().outcome)
+    }
+}
