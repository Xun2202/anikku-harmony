From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Sun, 25 Oct 2026 19:38:54 +0000
Subject: [PATCH] updater: fetch fresh release metadata for manual checks

Shared Mihon and Anikku 0058. Pass forceCheck to mirror and API requests. Bypass device cache and use a fresh query key for manual checks, retaining automatic cache policy.
---
 .../data/release/ReleaseCheckRequest.kt       | 16 ++++++++++++
 .../data/release/ReleaseServiceImpl.kt        | 26 ++++++++++++++-----
 2 files changed, 36 insertions(+), 6 deletions(-)
 create mode 100644 data/src/main/java/tachiyomi/data/release/ReleaseCheckRequest.kt

diff --git a/data/src/main/java/tachiyomi/data/release/ReleaseCheckRequest.kt b/data/src/main/java/tachiyomi/data/release/ReleaseCheckRequest.kt
new file mode 100644
index 000000000..671df40f3
--- /dev/null
+++ b/data/src/main/java/tachiyomi/data/release/ReleaseCheckRequest.kt
@@ -0,0 +1,16 @@
+package tachiyomi.data.release
+
+import eu.kanade.tachiyomi.network.GET
+import okhttp3.CacheControl
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.Request
+
+/** Manual checks must fetch fresh metadata; automatic checks retain the normal cache policy. */
+internal fun releaseCheckRequest(url: String, forceCheck: Boolean): Request {
+    if (!forceCheck) return GET(url)
+    val freshUrl = url.toHttpUrl().newBuilder()
+        .addQueryParameter("_harmony_check", System.currentTimeMillis().toString())
+        .build()
+    // no-cache bypasses the device cache; a fresh key also avoids an old CDN edge response.
+    return GET(freshUrl, cache = CacheControl.FORCE_NETWORK)
+}
diff --git a/data/src/main/java/tachiyomi/data/release/ReleaseServiceImpl.kt b/data/src/main/java/tachiyomi/data/release/ReleaseServiceImpl.kt
