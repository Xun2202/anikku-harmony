From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Sun, 15 Nov 2026 11:29:19 +0000
Subject: [PATCH] fix(ui): wake fast scroller on programmatic position changes

Preserve the existing visible thumb and immediate-grab behavior after restoring or programmatically scrolling a list. Notify on actual offset changes, including when isScrollInProgress is false; do not notify on alpha or chrome-only recompositions. Keep direct normalized geometry. Fix new pager tests to use the measured viewport origin when a required-size fixture exceeds the Robolectric screen; compare append-scroll response against a synchronized control so ongoing residual decay cannot invalidate the assertion. Do not remove or weaken the existing thumb/coast regression.
---
 .../core/components/FastScrollerProgress.kt       | 15 +++++++++++++++
 .../core/components/VerticalFastScroller.kt       |  8 ++++----
 .../NavigationChromeFastScrollerProgressTest.kt   | 12 ++++++++----
 .../NavigationChromePagerTransitionTest.kt        |  7 ++++---
 4 files changed, 31 insertions(+), 11 deletions(-)

diff --git a/presentation-core/src/main/java/tachiyomi/presentation/core/components/FastScrollerProgress.kt b/presentation-core/src/main/java/tachiyomi/presentation/core/components/FastScrollerProgress.kt
index 6ee65c71a..4a2fb040e 100644
--- a/presentation-core/src/main/java/tachiyomi/presentation/core/components/FastScrollerProgress.kt
+++ b/presentation-core/src/main/java/tachiyomi/presentation/core/components/FastScrollerProgress.kt
@@ -6,6 +6,7 @@ import androidx.compose.runtime.Composable
 import androidx.compose.runtime.LaunchedEffect
 import androidx.compose.runtime.SideEffect
 import androidx.compose.runtime.remember
+import kotlinx.coroutines.flow.MutableSharedFlow
 
 private class ScrollerSample(var count: Int = 0, var rendered: Float = 0f)
 
@@ -38,3 +39,17 @@ internal fun rememberFastScrollerDragTravel(liveTravel: Float, held: Boolean): F
     travel.held = held
     return travel.value
 }
+
+private class LastScrollPosition(var value: Float = Float.NaN)
+
+/** Programmatic scrolling must wake the thumb too; chrome/alpha-only recomposition must not. */
+@Composable
+internal fun FastScrollerPositionChanged(scrolled: MutableSharedFlow<Unit>, position: Float) {
+    val previous = remember { LastScrollPosition() }
+    SideEffect {
+        if (position != previous.value) {
+            previous.value = position
+            scrolled.tryEmit(Unit)
+        }
+    }
+}
