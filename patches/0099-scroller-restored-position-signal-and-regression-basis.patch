             }
 
             // Thumb alpha
@@ -958,7 +958,7 @@ fun VerticalMasonryFastScroller(
                     !state.canScrollForward -> 1f
                     else -> (state.scrollOffset / state.maxScroll.coerceAtLeast(1f)).coerceIn(0f, 1f)
                 }
-                if (state.isScrollInProgress) scrolled.tryEmit(Unit)
+                FastScrollerPositionChanged(scrolled, state.scrollOffset)
             }
 
             val isThumbVisible = alpha.value > 0f
@@ -1103,7 +1103,7 @@ internal fun VerticalTimelineFastScroller(
                         it.scrollOffset.toFloat() / (it.contentSize - it.viewportSize).coerceAtLeast(1)
                     }?.coerceIn(0f, 1f) ?: 0f
                 }
-                if (state.isScrollInProgress) scrolled.tryEmit(Unit)
+                FastScrollerPositionChanged(scrolled, state.scrollIndicatorState?.scrollOffset?.toFloat() ?: 0f)
             }
 
             val isThumbVisible = alpha.value > 0f
