-                input.copyTo(output)
+private fun UniFile.transferContentsTo(target: UniFile, resolver: ContentResolver?) {
+    if (!isDirectory) {
+        copyFileTo(target)
+        return
+    }
+
+    val children = listFiles()
+        ?: throw IOException("Failed to list directory $displayablePath")
+    children.forEach { child ->
+        val childName = child.name
+            ?: throw IOException("A file in $displayablePath has no name")
+        val existing = target.findFile(childName)
+        if (existing != null) {
+            // Left behind by an interrupted earlier attempt: keep it when it is complete.
+            if (!child.isDirectory && !existing.isDirectory && existing.length() == child.length()) {
+                return@forEach
             }
+            existing.deleteSafely()
+        }
+        if (resolver != null && child.moveInto(target, resolver)) {
+            return@forEach
         }
+        val childTarget = child.createCopyTarget(target, childName)
+            ?: throw IOException("Failed to create '$childName' in " + target.displayablePath)
+        child.transferContentsTo(childTarget, resolver)
+    }
+}
+
+/**
+ * Moves this document into [newParent] without streaming its data through the app. Returns false
+ * when the documents are not SAF documents or the provider does not support moving.
+ */
+private fun UniFile.moveInto(newParent: UniFile, resolver: ContentResolver): Boolean {
+    val source = uri
+    val oldParent = parentFile?.uri ?: return false
+    if (source.scheme != ContentResolver.SCHEME_CONTENT) return false
+    if (newParent.uri.scheme != ContentResolver.SCHEME_CONTENT) return false
+    return try {
+        DocumentsContract.moveDocument(resolver, source, oldParent, newParent.uri) != null
+    } catch (_: Exception) {
+        false
+    }
+}
+
+private fun UniFile.copyFileTo(target: UniFile) {
+    openInputStream().use { input ->
+        target.openOutputStream().use { output ->
+            input.copyTo(output)
+        }
+    }
+    val expected = length()
+    val actual = target.length()
+    // Some providers report 0 / -1 until their metadata is refreshed; only trust a positive size.
+    if (expected > 0 && actual > 0 && actual != expected) {
+        throw IOException("Copied ${target.displayablePath} is $actual bytes, expected $expected")
     }
 }
