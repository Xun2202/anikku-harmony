+    /** The HLS demuxer reads these TS fragments in order. Preserve every byte, including packets split across chunks. */
+    suspend fun writeTransportStream(prepared: Prepared, target: File, onBytesCopied: (Long) -> Unit) {
+        val coroutine = currentCoroutineContext()
+        var copied = 0L
+        val buffer = ByteArray(256 * 1024)
+        target.outputStream().use { output ->
+            repeat(prepared.segments) { index ->
+                coroutine.ensureActive()
+                segmentFile(prepared.directory, index).inputStream().use { input ->
+                    while (true) {
+                        coroutine.ensureActive()
+                        val count = input.read(buffer)
+                        if (count < 0) break
+                        output.write(buffer, 0, count)
+                        copied += count
+                    }
+                }
+                onBytesCopied(copied)
+            }
+        }
+        if (copied == 0L || copied != prepared.bytes || target.length() != copied) {
+            throw Failure("Cached HLS segments changed during offline save")
+        }
+    }
+
