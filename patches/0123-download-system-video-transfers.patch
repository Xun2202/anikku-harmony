+import java.io.IOException
+import java.io.RandomAccessFile
+import java.util.UUID
+import java.util.concurrent.ConcurrentHashMap
+import android.app.DownloadManager as PlatformDownloads
+
+/** Owns only episode requests created by Anikku. The provider keeps transferring while our process sleeps. */
+internal class SystemVideoTransfers(
+    private val provider: Provider,
+    private val elapsed: () -> Long = SystemClock::elapsedRealtime,
+    private val waitForSample: suspend () -> Unit = { delay(1000) },
+    private val report: (String) -> Unit = { message -> SystemVideoTransfers::class.java.logcat(LogPriority.INFO) { message } },
+) {
+    data class Ticket(val episode: Long, val id: Long, val wifiOnly: Boolean)
+    data class Sample(val status: Int, val reason: Int, val bytes: Long, val total: Long, val file: File? = null)
+    data class Media(val url: String, val headers: Headers)
+
+    interface Provider {
+        fun owned(): List<Ticket>
+        fun enqueue(episode: Long, media: Media, wifiOnly: Boolean): Ticket
+        fun sample(ticket: Ticket): Sample?
+        fun remove(ticket: Ticket)
+        fun isInteractive(): Boolean
+        fun isVideo(file: File): Boolean
+    }
+
+    private val tickets = ConcurrentHashMap<Long, Ticket>()
+    private var available = false
+
+    fun restore(queued: Set<Long>, paused: Set<Long>) {
+        try {
+            for (ticket in provider.owned().sortedByDescending { it.id }) {
+                if (ticket.episode !in queued || tickets.putIfAbsent(ticket.episode, ticket) != null) {
+                    provider.remove(ticket)
+                } else if (ticket.episode in paused) {
+                    discard(ticket, keepComplete = true)
+                }
+            }
+            available = true
+        } catch (failure: Exception) {
+            report("Download system provider unavailable reason=${failure.javaClass.simpleName}")
+        }
+    }
+
+    fun ticket(episode: Long) = tickets[episode]
+
+    fun detach(episode: Long) = tickets.remove(episode)
+
+    fun discard(ticket: Ticket, keepComplete: Boolean = false) {
+        if (keepComplete && provider.sample(ticket)?.status == PlatformDownloads.STATUS_SUCCESSFUL) return
+        // A fresh request always has a different provider id and destination, also after a quick requeue.
+        provider.remove(ticket)
+        tickets.remove(ticket.episode, ticket)
+    }
+
+    fun cleanup(ticket: Ticket, keepComplete: Boolean = false) {
+        try {
+            discard(ticket, keepComplete)
+        } catch (failure: Exception) {
+            report("Download system cleanup pending episode=${ticket.episode} request=${ticket.id} reason=${failure.javaClass.simpleName}")
+        }
+    }
+
+    suspend fun fetch(
+        episode: Long,
+        wifiOnly: Boolean,
+        allowNew: Boolean,
+        media: suspend () -> Media?,
+        rescheduling: () -> Boolean = { false },
+        onBytes: (bytes: Long, total: Long, increment: Long) -> Unit,
+    ): File? {
+        if (!available) return null
+        var ticket = tickets[episode]
+        if (ticket != null && (!allowNew || wifiOnly != ticket.wifiOnly)) {
+            discard(ticket, keepComplete = true)
+            ticket = tickets[episode]
+        }
+        if (ticket == null) {
+            if (!allowNew) return null
+            val selected = media() ?: return null
+            currentCoroutineContext().ensureActive()
+            ticket = try {
+                provider.enqueue(episode, selected, wifiOnly)
+            } catch (error: Exception) {
+                if (error is CancellationException) throw error
+                report("Download system fallback episode=$episode reason=enqueue-${error.javaClass.simpleName}")
+                return null
+            }
+            tickets[episode] = ticket
+            report("Download system enqueued episode=$episode request=${ticket.id} wifiOnly=$wifiOnly")
+        } else {
+            report("Download system reattached episode=$episode request=${ticket.id}")
+        }
+
+        var previousBytes = -1L
+        var previousTime = elapsed()
+        var lastStatus = -1
+        var visibleStall = 0L
+        try {
+            while (true) {
+                currentCoroutineContext().ensureActive()
+                val sample = provider.sample(ticket) ?: throw IOException("missing")
+                val now = elapsed()
+                val gap = (now - previousTime).coerceAtLeast(0)
+                val increment = if (previousBytes < 0) 0 else (sample.bytes - previousBytes).coerceAtLeast(0)
+                val pausedForNetwork = sample.status == PlatformDownloads.STATUS_PAUSED &&
+                    sample.reason in listOf(PlatformDownloads.PAUSED_WAITING_FOR_NETWORK, PlatformDownloads.PAUSED_QUEUED_FOR_WIFI)
+                if (lastStatus != sample.status || gap >= 5000) {
+                    report(
+                        "Download system sample episode=$episode request=${ticket.id} status=${sample.status} reason=${sample.reason} " +
+                            "bytes=${sample.bytes} total=${sample.total} previousBytes=$previousBytes gapMs=$gap",
+                    )
+                }
+                // Bytes already present when reattaching or accrued across a sleep aren't an instantaneous speed.
+                onBytes(sample.bytes, sample.total, if (gap < 5000) increment else 0)
+                if (sample.status == PlatformDownloads.STATUS_SUCCESSFUL) {
+                    val file = sample.file
+                    if (file == null || !file.isFile || file.length() <= 0 ||
+                        file.length() != sample.bytes || (sample.total > 0 && sample.total != sample.bytes) || !provider.isVideo(file)
+                    ) {
+                        throw IOException("unverified-video")
+                    }
+                    return file
+                }
+                if (sample.status == PlatformDownloads.STATUS_FAILED) throw IOException("provider-${sample.reason}")
+                visibleStall = if (sample.bytes == previousBytes && !pausedForNetwork && provider.isInteractive()) {
+                    visibleStall + gap.coerceAtMost(1500)
+                } else {
+                    0L
+                }
+                if (visibleStall >= 90_000) throw IOException("no-progress-while-awake")
+                previousBytes = sample.bytes
+                previousTime = now
+                lastStatus = sample.status
+                waitForSample()
+            }
+        } catch (cancelled: CancellationException) {
+            // Keep a finished file for the next save. A cancelled live transfer must release its slot.
+            if (!rescheduling()) cleanup(ticket, keepComplete = true)
+            throw cancelled
+        } catch (failure: Exception) {
+            val reason = if (failure.javaClass == IOException::class.java) {
+                failure.message?.takeIf { it.matches(Regex("[a-z0-9-]+")) }
+            } else {
+                null
+            }
+            report("Download system fallback episode=$episode request=${ticket.id} reason=${reason ?: failure.javaClass.simpleName}")
+            // Confirm removal before letting the other downloader start.
+            discard(ticket)
+            return null
+        }
+    }
+
+    companion object {
+        private val portableHeaders = setOf("user-agent", "accept", "accept-language", "referer", "origin")
+
+        fun media(video: Video, headers: Headers): Media? {
+            if (video.subtitleTracks.isNotEmpty() || video.audioTracks.isNotEmpty() ||
+                video.ffmpegStreamArgs.isNotEmpty() || video.ffmpegVideoArgs.isNotEmpty() || video.mpvArgs.isNotEmpty()
+            ) {
+                return null
+            }
+            val url = video.videoUrl.toHttpUrlOrNull() ?: return null
+            val host = url.host
+            if (!url.isHttps || url.username.isNotEmpty() || url.password.isNotEmpty() ||
+                '.' !in host || host.all { it.isDigit() || it == '.' } || ':' in host ||
+                host.endsWith(".localhost") || host.endsWith(".local") ||
+                !url.encodedPath.endsWith(".mp4", ignoreCase = true) || headers.names().any { it.lowercase() !in portableHeaders }
+            ) {
+                return null
+            }
+            return Media(video.videoUrl, headers)
+        }
+    }
+}
+
+/** Provider descriptions let us recover the enqueue/process-death boundary without persisting signed URLs. */
+internal class AndroidVideoTransferProvider(context: Context) : SystemVideoTransfers.Provider {
+    private val app = context.applicationContext
+    private val service get() = checkNotNull(app.getSystemService(PlatformDownloads::class.java))
+    private val description = Regex("""Anikku · (Wi-Fi|HTTP) #(\d+)""")
+    private val directory get() = File(checkNotNull(app.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)), ".anikku-transfers")
+
+    override fun owned() = owned(PlatformDownloads.Query())
+
+    fun owns(request: Long) = owned(PlatformDownloads.Query().setFilterById(request)).isNotEmpty()
+
+    private fun owned(query: PlatformDownloads.Query): List<SystemVideoTransfers.Ticket> = buildList {
+        checkNotNull(service.query(query)).use { cursor ->
+            val desc = cursor.getColumnIndexOrThrow(PlatformDownloads.COLUMN_DESCRIPTION)
+            val id = cursor.getColumnIndexOrThrow(PlatformDownloads.COLUMN_ID)
+            while (cursor.moveToNext()) {
+                val match = description.matchEntire(cursor.getString(desc).orEmpty()) ?: continue
+                val episode = match.groupValues[2].toLongOrNull() ?: continue
+                add(SystemVideoTransfers.Ticket(episode, cursor.getLong(id), match.groupValues[1] == "Wi-Fi"))
+            }
+        }
+    }
+
+    override fun enqueue(episode: Long, media: SystemVideoTransfers.Media, wifiOnly: Boolean): SystemVideoTransfers.Ticket {
+        val dir = directory
+        if (!dir.isDirectory && !dir.mkdirs() && !dir.isDirectory) throw IOException("directory-unavailable")
+        val destination = File(dir, "$episode-${UUID.randomUUID()}.mp4")
+        val type = if (wifiOnly) "Wi-Fi" else "HTTP"
+        val request = PlatformDownloads.Request(Uri.parse(media.url))
+            .setTitle("Anikku")
+            .setDescription("Anikku · $type #$episode")
+            .setMimeType("video/mp4")
+            .setDestinationUri(Uri.fromFile(destination))
+            .setNotificationVisibility(PlatformDownloads.Request.VISIBILITY_VISIBLE)
+        if (wifiOnly) request.setAllowedNetworkTypes(PlatformDownloads.Request.NETWORK_WIFI)
+        media.headers.forEach { (name, value) -> request.addRequestHeader(name, value) }
+        return SystemVideoTransfers.Ticket(episode, service.enqueue(request), wifiOnly)
+    }
+
+    override fun sample(ticket: SystemVideoTransfers.Ticket): SystemVideoTransfers.Sample? {
+        return checkNotNull(service.query(PlatformDownloads.Query().setFilterById(ticket.id))).use { cursor ->
+            if (!cursor.moveToFirst()) return null
+            val status = cursor.getInt(cursor.getColumnIndexOrThrow(PlatformDownloads.COLUMN_STATUS))
+            val file = if (status == PlatformDownloads.STATUS_SUCCESSFUL) {
+                completedFile(ticket, cursor.getString(cursor.getColumnIndexOrThrow(PlatformDownloads.COLUMN_LOCAL_URI)))
+            } else {
+                null
+            }
+            SystemVideoTransfers.Sample(
+                status,
+                cursor.getInt(cursor.getColumnIndexOrThrow(PlatformDownloads.COLUMN_REASON)),
+                cursor.getLong(cursor.getColumnIndexOrThrow(PlatformDownloads.COLUMN_BYTES_DOWNLOADED_SO_FAR)),
+                cursor.getLong(cursor.getColumnIndexOrThrow(PlatformDownloads.COLUMN_TOTAL_SIZE_BYTES)),
+                file,
+            )
+        }
+    }
+
+    private fun completedFile(ticket: SystemVideoTransfers.Ticket, localUri: String?): File? {
+        val dir = directory.canonicalFile
+        val prefix = "${ticket.episode}-"
+        val path = localUri?.let(Uri::parse)?.takeIf { it.scheme == "file" }?.path
+        path?.let(::File)?.canonicalFile?.takeIf { it.parentFile == dir && it.name.startsWith(prefix) && it.isFile }?.let { return it }
+        // Some providers expose a content URI. Match its open descriptor to our private destination.
+        return service.openDownloadedFile(ticket.id).use { fd ->
+            val source = Os.fstat(fd.fileDescriptor)
+            dir.listFiles()?.firstOrNull { file ->
+                file.name.startsWith(prefix) && file.isFile && Os.stat(file.path).let { it.st_dev == source.st_dev && it.st_ino == source.st_ino }
+            }
+        }
+    }
+
+    override fun remove(ticket: SystemVideoTransfers.Ticket) {
+        service.remove(ticket.id)
+    }
+
+    override fun isInteractive() = app.getSystemService(PowerManager::class.java)?.isInteractive != false
+
+    override fun isVideo(file: File): Boolean {
+        // A successful HTTP response can still be an HTML error page or disposable playlist.
+        if (file.length() < 12) return false
+        val type = RandomAccessFile(file, "r").use {
+            it.seek(4)
+            it.readInt()
+        }
+        if (type != 0x66747970) return false // ftyp
+        val extractor = android.media.MediaExtractor()
+        try {
+            extractor.setDataSource(file.absolutePath)
+            return (0 until extractor.trackCount).any {
+                extractor.getTrackFormat(it).getString(android.media.MediaFormat.KEY_MIME)?.startsWith("video/") == true
+            }
+        } finally {
+            extractor.release()
+        }
+    }
+}
