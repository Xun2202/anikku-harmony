+package eu.kanade.tachiyomi.data.download
+
+import eu.kanade.tachiyomi.animesource.model.Track
+import eu.kanade.tachiyomi.animesource.model.Video
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import okhttp3.Headers
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNotNull
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertSame
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+import android.app.DownloadManager as PlatformDownloads
+
+class NavigationChromeSystemVideoTransfersTest {
+    @TempDir lateinit var directory: File
+    private val headers = Headers.headersOf("User-Agent", "Anikku", "Referer", "https://example.org/")
+    private val url = "https://cdn.example.org/video.MP4?version=1"
+    private val media = SystemVideoTransfers.Media(url, headers)
+
+    @Test
+    fun `only portable direct files can leave the app`() {
+        val video = Video(videoUrl = url)
+        assertNotNull(SystemVideoTransfers.media(video, headers))
+        for (address in listOf("http://127.0.0.1/x.mp4", "https://127.0.0.1/x.mp4", "https://user:pw@example.org/v.mp4", "https://cdn.example.org/a.m3u8")) {
+            assertNull(SystemVideoTransfers.media(video.copy(videoUrl = address), headers))
+        }
+        assertNull(SystemVideoTransfers.media(video.copy(audioTracks = listOf(Track(url, "en"))), headers))
+        assertNull(SystemVideoTransfers.media(video.copy(ffmpegVideoArgs = listOf("codec" to "copy")), headers))
+        assertNull(SystemVideoTransfers.media(video, Headers.headersOf("Authorization", "test-value")))
+    }
+
+    @Test
+    fun `provider bytes advance while polling sleeps then a new process reattaches without resolving or enqueueing again`() = runBlocking {
+        val file = File(directory, "finished.mp4").apply { writeBytes(ByteArray(80)) }
+        val backend = Fake()
+        var now = 0L
+        val log = mutableListOf<String>()
+        val deltas = mutableListOf<Long>()
+        val system = SystemVideoTransfers(backend, { now }, {
+            now += 32_000
+            backend.latest = SystemVideoTransfers.Sample(PlatformDownloads.STATUS_SUCCESSFUL, 0, 80, 80, file)
+        }, log::add)
+        system.restore(setOf(9), emptySet())
+        assertSame(file, system.fetch(9, true, true, { media }) { _, _, delta -> deltas += delta })
+        assertEquals(listOf(0L, 0L), deltas)
+        assertTrue(log.any { "previousBytes=10 gapMs=32000" in it && "bytes=80" in it })
+        val afterDeath = SystemVideoTransfers(backend, { now }, { error("completed") }, {})
+        afterDeath.restore(setOf(9), emptySet())
+        assertSame(file, afterDeath.fetch(9, true, true, { error("must reuse original rendition") }) { _, _, _ -> })
+        assertEquals(1, backend.starts)
+        afterDeath.discard(checkNotNull(afterDeath.ticket(9)))
+        assertTrue(backend.owned().isEmpty())
+    }
+
+    @Test
+    fun `an explicit pause cancels a live writer and does not revive paused or removed requests after death`() = runBlocking {
+        val backend = Fake()
+        val entered = CompletableDeferred<Unit>()
+        val system = SystemVideoTransfers(backend, { 0 }, {
+            entered.complete(Unit)
+            awaitCancellation()
+        }, {})
+        system.restore(setOf(7), emptySet())
+        val owner = launch { system.fetch(7, true, true, { media }) { _, _, _ -> } }
+        entered.await()
+        owner.cancelAndJoin()
+        assertTrue(backend.owned().isEmpty())
+        val paused = backend.enqueue(7, media, true)
+        val orphan = backend.enqueue(4, media, true)
+        val active = backend.enqueue(8, media, true)
+        system.restore(setOf(7, 8), setOf(7))
+        assertFalse(paused in backend.owned() || orphan in backend.owned())
+        assertEquals(active, system.ticket(8))
+    }
+
+    @Test
+    fun `a rescheduled worker leaves its transfer with the provider for the successor`() = runBlocking {
+        val backend = Fake()
+        val polling = CompletableDeferred<Unit>()
+        val system = SystemVideoTransfers(backend, { 0 }, {
+            polling.complete(Unit)
+            awaitCancellation()
+        }, {})
+        system.restore(setOf(5), emptySet())
+        val worker = launch { system.fetch(5, true, true, { media }, rescheduling = { true }) { _, _, _ -> } }
+        polling.await()
+        worker.cancelAndJoin()
+        assertEquals(5L, backend.owned().single().episode)
+        val next = SystemVideoTransfers(backend, { 0 }, { error("terminal") }, {})
+        backend.latest = SystemVideoTransfers.Sample(PlatformDownloads.STATUS_FAILED, 403, 0, 0)
+        next.restore(setOf(5), emptySet())
+        assertNull(next.fetch(5, true, true, { error("already submitted") }) { _, _, _ -> })
+        assertEquals(1, backend.starts)
+    }
+
+    @Test
+    fun `failed and truncated successes are removed before the internal transport takes over`() = runBlocking {
+        val partial = File(directory, "bad.mp4").apply { writeBytes(ByteArray(5)) }
+        val complete = SystemVideoTransfers.Sample(PlatformDownloads.STATUS_SUCCESSFUL, 0, 5, 5, partial)
+        for (sample in listOf(
+            SystemVideoTransfers.Sample(PlatformDownloads.STATUS_FAILED, 403, 0, 0),
+            complete.copy(total = 20),
+            complete.copy(bytes = 20),
+            complete,
+        )) {
+            val backend = Fake().apply {
+                latest = sample
+                validVideo = false
+            }
+            val system = SystemVideoTransfers(backend, { 0 }, { error("terminal") }, {})
+            system.restore(setOf(1), emptySet())
+            assertNull(system.fetch(1, false, true, { media }) { _, _, _ -> })
+            assertTrue(backend.owned().isEmpty())
+            assertNull(system.ticket(1))
+        }
+    }
+
+    private class Fake : SystemVideoTransfers.Provider {
+        private val rows = mutableSetOf<SystemVideoTransfers.Ticket>()
+        var latest = SystemVideoTransfers.Sample(PlatformDownloads.STATUS_RUNNING, 0, 10, 80)
+        var starts = 0
+        var validVideo = true
+        override fun owned() = rows.toList()
+        override fun enqueue(episode: Long, media: SystemVideoTransfers.Media, wifiOnly: Boolean) =
+            SystemVideoTransfers.Ticket(episode, (++starts).toLong(), wifiOnly).also { rows += it }
+        override fun sample(ticket: SystemVideoTransfers.Ticket) = latest.takeIf { ticket in rows }
+        override fun remove(ticket: SystemVideoTransfers.Ticket) {
+            rows.remove(ticket)
+        }
+        override fun isInteractive() = true
+        override fun isVideo(file: File) = validVideo
+    }
+}
