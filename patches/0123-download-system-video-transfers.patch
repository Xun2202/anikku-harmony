diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/download/NavigationChromeSystemVideoTransfersTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/download/NavigationChromeSystemVideoTransfersTest.kt
