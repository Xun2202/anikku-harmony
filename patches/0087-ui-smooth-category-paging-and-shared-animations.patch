+package tachiyomi.presentation.core.components
+
+import androidx.compose.animation.core.Animatable
+import androidx.compose.animation.core.AnimationSpec
+import androidx.compose.animation.core.VectorConverter
+import androidx.compose.foundation.ExperimentalFoundationApi
+import androidx.compose.foundation.gestures.FlingBehavior
+import androidx.compose.foundation.gestures.ScrollScope
+import androidx.compose.foundation.gestures.ScrollableDefaults
+import androidx.compose.foundation.gestures.TargetedFlingBehavior
+import androidx.compose.foundation.pager.PagerDefaults
+import androidx.compose.foundation.pager.PagerState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.SideEffect
+import androidx.compose.runtime.State
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.runtime.snapshotFlow
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.launch
+
+/** The same per-operation clock guard as scrolling; healthy and virtual clocks stay unchanged. */
+suspend fun <T> withFrameTimeProtection(block: suspend () -> T): T = withFlingFrameClock(0L, block)
+
+@Composable
+fun rememberFrameTimeProtectedFlingBehavior(
+    native: FlingBehavior = ScrollableDefaults.flingBehavior(),
+): FlingBehavior = remember(native) {
+    object : FlingBehavior {
+        override suspend fun ScrollScope.performFling(initialVelocity: Float): Float {
+            val scope = this
+            return withFrameTimeProtection { with(native) { scope.performFling(initialVelocity) } }
+        }
+    }
+}
+
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+fun rememberFrameTimeProtectedPagerFlingBehavior(state: PagerState): TargetedFlingBehavior {
+    val native = PagerDefaults.flingBehavior(state)
+    return remember(native) {
+        object : TargetedFlingBehavior {
+            override suspend fun ScrollScope.performFling(
+                initialVelocity: Float,
+                onRemainingScrollOffsetUpdate: (Float) -> Unit,
+            ): Float {
+                val scope = this
+                return withFrameTimeProtection {
+                    with(native) { scope.performFling(initialVelocity, onRemainingScrollOffsetUpdate) }
+                }
+            }
+        }
+    }
+}
+
+/** Conflate targets and let Animatable interrupt its old job, retaining retargeting velocity. */
+@Composable
+fun frameTimeProtectedFloatAsState(
+    targetValue: Float,
+    animationSpec: AnimationSpec<Float>,
+    label: String,
+): State<Float> {
+    val animation = remember { Animatable(targetValue, Float.VectorConverter, visibilityThreshold = 0.01f, label = label) }
+    val spec by rememberUpdatedState(animationSpec)
+    val targets = remember { Channel<Float>(Channel.CONFLATED) }
+    SideEffect { targets.trySend(targetValue) }
+    LaunchedEffect(targets) {
+        for (target in targets) {
+            val latest = targets.tryReceive().getOrNull() ?: target
+            launch {
+                if (latest != animation.targetValue) {
+                    withFrameTimeProtection { animation.animateTo(latest, spec) }
+                }
+            }
+        }
+    }
+    return animation.asState()
+}
+
+/** Do not persist intermediate categories or rebuild screen state while a pager is moving. */
+@Composable
+fun ObserveSettledPage(state: PagerState, onPage: (Int) -> Unit) {
+    val currentOnPage by rememberUpdatedState(onPage)
+    LaunchedEffect(state) {
+        snapshotFlow { state.settledPage }.collect { currentOnPage(it) }
+    }
+}
