+package tachiyomi.presentation.core.components
+
+import androidx.compose.animation.core.tween
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.requiredSize
+import androidx.compose.foundation.pager.HorizontalPager
+import androidx.compose.foundation.pager.PagerState
+import androidx.compose.foundation.pager.rememberPagerState
+import androidx.compose.runtime.mutableFloatStateOf
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performTouchInput
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.test.swipeLeft
+import androidx.compose.ui.test.swipeRight
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromePagerAnimationTest {
+    @Test
+    fun `category animation persists only its settled page and rapid retargeting ends on the latest page`() = runComposeUiTest {
+        lateinit var pager: PagerState
+        lateinit var scope: CoroutineScope
+        val saved = mutableListOf<Int>()
+        setContent {
+            pager = rememberPagerState { 12 }
+            scope = rememberCoroutineScope()
+            ObserveSettledPage(pager) { saved += it }
+            HorizontalPager(
+                state = pager,
+                flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(pager),
+                modifier = Modifier.requiredSize(400.dp, 500.dp),
+            ) { Box(Modifier.fillMaxSize()) }
+        }
+        mainClock.autoAdvance = false
+        runOnIdle { scope.launch { withFrameTimeProtection { pager.animateScrollToPage(3) } } }
+        mainClock.advanceTimeBy(80)
+        runOnIdle { assertEquals(listOf(0), saved) }
+        mainClock.advanceTimeBy(1500)
+        runOnIdle {
+            assertEquals(3, pager.settledPage)
+            assertEquals(listOf(0, 3), saved)
+            scope.launch { withFrameTimeProtection { pager.animateScrollToPage(9) } }
+        }
+        mainClock.advanceTimeBy(32)
+        runOnIdle { scope.launch { withFrameTimeProtection { pager.animateScrollToPage(2) } } }
+        mainClock.advanceTimeBy(2000)
+        runOnIdle {
+            assertEquals(2, pager.settledPage)
+            assertEquals(2, saved.last())
+            assertTrue(9 !in saved)
+        }
+    }
+
+    @Test
+    fun `protected native pager fling snaps correctly in both directions`() = runComposeUiTest {
+        lateinit var pager: PagerState
+        setContent {
+            pager = rememberPagerState { 6 }
+            HorizontalPager(
+                state = pager,
+                flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(pager),
+                modifier = Modifier.requiredSize(400.dp, 500.dp).testTag("categories"),
+            ) { Box(Modifier.fillMaxSize()) }
+        }
+        onNodeWithTag("categories").performTouchInput { swipeLeft(durationMillis = 180) }
+        waitForIdle()
+        var leftPage = 0
+        runOnIdle {
+            leftPage = pager.settledPage
+            assertTrue(leftPage in 1..5)
+            assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+        }
+        onNodeWithTag("categories").performTouchInput { swipeRight(durationMillis = 180) }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(pager.settledPage < leftPage)
+            assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+        }
+    }
+
+    @Test
+    fun `protected indicator keeps intermediate animation and conflates rapid target changes`() = runComposeUiTest {
+        val target = mutableFloatStateOf(0f)
+        var value = 0f
+        setContent {
+            value = frameTimeProtectedFloatAsState(target.floatValue, tween(250), "indicator").value
+        }
+        mainClock.autoAdvance = false
+        runOnIdle { target.floatValue = 1f }
+        mainClock.advanceTimeBy(96)
+        runOnIdle { assertTrue(value in 0.01f..0.99f) }
+        runOnIdle {
+            target.floatValue = 0f
+            target.floatValue = 0.4f
+            target.floatValue = 0.8f
+        }
+        mainClock.advanceTimeBy(500)
+        runOnIdle { assertEquals(0.8f, value, 0.001f) }
+    }
+}
