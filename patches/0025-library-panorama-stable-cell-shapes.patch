+package eu.kanade.presentation.library.components
+
+import android.graphics.BitmapFactory
+import androidx.compose.runtime.compositionLocalOf
+import androidx.compose.runtime.mutableStateMapOf
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.BufferedReader
+import java.io.BufferedWriter
+import java.io.File
+import java.io.FileReader
+import java.io.FileWriter
+import kotlin.coroutines.cancellation.CancellationException
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+// Harmony -->
+// Cover shapes (height / width) learnt so far, kept across process restarts so a panorama grid can
+// lay every cell out with its final shape on first composition instead of re-measuring when the
+// image arrives. A shape learnt mid-scroll is what shoves the rest of a staggered lane downward.
+
+private const val MAX_ENTRIES = 20_000
+private const val RATIO_EPSILON = 0.01f
+private const val PERSIST_DELAY_MILLIS = 2_000L
+private const val PREFETCH_PARALLELISM = 4
+
+private val AlwaysSettled: () -> Boolean = { true }
+
+/**
+ * True once the surrounding panorama grid is not scrolling.
+ * Defaults to settled so a grid that never provides it still applies shapes.
+ * The default instance is shared: a fresh lambda on every read would fail equality and recompose forever.
+ */
+val LocalPanoramaGridSettled = compositionLocalOf<() -> Boolean> { AlwaysSettled }
+
+object PanoramaCoverShapes {
+    private val ratios = mutableStateMapOf<Long, Float>()
+    private val stored = LinkedHashMap<Long, Float>()
+    private val gate = Any()
+    private val ready = CompletableDeferred<Unit>()
+
+    private var storeFile: File? = null
+    private var persistScope: CoroutineScope? = null
+    private var persistJob: Job? = null
+
+    @Volatile
+    private var dirty = false
+
+    @Volatile
+    private var initialized = false
+
+    @Volatile
+    private var loaded = false
+
+    fun init(file: File, scope: CoroutineScope) {
+        synchronized(gate) {
+            if (initialized) return
+            initialized = true
+            storeFile = file
+            persistScope = scope
+        }
+        scope.launch(Dispatchers.IO) {
+            try {
+                read(file)
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                // A missing or corrupt file only means covers stay unknown until they are measured.
+            } finally {
+                // Puts that arrived while the file was still loading must not overwrite it early.
+                synchronized(gate) { loaded = true }
+                ready.complete(Unit)
+                if (dirty) schedulePersist()
+            }
+        }
+    }
+
+    fun get(mangaId: Long): Float? = ratios[mangaId]
+
+    fun put(mangaId: Long, ratio: Float) {
+        if (ratio <= 0f || ratio.isNaN() || ratio.isInfinite()) return
+        val changed = synchronized(gate) {
+            val current = stored[mangaId]
+            if (current != null && abs(current - ratio) <= RATIO_EPSILON) {
+                false
+            } else {
+                // Re-insert so the cap drops the oldest entry, not the one just learnt.
+                stored.remove(mangaId)
+                while (stored.size >= MAX_ENTRIES) {
+                    val eldest = stored.entries.iterator().next().key
+                    stored.remove(eldest)
+                    ratios.remove(eldest)
+                }
+                stored[mangaId] = ratio
+                ratios[mangaId] = ratio
+                true
+            }
+        }
+        if (changed) schedulePersist()
+    }
+
+    suspend fun prefetch(entries: List<Pair<Long, () -> File?>>) {
+        if (!initialized) return
+        ready.await()
+        val missing = ArrayList<Pair<Long, () -> File?>>()
+        for (entry in entries) {
+            if (storedRatio(entry.first) == null) missing.add(entry)
+        }
+        if (missing.isEmpty()) return
+        coroutineScope {
+            var next = 0
+            val workers = minOf(PREFETCH_PARALLELISM, missing.size)
+            repeat(workers) {
+                launch(Dispatchers.IO) {
+                    while (isActive) {
+                        val index = synchronized(missing) {
+                            if (next >= missing.size) -1 else next++
+                        }
+                        if (index < 0) return@launch
+                        val (id, fileOf) = missing[index]
+                        if (storedRatio(id) != null) continue
+                        val ratio = readRatio(fileOf) ?: continue
+                        put(id, ratio)
+                    }
+                }
+            }
+        }
+    }
+
+    private fun storedRatio(mangaId: Long): Float? = synchronized(gate) { stored[mangaId] }
+
+    private fun readRatio(fileOf: () -> File?): Float? {
+        val file = try {
+            fileOf()
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            null
+        } ?: return null
+        return decodeRatio(file)
+    }
+
+    private fun decodeRatio(file: File): Float? {
+        return try {
+            if (!file.isFile || file.length() <= 0L) return null
+            val options = BitmapFactory.Options()
+            options.inJustDecodeBounds = true
+            BitmapFactory.decodeFile(file.path, options)
+            val width = options.outWidth
+            val height = options.outHeight
+            if (width <= 0 || height <= 0) return null
+            height.toFloat() / width.toFloat()
+        } catch (_: Exception) {
+            null
+        }
+    }
+
+    private fun schedulePersist() {
+        val scope: CoroutineScope
+        val file: File
+        synchronized(gate) {
+            val currentScope = persistScope
+            val currentFile = storeFile
+            if (!loaded || currentScope == null || currentFile == null) {
+                dirty = true
+                return
+            }
+            dirty = false
+            persistJob?.cancel()
+            scope = currentScope
+            file = currentFile
+            persistJob = scope.launch {
+                delay(PERSIST_DELAY_MILLIS)
+                withContext(Dispatchers.IO) { write(file) }
+            }
+        }
+    }
+
+    private fun read(file: File) {
+        if (!file.isFile) return
+        val parsed = ArrayList<Pair<Long, Float>>()
+        BufferedReader(FileReader(file)).use { reader ->
+            while (true) {
+                val line = reader.readLine() ?: break
+                val space = line.indexOf(' ')
+                if (space <= 0) continue
+                val id = line.substring(0, space).toLongOrNull() ?: continue
+                val ratio = line.substring(space + 1).trim().toFloatOrNull() ?: continue
+                if (ratio <= 0f || ratio.isNaN() || ratio.isInfinite()) continue
+                parsed.add(id to ratio)
+            }
+        }
+        val kept = if (parsed.size > MAX_ENTRIES) {
+            parsed.subList(parsed.size - MAX_ENTRIES, parsed.size)
+        } else {
+            parsed
+        }
+        synchronized(gate) {
+            val newer = LinkedHashMap(stored)
+            stored.clear()
+            for ((id, ratio) in kept) {
+                if (id in newer) continue
+                stored.remove(id)
+                stored[id] = ratio
+                ratios[id] = ratio
+            }
+            for ((id, ratio) in newer) {
+                stored.remove(id)
+                stored[id] = ratio
+                ratios[id] = ratio
+            }
+            while (stored.size > MAX_ENTRIES) {
+                val eldest = stored.entries.iterator().next().key
+                stored.remove(eldest)
+                ratios.remove(eldest)
+            }
+        }
+    }
+
+    private fun write(destination: File) {
+        val parent = destination.parentFile ?: return
+        val snapshot = synchronized(gate) {
+            stored.entries.map { it.key to it.value }
+        }
+        val tmp = File(parent, "${destination.name}.tmp")
+        try {
+            BufferedWriter(FileWriter(tmp)).use { writer ->
+                for ((id, ratio) in snapshot) {
+                    writer.write(id.toString())
+                    writer.write(" ")
+                    writer.write(formatRatio(ratio))
+                    writer.newLine()
+                }
+            }
+            if (!tmp.renameTo(destination)) {
+                tmp.copyTo(destination, overwrite = true)
+                tmp.delete()
+            }
+        } catch (cancelled: CancellationException) {
+            tmp.delete()
+            throw cancelled
+        } catch (_: Exception) {
+            tmp.delete()
+        }
+    }
+
+    private fun formatRatio(ratio: Float): String {
+        val milli = (ratio * 1000f).roundToInt()
+        val whole = milli / 1000
+        val frac = milli % 1000
+        return "$whole.${frac.toString().padStart(3, '0')}"
+    }
+}
+// Harmony <--
