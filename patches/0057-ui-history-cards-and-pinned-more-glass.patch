+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.statusBars
+import androidx.compose.foundation.layout.windowInsetsTopHeight
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+
+/** Static home pages still provide a backdrop for the bottom navigation and the status strip. */
+@Composable
+fun PinnedBrowsingGlass(content: @Composable () -> Unit) {
+    val chrome = LocalBrowsingNavigationBarState.current
+    if (chrome == null) {
+        content()
+        return
+    }
+    val owner = remember { Any() }
+    DisposableEffect(chrome, owner) {
+        chrome.setPinned(owner, true)
+        onDispose { chrome.setPinned(owner, false) }
+    }
+    Box(Modifier.fillMaxSize()) {
+        // The source is a sibling of the status effect, and excludes both navigation overlays.
+        Box(Modifier.fillMaxSize().browsingGlassSource(chrome), propagateMinConstraints = true) {
+            content()
+        }
+        Box(
+            Modifier
+                .align(Alignment.TopCenter)
+                .fillMaxWidth()
+                .windowInsetsTopHeight(WindowInsets.statusBars)
+                .browsingGlassBackground(chrome),
+        )
+    }
+}
