+package tachiyomi.presentation.core.components.material
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+
+class NavigationChromeGeometryTest {
+    @Test
+    fun `leading header cannot outrun the content spacer`() {
+        assertEquals(0f, browsingLeadingHiddenFraction(1f, 0f, 100f))
+        assertEquals(0.25f, browsingLeadingHiddenFraction(1f, 25f, 100f))
+        assertEquals(1f, browsingLeadingHiddenFraction(1f, 200f, 100f))
+        assertEquals(0f, browsingLeadingHiddenFraction(0f, 25f, 100f))
+        assertEquals(1f, browsingLeadingHiddenFraction(1f, Float.POSITIVE_INFINITY, 100f))
+    }
+
+    @Test
+    fun `scrollbar track follows visible chrome while respecting system gestures`() {
+        assertEquals(104f, browsingTrackInset(104f, 100f, 0f, 24f))
+        assertEquals(54f, browsingTrackInset(104f, 100f, 0.5f, 24f))
+        assertEquals(28f, browsingTrackInset(104f, 100f, 1f, 24f))
+        assertEquals(20f, browsingTrackInset(76f, 72f, 1f, 16f))
+    }
+
+    @Test
+    fun `already inset hosts do not lose their parent safety area twice`() {
+        assertEquals(4f, browsingTrackInset(4f, 100f, 1f, 24f))
+        assertEquals(20f, browsingTrackInset(20f, 0f, 1f, 16f))
+        assertEquals(96f, browsingTrackInset(152f, 80f, 1f, 24f))
+    }
+}
