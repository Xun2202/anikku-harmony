+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.semantics.Role
+import androidx.compose.ui.unit.dp
+
+/** The current tab occupies the title slot on wide windows; all pages remain available in the menu. */
+@Composable
+fun BrowsingTabSelector(
+    labels: List<String>,
+    selectedIndex: Int,
+    badges: List<Int?> = emptyList(),
+    onSelect: (Int) -> Unit,
+) {
+    if (labels.isEmpty()) return
+    var expanded by remember { mutableStateOf(false) }
+    val selected = selectedIndex.coerceIn(labels.indices)
+    Box {
+        Row(
+            modifier = Modifier.heightIn(min = 48.dp).clickable(role = Role.Button) { expanded = true },
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(4.dp),
+        ) {
+            Box(Modifier.weight(1f, fill = false)) {
+                ProvideTextStyle(MaterialTheme.typography.titleMedium) {
+                    TabText(labels[selected], badges.getOrNull(selected))
+                }
+            }
+            Text("▾", style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(end = 4.dp))
+        }
+        DropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
+            labels.forEachIndexed { index, label ->
+                DropdownMenuItem(
+                    text = { TabText(label, badges.getOrNull(index)) },
+                    leadingIcon = { Text(if (index == selected) "✓" else "") },
+                    onClick = {
+                        expanded = false
+                        onSelect(index)
+                    },
+                )
+            }
+        }
+    }
+}
