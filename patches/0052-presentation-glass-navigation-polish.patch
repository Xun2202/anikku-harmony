+package tachiyomi.presentation.core.components.material
+
+import android.os.Build
+import androidx.compose.foundation.background
+import androidx.compose.foundation.isSystemInDarkTheme
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.unit.dp
+import dev.chrisbanes.haze.HazeStyle
+import dev.chrisbanes.haze.HazeTint
+import dev.chrisbanes.haze.hazeEffect
+import dev.chrisbanes.haze.hazeSource
+
+/** Blur only the content behind the controls, leaving icons, labels and badges sharp. */
+@Composable
+internal fun Modifier.browsingGlassBackground(state: BrowsingNavigationBarState): Modifier {
+    val surface = MaterialTheme.colorScheme.surface
+    if (Build.VERSION.SDK_INT < 31 || !LocalView.current.isHardwareAccelerated) {
+        return background(surface.copy(alpha = 0.94f))
+    }
+    return hazeEffect(
+        state = state.glassState,
+        style = HazeStyle(
+            backgroundColor = surface,
+            tint = HazeTint(surface.copy(alpha = if (isSystemInDarkTheme()) 0.72f else 0.64f)),
+            blurRadius = 18.dp,
+            noiseFactor = 0.03f,
+            fallbackTint = HazeTint(surface.copy(alpha = 0.94f)),
+        ),
+    )
+}
+
+@Composable
+internal fun Modifier.browsingGlassSource(state: BrowsingNavigationBarState?): Modifier =
+    if (state == null || Build.VERSION.SDK_INT < 31 ||
+        !LocalView.current.isHardwareAccelerated
+    ) {
+        this
+    } else {
+        hazeSource(state.glassState)
+    }
+
+@Composable
+fun browsingChromeContainerColor(): Color =
+    if (LocalBrowsingChrome.current != null) Color.Transparent else MaterialTheme.colorScheme.surface
