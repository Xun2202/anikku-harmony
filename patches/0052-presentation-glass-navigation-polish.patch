+package tachiyomi.presentation.core.components.material
+
+import kotlin.math.max
+import kotlin.math.min
+
+/** At the leading spacer the controls follow the actual content, so they cannot expose a blank band. */
+internal fun browsingLeadingHiddenFraction(animated: Float, leadingOffset: Float?, headerHeight: Float): Float =
+    if (leadingOffset == null || headerHeight <= 0f) {
+        animated
+    } else {
+        min(animated, (leadingOffset / headerHeight).coerceIn(0f, 1f))
+    }
+
+internal fun browsingTrackInset(padding: Float, chromeHeight: Float, hidden: Float, systemInset: Float): Float {
+    // Some hosts already sit inside screen padding. Do not subtract their parent's header again.
+    if (chromeHeight <= 0f || padding + 1f < chromeHeight) return padding
+    return (padding - chromeHeight + max(systemInset, chromeHeight * (1f - hidden))).coerceAtMost(padding)
+}
