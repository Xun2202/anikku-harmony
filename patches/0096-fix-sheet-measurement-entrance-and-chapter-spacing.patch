     SideEffect { nested.allowed = { allowImplicitDismiss && !state.isClosing } }
     DisposableEffect(nested) { onDispose { nested.cancel() } }
 
-    LaunchedEffect(drag, height > 0, state.isClosing) {
-        if (height == 0) {
-            if (state.isClosing) complete()
+    LaunchedEffect(drag, state.isClosing) {
+        if (state.isClosing && height == 0) {
+            complete()
             return@LaunchedEffect
         }
+        // Measurement can happen before this coroutine starts. Await it within one launch:
+        // keying the effect on readiness can cancel its own entrance and mark it as dismissed.
+        snapshotFlow { height > 0 && drag.offset.isFinite() }.first { it }
         state.hasPresented = true
         if (state.isClosing) {
             withFrameTimeProtection {
