@@ -303,7 +311,25 @@ class AppUpdateDownloadJob(private val context: Context, workerParams: WorkerPar
         /** Set when the download was started from the update screen, which then handles the install. */
         private const val EXTRA_INTERACTIVE = "interactive"
 
+        /** Extra tag on downloads started from the update screen, so the screen can tell them apart. */
+        const val TAG_INTERACTIVE = "AppUpdateDownloadInteractive"
+
         fun updateApk(context: Context): File = File(context.externalCacheDir, "update.apk")
+
+        /**
+         * Deletes the downloaded APK once it is installed (or turned out unreadable). Nothing else removes
+         * it: the system installer does not touch the file, so it would otherwise sit in the cache
+         * directory until the next update overwrote it.
+         */
+        fun deleteInstalledApk(context: Context) {
+            val apkFile = updateApk(context)
+            if (!apkFile.exists()) return
+            val downloadedVersionCode = context.packageManager.getPackageArchiveInfo(apkFile.absolutePath, 0)
+                ?.let { PackageInfoCompat.getLongVersionCode(it) }
+            if (downloadedVersionCode == null || downloadedVersionCode <= BuildConfig.VERSION_CODE) {
+                apkFile.delete()
+            }
+        }
         // Harmony <--
 
         // KMK -->
