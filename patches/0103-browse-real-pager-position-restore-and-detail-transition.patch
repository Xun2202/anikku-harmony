+    val rightEdge = maxOf(with(density) { 32.dp.toPx() }, gestures.getRight(density, direction).toFloat())
+    val currentContinue by rememberUpdatedState(onContinue)
+    val canContinue by rememberUpdatedState(enabled)
+
+    BoxWithConstraints(modifier.fillMaxSize().clipToBounds()) {
+        // Half-drags are transient: folding and process restoration must not reopen the reader.
+        val pager = remember(maxWidth) { PagerState { 2 } }
+        val motion = remember(pager) { DetailContinueMotion() }
+        val scope = rememberCoroutineScope()
+
+        fun reset() {
+            motion.generation++
+            motion.settleJob?.cancel()
+            pager.requestScrollToPage(0)
+            motion.phase = DetailContinuePhase.Idle
+            motion.launched = false
+        }
+
+        fun settle(target: Int) {
+            val generation = ++motion.generation
+            motion.settleJob?.cancel()
+            motion.phase = DetailContinuePhase.Settling
+            motion.settleJob = scope.launch {
+                try {
+                    // Native pager spring, guarded by the same frame clock as library paging.
+                    withFrameTimeProtection { pager.animateScrollToPage(target) }
+                } finally {
+                    if (motion.generation == generation) motion.phase = DetailContinuePhase.Idle
+                }
+            }
+        }
+
+        DisposableEffect(lifecycleOwner, pager) {
+            val observer = LifecycleEventObserver { _, event ->
+                if (motion.launched && (event == Lifecycle.Event.ON_STOP || event == Lifecycle.Event.ON_RESUME)) {
+                    // Reset offscreen before the returning activity can draw a stranded page.
+                    reset()
+                }
+            }
+            lifecycleOwner?.lifecycle?.addObserver(observer)
+            onDispose {
+                lifecycleOwner?.lifecycle?.removeObserver(observer)
+                motion.generation++
+                motion.settleJob?.cancel()
+            }
+        }
+
+        LaunchedEffect(enabled, pager) {
+            if (!enabled && !motion.launching && !motion.launched) settle(0)
+        }
+        LaunchedEffect(pager, lifecycleOwner) {
+            snapshotFlow {
+                pager.settledPage == 1 && !pager.isScrollInProgress && motion.phase == DetailContinuePhase.Idle
+            }.collect { completed ->
+                if (completed && canContinue && !motion.launching && !motion.launched) {
+                    motion.launching = true
+                    val opened = try {
+                        currentContinue()
+                    } finally {
+                        motion.launching = false
+                    }
+                    if (!opened) {
+                        settle(0)
+                    } else {
+                        motion.launched = true
+                        if (lifecycleOwner != null) {
+                            // An external player can reject launch without leaving this activity.
+                            if (!lifecycleOwner.lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED)) {
+                                reset()
+                            } else {
+                                delay(1000)
+                                if (motion.launched && lifecycleOwner.lifecycle.currentState == Lifecycle.State.RESUMED) reset()
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        HorizontalPager(
+            state = pager,
+            key = { it },
+            userScrollEnabled = false,
+            beyondViewportPageCount = 1,
+            reverseLayout = direction == LayoutDirection.Rtl,
+            flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(pager),
+            modifier = Modifier.fillMaxSize().pointerInput(enabled, pager, leftEdge, rightEdge) {
+                if (!enabled) return@pointerInput
+                awaitEachGesture {
+                    val down = awaitFirstDown(requireUnconsumed = false)
+                    if (motion.launching || motion.launched) return@awaitEachGesture
+                    val gestureWidth = size.width
+                    if (down.position.x <= leftEdge || down.position.x >= gestureWidth - rightEdge) return@awaitEachGesture
+                    val velocity = VelocityTracker().apply { addPosition(down.uptimeMillis, down.position) }
+                    var horizontal = false
+                    try {
+                        while (true) {
+                            // Children see Main first: chapter actions and horizontal rows own
+                            // their gesture, even when a row has reached its own end.
+                            val event = awaitPointerEvent()
+                            if (size.width != gestureWidth || event.changes.size != 1) break
+                            val change = event.changes.first()
+                            if (change.id != down.id || change.isConsumed) break
+                            velocity.addPosition(change.uptimeMillis, change.position)
+                            val total = change.position - down.position
+                            if (!horizontal) {
+                                if (change.uptimeMillis - down.uptimeMillis >= viewConfiguration.longPressTimeoutMillis) break
+                                if (total.getDistance() <= viewConfiguration.touchSlop) {
+                                    if (!change.pressed) break
+                                    continue
+                                }
+                                if (total.x >= 0f || abs(total.x) <= abs(total.y) * 1.25f) break
+                                motion.generation++
+                                motion.settleJob?.cancel()
+                                motion.phase = DetailContinuePhase.Dragging
+                                horizontal = true
+                                pager.dispatchRawDelta(-total.x - viewConfiguration.touchSlop)
+                            } else {
+                                pager.dispatchRawDelta(change.previousPosition.x - change.position.x)
+                            }
+                            change.consume()
+                            if (!change.pressed) {
+                                val progress = pager.currentPage + pager.currentPageOffsetFraction
+                                val speed = velocity.calculateVelocity().x
+                                val fast = 900.dp.toPx()
+                                val target = when {
+                                    speed > fast -> 0
+                                    speed < -fast && -total.x >= 56.dp.toPx() -> 1
+                                    progress >= 0.5f -> 1
+                                    else -> 0
+                                }
+                                settle(target)
+                                break
+                            }
+                        }
+                    } finally {
+                        if (motion.phase == DetailContinuePhase.Dragging) settle(0)
+                    }
+                }
+            },
+        ) { page ->
+            if (page == 0) content() else previewContent()
+        }
+    }
+}
+
+private enum class DetailContinuePhase { Idle, Dragging, Settling }
+
+private class DetailContinueMotion {
+    var phase by mutableStateOf(DetailContinuePhase.Idle)
+    var launching by mutableStateOf(false)
+    var launched by mutableStateOf(false)
+    var generation = 0L
+    var settleJob: Job? = null
+}
