+/** Detail and its loading destination move together; only a completed page opens the reader. */
+@Composable
+fun DetailContinuePager(
+    enabled: Boolean,
+    onContinue: suspend () -> Boolean,
+    modifier: Modifier = Modifier,
+    previewContent: @Composable () -> Unit = { LoadingScreen() },
+    lifecycleOwner: LifecycleOwner? = LocalView.current.findViewTreeLifecycleOwner(),
+    content: @Composable () -> Unit,
+) {
+    val density = LocalDensity.current
+    val direction = LocalLayoutDirection.current
+    val gestures = WindowInsets.systemGestures
