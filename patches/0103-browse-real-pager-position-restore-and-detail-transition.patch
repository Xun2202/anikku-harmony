+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.pager.HorizontalPager
+import androidx.compose.foundation.pager.rememberPagerState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.runtime.saveable.rememberSaveableStateHolder
+import androidx.compose.runtime.snapshotFlow
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import kotlinx.coroutines.launch
+import tachiyomi.presentation.core.components.material.BrowsingPagerPage
+import kotlin.math.abs
+
+/** Native, bounded paging with the same drag/fling and chrome ownership as library categories. */
+@Composable
+fun SourceBrowsePager(
+    selectedMode: SourceBrowseMode,
+    supportsLatest: Boolean,
+    supportsFilters: Boolean,
+    enabled: Boolean,
+    onSelectMode: (SourceBrowseMode) -> Boolean,
+    pageKey: (SourceBrowseMode) -> String,
+    modifier: Modifier = Modifier,
+    content: @Composable (SourceBrowseMode) -> Unit,
+) {
+    val modes = remember(supportsLatest, supportsFilters, selectedMode) {
+        SourceBrowseMode.entries.filter {
+            it == SourceBrowseMode.Popular || it == selectedMode ||
+                (it == SourceBrowseMode.Latest && supportsLatest) ||
+                (it == SourceBrowseMode.Filtered && supportsFilters)
+        }
+    }
+    val state = rememberPagerState(initialPage = modes.indexOf(selectedMode).coerceAtLeast(0)) { modes.size }
+    val holder = rememberSaveableStateHolder()
+    val selected by rememberUpdatedState(selectedMode)
+    val canSelect by rememberUpdatedState(enabled)
+    val selectMode by rememberUpdatedState(onSelectMode)
+
+    // Chip/search/filter submissions are external selections; use the native settle animation too.
+    LaunchedEffect(selectedMode, enabled, modes) {
+        val target = modes.indexOf(selectedMode).coerceAtLeast(0)
+        if (state.currentPage != target || (!enabled && state.currentPageOffsetFraction != 0f)) {
+            withFrameTimeProtection { state.animateScrollToPage(target) }
+        }
+    }
+    LaunchedEffect(state, modes) {
+        snapshotFlow { if (!state.isScrollInProgress) state.settledPage else null }.collect { page ->
+            val mode = modes.getOrNull(page ?: return@collect) ?: return@collect
+            if (mode != selected) {
+                // A first visit to an unconfigured filter opens its original sheet. Rejecting the
+                // selection animates back, retaining every lazy anchor underneath the sheet.
+                if (!canSelect || !selectMode(mode)) {
+                    // A dialog can disable paging in the same frame and start the same rollback.
+                    // Let that mutation cancel this child animation without losing the observer.
+                    launch {
+                        withFrameTimeProtection { state.animateScrollToPage(modes.indexOf(selected).coerceAtLeast(0)) }
+                    }
+                }
+            }
+        }
+    }
+    HorizontalPager(
+        state = state,
+        key = { modes[it].name },
+        userScrollEnabled = enabled,
+        flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(state),
+        verticalAlignment = Alignment.Top,
+        modifier = modifier.settlePagerOnWidthChange(state).fillMaxSize(),
+    ) { page ->
+        // Pager prefetch may compose a neighbour. Only collect its data once pixels are visible;
+        // an actual drag may load the adjacent page, an untouched offscreen page never does.
+        if (abs(state.currentPage + state.currentPageOffsetFraction - page) < 1f) {
+            val mode = modes[page]
+            BrowsingPagerPage(state, page) {
+                // Keys are source/mode/query revisions, never Flow or LazyPagingItems identities.
+                holder.SaveableStateProvider(pageKey(mode)) { content(mode) }
+            }
+        }
+    }
+}
