+import androidx.compose.foundation.lazy.grid.rememberLazyGridState
+import androidx.compose.foundation.lazy.rememberLazyListState
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.saveable.LocalSaveableStateRegistry
+import androidx.compose.runtime.saveable.SaveableStateRegistry
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import androidx.paging.PagingData
+import androidx.paging.compose.collectAsLazyPagingItems
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.launch
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotSame
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], qualifiers = "mdpi")
+class NavigationChromeSourceBrowseRestoreTest {
+    @Test
+    fun `list retains exact index and offset after detail disposal with new paging identity`() = assertRestore(0)
+
+    @Test
+    fun `grid retains exact index and offset after detail disposal with new paging identity`() = assertRestore(1)
+
+    @Test
+    fun `panorama retains exact anchor after detail disposal with new paging identity`() = assertRestore(2)
+
+    private fun assertRestore(layout: Int) = runComposeUiTest {
+        val shown = mutableStateOf(true)
+        val generation = mutableIntStateOf(0)
+        val queryRevision = mutableIntStateOf(0)
+        val selected = mutableStateOf(SourceBrowseMode.Popular)
+        val registry = mutableStateOf(SaveableStateRegistry(null) { true })
+        val positions = mutableMapOf<SourceBrowseMode, () -> Pair<Int, Int>>()
+        val scrolls = mutableMapOf<SourceBrowseMode, suspend (Int, Int) -> Unit>()
+        lateinit var scope: CoroutineScope
+        var pagingIdentity: Any? = null
+        setContent {
+            if (shown.value) {
+                CompositionLocalProvider(LocalSaveableStateRegistry provides registry.value) {
+                    SourceBrowsePager(
+                        selectedMode = selected.value,
+                        supportsLatest = true,
+                        supportsFilters = true,
+                        enabled = true,
+                        onSelectMode = {
+                            selected.value = it
+                            true
+                        },
+                        pageKey = { "source-123:${it.name}:query-${queryRevision.intValue}" },
+                        modifier = Modifier.requiredSize(320.dp, 500.dp),
+                    ) { mode ->
+                        scope = rememberCoroutineScope()
+                        // Recreated on return, exactly as collectAsLazyPagingItems recreates its
+                        // presenter. The saveable key continues to describe the same source/query.
+                        val flow = remember(generation.intValue, mode) { flowOf(PagingData.from((0 until 200).toList())) }
+                        val paging = flow.collectAsLazyPagingItems()
+                        if (mode == selected.value) pagingIdentity = paging
+                        if (paging.itemCount > 0) {
+                            when (layout) {
+                                0 -> {
+                                    val state = rememberLazyListState()
+                                    positions[mode] = { state.firstVisibleItemIndex to state.firstVisibleItemScrollOffset }
+                                    scrolls[mode] = { index, offset -> state.scrollToItem(index, offset) }
+                                    FastScrollLazyColumn(state = state, modifier = Modifier.fillMaxSize()) {
+                                        items(paging.itemCount, key = { paging.peek(it) ?: it }) {
+                                            Box(Modifier.fillMaxSize().height(64.dp))
+                                        }
+                                    }
+                                }
+                                1 -> {
+                                    val state = rememberLazyGridState()
+                                    positions[mode] = { state.firstVisibleItemIndex to state.firstVisibleItemScrollOffset }
+                                    scrolls[mode] = { index, offset -> state.scrollToItem(index, offset) }
+                                    FastScrollLazyVerticalGrid(state = state, columns = GridCells.Fixed(2)) {
+                                        items(paging.itemCount, key = { paging.peek(it) ?: it }) {
+                                            Box(Modifier.fillMaxSize().height(64.dp))
+                                        }
+                                    }
+                                }
+                                else -> {
+                                    val state = rememberPanoramaMasonryState()
+                                    positions[mode] = { state.firstVisibleItemIndex to state.firstVisibleItemScrollOffset }
+                                    scrolls[mode] = { index, offset -> state.scrollToItem(index, offset) }
+                                    FastScrollPanoramaMasonry(state = state, columns = PanoramaColumns.Fixed(2)) {
+                                        items(
+                                            count = paging.itemCount,
+                                            key = { paging.peek(it) ?: it },
+                                            height = { PanoramaCellHeight.Fixed(if (it % 3 == 0) 100.dp else 150.dp) },
+                                        ) { Box(Modifier.fillMaxSize()) }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        waitUntil { positions[SourceBrowseMode.Popular] != null }
+        runOnIdle { scope.launch { scrolls.getValue(SourceBrowseMode.Popular)(60, 17) } }
+        waitForIdle()
+        var expected = 0 to 0
+        var oldPaging: Any? = null
+        var saved: Map<String, List<Any?>> = emptyMap()
+        runOnIdle {
+            expected = positions.getValue(SourceBrowseMode.Popular)()
+            assertTrue(expected.first > 0)
+            oldPaging = pagingIdentity
+            saved = registry.value.performSave()
+            shown.value = false // source screen completely disposed while detail is shown
+        }
+        waitForIdle()
+        runOnIdle {
+            positions.clear()
+            scrolls.clear()
+            registry.value = SaveableStateRegistry(saved) { true }
+            generation.intValue++
+            shown.value = true
+        }
+        waitUntil { positions[SourceBrowseMode.Popular] != null }
+        waitForIdle()
+        runOnIdle {
+            assertNotSame(oldPaging, pagingIdentity)
+            assertEquals(expected, positions.getValue(SourceBrowseMode.Popular)(), "layout=$layout")
+            selected.value = SourceBrowseMode.Latest
+        }
+        waitForIdle()
+        runOnIdle { scope.launch { scrolls.getValue(SourceBrowseMode.Latest)(30, 9) } }
+        waitForIdle()
+        var latest = 0 to 0
+        runOnIdle {
+            latest = positions.getValue(SourceBrowseMode.Latest)()
+            selected.value = SourceBrowseMode.Popular
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(expected, positions.getValue(SourceBrowseMode.Popular)())
+            selected.value = SourceBrowseMode.Latest
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(latest, positions.getValue(SourceBrowseMode.Latest)())
+            queryRevision.intValue++ // only a genuinely new query receives a fresh scroll state
+        }
+        waitForIdle()
+        runOnIdle { assertEquals(0 to 0, positions.getValue(SourceBrowseMode.Latest)()) }
+    }
+}
