+    /** A flow is created only when a page becomes visible, and reused after detail navigation. */
+    fun mangaPagerFlow(listing: Listing): Flow<PagingData<StateFlow<Pair<Manga, RaisedSearchMetadata?>>>> {
+        visitedPagingFlows.keys.removeAll {
+            it is Listing.Search && it != listing && it != appliedFilterListing && it != lastSearchListing
+        }
+        return visitedPagingFlows.getOrPut(listing) {
+            Pager(PagingConfig(pageSize = 25)) {
