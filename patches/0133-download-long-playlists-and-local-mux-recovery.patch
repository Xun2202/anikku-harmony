+class NavigationChromeDownloadLargeHlsTest {
+    @TempDir
+    lateinit var cache: File
+
+    @Test
+    fun `a chunked playlist above one MiB downloads and saves every fragment in order`() = runBlocking {
+        val segments = 513
+        val query = "x".repeat(2200)
+        val manifest = buildString {
+            append("\uFEFF#EXTM3U\r\n#EXT-X-TOKEN=")
+            append("x".repeat(96 * 1024)).append("\r\n")
+            repeat(segments) { index ->
+                append("#EXTINF:4,\r\n/segment?url=$index&fixture=$query\r\n")
+            }
+            append("#EXT-X-ENDLIST")
+        }
+        assertTrue(manifest.toByteArray().size > 1024 * 1024)
+        val requests = AtomicInteger()
+        val prepared = prepare(
+            manifest = {
+                object : ForwardingSource(Buffer().writeUtf8(manifest)) {
+                    override fun read(sink: Buffer, byteCount: Long): Long = super.read(sink, minOf(257L, byteCount))
+                }.buffer().asResponseBody()
+            },
+            segment = { value ->
+                requests.incrementAndGet()
+                fragment(value)
+            },
+        )
+        assertEquals(segments, requests.get())
+        assertEquals(segments, prepared.segments)
+        assertEquals(segments * 4000L, prepared.durationMillis)
+        val output = File(cache, "offline.ts")
+        DownloadHlsSegments.writeTransportStream(prepared, output) {}
+        assertEquals(segments * PACKET_BYTES.toLong(), output.length())
+        output.inputStream().buffered().use { stream ->
+            for (index in 0 until segments) assertArrayEquals(fragment(index), stream.readNBytes(PACKET_BYTES))
+        }
+    }
+
+    @Test
+    fun `a preview 73 cache is recognized without requesting any fragment`() = runBlocking {
+        val original = File(cache, "8210eec375f0d0d4e74b1eff68d15a54e8ab0646da8cff5b32d0e9fe4d04133e")
+        assertTrue(original.mkdir())
+        File(original, "00000.ts").writeBytes(fragment(0))
+        File(original, "00001.ts").writeBytes(fragment(1))
+        val oldPlan = "#EXTM3U\r#EXTINF:1.0,\r/segment?url=0\r#EXTINF:1.00,\r/segment?url=1\r#EXT-X-ENDLIST"
+        val result = prepare({ oldPlan.toResponseBody() }) { error("Downloaded an existing fragment") }
+        assertEquals(original, result.directory)
+        assertEquals(2L * PACKET_BYTES, result.bytes)
+    }
+
+    @Test
+    fun `the final verified fragment reaches the exact duration despite per-fragment rounding`() = runBlocking {
+        val plan = "#EXTM3U\n" + (1..4).joinToString("") { "#EXTINF:0.0014,\n/segment?url=$it\n" } + "#EXT-X-ENDLIST"
+        val progress = mutableListOf<DownloadHlsSegments.Progress>()
+        val result = prepare({ plan.toResponseBody() }, progress::add, ::fragment)
+        assertEquals(6L, result.durationMillis)
+        assertEquals(result.durationMillis, progress.last().completedMillis)
+        assertTrue(progress.dropLast(1).all { it.completedMillis < it.totalMillis })
+    }
+
+    @Test
+    fun `unknown length oversized lines and oversized playlists stop before requesting media`() = runBlocking {
+        val longLine = "#EXTM3U\n#EXT-X-TOKEN=" + "x".repeat(1024 * 1024)
+        val block = ("#EXT-X-TOKEN=" + "x".repeat(8192) + "\n").toByteArray()
+        val blocks = buildList<InputStream> {
+            add("#EXTM3U\n".byteInputStream())
+            repeat(2048) { add(block.inputStream()) }
+        }
+        val tooManyBytes = SequenceInputStream(Collections.enumeration(blocks)).source().buffer().asResponseBody()
+        for ((body, reason) in listOf(Buffer().writeUtf8(longLine).asResponseBody() to "1 MiB", tooManyBytes to "16 MiB")) {
+            val failure = runCatching { prepare({ body }) { error("Requested a fragment") } }.exceptionOrNull()
+            assertTrue(failure is DownloadHlsSegments.Failure)
+            assertTrue(failure?.message.orEmpty().endsWith(reason))
+        }
+        assertTrue(cache.listFiles().orEmpty().isEmpty())
+    }
+
+    private suspend fun prepare(
+        manifest: () -> ResponseBody,
+        onProgress: (DownloadHlsSegments.Progress) -> Unit = {},
+        segment: (Int) -> ByteArray,
+    ): DownloadHlsSegments.Prepared {
+        val client = OkHttpClient.Builder().addInterceptor { chain ->
+            val request = chain.request()
+            val body = if (request.url.encodedPath == "/m3u8") {
+                manifest()
+            } else {
+                segment(checkNotNull(request.url.queryParameter("url")).toInt()).toResponseBody()
+            }
+            Response.Builder().request(request).protocol(Protocol.HTTP_1_1).code(200).message("test").body(body).build()
+        }.build()
+        return checkNotNull(DownloadHlsSegments.prepare(client, "MissAV", "http://localhost:1234/m3u8", headersOf(), cache, onProgress = onProgress))
+    }
+
+    private fun fragment(index: Int) = ByteArray(PACKET_BYTES) { offset ->
