+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withContext
+import okhttp3.Headers
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import java.io.File
+import java.io.IOException
+import java.math.BigDecimal
+import java.math.RoundingMode
+import java.security.MessageDigest
+import java.util.Locale
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+
+/** Bounded, resumable TS fetches through the extension's existing loopback proxy. */
+internal object DownloadHlsSegments {
+    data class Progress(val bytes: Long, val networkBytes: Long, val completedMillis: Long, val totalMillis: Long)
+
+    data class Prepared(val input: File, val directory: File, val bytes: Long, val durationMillis: Long)
+
+    class Failure(message: String) : IOException(message)
+
+    private data class Segment(val url: HttpUrl, val seconds: BigDecimal, val millis: Long)
+
+    suspend fun prepare(
+        client: OkHttpClient,
+        sourceName: String,
+        url: String,
+        headers: Headers,
+        cacheRoot: File,
+        onProgress: (Progress) -> Unit,
+    ): Prepared? = try {
+        withContext(Dispatchers.IO) {
+            // Other extensions can expose the same proxy endpoints. This rollout is MissAV only.
+            if (!sourceName.equals("MissAV", ignoreCase = true)) return@withContext null
+            val manifestUrl = url.toHttpUrlOrNull()?.takeIf { isProxy(it) && it.encodedPath == "/m3u8" }
+                ?: return@withContext null
+            val text = fetch(client, Request.Builder().url(manifestUrl).headers(headers).build()) { response ->
+                if (!response.isSuccessful) throw Failure("HLS manifest HTTP ${response.code}")
+                val source = response.body.source()
+                source.request(MAX_MANIFEST_BYTES + 1)
+                if (source.buffer.size > MAX_MANIFEST_BYTES) throw Failure("HLS manifest exceeds size limit")
+                source.readUtf8()
+            }
+            val segments = parse(text, manifestUrl) ?: return@withContext null
+            val totalMillis = try {
+                segments.fold(BigDecimal.ZERO) { sum, segment -> sum + segment.seconds }
+                    .movePointRight(3).setScale(0, RoundingMode.HALF_UP).longValueExact()
+            } catch (_: ArithmeticException) {
+                return@withContext null
+            }
+            val fingerprint = MessageDigest.getInstance("SHA-256").digest(
+                buildString {
+                    segments.forEach { segment ->
+                        append(segment.seconds.stripTrailingZeros().toPlainString()).append('\n')
+                        segment.url.queryParameterNames.sorted().forEach { name ->
+                            segment.url.queryParameterValues(name).forEach { value ->
+                                append(name.length).append(':').append(name)
+                                append(value?.length ?: -1).append(':').append(value.orEmpty()).append('\n')
+                            }
+                        }
+                        append('\n')
+                    }
+                }.toByteArray(Charsets.UTF_8),
+            ).joinToString("") { "%02x".format(Locale.ROOT, it) }
+            val directory = File(cacheRoot, fingerprint)
+            if (!directory.isDirectory && !directory.mkdirs()) throw Failure("Cannot create segment cache")
+            val state = ProgressState(totalMillis, onProgress)
+            val pending = mutableListOf<Int>()
+            segments.forEachIndexed { index, segment ->
+                val file = segmentFile(directory, index)
+                if (validTs(file)) {
+                    state.complete(file.length(), segment.millis)
+                } else {
+                    pending += index
+                }
+            }
+            var next = 0
+            coroutineScope {
+                repeat(minOf(2, pending.size)) {
+                    launch {
+                        while (true) {
+                            val index = synchronized(pending) {
+                                if (next < pending.size) pending[next++] else null
+                            } ?: break
+                            val segment = segments[index]
+                            val file = segmentFile(directory, index)
+                            var failure: IOException? = null
+                            for (attempt in 0..2) {
+                                ensureActive()
+                                val partial = File(directory, "${file.name}.part")
+                                try {
+                                    fetch(client, Request.Builder().url(segment.url).headers(headers).build()) { response ->
+                                        if (!response.isSuccessful) throw Failure("HLS segment HTTP ${response.code}")
+                                        val expected = response.body.contentLength()
+                                        var count = 0L
+                                        partial.outputStream().use { output ->
+                                            response.body.byteStream().use { input ->
+                                                val buffer = ByteArray(32 * 1024)
+                                                while (true) {
+                                                    ensureActive()
+                                                    val read = input.read(buffer)
+                                                    if (read < 0) break
+                                                    count += read
+                                                    state.received(read.toLong())
+                                                    output.write(buffer, 0, read)
+                                                }
+                                            }
+                                        }
+                                        if (count == 0L || (expected >= 0 && expected != count) || !validTs(partial)) {
+                                            throw Failure("Invalid or incomplete HLS TS segment")
+                                        }
+                                        ensureActive()
+                                        if (!partial.renameTo(file)) throw Failure("Cannot finalize HLS segment cache")
+                                    }
+                                    state.complete(file.length(), segment.millis)
+                                    failure = null
+                                    break
+                                } catch (cancelled: CancellationException) {
+                                    throw cancelled
+                                } catch (error: IOException) {
+                                    ensureActive()
+                                    failure = error
+                                    if (attempt < 2) delay((attempt + 1) * 1000L)
+                                }
+                            }
+                            failure?.let {
+                                val detail = if (it is Failure) it.message else it.javaClass.simpleName
+                                throw Failure("HLS segment ${index + 1}/${segments.size} failed after 3 attempts: $detail")
+                            }
+                        }
+                    }
+                }
+            }
+            ensureActive()
+            val input = File(directory, "input.ffconcat")
+            File(directory, "input.ffconcat.part").let { partial ->
+                partial.bufferedWriter().use { writer ->
+                    writer.appendLine("ffconcat version 1.0")
+                    segments.forEachIndexed { index, segment ->
+                        writer.appendLine("file '${segmentFile(directory, index).name}'")
+                        writer.appendLine("duration ${segment.seconds.toPlainString()}")
+                    }
+                }
+                if (!partial.renameTo(input)) throw Failure("Cannot finalize local HLS plan")
+            }
+            Prepared(input, directory, state.snapshot().bytes, totalMillis)
+        }
+    } catch (cancelled: CancellationException) {
+        throw cancelled
+    } catch (error: IOException) {
+        throw if (error is Failure) error else Failure("HLS segment preparation failed: ${error.javaClass.simpleName}")
+    }
+
+    /** Cancellation cancels the call immediately; synchronous IO must exit before this block returns. */
+    private suspend fun <T> fetch(client: OkHttpClient, request: Request, read: (Response) -> T): T =
+        suspendCancellableCoroutine { continuation ->
+            val call = client.newCall(request)
+            continuation.invokeOnCancellation { call.cancel() }
+            try {
+                val result = call.execute().use(read)
+                continuation.resume(result)
+            } catch (error: Exception) {
+                continuation.resumeWithException(error)
+            }
+        }
+
+    private fun parse(text: String, base: HttpUrl): List<Segment>? {
+        val lines = text.removePrefix("\uFEFF").lineSequence().iterator()
+        if (!lines.hasNext() || lines.next().trim() != "#EXTM3U") return null
+        val result = mutableListOf<Segment>()
+        var seconds: BigDecimal? = null
+        var ended = false
+        for (raw in lines) {
+            val line = raw.trim()
+            when {
+                line.isEmpty() -> Unit
+                line == "#EXT-X-ENDLIST" -> ended = true
+                line.startsWith("#EXTINF:") -> {
+                    if (ended || seconds != null) return null
+                    val value = line.substringAfter(':').substringBefore(',').trim()
+                    if (!DECIMAL.matches(value)) return null
+                    seconds = value.toBigDecimalOrNull()?.takeIf { it.signum() > 0 } ?: return null
+                }
+                line == "#EXT-X-KEY:METHOD=NONE" -> Unit
+                line.startsWith("#EXT-X-VERSION:") || line.startsWith("#EXT-X-TARGETDURATION:") ||
+                    line.startsWith("#EXT-X-MEDIA-SEQUENCE:") || line.startsWith("#EXT-X-PLAYLIST-TYPE:") ||
+                    line.startsWith("#EXT-X-PROGRAM-DATE-TIME:") || line.startsWith("#EXT-X-TOKEN=") ||
+                    line == "#EXT-X-INDEPENDENT-SEGMENTS" -> Unit
+                line.startsWith('#') -> return null
+                else -> {
+                    if (ended) return null
+                    val duration = seconds ?: return null
+                    val segmentUrl = base.resolve(line) ?: return null
+                    if (!isProxy(segmentUrl) || segmentUrl.host != base.host || segmentUrl.port != base.port ||
+                        segmentUrl.scheme != base.scheme || segmentUrl.encodedPath != "/segment" || segmentUrl.queryParameter("url").isNullOrBlank()
+                    ) {
+                        return null
+                    }
+                    val millis = runCatching {
+                        duration.movePointRight(3).setScale(0, RoundingMode.HALF_UP).longValueExact()
+                    }.getOrNull()?.takeIf { it > 0 } ?: return null
+                    result += Segment(segmentUrl, duration, millis)
+                    if (result.size > 20_000) return null
+                    seconds = null
+                }
+            }
+        }
+        return result.takeIf { ended && seconds == null && it.isNotEmpty() }
+    }
+
+    private fun isProxy(url: HttpUrl): Boolean = url.scheme == "http" && url.host in setOf("localhost", "127.0.0.1", "::1")
+
+    private fun segmentFile(directory: File, index: Int): File = File(directory, "%05d.ts".format(Locale.ROOT, index))
+
+    private fun validTs(file: File): Boolean {
+        if (!file.isFile || file.length() == 0L) return false
+        return try {
+            file.inputStream().use { input ->
+                val head = ByteArray(4096)
+                var size = 0
+                while (size < head.size) {
+                    val count = input.read(head, size, head.size - size)
+                    if (count < 0) break
+                    size += count
+                }
+                (0 until size - 376).any { offset ->
+                    head[offset] == 0x47.toByte() && head[offset + 188] == 0x47.toByte() && head[offset + 376] == 0x47.toByte()
+                }
+            }
+        } catch (_: IOException) {
+            false
+        }
+    }
+
+    private class ProgressState(private val total: Long, private val callback: (Progress) -> Unit) {
+        private var bytes = 0L
+        private var network = 0L
+        private var millis = 0L
+        private var lastReport = 0L
+
+        @Synchronized
+        fun received(count: Long) {
+            network += count
+            val now = System.nanoTime()
+            if (now - lastReport >= 250_000_000L) {
+                lastReport = now
+                callback(snapshot())
+            }
+        }
+
+        @Synchronized
+        fun complete(count: Long, duration: Long) {
+            bytes += count
+            millis += duration
+            lastReport = System.nanoTime()
+            callback(snapshot())
+        }
+
+        @Synchronized
+        fun snapshot(): Progress = Progress(bytes, network, minOf(millis, total), total)
+    }
+
+    private const val MAX_MANIFEST_BYTES = 1024L * 1024
+    private val DECIMAL = Regex("[0-9]+(?:\\.[0-9]*)?")
+}
