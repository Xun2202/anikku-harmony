+class NavigationChromeDownloadHlsSegmentsTest {
+    @Test
+    fun `two workers fetch TS through proxy with headers and write only relative concat entries`() = withCache { cache ->
+        val active = AtomicInteger()
+        val maximum = AtomicInteger()
+        val calls = AtomicInteger()
+        val client = client { chain ->
+            if (chain.request().url.encodedPath == "/m3u8") {
+                response(chain, manifest(4).toByteArray())
+            } else {
+                assertEquals("test", chain.request().header("Cookie"))
+                calls.incrementAndGet()
+                val current = active.incrementAndGet()
+                maximum.updateAndGet { maxOf(it, current) }
+                Thread.sleep(40)
+                active.decrementAndGet()
+                response(chain, TS)
+            }
+        }
+        val progress = mutableListOf<DownloadHlsSegments.Progress>()
+        val prepared = DownloadHlsSegments.prepare(client, "MissAV", URL, headersOf("Cookie", "test"), cache, progress::add)!!
+        assertEquals(4, calls.get())
+        assertEquals(2, maximum.get())
+        assertEquals(4L * TS.size, prepared.bytes)
+        assertEquals(4000L, prepared.durationMillis)
+        assertEquals(prepared.bytes, progress.last().networkBytes)
+        assertEquals(4000L, progress.last().completedMillis)
+        val concat = prepared.input.readText()
+        assertTrue(concat.startsWith("ffconcat version 1.0\n"))
+        assertTrue(concat.contains("file '00000.ts'"))
+        assertFalse(concat.contains("http") || concat.contains("token"))
+    }
+
+    @Test
+    fun `completed files resume without segment traffic after localhost port changes`() = withCache { cache ->
+        val segmentCalls = AtomicInteger()
+        val client = client { chain ->
+            if (chain.request().url.encodedPath == "/m3u8") {
+                response(chain, manifest(2).toByteArray())
+            } else {
+                segmentCalls.incrementAndGet()
+                response(chain, TS)
+            }
+        }
+        val first = DownloadHlsSegments.prepare(client, "MissAV", URL, headersOf(), cache) {}!!
+        var last: DownloadHlsSegments.Progress? = null
+        val second = DownloadHlsSegments.prepare(client, "MissAV", URL.replace("1234", "9876"), headersOf(), cache) { last = it }!!
+        assertEquals(first.directory, second.directory)
+        assertEquals(2, segmentCalls.get())
+        assertEquals(0L, last!!.networkBytes)
+        assertEquals(first.bytes, second.bytes)
+    }
+
+    @Test
+    fun `a single transient failure retries just that segment`() = withCache { cache ->
+        val segmentCalls = AtomicInteger()
