+            } else {
+                response(chain, TS)
+            }
+        }
+        assertNotNull(DownloadHlsSegments.prepare(client, "MissAV", URL, headersOf(), cache) {})
+        assertEquals(2, segmentCalls.get())
+    }
+
+    @Test
+    fun `permanent failure does not skip a segment or discard completed neighbours`() = withCache { cache ->
+        val badCalls = AtomicInteger()
+        val client = client { chain ->
+            when {
+                chain.request().url.encodedPath == "/m3u8" -> response(chain, manifest(2).toByteArray())
+                chain.request().url.queryParameter("url") == "0" -> response(chain, TS)
+                else -> {
+                    badCalls.incrementAndGet()
+                    response(chain, byteArrayOf(), 503)
+                }
+            }
+        }
+        val failure = runCatching { DownloadHlsSegments.prepare(client, "MissAV", URL, headersOf(), cache) {} }.exceptionOrNull()
+        assertTrue(failure is DownloadHlsSegments.Failure)
+        assertEquals(3, badCalls.get())
+        assertEquals(1, cache.walkTopDown().count { it.name == "00000.ts" })
+        assertFalse(cache.walkTopDown().any { it.name == "input.ffconcat" })
+    }
+
+    @Test
+    fun `cancellation waits for blocking call and never promotes a partial file`() = withCache { cache ->
+        val entered = CountDownLatch(1)
+        val exited = CountDownLatch(1)
+        val client = client { chain ->
+            if (chain.request().url.encodedPath == "/m3u8") {
+                response(chain, manifest(1).toByteArray())
+            } else {
+                var sent = false
+                val source = object : Source {
+                    override fun read(sink: Buffer, byteCount: Long): Long {
+                        if (!sent) {
+                            sent = true
+                            sink.write(TS, 0, 100)
+                            return 100
+                        }
+                        entered.countDown()
+                        while (!chain.call().isCanceled()) Thread.sleep(5)
+                        throw IOException("cancelled")
+                    }
+
+                    override fun timeout(): Timeout = Timeout.NONE
+
+                    override fun close() {
+                        exited.countDown()
+                    }
+                }.buffer()
+                response(chain, byteArrayOf()).newBuilder().body(object : ResponseBody() {
+                    override fun contentType() = null
+                    override fun contentLength(): Long = -1
+                    override fun source() = source
+                }).build()
+            }
+        }
+        kotlinx.coroutines.coroutineScope {
+            val job = launch { DownloadHlsSegments.prepare(client, "MissAV", URL, headersOf(), cache) {} }
+            // IO workers must be able to start while the test thread is waiting.
+            kotlinx.coroutines.yield()
+            assertTrue(entered.await(5, TimeUnit.SECONDS))
+            job.cancelAndJoin()
+            assertEquals(0L, exited.count)
+        }
+        assertFalse(cache.walkTopDown().any { it.extension == "ts" || it.name == "input.ffconcat" })
+        assertTrue(cache.walkTopDown().any { it.name == "00000.ts.part" && it.length() == 100L })
+        val resumedClient = client { chain ->
+            response(chain, if (chain.request().url.encodedPath == "/m3u8") manifest(1).toByteArray() else TS)
+        }
+        assertNotNull(DownloadHlsSegments.prepare(resumedClient, "MissAV", URL, headersOf(), cache) {})
+    }
+
+    @Test
+    fun `invalid TS fails rather than producing a merged plan`() = withCache { cache ->
+        val calls = AtomicInteger()
+        val client = client { chain ->
+            if (chain.request().url.encodedPath == "/m3u8") {
+                response(chain, manifest(1).toByteArray())
+            } else {
+                calls.incrementAndGet()
+                response(chain, "<html>not TS</html>".toByteArray())
+            }
+        }
+        assertTrue(runCatching { DownloadHlsSegments.prepare(client, "MissAV", URL, headersOf(), cache) {} }.exceptionOrNull() is DownloadHlsSegments.Failure)
+        assertEquals(3, calls.get())
+        assertFalse(cache.walkTopDown().any { it.extension == "ts" || it.name == "input.ffconcat" })
+    }
+
+    @Test
+    fun `encrypted ranged mapped live and remote manifests fall back without segment requests`() = withCache { cache ->
+        val unsupported = listOf(
+            manifest(1).replace("#EXTINF", "#EXT-X-KEY:METHOD=AES-128,URI=\"key\"\n#EXTINF"),
+            manifest(1).replace("#EXTINF", "#EXT-X-BYTERANGE:188\n#EXTINF"),
+            manifest(1).replace("#EXTINF", "#EXT-X-MAP:URI=\"init\"\n#EXTINF"),
+            manifest(1).replace("#EXT-X-ENDLIST", ""),
+            manifest(1).replace("/segment?url=0", "https://cdn.example/segment.ts"),
+            "not HLS",
+        )
+        unsupported.forEach { text ->
+            var calls = 0
+            val client = client { chain ->
+                calls++
+                assertEquals("/m3u8", chain.request().url.encodedPath)
+                response(chain, text.toByteArray())
+            }
+            assertNull(DownloadHlsSegments.prepare(client, "MissAV", URL, headersOf(), cache) {})
+            assertEquals(1, calls)
+        }
+        assertTrue(cache.listFiles().orEmpty().isEmpty())
+    }
+
+    @Test
+    fun `other sources sharing the proxy and non proxy inputs never enter this downloader`() = withCache { cache ->
+        val client = client { error("Ineligible source must not make any network request") }
+        listOf("RouXun", "XNXX Xun", "MissAV Xun", "Other").forEach { source ->
+            assertNull(DownloadHlsSegments.prepare(client, source, URL, headersOf(), cache) {})
+        }
+        listOf("https://cdn.example/video.m3u8", "http://localhost:1234/other", "https://localhost:1234/m3u8").forEach { url ->
+            assertNull(DownloadHlsSegments.prepare(client, "MissAV", url, headersOf(), cache) {})
+        }
+        assertTrue(cache.listFiles().orEmpty().isEmpty())
+    }
+
+    private fun withCache(block: suspend (File) -> Unit) = runBlocking {
+        val cache = createTempDirectory("hls-segments-test").toFile()
+        try {
+            block(cache)
+        } finally {
+            cache.deleteRecursively()
+        }
+    }
+
+    private fun manifest(count: Int): String = buildString {
+        appendLine("#EXTM3U")
+        appendLine("#EXT-X-TOKEN=ignored-fixture")
+        repeat(count) { index ->
+            appendLine("#EXTINF:1.0,")
+            appendLine("/segment?url=$index")
+        }
+        appendLine("#EXT-X-ENDLIST")
+    }
+
+    private fun client(interceptor: Interceptor): OkHttpClient = OkHttpClient.Builder().addInterceptor(interceptor).build()
+
+    private fun response(chain: Interceptor.Chain, bytes: ByteArray, code: Int = 200): Response = Response.Builder()
+        .request(chain.request()).protocol(Protocol.HTTP_1_1).code(code).message("test")
+        .body(bytes.toResponseBody()).build()
+
+    private companion object {
+        const val URL = "http://localhost:1234/m3u8?url=private"
+        val TS = ByteArray(188 * 4) { if (it % 188 == 0) 0x47 else 0 }
+    }
+}
