+package eu.kanade.tachiyomi.data.download
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class NavigationChromeDownloadFfmpegLogsTest {
+    @Test
+    fun `native numeric ERROR survives later warnings and info summaries without needing keywords`() {
+        val logs = DownloadFfmpegLogs()
+        logs.record(16, "A native cause without a matching keyword")
+        repeat(20) { logs.record(24, "Later warning $it") }
+        logs.record(32, "Informational output")
+        val detail = logs.failureDetail("Conversion failed!\nvideo:100kB audio:10kB muxing overhead: 1%", "1")
+        assertTrue(detail.contains("A native cause without a matching keyword"))
+        assertFalse(detail.contains("Informational output"))
+    }
+
+    @Test
+    fun `AAC bitstream and timestamp causes precede terminal statistics`() {
+        val cause = "Malformed AAC bitstream detected: use the audio bitstream filter aac_adtstoasc to fix it"
+        val detail = DownloadFfmpegPolicy.failureDetail(
+            listOf(cause, "Conversion failed!", "video:100kB audio:10kB", "muxing overhead: 1%"),
+            "1",
+        )
+        assertTrue(detail.startsWith(cause))
+        assertTrue(DownloadFfmpegPolicy.failureDetail(listOf("Non-monotonous DTS in output stream", "summary", "end"), "1").startsWith("Non-monotonous DTS"))
+    }
+
+    @Test
+    fun `first and latest native errors survive many intermediate error records`() {
+        val logs = DownloadFfmpegLogs()
+        logs.record(8, "Initial fatal cause")
+        repeat(100) { logs.record(16, "Intermediate record $it") }
+        logs.record(0, "Final panic cause")
+        val detail = logs.failureDetail("Conversion failed!", "1")
+        assertTrue(detail.contains("Initial fatal cause"))
+        assertTrue(detail.contains("Final panic cause"))
+        assertTrue(detail.length <= 1600)
+    }
+
+    @Test
+    fun `retained callback diagnostics redact URL credentials query and secret headers`() {
+        val logs = DownloadFfmpegLogs()
+        logs.record(16, "[aac @ 0xABC] Failed https://user:password@cdn.example/segment?token=private\nAuthorization: Bearer private-secret\nCookie: private-cookie")
+        val detail = logs.failureDetail("Conversion failed!", "1")
+        assertTrue(detail.contains("https://cdn.example/segment"))
+        listOf("password", "private", "user:", "0xABC", "token=").forEach { assertFalse(detail.contains(it)) }
+    }
+
+    @Test
+    fun `empty diagnostics retain return code and large records remain bounded`() {
+        assertEquals("rc=-1", DownloadFfmpegLogs().failureDetail("", "-1"))
+        val logs = DownloadFfmpegLogs()
+        repeat(1000) { logs.record(16, "$it " + "x".repeat(2000)) }
+        assertTrue(logs.failureDetail("Conversion failed!", "1").length <= 1600)
+    }
+
+    @Test
+    fun `AAC filter retry requires the explicit native bitstream conversion recommendation`() {
+        val recommendation = "Malformed AAC bitstream detected: use the audio bitstream filter 'aac_adtstoasc' to fix it ('-bsf:a aac_adtstoasc' option with ffmpeg)"
+        assertTrue(DownloadFfmpegPolicy.needsAacAdtsToAsc(recommendation))
+        val logs = DownloadFfmpegLogs()
+        logs.record(16, recommendation)
+        repeat(20) { logs.record(24, "Following warning $it") }
+        assertTrue(logs.needsAacAdtsToAsc("Conversion failed!"))
+        listOf(
+            "Malformed AAC bitstream detected",
+            "Invalid ADTS data",
+            "Error applying aac_adtstoasc filter",
+            "Malformed AAC bitstream\nUse aac_adtstoasc for a different stream",
+            "Conversion failed!",
+        ).forEach { assertFalse(DownloadFfmpegPolicy.needsAacAdtsToAsc(it)) }
+    }
+}
