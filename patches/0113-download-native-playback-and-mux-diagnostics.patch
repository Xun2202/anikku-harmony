+package eu.kanade.tachiyomi.data.download
+
+/** Preserve native error severity separately from the warning tail and ffmpeg's final summary. */
+internal class DownloadFfmpegLogs {
+    class Failure(detail: String, val needsAdtsConversion: Boolean) : java.io.IOException("ffmpeg: $detail")
+
+    private val firstErrors = mutableListOf<String>()
+    private val lastErrors = ArrayDeque<String>()
+    private val warnings = ArrayDeque<String>()
+
+    /** Use FFmpeg's numeric level value, independent of the Java enum's declaration order. */
+    @Synchronized
+    fun record(levelValue: Int, message: String?) {
+        if (message == null || levelValue > 24 || levelValue == -8) return
+        message.lineSequence().forEach { raw ->
+            val line = DownloadFfmpegPolicy.sanitizeLogLine(raw).take(320)
+            if (line.isEmpty()) return@forEach
+            if (levelValue in 0..16) {
+                if (line !in firstErrors && firstErrors.size < 2) firstErrors += line
+                append(lastErrors, line, 2)
+            } else {
+                append(warnings, line, 4)
+            }
+        }
+    }
+
+    @Synchronized
+    fun failureDetail(sessionLogs: String, returnCode: String): String {
+        val errors = (firstErrors + lastErrors).distinct()
+        val context = DownloadFfmpegPolicy.failureDetail(listOf(sessionLogs) + warnings, returnCode)
+        // Numeric ERROR/FATAL records are retained even when their wording lacks a known keyword.
+        return (errors + context.take(300)).distinct().joinToString(" | ").take(1600)
+    }
+
+    @Synchronized
+    fun needsAacAdtsToAsc(sessionLogs: String): Boolean =
+        (firstErrors + lastErrors + warnings + sessionLogs).any(DownloadFfmpegPolicy::needsAacAdtsToAsc)
+
+    private fun append(lines: ArrayDeque<String>, line: String, limit: Int) {
+        if (lines.lastOrNull() == line) return
+        if (lines.size == limit) lines.removeFirst()
+        lines.addLast(line)
+    }
+}
