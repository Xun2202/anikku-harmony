@@ -0,0 +1,119 @@
+package eu.kanade.tachiyomi.network.interceptor
+
+import okhttp3.HttpUrl
+import okhttp3.Interceptor
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import okio.utf8Size
+import java.io.IOException
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * The extension's loopback proxy resolves media URIs against its input URL even after its HTTP client follows a redirect.
+ * While that proxy is reading a download playlist, resolve relative references on the successful response that supplied them.
+ */
+object HlsPlaylistRedirectInterceptor : Interceptor {
+    private class Watch {
+        @Volatile
+        var changed: Int = 0
+    }
+
+    private val active = ConcurrentHashMap<HttpUrl, List<Watch>>()
+    private const val MAX_BYTES = 16L * 1024 * 1024
+    private val attribute = Regex("""([A-Z0-9-]+)=("[^"]*"|[^,]*)""")
+
+    suspend fun <T> during(url: HttpUrl?, report: (Int) -> Unit, read: suspend () -> T): T {
+        if (url == null) return read()
+        val watch = Watch()
+        active.compute(url) { _, watches -> watches.orEmpty() + watch }
+        try {
+            return read()
+        } finally {
+            active.computeIfPresent(url) { _, watches -> (watches - watch).ifEmpty { null } }
+            if (watch.changed > 0) report(watch.changed)
+        }
+    }
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        val watchers = active[request.url]
+        val response = chain.proceed(request)
+        if (watchers == null || request.method != "GET" || response.code != 200) return response
+        val effective = response.request.url
+        val original = request.url
+        if (original == effective || (original.isHttps && !effective.isHttps) ||
+            effective.username.isNotEmpty() || effective.password.isNotEmpty() ||
+            generateSequence(response.priorResponse) { it.priorResponse }.none { it.isRedirect } ||
+            response.header("Content-Encoding")?.equals("identity", ignoreCase = true) == false ||
+            response.body.contentLength() > MAX_BYTES
+        ) {
+            return response
+        }
+
+        try {
+            if (!response.peekBody(16).string().removePrefix("\uFEFF").startsWith("#EXTM3U")) return response
+            val copy = response.peekBody(MAX_BYTES + 1)
+            if (copy.contentLength() > MAX_BYTES) return response
+            val result = rebase(copy.string(), original, effective) ?: return response
+            val body = result.text.toResponseBody(response.body.contentType())
+            response.close()
+            watchers.forEach { it.changed = result.count }
+            return response.newBuilder()
+                .removeHeader("ETag")
+                .removeHeader("Content-MD5")
+                .removeHeader("Digest")
+                .header("Content-Length", body.contentLength().toString())
+                .body(body)
+                .build()
+        } catch (error: IOException) {
+            response.close()
+            throw error
+        }
+    }
+
+    private data class Rebased(val text: String, val count: Int)
+
+    private fun rebase(text: String, original: HttpUrl, effective: HttpUrl): Rebased? {
+        if (text.lineSequence().firstOrNull()?.removePrefix("\uFEFF")?.trim() != "#EXTM3U") return null
+        var count = 0
+        fun resolve(value: String): String {
+            if (value.isBlank()) return value
+            val destination = effective.resolve(value) ?: return value
+            if (destination == original.resolve(value) || destination.username.isNotEmpty() || destination.password.isNotEmpty()) {
+                return value
+            }
+            count++
+            return destination.toString()
+        }
+
+        var media = false
+        var ended = false
+        var bytes = 0L
+        val output = StringBuilder(text.length)
+        for (line in text.lineSequence()) {
+            if (line.length > 1024 * 1024) return null
+            val raw = line.trim()
+            val replacement = when {
+                raw.startsWith("#EXTINF:") -> line.also { media = true }
+                raw == "#EXT-X-ENDLIST" -> line.also { ended = true }
+                raw.startsWith("#EXT-X-KEY:") || raw.startsWith("#EXT-X-MAP:") -> attribute.replace(line) { match ->
+                    val value = match.groupValues[2]
+                    if (match.groupValues[1] == "URI" && value.startsWith('"') && value.endsWith('"')) {
+                        "URI=\"${resolve(value.removeSurrounding("\""))}\""
+                    } else {
+                        match.value
+                    }
+                }
+                // Leave playlists with other resource-bearing tags entirely to the source.
+                raw.startsWith("#EXT-X-DEFINE:") || (raw.startsWith("#EXT-X-") && raw.contains("URI=")) -> return null
+                raw.isEmpty() || raw.startsWith('#') -> line
+                else -> resolve(raw)
+            }
+            bytes += replacement.utf8Size() + if (output.isEmpty()) 0 else 1
+            if (bytes > MAX_BYTES) return null
+            if (output.isNotEmpty()) output.append('\n')
+            output.append(replacement)
+        }
+        return if (media && ended && count > 0) Rebased(output.toString(), count) else null
+    }
+}
