+    private fun BigDecimal.toMillis(): Long = movePointRight(3).setScale(0, RoundingMode.HALF_UP).longValueExact()
+
+    private fun segmentFailure(response: Response): Failure {
+        val code = response.code
+        if (code != 401 && code != 403 && code != 404) return Failure("HLS segment HTTP $code", code)
+        // The local extension may identify the upstream resource in its error body. Never log that URL.
+        val prefix = "Upstream $code for "
+        val target = try {
+            val firstLine = response.peekBody(4096).string().substringBefore('\n').trimEnd('\r')
+            val url = response.request.url
+            when {
+                !firstLine.startsWith(prefix) -> "unknown"
+                firstLine.removePrefix(prefix) == url.queryParameter("url") -> "media"
+                firstLine.removePrefix(prefix) == url.queryParameter("key") -> "key"
+                else -> "upstream"
+            }
+        } catch (_: IOException) {
+            "unknown"
+        }
+        return Failure("HLS segment HTTP $code (target=$target)", code)
+    }
+
