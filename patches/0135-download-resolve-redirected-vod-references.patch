+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+
+class NavigationChromeDownloadHlsRedirectTest {
+    @TempDir
+    lateinit var directory: File
+
+    @Test
+    fun `a redirected VOD resolves segment key and map against its effective URL only during the download`() = runBlocking {
+        val from = "/original/list"
+        val to = "/final/1080/vod.m3u8"
+        NavigationChromeDownloadQueueConcurrencyTest.LoopbackHttpServer(redirects = mapOf(from to to, "/other-source" to to)).use { server ->
+            val base = "http://127.0.0.1:${server.port}"
+            val entry = (base + from).toHttpUrl()
+            val input = listOf(
+                "#EXTM3U",
+                "#EXT-X-MAP:URI=\"init.mp4\"",
+                "#EXT-X-KEY:METHOD=AES-128,KEYFORMAT=\"a,b\",URI=\"../k?auth=a%2Bb\",IV=0x01",
+                "#EXTINF:4,",
+                "seg.ts?name=a%2Fb",
+                "#EXTINF:4,",
+                "$base/static/other.ts?x=%2B",
+                "#EXT-X-ENDLIST",
+            ).joinToString("\n")
+            var manifest = input
+            server.handler = { manifest.toByteArray() }
+            server.start()
+            val client = OkHttpClient.Builder().addInterceptor(HlsPlaylistRedirectInterceptor).build()
+            fun read(path: String = from) = client.newCall(Request.Builder().url(base + path).build()).execute().use { it.body.string() }
+            val events = mutableListOf<Int>()
+            assertEquals(input, read())
+            val fixed = HlsPlaylistRedirectInterceptor.during(entry, events::add) {
+                withContext(Dispatchers.IO) {
+                    assertEquals(input, read("/other-source"))
+                    read()
+                }
+            }
+            assertEquals(listOf(3), events)
+            assertTrue("URI=\"$base/final/1080/init.mp4\"" in fixed)
+            assertTrue("KEYFORMAT=\"a,b\",URI=\"$base/final/k?auth=a%2Bb\",IV=0x01" in fixed)
+            assertTrue("$base/final/1080/seg.ts?name=a%2Fb" in fixed)
+            assertTrue("$base/static/other.ts?x=%2B" in fixed)
+            assertEquals(input, read())
+
+            // A live playlist, an unknown URI-bearing tag and an ordinary unredirected fetch stay source-owned.
+            for (other in listOf(input.replace("#EXT-X-ENDLIST", ""), input.replace("#EXTINF:4,", "#EXT-X-PART:URI=\"p\"\n#EXTINF:4,"))) {
+                manifest = other
+                assertEquals(other, HlsPlaylistRedirectInterceptor.during(entry, events::add) { read() })
+            }
+            manifest = input
+            assertEquals(input, HlsPlaylistRedirectInterceptor.during((base + to).toHttpUrl(), events::add) { read(to) })
+            assertEquals(listOf(3), events)
+        }
+    }
+
+    @Test
+    fun `a persistent upstream refusal reports the timestamp without exporting a media or key address`() = runBlocking {
+        val media = "https://fixture.invalid/part?private=sample"
+        val key = "https://fixture.invalid/key?private=sample"
+        val base = "http://localhost:8765"
+        val segment = "$base/segment".toHttpUrl().newBuilder().addQueryParameter("url", media).addQueryParameter("key", key).build()
+        val playlist = "#EXTM3U\n#EXTINF:65.5,\n/segment?url=first\n#EXTINF:4,\n$segment\n#EXT-X-ENDLIST"
+        val ts = ByteArray(188 * 4) { if (it % 188 == 0) 0x47 else 0 }
+        val client = OkHttpClient.Builder().addInterceptor { chain ->
+            val req = chain.request()
+            val reply = Response.Builder().request(req).protocol(Protocol.HTTP_1_1).message("fixture")
+            when {
+                req.url.encodedPath == "/m3u8" -> reply.code(200).body(playlist.toResponseBody()).build()
+                req.url.queryParameter("url") == "first" -> reply.code(200).body(ts.toResponseBody()).build()
+                else -> reply.code(403).body("Upstream 403 for $key\nforbidden".toResponseBody()).build()
+            }
+        }.build()
+        val failure = runCatching {
+            DownloadHlsSegments.prepare(client, "MissAV", "$base/m3u8", headersOf(), directory) {}
+        }.exceptionOrNull() as DownloadHlsSegments.Failure
+        assertEquals(403, failure.httpStatus)
+        assertEquals(65_500L, failure.startMillis)
+        assertEquals("HLS 1/2 · #2 · 01:05", failure.fragmentLabel())
+        assertTrue("target=key" in failure.message.orEmpty())
+        assertFalse("private" in failure.message.orEmpty())
+        assertFalse(directory.walk().any { it.name == "input.m3u8" })
+    }
+}
