diff --git a/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaFrameCounters.kt b/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaFrameCounters.kt
new file mode 100644
index 0000000..aad6f5e
--- /dev/null
+++ b/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaFrameCounters.kt
@@ -0,0 +1,41 @@
+package tachiyomi.presentation.core.components
+
+/**
+ * Harmony: per-frame work counters for the scroll performance recorder.
+ *
+ * Written and read on the main thread only: measure, composition and the recorder's
+ * Choreographer callback all run there. The hot path is one [System.nanoTime] pair and two
+ * additions per measure, one addition per newly composed cell. Nothing allocates.
+ */
+object PanoramaFrameCounters {
+
+    /** [PanoramaMasonry] measure passes since the last [reset]. */
+    var measureCount: Int = 0
+        private set
+
+    /** Total wall time of those measure passes, ns. */
+    var measureNanos: Long = 0L
+        private set
+
+    /** Cells composed for the first time (or reused for a new key) since the last [reset]. */
+    var composedCells: Int = 0
+        private set
+
+    /** Test hook: sees every [PanoramaScrollTrace.phase] change. */
+    internal var phaseListener: ((Int) -> Unit)? = null
+
+    internal fun onMeasure(nanos: Long) {
+        measureCount++
+        measureNanos += nanos
+    }
+
+    internal fun onCellComposed() {
+        composedCells++
+    }
+
+    fun reset() {
+        measureCount = 0
+        measureNanos = 0L
+        composedCells = 0
+    }
+}
diff --git a/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaMasonry.kt b/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaMasonry.kt
index f4d7f95..2db5ef0 100644
--- a/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaMasonry.kt
+++ b/presentation-core/src/main/java/tachiyomi/presentation/core/components/PanoramaMasonry.kt
