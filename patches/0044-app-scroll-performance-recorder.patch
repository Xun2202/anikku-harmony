+/**
+ * Harmony: on-device scroll performance recorder, behind a debug switch that is off by default.
+ *
+ * While switched on and the activity is started it keeps, in primitive ring buffers:
+ * FrameMetrics per rendered frame (callback on its own HandlerThread), the Choreographer vsync
+ * interval per main-thread frame with the panorama scroll phase / measure / compose counters,
+ * and a 500 ms sample of GC count, process CPU, display refresh rate, thermal status and battery
+ * saver. The export holds only those numbers, per-second counts of 卓易通 graphics-layer logcat
+ * lines and [PanoramaScrollTrace]; no titles, URLs, extension list or logcat text.
+ *
+ * Shared byte for byte between mihon-harmony and anikku-harmony.
+ */
+object HarmonyFramePerf {
+
+    private const val FRAME_CAPACITY = 6000
+    private const val TICK_CAPACITY = 6000
+    private const val SAMPLE_CAPACITY = 1200
+    private const val SAMPLE_INTERVAL_MS = 500L
+    private const val FIRST_FRAME_TIMEOUT_MS = 3000L
+
+    /** About 1 MB, allocated on the first attach and dropped when the switch is turned off. */
+    private class Buffers {
+        val frames = PerfRing(FRAME_CAPACITY, PerfReport.FRAME_WIDTH)
+        val ticks = PerfRing(TICK_CAPACITY, PerfReport.TICK_WIDTH)
+        val samples = PerfRing(SAMPLE_CAPACITY, PerfReport.SAMPLE_WIDTH)
+    }
+
+    @Volatile private var buffers: Buffers? = null
+
+    private val recordingState = MutableStateFlow(false)
+
+    /** True while attached to a window. The record button follows it. */
+    val recording: StateFlow<Boolean> = recordingState.asStateFlow()
+
+    // Main thread only.
+    private var window: Window? = null
+    private var thread: HandlerThread? = null
+    private var metricsListener: Window.OnFrameMetricsAvailableListener? = null
+    private var ticking = false
+    private var lastTickNanos = 0L
+
+    // Written on the main thread, read on the sampler thread.
+    @Volatile private var handler: Handler? = null
+
+    @Volatile private var appContext: Context? = null
+
+    @Volatile private var display: Display? = null
+
+    @Volatile private var startedNanos = 0L
+
+    @Volatile private var startedWallMs = 0L
+
+    @Volatile private var firstFrameSeen = false
+
+    @Volatile private var frameMetricsLate = false
+
+    @Volatile private var frameMetricsError: String? = null
+
+    // Sampler thread only.
+    private var lastGcCount = -1L
+    private var lastCpuMs = -1L
+
+    /**
+     * Records while [enabled] emits true and [activity] is started. Turning the switch off
+     * also drops what was recorded.
+     */
+    fun bind(activity: ComponentActivity, enabled: Flow<Boolean>) {
+        activity.lifecycleScope.launch {
+            activity.repeatOnLifecycle(Lifecycle.State.STARTED) {
+                try {
+                    enabled.distinctUntilChanged().collect { on ->
+                        if (on) {
+                            attach(activity)
+                        } else {
+                            detach()
+                            clear()
+                        }
+                    }
+                } finally {
+                    detach()
+                }
+            }
+        }
+    }
+
+    private fun attach(activity: Activity) {
+        if (window === activity.window) return
+        detach()
+        appContext = activity.applicationContext
+        if (buffers == null) buffers = Buffers()
+        if (startedWallMs == 0L) {
+            startedWallMs = System.currentTimeMillis()
+            startedNanos = System.nanoTime()
+        }
+        val samplerThread = HandlerThread("HarmonyFramePerf").also { it.start() }
+        val samplerHandler = Handler(samplerThread.looper)
+        thread = samplerThread
+        handler = samplerHandler
+        window = activity.window
+        display = displayOf(activity)
+        firstFrameSeen = false
+        frameMetricsLate = false
+        frameMetricsError = null
+        val listener = Window.OnFrameMetricsAvailableListener { _, metrics, _ -> onFrameMetrics(metrics) }
+        try {
+            activity.window.addOnFrameMetricsAvailableListener(listener, samplerHandler)
+            metricsListener = listener
+        } catch (e: Throwable) {
+            frameMetricsError = e.javaClass.simpleName
+        }
+        lastGcCount = -1L
+        lastCpuMs = -1L
+        samplerHandler.post(sampler)
+        samplerHandler.postDelayed(firstFrameCheck, FIRST_FRAME_TIMEOUT_MS)
+        lastTickNanos = 0L
+        PanoramaFrameCounters.reset()
+        ticking = true
+        Choreographer.getInstance().postFrameCallback(tickCallback)
+        // One frame right away, so an idle screen does not read as "FrameMetrics not provided".
+        activity.window.decorView.invalidate()
+        recordingState.value = true
+    }
+
+    private fun detach() {
+        val attached = window ?: return
+        metricsListener?.let { listener -> runCatching { attached.removeOnFrameMetricsAvailableListener(listener) } }
+        metricsListener = null
+        window = null
+        ticking = false
+        Choreographer.getInstance().removeFrameCallback(tickCallback)
+        handler?.removeCallbacksAndMessages(null)
+        thread?.quitSafely()
+        handler = null
+        thread = null
+        display = null
+        recordingState.value = false
+    }
+
+    private fun clear() {
+        buffers = null
+        startedWallMs = 0L
+        startedNanos = 0L
+    }
+
+    private val tickCallback = Choreographer.FrameCallback { frameTimeNanos -> onTick(frameTimeNanos) }
+
+    private fun onTick(frameTimeNanos: Long) {
+        if (!ticking) return
+        val previous = lastTickNanos
+        lastTickNanos = frameTimeNanos
+        val ticks = buffers?.ticks ?: return
+        synchronized(ticks) {
+            // Counters read here were filled by the previous frame's composition and measure.
+            val last = ticks.lastRow()
+            if (last >= 0) {
+                ticks[last + PerfReport.T_MEASURES] = PanoramaFrameCounters.measureCount.toLong()
+                ticks[last + PerfReport.T_MEASURE_NS] = PanoramaFrameCounters.measureNanos
+                ticks[last + PerfReport.T_COMPOSED] = PanoramaFrameCounters.composedCells.toLong()
+            }
+            val row = ticks.appendRow()
+            ticks[row + PerfReport.T_TIME] = frameTimeNanos
+            ticks[row + PerfReport.T_INTERVAL] = if (previous == 0L) 0L else frameTimeNanos - previous
+            ticks[row + PerfReport.T_PHASE] = PanoramaScrollTrace.phase.toLong()
+            ticks[row + PerfReport.T_MEASURES] = 0L
+            ticks[row + PerfReport.T_MEASURE_NS] = 0L
+            ticks[row + PerfReport.T_COMPOSED] = 0L
+        }
+        PanoramaFrameCounters.reset()
+        Choreographer.getInstance().postFrameCallback(tickCallback)
+    }
+
+    private fun onFrameMetrics(metrics: FrameMetrics) {
+        if (!firstFrameSeen) firstFrameSeen = true
+        if (metrics.getMetric(FrameMetrics.FIRST_DRAW_FRAME) == 1L) return
+        val frames = buffers?.frames ?: return
+        val modern = Build.VERSION.SDK_INT >= Build.VERSION_CODES.S
+        synchronized(frames) {
+            val row = frames.appendRow()
+            frames[row + PerfReport.F_INTENDED_VSYNC] = metrics.getMetric(FrameMetrics.INTENDED_VSYNC_TIMESTAMP)
+            frames[row + PerfReport.F_VSYNC] = metrics.getMetric(FrameMetrics.VSYNC_TIMESTAMP)
+            frames[row + PerfReport.F_TOTAL] = metrics.getMetric(FrameMetrics.TOTAL_DURATION)
+            frames[row + PerfReport.F_DELAY] = metrics.getMetric(FrameMetrics.UNKNOWN_DELAY_DURATION)
+            frames[row + PerfReport.F_INPUT] = metrics.getMetric(FrameMetrics.INPUT_HANDLING_DURATION)
+            frames[row + PerfReport.F_ANIMATION] = metrics.getMetric(FrameMetrics.ANIMATION_DURATION)
+            frames[row + PerfReport.F_LAYOUT] = metrics.getMetric(FrameMetrics.LAYOUT_MEASURE_DURATION)
+            frames[row + PerfReport.F_DRAW] = metrics.getMetric(FrameMetrics.DRAW_DURATION)
+            frames[row + PerfReport.F_SYNC] = metrics.getMetric(FrameMetrics.SYNC_DURATION)
+            frames[row + PerfReport.F_COMMAND] = metrics.getMetric(FrameMetrics.COMMAND_ISSUE_DURATION)
+            frames[row + PerfReport.F_SWAP] = metrics.getMetric(FrameMetrics.SWAP_BUFFERS_DURATION)
+            frames[row + PerfReport.F_GPU] = if (modern) metrics.getMetric(FrameMetrics.GPU_DURATION) else -1L
+            frames[row + PerfReport.F_DEADLINE] = if (modern) metrics.getMetric(FrameMetrics.DEADLINE) else -1L
+        }
+    }
+
+    private val firstFrameCheck = Runnable {
+        if (!firstFrameSeen) frameMetricsLate = true
+    }
+
+    private val sampler = object : Runnable {
+        override fun run() {
+            sample()
+            // A detach may have quit this thread and started another one; do not post onto that.
+            val current = handler ?: return
+            if (current.looper == Looper.myLooper()) current.postDelayed(this, SAMPLE_INTERVAL_MS)
+        }
+    }
+
+    private fun sample() {
+        val context = appContext ?: return
+        val gc = Debug.getRuntimeStat("art.gc.gc-count")?.toLongOrNull() ?: -1L
+        val cpu = Process.getElapsedCpuTime()
+        val gcDelta = if (gc >= 0 && lastGcCount >= 0) gc - lastGcCount else 0L
+        val cpuDelta = if (lastCpuMs >= 0) cpu - lastCpuMs else 0L
+        lastGcCount = gc
+        lastCpuMs = cpu
+        val currentDisplay = display
+        val mode = currentDisplay?.mode
+        val power = context.getSystemService(Context.POWER_SERVICE) as? PowerManager
+        val samples = buffers?.samples ?: return
+        synchronized(samples) {
+            val row = samples.appendRow()
+            samples[row + PerfReport.S_TIME] = System.nanoTime()
+            samples[row + PerfReport.S_GC] = gcDelta
+            samples[row + PerfReport.S_CPU_MS] = cpuDelta
+            samples[row + PerfReport.S_REFRESH_MILLI] = ((currentDisplay?.refreshRate ?: 0f) * 1000f).toLong()
+            samples[row + PerfReport.S_MODE_ID] = mode?.modeId?.toLong() ?: -1L
+            samples[row + PerfReport.S_MODE_REFRESH_MILLI] = ((mode?.refreshRate ?: 0f) * 1000f).toLong()
+            samples[row + PerfReport.S_THERMAL] = thermalStatus(power).toLong()
+            samples[row + PerfReport.S_POWER_SAVE] = if (power?.isPowerSaveMode == true) 1L else 0L
+        }
+    }
+
+    /**
+     * Writes the export into the cache directory and returns it. Call [collectHeader] on the
+     * main thread first; the rest runs on any thread.
+     */
+    fun writeReport(context: Context, header: PerfHeader): java.io.File {
+        val nowNanos = System.nanoTime()
+        val nowWallMs = System.currentTimeMillis()
+        val noise = readNoise(nowWallMs / 1000 - PerfReport.RECENT_SECONDS)
+        val current = buffers
+        val input = PerfReportInput(
+            header = header,
+            frames = snapshot(current?.frames, PerfReport.FRAME_WIDTH),
+            ticks = snapshot(current?.ticks, PerfReport.TICK_WIDTH),
+            samples = snapshot(current?.samples, PerfReport.SAMPLE_WIDTH),
+            frameMetricsLate = frameMetricsLate,
+            frameMetricsError = frameMetricsError,
+            noiseMarkers = CrashLogUtil.HARMONY_NOISE_MARKERS,
+            noise = noise,
+            trace = PanoramaScrollTrace.snapshot(),
+            startedNanos = startedNanos.takeIf { it != 0L } ?: nowNanos,
+            startedWallMs = startedWallMs.takeIf { it != 0L } ?: nowWallMs,
+            nowNanos = nowNanos,
+            nowWallMs = nowWallMs,
+            timeZone = TimeZone.getDefault(),
+        )
+        val stamp = SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(Date(nowWallMs))
+        val file = context.createFileInCacheDir("${fileLabel(header)}_scroll_perf_$stamp.txt")
+        file.writeText(PerfReport.format(input))
+        return file
+    }
+
+    private fun snapshot(ring: PerfRing?, width: Int): PerfTable {
+        if (ring == null) return PerfTable(0, width, LongArray(0))
+        return synchronized(ring) { ring.snapshot() }
+    }
+
+    fun collectHeader(activity: Activity): PerfHeader {
+        val packageManager = activity.packageManager
+        val info = runCatching {
+            @Suppress("DEPRECATION")
+            packageManager.getPackageInfo(activity.packageName, 0)
+        }.getOrNull()
+        val versionCode = when {
+            info == null -> -1L
+            Build.VERSION.SDK_INT >= Build.VERSION_CODES.P -> info.longVersionCode
+            else ->
+                @Suppress("DEPRECATION")
+                info.versionCode.toLong()
+        }
+        val density = activity.resources.displayMetrics.density
+        val (widthPx, heightPx) = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            val bounds = activity.windowManager.currentWindowMetrics.bounds
+            bounds.width() to bounds.height()
+        } else {
+            activity.window.decorView.width to activity.window.decorView.height
+        }
+        val currentDisplay = displayOf(activity)
+        val mode = currentDisplay?.mode
+        val power = activity.getSystemService(Context.POWER_SERVICE) as? PowerManager
+        return PerfHeader(
+            appId = activity.packageName,
+            appLabel = activity.applicationInfo.loadLabel(packageManager).toString(),
+            versionName = info?.versionName ?: "?",
+            versionCode = versionCode,
+            brand = Build.BRAND,
+            model = Build.MODEL,
+            androidRelease = Build.VERSION.RELEASE,
+            sdk = Build.VERSION.SDK_INT,
+            windowWidthDp = (widthPx / density).toInt(),
+            windowHeightDp = (heightPx / density).toInt(),
+            density = density,
+            supportedRefreshRates = currentDisplay?.supportedModes
+                ?.map { it.refreshRate }
+                ?.distinct()
+                ?.sorted()
+                .orEmpty(),
+            currentRefreshRate = currentDisplay?.refreshRate ?: 0f,
+            displayMode = mode?.let { "id=${it.modeId} ${it.physicalWidth}x${it.physicalHeight} @${it.refreshRate}" }
+                ?: "?",
+            thermalStatus = thermalStatus(power),
+            powerSave = power?.isPowerSaveMode == true,
+            uptimeMs = SystemClock.elapsedRealtime(),
+        )
+    }
+
+    private fun readNoise(fromEpochSec: Long): SortedMap<Long, IntArray> {
+        return try {
+            val process = Runtime.getRuntime().exec(arrayOf("logcat", "-d", "-v", "epoch"))
+            val counts = process.inputStream.bufferedReader().useLines {
+                PerfReport.countNoise(it, CrashLogUtil.HARMONY_NOISE_MARKERS, fromEpochSec)
+            }
+            process.waitFor()
+            counts
+        } catch (_: Throwable) {
+            TreeMap()
+        }
+    }
+
+    private fun fileLabel(header: PerfHeader): String {
+        val fromLabel = header.appLabel.lowercase(Locale.US).filter { it in 'a'..'z' || it in '0'..'9' }
+        if (fromLabel.isNotEmpty()) return fromLabel
+        return header.appId.substringAfterLast('.').lowercase(Locale.US).ifEmpty { "app" }
+    }
+
+    private fun displayOf(activity: Activity): Display? {
+        return runCatching {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                activity.display
+            } else {
+                @Suppress("DEPRECATION")
+                activity.windowManager.defaultDisplay
+            }
+        }.getOrNull()
+    }
+
+    private fun thermalStatus(power: PowerManager?): Int {
+        if (power == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return -1
+        return power.currentThermalStatus
+    }
+}
