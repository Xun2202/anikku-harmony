+/**
+ * Harmony: the record button of [HarmonyFramePerf]. Bottom-start, above the bottom navigation,
+ * only while recording. Touches outside the 40 dp circle pass through.
+ */
+@Composable
+fun HarmonyFramePerfButton() {
+    val recording by HarmonyFramePerf.recording.collectAsState()
+    if (!recording) return
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var busy by remember { mutableStateOf(false) }
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .windowInsetsPadding(WindowInsets.safeDrawing)
+            .padding(start = 8.dp, bottom = 96.dp),
+        contentAlignment = Alignment.BottomStart,
+    ) {
+        Box(
+            modifier = Modifier
+                .size(40.dp)
+                .clip(CircleShape)
+                .background(Color.Black.copy(alpha = if (busy) 0.25f else 0.45f))
+                .clickable(enabled = !busy) {
+                    val activity = context.findActivity() ?: return@clickable
+                    PanoramaScrollTrace.log(0, "mark user")
+                    busy = true
+                    val header = HarmonyFramePerf.collectHeader(activity)
+                    scope.launch {
+                        val file = withContext(Dispatchers.IO) {
+                            runCatching { HarmonyFramePerf.writeReport(activity, header) }.getOrNull()
+                        }
+                        busy = false
+                        if (file == null) {
+                            context.toast("Failed to write the performance log")
+                            return@launch
+                        }
+                        val uri = file.getUriCompat(activity)
+                        runCatching { activity.startActivity(uri.toShareIntent(activity, "text/plain")) }
+                    }
+                },
+            contentAlignment = Alignment.Center,
+        ) {
+            Text(text = "记录", color = Color.White, fontSize = 12.sp)
+        }
+    }
+}
+
+private fun Context.findActivity(): Activity? {
+    var current: Context? = this
+    while (current is android.content.ContextWrapper) {
+        if (current is Activity) return current
+        current = current.baseContext
+    }
+    return null
+}
+
+/** Device facts collected on the main thread when the record button is pressed. */
+class PerfHeader(
+    val appId: String,
+    val appLabel: String,
+    val versionName: String,
+    val versionCode: Long,
+    val brand: String,
+    val model: String,
+    val androidRelease: String,
+    val sdk: Int,
+    val windowWidthDp: Int,
+    val windowHeightDp: Int,
+    val density: Float,
+    val supportedRefreshRates: List<Float>,
+    val currentRefreshRate: Float,
+    val displayMode: String,
+    val thermalStatus: Int,
+    val powerSave: Boolean,
+    val uptimeMs: Long,
+)
+
+/** Fixed-width rows of longs in one array. Callers hold the ring's monitor. */
+internal class PerfRing(private val capacity: Int, private val width: Int) {
+    private val data = LongArray(capacity * width)
+    private var next = 0
+    private var size = 0
+
+    /** Index of the new row's first column. */
+    fun appendRow(): Int {
+        val base = next * width
+        next = (next + 1) % capacity
+        if (size < capacity) size++
+        return base
+    }
+
+    fun lastRow(): Int = if (size == 0) -1 else ((next - 1 + capacity) % capacity) * width
+
+    operator fun set(index: Int, value: Long) {
+        data[index] = value
+    }
+
+    fun clear() {
+        next = 0
+        size = 0
+    }
+
+    /** Copy in recording order. */
+    fun snapshot(): PerfTable {
+        val out = LongArray(size * width)
+        val first = (next - size + capacity) % capacity
+        for (row in 0 until size) {
+            System.arraycopy(data, ((first + row) % capacity) * width, out, row * width, width)
+        }
+        return PerfTable(size, width, out)
+    }
+}
+
+class PerfTable(val rows: Int, val width: Int, val data: LongArray) {
+    operator fun get(row: Int, column: Int): Long = data[row * width + column]
+
+    companion object {
+        fun of(width: Int, vararg rows: LongArray): PerfTable {
+            val data = LongArray(rows.size * width)
+            rows.forEachIndexed { index, row -> System.arraycopy(row, 0, data, index * width, width) }
+            return PerfTable(rows.size, width, data)
+        }
+    }
+}
+
+class PerfReportInput(
+    val header: PerfHeader,
+    val frames: PerfTable,
+    val ticks: PerfTable,
+    val samples: PerfTable,
+    val frameMetricsLate: Boolean,
+    val frameMetricsError: String?,
+    val noiseMarkers: List<String>,
+    val noise: SortedMap<Long, IntArray>,
+    val trace: List<String>,
+    val startedNanos: Long,
+    val startedWallMs: Long,
+    val nowNanos: Long,
+    val nowWallMs: Long,
+    val timeZone: TimeZone,
+)
+
+class PerfSegment(val phase: Int, val startNs: Long, val endNs: Long)
+
+/** Pure formatting and statistics of the export, so they can be unit tested off-device. */
+object PerfReport {
+    const val F_INTENDED_VSYNC = 0
+    const val F_VSYNC = 1
+    const val F_TOTAL = 2
+    const val F_DELAY = 3
+    const val F_INPUT = 4
+    const val F_ANIMATION = 5
+    const val F_LAYOUT = 6
+    const val F_DRAW = 7
+    const val F_SYNC = 8
+    const val F_COMMAND = 9
+    const val F_SWAP = 10
+    const val F_GPU = 11
+    const val F_DEADLINE = 12
+    const val FRAME_WIDTH = 13
+
+    const val T_TIME = 0
+    const val T_INTERVAL = 1
+    const val T_PHASE = 2
+    const val T_MEASURES = 3
+    const val T_MEASURE_NS = 4
+    const val T_COMPOSED = 5
+    const val TICK_WIDTH = 6
+
+    const val S_TIME = 0
+    const val S_GC = 1
+    const val S_CPU_MS = 2
+    const val S_REFRESH_MILLI = 3
+    const val S_MODE_ID = 4
+    const val S_MODE_REFRESH_MILLI = 5
+    const val S_THERMAL = 6
+    const val S_POWER_SAVE = 7
+    const val SAMPLE_WIDTH = 8
+
+    const val RECENT_SECONDS = 30L
+    const val PRIVACY_LINE = "privacy: no titles, urls, extension list or logcat text"
+
+    private const val SECOND_NS = 1_000_000_000L
+    private const val SEGMENT_GAP_NS = SECOND_NS
+    private const val IDLE_MERGE_NS = 100_000_000L
+    private const val DEFAULT_PERIOD_NS = 16_666_667L
+
+    /** Stage columns in report order; names match the analyzer. */
+    private val STAGES = listOf(
+        "delay" to F_DELAY,
+        "input" to F_INPUT,
+        "animation" to F_ANIMATION,
+        "layout" to F_LAYOUT,
+        "draw" to F_DRAW,
+        "sync" to F_SYNC,
+        "command" to F_COMMAND,
+        "swap" to F_SWAP,
+        "gpu" to F_GPU,
+    )
+
+    fun phaseName(phase: Int): String = when (phase) {
+        PanoramaScrollTrace.PHASE_DRAG -> "drag"
+        PanoramaScrollTrace.PHASE_FLING -> "fling"
+        else -> "idle"
+    }
+
+    /** Nearest-rank percentile of an ascending array; -1 when empty. */
+    fun percentile(sorted: LongArray, percent: Double): Long {
+        if (sorted.isEmpty()) return -1L
+        val rank = ceil(percent / 100.0 * sorted.size).toInt().coerceIn(1, sorted.size)
+        return sorted[rank - 1]
+    }
+
+    /** DEADLINE when the platform reports one, otherwise 1.5 vsync periods. */
+    fun isJank(totalNs: Long, deadlineNs: Long, periodNs: Long): Boolean {
+        if (totalNs < 0) return false
+        return if (deadlineNs > 0) totalNs > deadlineNs else totalNs * 2 > periodNs * 3
+    }
+
+    /**
+     * Runs of one scroll phase over the Choreographer ticks. A tick gap over a second starts a
+     * new run. An idle run under 100 ms right before a drag or fling (the release before the
+     * fling starts) belongs to that run.
+     */
+    fun segments(ticks: PerfTable): List<PerfSegment> {
+        val raw = ArrayList<PerfSegment>()
+        if (ticks.rows == 0) return raw
+        var phase = ticks[0, T_PHASE].toInt()
+        var start = ticks[0, T_TIME]
+        var last = start
+        for (row in 1 until ticks.rows) {
+            val time = ticks[row, T_TIME]
+            val rowPhase = ticks[row, T_PHASE].toInt()
+            val gap = time - last > SEGMENT_GAP_NS
+            if (rowPhase != phase || gap) {
+                raw += PerfSegment(phase, start, if (gap) last else time)
+                phase = rowPhase
+                start = time
+            }
+            last = time
+        }
+        raw += PerfSegment(phase, start, last)
+        val merged = ArrayList<PerfSegment>(raw.size)
+        fun append(segment: PerfSegment) {
+            val previous = merged.lastOrNull()
+            if (previous != null && previous.phase == segment.phase && previous.endNs == segment.startNs) {
+                merged[merged.lastIndex] = PerfSegment(segment.phase, previous.startNs, segment.endNs)
+            } else {
+                merged += segment
+            }
+        }
+        var index = 0
+        while (index < raw.size) {
+            val segment = raw[index]
+            val following = raw.getOrNull(index + 1)
+            if (segment.phase == PanoramaScrollTrace.PHASE_IDLE &&
+                segment.endNs - segment.startNs < IDLE_MERGE_NS &&
+                following != null &&
+                following.phase != PanoramaScrollTrace.PHASE_IDLE &&
+                following.startNs == segment.endNs
+            ) {
+                append(PerfSegment(following.phase, segment.startNs, following.endNs))
+                index += 2
+            } else {
+                append(segment)
+                index++
+            }
+        }
+        return merged
+    }
+
+    /** Index of the tick nearest [time], or -1. */
+    private fun nearestTick(ticks: PerfTable, time: Long): Int {
+        if (ticks.rows == 0) return -1
+        var low = 0
+        var high = ticks.rows - 1
+        while (low < high) {
+            val mid = (low + high) ushr 1
+            if (ticks[mid, T_TIME] < time) low = mid + 1 else high = mid
+        }
+        if (low > 0 && abs(ticks[low - 1, T_TIME] - time) <= abs(ticks[low, T_TIME] - time)) return low - 1
+        return low
+    }
+
+    /** Vsync period in effect at [time], from the 500 ms samples. */
+    fun periodAt(samples: PerfTable, time: Long, fallbackRate: Float): Long {
+        // Last sample at or before [time]; the first sample covers anything earlier.
+        var low = 0
+        var high = samples.rows
+        while (low < high) {
+            val mid = (low + high) ushr 1
+            if (samples[mid, S_TIME] <= time) low = mid + 1 else high = mid
+        }
+        var rateMilli = 0L
+        var row = low - 1
+        while (row >= 0 && rateMilli <= 0) rateMilli = samples[row--, S_REFRESH_MILLI]
+        row = low
+        while (row < samples.rows && rateMilli <= 0) rateMilli = samples[row++, S_REFRESH_MILLI]
+        if (rateMilli > 0) return 1_000_000_000_000L / rateMilli
+        if (fallbackRate > 1f) return (SECOND_NS / fallbackRate).toLong()
+        return DEFAULT_PERIOD_NS
+    }
+
+    /** Per-second counts of noise lines from `logcat -v epoch`. Values: one per marker, then the total. */
+    fun countNoise(lines: Sequence<String>, markers: List<String>, fromEpochSec: Long): SortedMap<Long, IntArray> {
+        val counts = TreeMap<Long, IntArray>()
+        for (line in lines) {
+            val trimmed = line.trimStart()
+            val second = trimmed.substringBefore(' ').substringBefore('.').toLongOrNull() ?: continue
+            if (second < fromEpochSec) continue
+            var hit = false
+            for ((index, marker) in markers.withIndex()) {
+                if (marker in trimmed) {
+                    val row = counts.getOrPut(second) { IntArray(markers.size + 1) }
+                    row[index]++
+                    hit = true
+                }
+            }
+            if (hit) counts.getValue(second)[markers.size]++
+        }
+        return counts
+    }
+
+    fun format(input: PerfReportInput): String {
+        val out = StringBuilder(64 * 1024)
+        val clock = Clock(input)
+        val header = input.header
+        val frames = input.frames
+        val ticks = input.ticks
+        val samples = input.samples
+        val fallbackRate = header.currentRefreshRate
+        val haveFrames = frames.rows > 0
+
+        out.appendLine("# ${header.appLabel} scroll performance log")
+        out.appendLine("format: harmony-scroll-perf 1")
+        out.appendLine("app_id: ${header.appId}")
+        out.appendLine("version: ${header.versionName} (${header.versionCode})")
+        out.appendLine("device: ${header.brand} / ${header.model}")
+        out.appendLine("android: ${header.androidRelease} (SDK ${header.sdk})")
+        out.appendLine("window_dp: ${header.windowWidthDp}x${header.windowHeightDp}")
+        out.appendLine("density: ${header.density}")
+        out.appendLine("refresh_rates_supported: ${header.supportedRefreshRates.joinToString(", ") { rate(it) }}")
+        out.appendLine("refresh_rate_current: ${rate(header.currentRefreshRate)}")
+        out.appendLine("display_mode: ${header.displayMode}")
+        out.appendLine("thermal: ${thermalName(header.thermalStatus)}")
+        out.appendLine("power_save: ${header.powerSave}")
+        out.appendLine("uptime: ${duration(header.uptimeMs)}")
+        out.appendLine("recording_started: ${clock.full(input.startedWallMs)}")
+        out.appendLine("exported: ${clock.full(input.nowWallMs)}")
+        out.appendLine("recorded_seconds: ${(input.nowNanos - input.startedNanos) / SECOND_NS}")
+        out.appendLine("vsync_ms: ${ms(periodAt(samples, input.nowNanos, fallbackRate))}")
+        when {
+            haveFrames && input.frameMetricsLate ->
+                out.appendLine("frame_metrics: provided (${frames.rows} frames; first frame came after the 3 s check)")
+            haveFrames -> out.appendLine("frame_metrics: provided (${frames.rows} frames)")
+            else -> {
+                val reason = input.frameMetricsError?.let { "listener failed: $it" } ?: "no frame within 3 s of attach"
+                out.appendLine(
+                    "frame_metrics: FrameMetrics 未提供 (not provided: $reason); summary uses Choreographer only",
+                )
+            }
+        }
+        out.appendLine(
+            "jank_rule: TOTAL_DURATION > DEADLINE when DEADLINE is known, otherwise > 1.5 x vsync period; " +
+                "Choreographer: interval > 1.5 x vsync period",
+        )
+        out.appendLine()
+
+        val segments = segments(ticks)
+        val framePhase = IntArray(frames.rows)
+        val frameTick = IntArray(frames.rows)
+        val framePeriod = LongArray(frames.rows)
+        val frameJank = BooleanArray(frames.rows)
+        for (row in 0 until frames.rows) {
+            val vsync = frames[row, F_VSYNC]
+            val tick = nearestTick(ticks, vsync)
+            val period = periodAt(samples, vsync, fallbackRate)
+            framePeriod[row] = period
+            frameJank[row] = isJank(frames[row, F_TOTAL], frames[row, F_DEADLINE], period)
+            if (tick >= 0) {
+                framePhase[row] = ticks[tick, T_PHASE].toInt()
+                frameTick[row] = if (abs(ticks[tick, T_TIME] - vsync) * 2 <= period) tick else -1
+            } else {
+                framePhase[row] = PanoramaScrollTrace.PHASE_IDLE
+                frameTick[row] = -1
+            }
+        }
+
+        out.appendLine("## Summary by scroll segment")
+        out.appendLine(
+            if (haveFrames) {
+                "# p50/p90/p99/max are TOTAL_DURATION ms; main = stage with the largest mean among jank frames"
+            } else {
+                "# source=choreographer: frames are vsync ticks, p50/p90/p99/max are tick intervals ms"
+            },
+        )
+        for (segment in segments) {
+            out.appendLine(
+                if (haveFrames) {
+                    frameSegmentLine(segment, frames, framePhase, frameJank, clock)
+                } else {
+                    tickSegmentLine(segment, ticks, samples, fallbackRate, clock)
+                },
+            )
+        }
+        out.appendLine()
+
+        if (haveFrames) {
+            out.appendLine("## Jank frame stage means (ms)")
+            out.appendLine(stageLine("all", frames, frameJank) { true })
+            for (phase in PHASES) {
+                out.appendLine(stageLine(phaseName(phase), frames, frameJank) { framePhase[it] == phase })
+            }
+            out.appendLine()
+        }
+
+        out.appendLine("## Choreographer intervals")
+        out.appendLine(choreographerLine("all", ticks, samples, fallbackRate) { true })
+        for (phase in PHASES) {
+            out.appendLine(
+                choreographerLine(phaseName(phase), ticks, samples, fallbackRate) {
+                    ticks[it, T_PHASE].toInt() == phase
+                },
+            )
+        }
+        out.appendLine()
+
+        val recentFrom = input.nowNanos - RECENT_SECONDS * SECOND_NS
+        out.appendLine("## Last 30 s: jank frames")
+        out.appendLine(
+            "# columns: time phase total delay input animation layout draw sync command swap gpu deadline " +
+                "intended_vsync_lag vsync_ms measures measure_ms composed (ms unless noted, -1 = not available)",
+        )
+        var listed = 0
+        for (row in 0 until frames.rows) {
+            if (frames[row, F_VSYNC] < recentFrom || !frameJank[row]) continue
+            val tick = frameTick[row]
+            out.append("jank ").append(clock.time(frames[row, F_VSYNC]))
+            out.append(' ').append(phaseName(framePhase[row]))
+            for (column in listOf(F_TOTAL, F_DELAY, F_INPUT, F_ANIMATION, F_LAYOUT, F_DRAW, F_SYNC, F_COMMAND)) {
+                out.append(' ').append(ms(frames[row, column]))
+            }
+            out.append(' ').append(ms(frames[row, F_SWAP]))
+            out.append(' ').append(ms(frames[row, F_GPU]))
+            out.append(' ').append(ms(frames[row, F_DEADLINE]))
+            out.append(' ').append(ms(frames[row, F_VSYNC] - frames[row, F_INTENDED_VSYNC]))
+            out.append(' ').append(ms(framePeriod[row]))
+            if (tick >= 0) {
+                out.append(' ').append(ticks[tick, T_MEASURES])
+                out.append(' ').append(ms(ticks[tick, T_MEASURE_NS]))
+                out.append(' ').append(ticks[tick, T_COMPOSED])
+            } else {
+                out.append(" -1 -1 -1")
+            }
+            out.appendLine()
+            listed++
+        }
+        if (!haveFrames) {
+            out.appendLine("# columns: time phase interval vsync_ms measures measure_ms composed")
+            for (row in 0 until ticks.rows) {
+                val time = ticks[row, T_TIME]
+                val interval = ticks[row, T_INTERVAL]
+                val period = periodAt(samples, time, fallbackRate)
+                if (time < recentFrom || interval <= 0 || interval * 2 <= period * 3) continue
+                out.append("jank_tick ").append(clock.time(time))
+                out.append(' ').append(phaseName(ticks[row, T_PHASE].toInt()))
+                out.append(' ').append(ms(interval)).append(' ').append(ms(period))
+                out.append(' ').append(ticks[row, T_MEASURES])
+                out.append(' ').append(ms(ticks[row, T_MEASURE_NS]))
+                out.append(' ').append(ticks[row, T_COMPOSED])
+                out.appendLine()
+                listed++
+            }
+        }
+        if (listed == 0) out.appendLine("# none")
+        out.appendLine()
+
+        out.appendLine("## Last 30 s: 500 ms samples")
+        out.appendLine("# gc = GC count delta, cpu_ms = process CPU delta, refresh = Display.refreshRate")
+        for (row in 0 until samples.rows) {
+            val time = samples[row, S_TIME]
+            if (time < recentFrom) continue
+            out.appendLine(
+                "sample ${clock.time(time)} gc=${samples[row, S_GC]} cpu_ms=${samples[row, S_CPU_MS]} " +
+                    "refresh=${rateMilli(samples[row, S_REFRESH_MILLI])} mode=${samples[row, S_MODE_ID]}" +
+                    "@${rateMilli(samples[row, S_MODE_REFRESH_MILLI])} " +
+                    "thermal=${samples[row, S_THERMAL]} power_save=${samples[row, S_POWER_SAVE] == 1L}",
+            )
+        }
+        out.appendLine()
+
+        out.appendLine("## Last 30 s: 卓易通 graphics-layer logcat lines per second (counts only, no log text)")
+        out.appendLine("# markers: ${input.noiseMarkers.joinToString(" | ")}")
+        if (input.noise.isEmpty()) out.appendLine("# none")
+        for ((second, counts) in input.noise) {
+            out.append("noise ").append(clock.second(second)).append(" total=").append(counts[input.noiseMarkers.size])
+            for ((index, marker) in input.noiseMarkers.withIndex()) {
+                if (counts[index] > 0) out.append(" [").append(marker).append("]=").append(counts[index])
+            }
+            out.appendLine()
+        }
+        out.appendLine()
+
+        out.appendLine("## Panorama scroll trace (${input.trace.size} events)")
+        input.trace.forEach { out.appendLine(it) }
+        out.appendLine()
+        out.appendLine(PRIVACY_LINE)
+        return out.toString()
+    }
+
+    private val PHASES = intArrayOf(
+        PanoramaScrollTrace.PHASE_DRAG,
+        PanoramaScrollTrace.PHASE_FLING,
+        PanoramaScrollTrace.PHASE_IDLE,
+    )
+
+    private fun frameSegmentLine(
+        segment: PerfSegment,
+        frames: PerfTable,
+        framePhase: IntArray,
+        frameJank: BooleanArray,
+        clock: Clock,
+    ): String {
+        val totals = ArrayList<Long>()
+        var jank = 0
+        val inSegment = { row: Int ->
+            val vsync = frames[row, F_VSYNC]
+            vsync >= segment.startNs && vsync <= segment.endNs && framePhase[row] == segment.phase
+        }
+        for (row in 0 until frames.rows) {
+            if (!inSegment(row)) continue
+            totals += frames[row, F_TOTAL]
+            if (frameJank[row]) jank++
+        }
+        val sorted = totals.toLongArray().also { it.sort() }
+        return segmentPrefix(segment, sorted.size, clock) +
+            " jank=$jank p50=${ms(percentile(sorted, 50.0))} p90=${ms(percentile(sorted, 90.0))}" +
+            " p99=${ms(percentile(sorted, 99.0))} max=${ms(sorted.lastOrNull() ?: -1L)}" +
+            " main=${mainStage(frames) { inSegment(it) && frameJank[it] } ?: "-"}"
+    }
+
+    private fun tickSegmentLine(
+        segment: PerfSegment,
+        ticks: PerfTable,
+        samples: PerfTable,
+        fallbackRate: Float,
+        clock: Clock,
+    ): String {
+        val intervals = ArrayList<Long>()
+        var jank = 0
+        var count = 0
+        for (row in 0 until ticks.rows) {
+            val time = ticks[row, T_TIME]
+            if (time < segment.startNs || time > segment.endNs || ticks[row, T_PHASE].toInt() != segment.phase) continue
+            count++
+            val interval = ticks[row, T_INTERVAL]
+            if (interval <= 0) continue
+            intervals += interval
+            if (interval * 2 > periodAt(samples, time, fallbackRate) * 3) jank++
+        }
+        val sorted = intervals.toLongArray().also { it.sort() }
+        return segmentPrefix(segment, count, clock) +
+            " jank=$jank p50=${ms(percentile(sorted, 50.0))} p90=${ms(percentile(sorted, 90.0))}" +
+            " p99=${ms(percentile(sorted, 99.0))} max=${ms(sorted.lastOrNull() ?: -1L)} main=- source=choreographer"
+    }
+
+    private fun segmentPrefix(segment: PerfSegment, frameCount: Int, clock: Clock): String {
+        val durationNs = segment.endNs - segment.startNs
+        val fps = if (durationNs > 0) frameCount * SECOND_NS.toDouble() / durationNs else 0.0
+        return "segment type=${phaseName(segment.phase)} start=${clock.time(segment.startNs)} " +
+            "end=${clock.time(segment.endNs)} ms=${durationNs / 1_000_000} frames=$frameCount " +
+            "fps=${String.format(Locale.US, "%.1f", fps)}"
+    }
+
+    private fun mainStage(frames: PerfTable, include: (Int) -> Boolean): String? {
+        val means = stageMeans(frames, include) ?: return null
+        return means.maxByOrNull { it.second }?.takeIf { it.second > 0.0 }?.first
+    }
+
+    private fun stageMeans(frames: PerfTable, include: (Int) -> Boolean): List<Pair<String, Double>>? {
+        val sums = DoubleArray(STAGES.size)
+        val counts = IntArray(STAGES.size)
+        var any = false
+        for (row in 0 until frames.rows) {
+            if (!include(row)) continue
+            any = true
+            STAGES.forEachIndexed { index, (_, column) ->
+                val value = frames[row, column]
+                if (value >= 0) {
+                    sums[index] += value.toDouble()
+                    counts[index]++
+                }
+            }
+        }
+        if (!any) return null
+        return STAGES.mapIndexed { index, (name, _) ->
+            name to if (counts[index] == 0) -1.0 else sums[index] / counts[index]
+        }
+    }
+
+    private fun stageLine(
+        scope: String,
+        frames: PerfTable,
+        frameJank: BooleanArray,
+        include: (Int) -> Boolean,
+    ): String {
+        var count = 0
+        for (row in 0 until frames.rows) if (frameJank[row] && include(row)) count++
+        val means = stageMeans(frames) { frameJank[it] && include(it) }
+        if (means == null) return "jank_stages scope=$scope frames=0"
+        val main = means.maxByOrNull { it.second }?.takeIf { it.second > 0.0 }?.first ?: "-"
+        val detail = means.joinToString(" ") { (name, mean) ->
+            "$name=${if (mean < 0) "-1" else String.format(Locale.US, "%.2f", mean / 1_000_000.0)}"
+        }
+        return "jank_stages scope=$scope frames=$count $detail main=$main"
+    }
+
+    private fun choreographerLine(
+        scope: String,
+        ticks: PerfTable,
+        samples: PerfTable,
+        fallbackRate: Float,
+        include: (Int) -> Boolean,
+    ): String {
+        val intervals = ArrayList<Long>()
+        var over = 0
+        for (row in 0 until ticks.rows) {
+            val interval = ticks[row, T_INTERVAL]
+            if (interval <= 0 || !include(row)) continue
+            intervals += interval
+            if (interval * 2 > periodAt(samples, ticks[row, T_TIME], fallbackRate) * 3) over++
+        }
+        val sorted = intervals.toLongArray().also { it.sort() }
+        return "choreographer scope=$scope ticks=${sorted.size} p50=${ms(percentile(sorted, 50.0))} " +
+            "p90=${ms(percentile(sorted, 90.0))} max=${ms(sorted.lastOrNull() ?: -1L)} over_1_5x=$over"
+    }
+
+    fun ms(nanos: Long): String = if (nanos < 0) "-1" else String.format(Locale.US, "%.2f", nanos / 1_000_000.0)
+
+    private fun rate(value: Float): String = String.format(Locale.US, "%.1f", value)
+
+    private fun rateMilli(value: Long): String {
+        return if (value <= 0) "-1" else String.format(Locale.US, "%.1f", value / 1000.0)
+    }
+
+    private fun thermalName(status: Int): String = when (status) {
+        0 -> "none(0)"
+        1 -> "light(1)"
+        2 -> "moderate(2)"
+        3 -> "severe(3)"
+        4 -> "critical(4)"
+        5 -> "emergency(5)"
+        6 -> "shutdown(6)"
+        else -> "unknown($status)"
+    }
+
+    private fun duration(ms: Long): String {
+        val seconds = ms / 1000
+        val clock = String.format(Locale.US, "%02d:%02d:%02d", seconds / 3600 % 24, seconds / 60 % 60, seconds % 60)
+        return "${seconds / 86400}d $clock"
+    }
+
+    /** Converts monotonic nanos to local wall time using the export instant as the anchor. */
+    private class Clock(input: PerfReportInput) {
+        private val nowNanos = input.nowNanos
+        private val nowWallMs = input.nowWallMs
+        private val timeFormat = SimpleDateFormat("HH:mm:ss.SSS", Locale.US).apply { timeZone = input.timeZone }
+        private val secondFormat = SimpleDateFormat("HH:mm:ss", Locale.US).apply { timeZone = input.timeZone }
+        private val fullFormat = SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS Z", Locale.US).apply {
+            timeZone = input.timeZone
+        }
+
+        fun time(nanos: Long): String = timeFormat.format(Date(nowWallMs - (nowNanos - nanos) / 1_000_000))
+
+        fun second(epochSecond: Long): String = secondFormat.format(Date(epochSecond * 1000))
+
+        fun full(wallMs: Long): String = fullFormat.format(Date(wallMs))
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/util/system/HarmonyFramePerfTest.kt b/app/src/test/java/eu/kanade/tachiyomi/util/system/HarmonyFramePerfTest.kt
new file mode 100644
index 0000000..ac5478b
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/util/system/HarmonyFramePerfTest.kt
@@ -0,0 +1,274 @@
+package eu.kanade.tachiyomi.util.system
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.presentation.core.components.PanoramaScrollTrace
+import java.io.File
+import java.util.TimeZone
+import java.util.TreeMap
+
+class HarmonyFramePerfTest {
+
+    @Test
+    fun `percentile uses the nearest rank`() {
+        val sorted = LongArray(10) { it + 1L }
+        assertEquals(5L, PerfReport.percentile(sorted, 50.0))
+        assertEquals(9L, PerfReport.percentile(sorted, 90.0))
+        assertEquals(10L, PerfReport.percentile(sorted, 99.0))
+        assertEquals(1L, PerfReport.percentile(longArrayOf(1L), 99.0))
+        assertEquals(-1L, PerfReport.percentile(LongArray(0), 50.0))
+    }
+
+    @Test
+    fun `jank uses the deadline when known and 1_5 vsync otherwise`() {
+        assertTrue(PerfReport.isJank(totalNs = 20 * MS, deadlineNs = PERIOD, periodNs = PERIOD))
+        assertFalse(PerfReport.isJank(totalNs = 10 * MS, deadlineNs = PERIOD, periodNs = PERIOD))
+        assertTrue(PerfReport.isJank(totalNs = 26 * MS, deadlineNs = -1L, periodNs = PERIOD))
+        assertFalse(PerfReport.isJank(totalNs = 24 * MS, deadlineNs = -1L, periodNs = PERIOD))
+        assertFalse(PerfReport.isJank(totalNs = -1L, deadlineNs = -1L, periodNs = PERIOD))
+    }
+
+    @Test
+    fun `segments follow the tick phase and absorb the release gap before a fling`() {
+        val ticks = ArrayList<LongArray>()
+        var time = BASE
+        fun run(phase: Int, count: Int) {
+            repeat(count) {
+                ticks += tick(time, phase)
+                time += PERIOD
+            }
+        }
+        run(IDLE, 10)
+        run(DRAG, 20)
+        run(IDLE, 3)
+        run(FLING, 30)
+        run(IDLE, 10)
+        time += 3 * SECOND
+        run(IDLE, 5)
+        val segments = PerfReport.segments(PerfTable.of(PerfReport.TICK_WIDTH, *ticks.toTypedArray()))
+        assertEquals(
+            listOf("idle", "drag", "fling", "idle", "idle"),
+            segments.map { PerfReport.phaseName(it.phase) },
+        )
+        assertEquals(BASE + 30 * PERIOD, segments[2].startNs)
+        assertEquals(BASE + 63 * PERIOD, segments[2].endNs)
+    }
+
+    @Test
+    fun `noise counting keeps only per-second counts of the last window`() {
+        val markers = listOf("BLASTBufferQueue", "SurfaceDelegator")
+        val lines = sequenceOf(
+            "  1792000000.100  123  456 E BLASTBufferQueue: old line",
+            "  1792000010.100  123  456 E BLASTBufferQueue: [SurfaceView] https://example.com/title",
+            "  1792000010.900  123  456 E SurfaceDelegator: client is nullptr",
+            "  1792000011.000  123  456 I Tag: unrelated BLAST line? no",
+            "  1792000011.200  123  456 W pkg: SurfaceDelegator BLASTBufferQueue both",
+            "--------- beginning of main",
+        )
+        val counts = PerfReport.countNoise(lines, markers, fromEpochSec = 1_792_000_005L)
+        assertEquals(listOf(1_792_000_010L, 1_792_000_011L), counts.keys.toList())
+        assertEquals(listOf(1, 1, 2), counts.getValue(1_792_000_010L).toList())
+        assertEquals(listOf(1, 1, 1), counts.getValue(1_792_000_011L).toList())
+    }
+
+    @Test
+    fun `the export summarises segments and holds no forbidden text`() {
+        val input = syntheticInput()
+        val text = PerfReport.format(input)
+        File("build/tmp").mkdirs()
+        File("build/tmp/harmony_scroll_perf_sample.txt").writeText(text)
+
+        assertTrue(text.contains("frame_metrics: provided"), text)
+        assertTrue(Regex("segment type=fling .* jank=[1-9]").containsMatchIn(text), text)
+        assertTrue(text.contains("segment type=drag"), text)
+        assertTrue(text.contains("jank_stages scope=fling"), text)
+        assertTrue(Regex("jank_stages scope=fling frames=\\d+ .* main=layout").containsMatchIn(text), text)
+        assertTrue(text.contains("choreographer scope=all"), text)
+        assertTrue(text.contains("\njank "), text)
+        assertTrue(text.contains("\nsample "), text)
+        assertTrue(text.contains("\nnoise "), text)
+        assertTrue(text.contains("g0 mark user"), text)
+        assertTrue(text.trimEnd().endsWith(PerfReport.PRIVACY_LINE), text)
+        // Marker names appear in the "# markers:" line by design; the log message text must not.
+        val body = text.substringBeforeLast(PerfReport.PRIVACY_LINE)
+        val forbidden = listOf("http", "example.com", "SurfaceView", "Secret Title", "/storage/", "extension")
+        for (word in forbidden) {
+            assertFalse(body.contains(word, ignoreCase = true), "contains $word")
+        }
+    }
+
+    @Test
+    fun `without FrameMetrics the export says so and falls back to Choreographer`() {
+        val full = syntheticInput()
+        val input = PerfReportInput(
+            header = full.header,
+            frames = PerfTable(0, PerfReport.FRAME_WIDTH, LongArray(0)),
+            ticks = full.ticks,
+            samples = full.samples,
+            frameMetricsLate = true,
+            frameMetricsError = null,
+            noiseMarkers = full.noiseMarkers,
+            noise = TreeMap(),
+            trace = emptyList(),
+            startedNanos = full.startedNanos,
+            startedWallMs = full.startedWallMs,
+            nowNanos = full.nowNanos,
+            nowWallMs = full.nowWallMs,
+            timeZone = full.timeZone,
+        )
+        val text = PerfReport.format(input)
+        assertTrue(text.contains("FrameMetrics 未提供"), text)
+        assertTrue(text.contains("source=choreographer"), text)
+        assertTrue(text.contains("\njank_tick "), text)
+        assertTrue(text.trimEnd().endsWith(PerfReport.PRIVACY_LINE), text)
+    }
+
+    /**
+     * 12 s at 60 Hz: idle, a drag, a fling whose every 15th frame is a 30 ms layout frame, then
+     * a second drag with slow sync frames, and a switch to 90 Hz at 11.5 s.
+     */
+    private fun syntheticInput(): PerfReportInput {
+        val ticks = ArrayList<LongArray>()
+        val frames = ArrayList<LongArray>()
+        var previous = 0L
+        var index = -1
+        var time = BASE - PERIOD
+        while (true) {
+            index++
+            time += if (time - BASE >= SWITCH_NS) PERIOD_90 else PERIOD
+            if (time >= BASE + 12 * SECOND) break
+            val second = (time - BASE).toDouble() / SECOND
+            val phase = when {
+                second < 2.0 -> IDLE
+                second < 3.0 -> DRAG
+                second < 3.05 -> IDLE
+                second < 5.0 -> FLING
+                second < 8.0 -> IDLE
+                second < 9.0 -> DRAG
+                second < 11.0 -> FLING
+                else -> IDLE
+            }
+            // A main-thread stall: three vsyncs without a Choreographer frame.
+            if (index in 400..402) continue
+            ticks += tick(time, phase, interval = if (previous == 0L) 0L else time - previous).also {
+                it[PerfReport.T_MEASURES] = if (phase == IDLE) 0L else 1L
+                it[PerfReport.T_MEASURE_NS] = if (phase == IDLE) 0L else 2 * MS
+                it[PerfReport.T_COMPOSED] = if (index % 10 == 0 && phase != IDLE) 2L else 0L
+            }
+            previous = time
+            if (phase == IDLE && index % 30 != 0) continue
+            val frame = LongArray(PerfReport.FRAME_WIDTH)
+            frame[PerfReport.F_INTENDED_VSYNC] = time
+            frame[PerfReport.F_VSYNC] = time
+            frame[PerfReport.F_DELAY] = MS / 5
+            frame[PerfReport.F_INPUT] = if (phase == DRAG) MS / 2 else 0L
+            frame[PerfReport.F_ANIMATION] = MS
+            frame[PerfReport.F_LAYOUT] = 3 * MS
+            frame[PerfReport.F_DRAW] = MS
+            frame[PerfReport.F_SYNC] = MS / 2
+            frame[PerfReport.F_COMMAND] = MS
+            frame[PerfReport.F_SWAP] = MS / 2
+            frame[PerfReport.F_GPU] = 2 * MS
+            frame[PerfReport.F_DEADLINE] = if (time - BASE >= SWITCH_NS) PERIOD_90 else PERIOD
+            if (phase == FLING && index % 15 == 0) frame[PerfReport.F_LAYOUT] = 24 * MS
+            if (phase == DRAG && second > 8.0 && index % 12 == 0) frame[PerfReport.F_SYNC] = 20 * MS
+            frame[PerfReport.F_TOTAL] = listOf(
+                PerfReport.F_DELAY,
+                PerfReport.F_INPUT,
+                PerfReport.F_ANIMATION,
+                PerfReport.F_LAYOUT,
+                PerfReport.F_DRAW,
+                PerfReport.F_SYNC,
+                PerfReport.F_COMMAND,
+                PerfReport.F_SWAP,
+            ).sumOf { frame[it] }
+            frames += frame
+        }
+        val samples = ArrayList<LongArray>()
+        for (slot in 0 until 24) {
+            val sample = LongArray(PerfReport.SAMPLE_WIDTH)
+            sample[PerfReport.S_TIME] = BASE + slot * SECOND / 2
+            sample[PerfReport.S_GC] = if (slot == 19) 2L else 0L
+            sample[PerfReport.S_CPU_MS] = 120L
+            val rate = if (slot * SECOND / 2 >= SWITCH_NS) 90_000L else 60_000L
+            sample[PerfReport.S_REFRESH_MILLI] = rate
+            sample[PerfReport.S_MODE_ID] = if (rate == 90_000L) 2L else 1L
+            sample[PerfReport.S_MODE_REFRESH_MILLI] = rate
+            sample[PerfReport.S_THERMAL] = 0L
+            sample[PerfReport.S_POWER_SAVE] = 0L
+            samples += sample
+        }
+        val nowNanos = BASE + 12 * SECOND
+        val nowWallMs = 1_792_000_000_000L
+        val noiseLines = (0 until 12).flatMap { offset ->
+            val epoch = nowWallMs / 1000 - 12 + offset
+            List(if (offset == 9) 40 else 3) {
+                "  $epoch.500  1  2 E BLASTBufferQueue: [SurfaceView Secret Title] https://example.com/x"
+            }
+        }
+        val markers = listOf("BLASTBufferQueue", "SurfaceDelegator", "client is nullptr")
+        val header = PerfHeader(
+            appId = "app.mihon.test",
+            appLabel = "Mihon",
+            versionName = "0.20.4",
+            versionCode = 20,
+            brand = "HUAWEI",
+            model = "ALN-AL00",
+            androidRelease = "12",
+            sdk = 31,
+            windowWidthDp = 411,
+            windowHeightDp = 891,
+            density = 2.625f,
+            supportedRefreshRates = listOf(60f, 90f, 120f),
+            currentRefreshRate = 60f,
+            displayMode = "id=1 1260x2720 @60.0",
+            thermalStatus = 0,
+            powerSave = false,
+            uptimeMs = 93_784_000L,
+        )
+        return PerfReportInput(
+            header = header,
+            frames = PerfTable.of(PerfReport.FRAME_WIDTH, *frames.toTypedArray()),
+            ticks = PerfTable.of(PerfReport.TICK_WIDTH, *ticks.toTypedArray()),
+            samples = PerfTable.of(PerfReport.SAMPLE_WIDTH, *samples.toTypedArray()),
+            frameMetricsLate = false,
+            frameMetricsError = null,
+            noiseMarkers = markers,
+            noise = PerfReport.countNoise(noiseLines.asSequence(), markers, nowWallMs / 1000 - 30),
+            trace = listOf(
+                "00:00:02.000 g1 down pointers=1",
+                "00:00:03.000 g1 up moves=20 dy=-600 gapLastMove=8ms trackerV=-4000 recentV=-4100 consumed=true",
+                "00:00:03.016 g1 fling start v=4000 offset=1200 max=90000",
+                "00:00:05.000 g1 fling done left=0 dist=3000 frames=118 ms=1950 maxGap=33ms offset=4200 max=90000",
+                "00:00:12.000 g0 mark user",
+            ),
+            startedNanos = BASE,
+            startedWallMs = nowWallMs - 12_000L,
+            nowNanos = nowNanos,
+            nowWallMs = nowWallMs,
+            timeZone = TimeZone.getTimeZone("UTC"),
+        )
+    }
+
+    private fun tick(time: Long, phase: Int, interval: Long = PERIOD): LongArray {
+        val row = LongArray(PerfReport.TICK_WIDTH)
+        row[PerfReport.T_TIME] = time
+        row[PerfReport.T_INTERVAL] = interval
+        row[PerfReport.T_PHASE] = phase.toLong()
+        return row
+    }
+
+    private companion object {
+        const val MS = 1_000_000L
+        const val SECOND = 1_000_000_000L
+        const val PERIOD = 16_666_667L
+        const val PERIOD_90 = 11_111_111L
+        const val SWITCH_NS = 11_500_000_000L
+        const val BASE = 1_000_000_000_000L
+        const val IDLE = PanoramaScrollTrace.PHASE_IDLE
+        const val DRAG = PanoramaScrollTrace.PHASE_DRAG
+        const val FLING = PanoramaScrollTrace.PHASE_FLING
+    }
+}
