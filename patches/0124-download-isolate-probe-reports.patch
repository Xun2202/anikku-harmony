+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.async
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+
+class NavigationChromeDownloadProbeReportTest {
+    @TempDir lateinit var cache: File
+
+    // Same lengths as the transport recording rejected while mpv owned libav's log output.
+    private val full = """{"format":{"format_name":"mpegts","duration":"9919.574222"},"streams":[{"codec_type":"video","duration":"9919.552889"},{"codec_type":"audio","duration":"9919.274667"}]}"""
+
+    @Test
+    fun `concurrent probes use only their own completed output even when no session logs arrive`() = runTest {
+        val pending = mutableMapOf<String, Pair<File, (Int?) -> Unit>>()
+        suspend fun verify(input: String): String? {
+            val report = DownloadProbeReport.read(cache, arrayOf("-of", "json", input), 30_000) { args, done ->
+                assertEquals("-o", args[0])
+                pending[input] = File(args[1]) to done
+                return@read {}
+            }
+            assertEquals("ok", report.status)
+            return DownloadFfmpegPolicy.transportStreamMismatch(report.text, 9_919_553)
+        }
+
+        val good = async(start = CoroutineStart.UNDISPATCHED) { verify("full.ts") }
+        val short = async(start = CoroutineStart.UNDISPATCHED) { verify("truncated.ts") }
+        val (goodPath, finishGood) = pending.getValue("full.ts")
+        val (shortPath, finishShort) = pending.getValue("truncated.ts")
+        assertNotEquals(goodPath, shortPath)
+        shortPath.writeText(full.replace("9919.274667", "100.0"))
+        goodPath.writeText(full)
+        finishShort(0)
+        finishGood(0)
+        assertNull(good.await())
+        assertEquals("audio-duration-ms=100000", short.await())
+        assertTrue(cache.listFiles()!!.isEmpty())
+    }
+
+    @Test
+    fun `a late writer after timeout cannot overwrite a retry or resurrect its report`() = runTest {
+        lateinit var oldFile: File
+        lateinit var finishOld: (Int?) -> Unit
+        var cancelled = false
+        val old = DownloadProbeReport.read(cache, emptyArray(), 10) { args, done ->
+            oldFile = File(args[1])
+            finishOld = done
+            return@read { cancelled = true }
+        }
+        assertEquals("timeout", old.status)
+        assertTrue(cancelled)
+        val next = DownloadProbeReport.read(cache, emptyArray(), 10) { args, done ->
+            val newFile = File(args[1])
+            assertNotEquals(oldFile, newFile)
+            oldFile.writeText("stale")
+            finishOld(0)
+            newFile.writeText(full)
+            done(0)
+            return@read {}
+        }
+        assertEquals(full, next.text)
+        assertFalse(oldFile.exists())
+        assertTrue(cache.listFiles()!!.isEmpty())
+    }
+
+    @Test
+    fun `an empty report or a failed probe cannot promote a cached video`() = runTest {
+        for (code in listOf(0, 1)) {
+            val result = DownloadProbeReport.read(cache, emptyArray(), 10_000) { args, done ->
+                if (code != 0) File(args[1]).writeText(full)
+                done(code)
+                return@read {}
+            }
+            assertEquals(if (code == 0) "report-bytes-0" else "exit-1", result.status)
+            assertTrue(result.text.isEmpty())
+        }
+        assertTrue(cache.listFiles()!!.isEmpty())
+    }
+}
