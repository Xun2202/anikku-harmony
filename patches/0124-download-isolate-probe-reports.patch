+package eu.kanade.tachiyomi.data.download
+
+import com.arthenica.ffmpegkit.FFprobeKit
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withTimeoutOrNull
+import java.io.File
+import java.io.IOException
+import java.util.concurrent.Executors
+import kotlin.coroutines.resume
+
+/** Read the probe's own output even when mpv owns the process-wide libav log callback. */
+internal object DownloadProbeReport {
+    data class Result(val text: String = "", val status: String)
+
+    suspend fun read(
+        cache: File,
+        options: Array<String>,
+        timeoutMillis: Long,
+        start: (Array<String>, (Int?) -> Unit) -> (() -> Unit) = ::startNative,
+    ): Result = withTimeoutOrNull(timeoutMillis) {
+        suspendCancellableCoroutine<Result> { continuation ->
+            val report = try {
+                File.createTempFile("download-probe-", ".out", cache)
+            } catch (error: IOException) {
+                continuation.resume(Result(status = "create-${error.javaClass.simpleName}"))
+                return@suspendCancellableCoroutine
+            }
+            try {
+                val cancel = start(arrayOf("-o", report.absolutePath, *options)) { code ->
+                    // The native writer is closed here, even if the caller timed out earlier.
+                    val result = try {
+                        when {
+                            !continuation.isActive -> null
+                            code != 0 -> Result(status = "exit-$code")
+                            report.length() !in 1..MAX_REPORT_BYTES -> Result(status = "report-bytes-${report.length()}")
+                            else -> Result(report.readText(), "ok")
+                        }
+                    } catch (error: IOException) {
+                        Result(status = "read-${error.javaClass.simpleName}")
+                    } finally {
+                        report.delete()
+                    }
+                    if (result != null) continuation.resume(result)
+                }
+                continuation.invokeOnCancellation { cancel() }
+            } catch (error: Exception) {
+                report.delete()
+                if (error is CancellationException) throw error
+                continuation.resume(Result(status = "start-${error.javaClass.simpleName}"))
+            }
+        }
+    } ?: Result(status = "timeout")
+
+    private fun startNative(arguments: Array<String>, done: (Int?) -> Unit): () -> Unit {
+        // Kit 1.18 leaves output_filename in native thread-local storage between invocations.
+        // A fresh thread prevents one probe from inheriting the previous probe's output path.
+        val executor = Executors.newSingleThreadExecutor()
+        return try {
+            val session = FFprobeKit.executeWithArgumentsAsync(arguments, { done(it.returnCode?.value) }, executor)
+            session::cancel
+        } finally {
+            // Shutdown accepts no more work; the one submitted probe still runs its completion callback.
+            executor.shutdown()
+        }
+    }
+
+    private const val MAX_REPORT_BYTES = 128L * 1024
+}
