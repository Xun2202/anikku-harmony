+                listSignature,
+                PanoramaCoverShapes.committedShapeVersion.intValue,
+            )
+        }.collect { (settled, signature, _) ->
+            // Harmony: flush cross-band commits first. That flush may bump the version.
             PanoramaCoverShapes.setGridScrolling(token, scrolling = !settled)
+            val version = PanoramaCoverShapes.committedShapeVersion.intValue
+            val (total, idAt) = listed
+            currentMode.onGridSignal(settled, total, idAt, signature, version)
         }
     }
 }
