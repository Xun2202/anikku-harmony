 object PanoramaFrameCounters {
 
+    var enabled: Boolean = false
+    const val NAVIGATION_SOURCE = 0
+    const val SCROLLER_SOURCE = 1
+
+    var navigationSources: Int = 0
+        private set
+    var scrollerSources: Int = 0
+        private set
+    var navigationDrawNanos: Long = 0L
+        private set
+    var scrollerDrawNanos: Long = 0L
+        private set
+    var planNanos: Long = 0L
+        private set
+    var cellsNanos: Long = 0L
+        private set
+    var visibleCells: Int = 0
+        private set
+    var prefetchCells: Int = 0
+        private set
+    var scannedRects: Int = 0
+        private set
+
+    // Attachment lifetime is independent of the recorder lifetime.
+    fun sourceAttached(kind: Int) {
+        when (kind) {
+            NAVIGATION_SOURCE -> navigationSources++
+            SCROLLER_SOURCE -> scrollerSources++
+        }
+    }
+
+    fun sourceDetached(kind: Int) {
+        when (kind) {
+            NAVIGATION_SOURCE -> navigationSources = (navigationSources - 1).coerceAtLeast(0)
+            SCROLLER_SOURCE -> scrollerSources = (scrollerSources - 1).coerceAtLeast(0)
+        }
+    }
+
+    /** Inclusive durations: these can overlap measure and must not be added together. */
+    fun sourceDraw(kind: Int, nanos: Long) {
+        if (!enabled) return
+        when (kind) {
+            NAVIGATION_SOURCE -> navigationDrawNanos += nanos
+            SCROLLER_SOURCE -> scrollerDrawNanos += nanos
+        }
+    }
+
+    fun masonryWork(planNanos: Long, cellsNanos: Long, visibleCells: Int, prefetchCells: Int, scannedRects: Int) {
+        if (!enabled) return
+        this.planNanos += planNanos
+        this.cellsNanos += cellsNanos
+        this.visibleCells += visibleCells
+        this.prefetchCells += prefetchCells
+        this.scannedRects += scannedRects
+    }
