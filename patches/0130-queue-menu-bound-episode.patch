@@ -153,6 +153,7 @@ class DownloadQueueScreenModel(
         screenModelScope.launch {
             downloadManager.queueState
                 .map { downloads ->
+                    qualityTarget.update { target -> target?.takeIf { downloads.any { it === target } } }
                     downloads
                         .groupBy { it.source }
                         .map { entry ->
