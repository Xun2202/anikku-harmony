From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Mon, 23 Nov 2026 14:34:36 +0000
Subject: [PATCH] downloads: anchor an open queue menu to its episode

Background transfers can finish or move while the overflow menu or quality picker is open. Ignore recycled rows, identify the episode in the picker, and dismiss it when its queue entry disappears.
---
 .../kanade/tachiyomi/ui/download/DownloadHolder.kt |  6 +++++-
 .../tachiyomi/ui/download/DownloadQualityDialog.kt | 14 +++++++++++++-
 .../ui/download/DownloadQueueScreenModel.kt        |  1 +
 3 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/app/src/main/java/eu/kanade/tachiyomi/ui/download/DownloadHolder.kt b/app/src/main/java/eu/kanade/tachiyomi/ui/download/DownloadHolder.kt
index 6a0d57a..4282ba3 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/ui/download/DownloadHolder.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/ui/download/DownloadHolder.kt
@@ -149,6 +149,7 @@ class DownloadHolder(private val view: View, val adapter: DownloadAdapter) :
 
     private fun showPopupMenu(view: View) {
         if (bindingAdapterPosition == RecyclerView.NO_POSITION) return
+        val target = download
         view.popupMenu(
             menuRes = R.menu.download_single,
             initMenu = {
@@ -175,7 +176,10 @@ class DownloadHolder(private val view: View, val adapter: DownloadAdapter) :
                     bindingAdapterPosition != adapter.itemCount - 1
             },
             onMenuItemClick = {
-                adapter.downloadItemListener.onMenuItemClick(bindingAdapterPosition, this)
+                val position = bindingAdapterPosition
+                if (position != RecyclerView.NO_POSITION && (adapter.getItem(position) as? DownloadItem)?.download === target) {
+                    adapter.downloadItemListener.onMenuItemClick(position, this)
+                }
             },
         )
     }
