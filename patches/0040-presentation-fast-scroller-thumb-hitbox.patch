+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.MutatePriority
+import androidx.compose.runtime.BroadcastFrameClock
+import androidx.compose.runtime.withFrameNanos
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import kotlinx.coroutines.yield
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import kotlin.math.abs
+
+/**
+ * Drives [PanoramaMasonryState] the way [androidx.compose.foundation.gestures.DefaultFlingBehavior]
+ * does: each frame scrolls by the decay delta and cancels when the consumed amount misses that
+ * delta by more than half a pixel. Layout passes run between frames, while the fling session is
+ * suspended, which is when measure rewrites [PanoramaMasonryState.scrollOffset].
+ */
+class PanoramaMasonryFlingLogicTest {
+    @Test
+    fun `baseline fling travels until the decay ends`() = runBlocking {
+        val trace = fling()
+        println("FLING_LOGIC baseline distance=${trace.distance} frames=${trace.frames} cancelled=${trace.cancelled}")
+        assertTrue(trace.distance > 2_000f, "distance ${trace.distance}")
+        assertTrue(trace.frames > 20, "frames ${trace.frames}")
+        assertTrue(!trace.cancelled)
+    }
+
+    @Test
+    fun `one epoch change during a fling keeps almost all of the distance`() = runBlocking {
+        val baseline = fling()
+        val trace = fling { frame, _, control ->
+            // Measure has been keeping the anchor on the viewport. One new epoch snaps to it.
+            if (frame == 8) control.epoch = 99L
+        }
+        println(
+            "FLING_LOGIC epochOnce distance=${trace.distance} frames=${trace.frames} " +
+                "cancelled=${trace.cancelled} baseline=${baseline.distance}",
+        )
+        assertTrue(!trace.cancelled)
+        assertTrue(trace.distance > baseline.distance * 0.85f, "${trace.distance} vs ${baseline.distance}")
+    }
+
+    @Test
+    fun `epoch change on every frame leaves no visual fling`() = runBlocking {
+        val baseline = fling()
+        val trace = fling { frame, _, control ->
+            control.epoch = frame.toLong() + 10L
+        }
+        println(
+            "FLING_LOGIC epochEveryFrame distance=${trace.distance} frames=${trace.frames} " +
+                "cancelled=${trace.cancelled} baseline=${baseline.distance}",
+        )
+        assertTrue(trace.distance < baseline.distance * 0.15f, "${trace.distance} vs ${baseline.distance}")
+    }
+
+    @Test
+    fun `same keys in a new list do not pull the offset back`() = runBlocking {
+        val baseline = fling()
+        // Every frame already rebuilds the key list. The epoch stays, so the snap stays off.
+        val trace = fling()
+        println(
+            "FLING_LOGIC sameKeys distance=${trace.distance} frames=${trace.frames} " +
+                "baseline=${baseline.distance}",
+        )
+        assertTrue(!trace.cancelled)
+        assertTrue(abs(trace.distance - baseline.distance) < 2f, "${trace.distance} vs ${baseline.distance}")
+    }
+
+    @Test
+    fun `one height change during a fling does not end it`() = runBlocking {
+        val baseline = fling()
+        val trace = fling { frame, _, control ->
+            if (frame == 8) {
+                control.epoch = 50L
+                control.height = 280
+            }
+        }
+        println(
+            "FLING_LOGIC heightOnce distance=${trace.distance} frames=${trace.frames} " +
+                "cancelled=${trace.cancelled} baseline=${baseline.distance}",
+        )
+        assertTrue(!trace.cancelled)
+        assertTrue(trace.frames > baseline.frames - 5, "frames ${trace.frames} vs ${baseline.frames}")
+        assertTrue(trace.distance > 1_000f, "distance ${trace.distance}")
+    }
+
+    @Test
+    fun `pending restore during a fling jumps once and the decay continues`() = runBlocking {
+        val baseline = fling()
+        val trace = fling { frame, state, _ ->
+            if (frame == 5) {
+                state.pendingRestore = PanoramaPendingRestore(
+                    index = 40,
+                    offsetFromViewportTop = 0,
+                    key = 40,
+                )
+            }
+        }
+        println(
+            "FLING_LOGIC pendingRestore distance=${trace.distance} frames=${trace.frames} " +
+                "cancelled=${trace.cancelled} baseline=${baseline.distance}",
+        )
+        assertTrue(!trace.cancelled, "restore must not look like an edge")
+        assertTrue(trace.frames > 20, "frames ${trace.frames}")
+        assertEquals(null, trace.state.pendingRestore)
+    }
+
+    @Test
+    fun `user input scroll cancels the fling session`() = runBlocking {
+        val baseline = fling()
+        val trace = fling { frame, state, _ ->
+            if (frame == 4) {
+                launch(start = CoroutineStart.UNDISPATCHED) {
+                    state.scrollableState.scroll(MutatePriority.UserInput) {
+                        scrollBy(1f)
+                    }
+                }
+            }
+        }
+        println(
+            "FLING_LOGIC userInput distance=${trace.distance} frames=${trace.frames} " +
+                "cancelled=${trace.cancelled} baseline=${baseline.distance}",
+        )
+        assertTrue(trace.distance < baseline.distance * 0.35f, "${trace.distance} vs ${baseline.distance}")
+        assertTrue(trace.frames < baseline.frames / 2, "frames ${trace.frames} vs ${baseline.frames}")
+    }
+
+    private suspend fun fling(
+        count: Int = ITEM_COUNT,
+        onFrame: suspend CoroutineScope.(
+            frame: Int,
+            state: PanoramaMasonryState,
+            control: FrameControl,
+        ) -> Unit = { _, _, _ -> },
+    ): FlingTrace = coroutineScope {
+        val state = PanoramaMasonryState()
+        val control = FrameControl()
+        applyShelf(state, epoch = control.epoch, height = control.height, count = count)
+        val clock = BroadcastFrameClock()
+        val samples = ArrayList<Float>()
+        var cancelled = false
+        val job = launch(clock, start = CoroutineStart.UNDISPATCHED) {
+            state.scrollableState.scroll(MutatePriority.Default) {
+                var velocity = INITIAL_VELOCITY
+                var last = 0f
+                var value = 0f
+                while (abs(velocity) > 40f) {
+                    value += velocity * FRAME_SECONDS
+                    val delta = value - last
+                    val consumed = scrollBy(delta)
+                    last = value
+                    if (abs(delta - consumed) > 0.5f) {
+                        cancelled = true
+                        break
+                    }
+                    velocity *= DECAY
+                    withFrameNanos { }
+                }
+            }
+        }
+        var frames = 0
+        withTimeout(5_000) {
+            while (job.isActive && frames < MAX_FRAMES) {
+                // The finger already moved this frame. Measure, as the real grid does, before
+                // the next decay step. The hook may change the epoch or the heights first.
+                onFrame(frames, state, control)
+                applyShelf(state, epoch = control.epoch, height = control.height, count = count)
+                clock.sendFrame(frames * FRAME_NANOS)
+                yield()
+                samples.add(state.scrollOffset)
+                frames++
+            }
+        }
+        job.cancel()
+        val distance = if (samples.isEmpty()) 0f else samples.last() - samples.first()
+        FlingTrace(state, distance, frames, cancelled)
+    }
+
+    private fun applyShelf(
+        state: PanoramaMasonryState,
+        epoch: Long,
+        height: Int,
+        count: Int = ITEM_COUNT,
+        forceStructural: Boolean? = null,
+    ) {
+        val heights = IntArray(count) { height }
+        val layout = state.layoutCache.layout(
+            count = count,
+            contentEpoch = epoch,
+            heightOf = { index, _ -> heights[index] },
+            laneWidths = intArrayOf(LANE, LANE),
+            verticalSpacing = SPACING,
+            horizontalSpacing = SPACING,
+            rtl = false,
+        )
+        val keys = List(layout.rects.size) { it }
+        val structural = forceStructural ?: state.layoutCache.structuralChange
+        val viewport = 1_800
+        val total = layout.contentHeight
+        state.applyMeasuredViewport(
+            rects = layout.rects,
+            keys = keys,
+            topPadding = 0,
+            viewport = viewport,
+            totalHeight = total,
+            bottomPadding = 0,
+            structural = structural,
+        )
+    }
+
+    private class FrameControl {
+        var epoch = 1L
+        var height = 400
+    }
+
+    private class FlingTrace(
+        val state: PanoramaMasonryState,
+        val distance: Float,
+        val frames: Int,
+        val cancelled: Boolean,
+    )
+
+    private companion object {
+        const val ITEM_COUNT = 2_000
+        const val LANE = 300
+        const val SPACING = 8
+        const val MAX_FRAMES = 240
+        const val FRAME_SECONDS = 0.016f
+        const val FRAME_NANOS = 16_000_000L
+        const val DECAY = 0.94f
+        const val INITIAL_VELOCITY = 12_000f
+    }
+}
