+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.requiredSize
+import androidx.compose.runtime.MutableIntState
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ComposeUiTest
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performTouchInput
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.test.swipe
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import org.junit.After
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+import kotlin.math.abs
+
+/**
+ * Finger-up coast of a 2000-cell panorama, stepped a frame at a time on the compose clock.
+ */
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class PanoramaMasonryFlingTest {
+    @After
+    fun resetEpoch() {
+        PanoramaMasonryContentEpoch.intValue = 0
+    }
+
+    @Test
+    fun `a coast from the content survives and a coast from the thumb does not`() {
+        val center = coast(xFromEnd = null)
+        val from40 = coast(xFromEnd = 40.dp)
+        val from20 = coast(xFromEnd = 20.dp)
+        val onThumb = coast(xFromEnd = 6.dp)
+        println(
+            "FLING_UI center=${center.inertia} drag=${center.drag} frames=${center.frames} " +
+                "dp40=${from40.inertia} drag=${from40.drag} frames=${from40.frames} " +
+                "dp20=${from20.inertia} drag=${from20.drag} frames=${from20.frames} " +
+                "thumb=${onThumb.inertia} drag=${onThumb.drag} frames=${onThumb.frames}",
+        )
+        assertTrue(center.inertia > 300f, "baseline ${center.inertia}")
+        assertTrue(from40.inertia > center.inertia * 0.6f, "40dp ${from40.inertia} vs ${center.inertia}")
+        assertTrue(from20.inertia > center.inertia * 0.6f, "20dp ${from20.inertia} vs ${center.inertia}")
+        assertTrue(onThumb.inertia < center.inertia * 0.25f, "thumb ${onThumb.inertia} vs ${center.inertia}")
+    }
+
+    @Test
+    fun `a downward flick beside the bottom thumb still coasts`() {
+        // Harmony: at the end of the list the thumb sits in the bottom corner. A return
+        // flick starts inside its height, 20 dp from the end, which the old 32 dp hit box covered.
+        val center = coast(xFromEnd = null, atEnd = true, swipeDown = true)
+        val beside = coast(xFromEnd = 20.dp, atEnd = true, swipeDown = true)
+        val centerBack = -center.inertia
+        val besideBack = -beside.inertia
+        println(
+            "FLING_UI bottomReturn center=$centerBack drag=${center.drag} frames=${center.frames} " +
+                "beside=$besideBack drag=${beside.drag} frames=${beside.frames}",
+        )
+        assertTrue(centerBack > 100f, "baseline $centerBack")
+        assertTrue(besideBack >= centerBack * 0.9f, "20dp $besideBack vs $centerBack")
+    }
+
+    @Test
+    fun `one epoch bump during the coast keeps most of it`() {
+        val baseline = coast(fastScroller = false)
+        val bumped = coast(fastScroller = false) { frame, _ ->
+            if (frame == 3) PanoramaMasonryContentEpoch.intValue++
+        }
+        println(
+            "FLING_UI epochOnce baseline=${baseline.inertia} frames=${baseline.frames} " +
+                "bumped=${bumped.inertia} frames=${bumped.frames}",
+        )
+        assertTrue(bumped.inertia > baseline.inertia * 0.6f, "${bumped.inertia} vs ${baseline.inertia}")
+        assertTrue(bumped.frames > 8, "frames ${bumped.frames}")
+    }
+
+    @Test
+    fun `a new items lambda once during the coast keeps most of it`() {
+        val baseline = coast(fastScroller = false)
+        val replaced = coast(
+            xFromEnd = null,
+            fastScroller = false,
+            observeGeneration = true,
+            restyle = false,
+        ) { frame, _, generation ->
+            if (frame == 3) generation.intValue++
+        }
+        println(
+            "FLING_UI newLambda baseline=${baseline.inertia} frames=${baseline.frames} " +
+                "replaced=${replaced.inertia} frames=${replaced.frames}",
+        )
+        assertTrue(replaced.inertia > baseline.inertia * 0.6f, "${replaced.inertia} vs ${baseline.inertia}")
+    }
+
+    @Test
+    fun `a height change once during the coast does not end it`() {
+        val baseline = coast(fastScroller = false)
+        val changed = coast(
+            xFromEnd = null,
+            fastScroller = false,
+            observeGeneration = true,
+            restyle = true,
+        ) { frame, _, generation ->
+            if (frame == 3) generation.intValue++
+        }
+        println(
+            "FLING_UI heightOnce baseline=${baseline.inertia} frames=${baseline.frames} " +
+                "changed=${changed.inertia} frames=${changed.frames}",
+        )
+        assertTrue(changed.frames > 8, "frames ${changed.frames}")
+    }
+
+    @Test
+    fun `a new items lambda on every coast frame eats the visual fling`() {
+        val baseline = coast(fastScroller = false)
+        val every = coast(
+            xFromEnd = null,
+            fastScroller = false,
+            observeGeneration = true,
+            restyle = false,
+        ) { _, _, generation ->
+            generation.intValue++
+        }
+        println(
+            "FLING_UI lambdaEveryFrame baseline=${baseline.inertia} frames=${baseline.frames} " +
+                "every=${every.inertia} frames=${every.frames}",
+        )
+        assertTrue(every.inertia < baseline.inertia * 0.35f, "${every.inertia} vs ${baseline.inertia}")
+    }
+
+    @Test
+    fun `pending restore during the coast does not end it`() {
+        val baseline = coast(fastScroller = false)
+        val restored = coast(fastScroller = false) { frame, masonry ->
+            if (frame == 2 && masonry.pendingRestore == null) {
+                masonry.pendingRestore = PanoramaPendingRestore(
+                    index = 30,
+                    offsetFromViewportTop = 0,
+                    key = 30,
+                )
+            }
+        }
+        println(
+            "FLING_UI pendingRestore baseline=${baseline.inertia} frames=${baseline.frames} " +
+                "restored=${restored.inertia} frames=${restored.frames}",
+        )
+        assertTrue(restored.frames > 8, "frames ${restored.frames}")
+    }
+
+    private fun coast(
+        xFromEnd: Dp? = null,
+        fastScroller: Boolean = true,
+        observeGeneration: Boolean = false,
+        restyle: Boolean = false,
+        atEnd: Boolean = false,
+        swipeDown: Boolean = false,
+        onFrame: (frame: Int, state: PanoramaMasonryState) -> Unit = { _, _ -> },
+    ): Coast = coast(
+        xFromEnd,
+        fastScroller,
+        observeGeneration,
+        restyle,
+        atEnd,
+        swipeDown,
+    ) { frame, state, _ ->
+        onFrame(frame, state)
+    }
+
+    private fun coast(
+        xFromEnd: Dp?,
+        fastScroller: Boolean,
+        observeGeneration: Boolean,
+        restyle: Boolean = false,
+        atEnd: Boolean = false,
+        swipeDown: Boolean = false,
+        onFrame: (frame: Int, state: PanoramaMasonryState, generation: MutableIntState) -> Unit,
+    ): Coast {
+        lateinit var coast: Coast
+        runComposeUiTest {
+            coast = runCoast(xFromEnd, fastScroller, observeGeneration, restyle, atEnd, swipeDown, onFrame)
+        }
+        return coast
+    }
+
+    private fun ComposeUiTest.runCoast(
+        xFromEnd: Dp?,
+        fastScroller: Boolean,
+        observeGeneration: Boolean,
+        restyle: Boolean,
+        atEnd: Boolean,
+        swipeDown: Boolean,
+        onFrame: (frame: Int, state: PanoramaMasonryState, generation: MutableIntState) -> Unit,
+    ): Coast {
+        val state = PanoramaMasonryState()
+        val generation = mutableIntStateOf(0)
+        setContent {
+            val tick = if (observeGeneration) generation.intValue else 0
+            Box(Modifier.requiredSize(360.dp, 640.dp)) {
+                val grid = Modifier
+                    .fillMaxSize()
+                    .testTag("grid")
+                val content: PanoramaMasonryScope.() -> Unit = {
+                    items(
+                        count = ITEM_COUNT,
+                        key = { it },
+                        height = {
+                            val tall = restyle && tick != 0 && it % 5 == 0
+                            PanoramaCellHeight.Fixed(if (tall) 90.dp else 150.dp)
+                        },
+                    ) {
+                        Box(Modifier.fillMaxSize())
+                    }
+                }
+                if (fastScroller) {
+                    FastScrollPanoramaMasonry(
+                        columns = PanoramaColumns.Fixed(2),
+                        modifier = grid,
+                        state = state,
+                        thumbColor = Color.Black,
+                        content = content,
+                    )
+                } else {
+                    PanoramaMasonry(
+                        columns = PanoramaColumns.Fixed(2),
+                        modifier = grid,
+                        state = state,
+                        content = content,
+                    )
+                }
+            }
+        }
+        mainClock.autoAdvance = false
+        repeat(4) { mainClock.advanceTimeByFrame() }
+        check(state.maxScroll > 1_000f) { "maxScroll=${state.maxScroll}" }
+        if (fastScroller || atEnd) {
+            state.scrollOffset = if (atEnd) state.maxScroll else state.maxScroll / 2f
+            // The thumb fades in off the scroll signal. Give that delay a few frames.
+            repeat(40) { mainClock.advanceTimeByFrame() }
+        }
+        if (atEnd) {
+            check(abs(state.scrollOffset - state.maxScroll) < 1f) {
+                "offset ${state.scrollOffset} max ${state.maxScroll}"
+            }
+            check(!state.canScrollForward) { "thumb is not parked at the end" }
+        }
+        val beforeDrag = state.scrollOffset
+        onNodeWithTag("grid").performTouchInput {
+            val x = if (xFromEnd == null) centerX else width - xFromEnd.toPx()
+            val startY: Float
+            val endY: Float
+            if (swipeDown) {
+                // Drawn thumb is 48 dp. The down is inside that span; only x differs from the center flick.
+                val thumbHeightPx = 48.dp.toPx()
+                val topPad = Dp.Hairline.toPx()
+                val bottomPad = Dp.Hairline.toPx()
+                val track = height - topPad - bottomPad - state.afterContentPadding - thumbHeightPx
+                check(track > 0f) { "track $track" }
+                val proportion = if (!state.canScrollForward) {
+                    1f
+                } else {
+                    (state.scrollOffset / state.maxScroll).coerceIn(0f, 1f)
+                }
+                val thumbTop = topPad + track * proportion
+                startY = thumbTop + 1f
+                endY = thumbTop + thumbHeightPx - 1f
+                check(startY > thumbTop && endY < thumbTop + thumbHeightPx) { "y $startY..$endY top $thumbTop" }
+            } else {
+                // Half-scroll puts the thumb on the vertical middle. The down has to land there
+                // for the right-edge cases; the same line is a normal content fling in the middle.
+                startY = height * 0.50f
+                endY = height * 0.12f
+            }
+            swipe(
+                start = Offset(x, startY),
+                end = Offset(x, endY),
+                durationMillis = 40,
+            )
+        }
+        val atRelease = state.scrollOffset
+        var frames = 0
+        var stable = 0
+        var previous = atRelease
+        while (frames < MAX_COAST_FRAMES && stable < 4) {
+            onFrame(frames, state, generation)
+            mainClock.advanceTimeByFrame()
+            val now = state.scrollOffset
+            if (abs(now - previous) < 0.5f) stable++ else stable = 0
+            previous = now
+            frames++
+        }
+        return Coast(
+            drag = atRelease - beforeDrag,
+            inertia = state.scrollOffset - atRelease,
+            frames = frames,
+        )
+    }
+
+    private class Coast(
+        val drag: Float,
+        val inertia: Float,
+        val frames: Int,
+    )
+
+    private companion object {
+        const val ITEM_COUNT = 2_000
+        const val MAX_COAST_FRAMES = 160
+    }
+}
