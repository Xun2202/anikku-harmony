+    @Test
+    fun `a cancelled proxy request returning late cannot replace the resumed downloads successful response`() = runTest {
+        val url = "https://example.test/block.ts".toHttpUrl()
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val client = OkHttpClient.Builder().addInterceptor(HlsRepairResponseInterceptor).addInterceptor { chain ->
+            val late = chain.request().header("Fixture") == "late"
+            if (late) {
+                entered.countDown()
+                check(release.await(5, TimeUnit.SECONDS))
+            }
+            val ts = ByteArray(3 * 188) {
+                if (it % 188 == 0) {
+                    0x47
+                } else if (late) {
+                    1
+                } else {
+                    2
+                }
+            }
+            Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).message("fixture").code(200).body(ts.toResponseBody()).build()
+        }.build()
+        fun read(value: String) = client.newCall(Request.Builder().url(url).header("Fixture", value).build()).execute().use { it.body.bytes() }
+        val temporary = File(root, "same.part")
+        val late = HlsRepairResponseInterceptor.during(url, temporary) {
+            async(Dispatchers.IO) { read("late") }.also { assertTrue(entered.await(5, TimeUnit.SECONDS)) }
+        }
+        HlsRepairResponseInterceptor.during(url, temporary) { observed ->
+            val expected = read("resumed")
+            release.countDown()
+            late.await()
+            assertTrue(expected.contentEquals(checkNotNull(observed()).readBytes()))
+        }
+        assertFalse(temporary.exists())
+    }
+
