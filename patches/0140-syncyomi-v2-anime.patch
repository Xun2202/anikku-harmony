+                    .executeAsOneOrNull()
+                val season = entry.parentId != null || entry.parentUrl != null || existing?.parentId != null
+                val include = if (season) {
+                    options.seasons
+                } else {
+                    entry.favorite || options.seenEntries || existing?.favorite == true ||
+                        uploadedWorks[key]?.favorite == true || acknowledgedWorks[key]?.favorite == true
+                }
