+    private fun <T> verifyUnchanged(current: T?, uploaded: T?, incoming: T?, field: String, hadSnapshot: Boolean) {
+        if (hadSnapshot && current != incoming && current != uploaded) {
+            throw IOException("The local $field changed during SyncYomi sync")
+        }
