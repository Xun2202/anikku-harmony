+        }
+        customUpdates.forEach { customMangaRepository.set(it) }
+        if (applied.works.isNotEmpty()) {
+            enrichSyncYomiSourceUrls(applied.backup.backupManga, applied.works, handler = handler)
+        }
+
+        fun allowPreference(key: String): Boolean =
+            !Preference.isAppState(key) && (options.privateSettings || !Preference.isPrivate(key))
+
+        if (options.appSettings) {
+            val preferences = remote.backupPreferences.filter { allowPreference(it.key) }
+            if (preferences.isNotEmpty()) {
