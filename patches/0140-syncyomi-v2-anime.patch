+    private data class CategoryRestore(
+        val idsByRemoteOrder: Map<Long, Long>,
+        val idsBeforeRestore: Map<Long, Long>,
+        val idsBeforeUpload: Map<Long, Long>,
+        val categories: List<BackupCategory>,
+    )
+
+    private fun Database.restoreCategories(
+        incoming: List<BackupCategory>,
+        uploaded: Backup?,
+        acknowledged: Backup?,
+    ): CategoryRestore {
+        val current = categoriesQueries.getCategories(CategoryMapper::mapCategory).executeAsList()
+            .filter { it.id > 0 }.map(backupCategoryMapper)
+        val uploadedById = uploaded?.backupCategories.orEmpty().associateBy { it.id }
+        val uploadedByName = uploaded?.backupCategories.orEmpty().associateBy { it.name }
+        val acknowledgedById = acknowledged?.backupCategories.orEmpty().associateBy { it.id }
+        val currentById = current.associateBy { it.id }
+        val currentByName = current.associateBy { it.name }
+        val knownIds = (acknowledgedById + uploadedById).values.filter { it.uid != 0L }.associate { it.uid to it.id }
+        val remoteNames = incoming.map { it.name }.toSet()
+        val remoteUids = incoming.map { it.uid }.filter { it != 0L }.toSet()
+        val uploadedMemberships = uploaded?.backupManga.orEmpty().flatMap { entry ->
+            entry.categories.map { it to (entry.source to entry.url) }
+        }.groupBy({ it.first }, { it.second }).mapValues { (_, members) -> members.toSet() }
+        val deleted = current.filter { category ->
+            val sent = uploadedById[category.id]
+            val prior = acknowledgedById[category.id]
+            prior != null && category.name !in remoteNames && prior.uid !in remoteUids &&
+                category.sameLocalCategory(sent) && category.sameLocalCategory(prior) &&
+                animes_categoriesQueries.getAnimeKeysForCategory(category.id).executeAsList().all {
+                    (it.source to it.url) in uploadedMemberships[category.order].orEmpty()
+                }
+        }
+        deleted.forEach { categoriesQueries.delete(it.id) }
+        val deletedIds = deleted.map { it.id }.toSet()
+        var nextOrder = (current.maxOfOrNull { it.order } ?: -1) + 1
+        val matched = linkedMapOf<Long, Pair<BackupCategory, BackupCategory>>()
+        incoming.forEach { entry ->
+            val knownId = knownIds[entry.uid] ?: uploadedByName[entry.name]?.id
+            val observed = (knownId?.let(currentById::get) ?: currentByName[entry.name])
+                ?.takeUnless { it.id in deletedIds }
+            if (observed == null && knownId in uploadedById) {
+                throw IOException("The local category changed during SyncYomi sync")
+            }
+            val category = if (observed == null) {
+                val order = nextOrder++
+                categoriesQueries.insert(entry.name, order, entry.flags, if (entry.hidden) 1 else 0)
+                entry.copy(id = categoriesQueries.selectLastInsertedRowId().executeAsOne(), order = order, syncOrder = null)
+            } else {
+                val sent = uploadedById[observed.id]
+                val restored = entry.copy(id = observed.id, order = observed.order, syncOrder = null)
+                if (uploaded != null && !observed.sameLocalCategory(sent) && !observed.sameLocalCategory(restored)) {
+                    throw IOException("The local category changed during SyncYomi sync")
+                }
+                if (!observed.sameLocalCategory(restored)) {
+                    categoriesQueries.update(entry.name, null, entry.flags, if (entry.hidden) 1 else 0, observed.id)
+                }
+                restored
+            }
+            check(matched.put(category.id, entry to category) == null) { "SyncYomi sent duplicate category identities" }
+        }
+        val local = current.filter { it.id !in deletedIds && it.id !in matched }
+            .map { row ->
+                val known = uploadedById[row.id] ?: acknowledgedById[row.id]
+                if (known == null) row else row.copy(version = known.version, uid = known.uid, lastModifiedAt = known.lastModifiedAt)
+            }
+        val layout = arrangeSyncYomiCategories(matched.values, local)
+        layout.categories.forEach { category ->
+            val original = matched[category.id]?.second ?: return@forEach
+            val observed = currentById[category.id]
+            verifyUnchanged(
+                observed?.order,
+                uploadedById[category.id]?.order,
+                category.order,
+                "category order",
+                uploaded != null && observed != null,
+            )
+            if (category.order != original.order) {
+                categoriesQueries.update(null, category.order, null, null, category.id)
+            }
+        }
+        return CategoryRestore(
+            layout.idsByWireOrder,
+            current.associate { it.order to it.id },
+            uploadedById.values.associate { it.order to it.id },
+            layout.categories,
+        )
+    }
+
+    private fun BackupCategory.sameLocalCategory(other: BackupCategory?): Boolean =
+        other != null && name == other.name && order == other.order && flags == other.flags && hidden == other.hidden
