+    private fun unsignedWork(work: BackupManga): ByteArray = ProtoBuf.encodeToByteArray(
+        RootRecords.serializer(),
+        RootRecords(works = listOf(ProtoBuf.encodeToByteArray(BackupManga.serializer(), work))),
