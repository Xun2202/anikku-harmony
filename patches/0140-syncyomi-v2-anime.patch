+
+        fun BackupChapter.content() = copy(version = 0L, lastModifiedAt = 0L)
+
+        fun BackupCategory.content() = copy(uid = 0L, version = 0L, lastModifiedAt = 0L, syncOrder = null)
+
+        fun BackupCategory.identity() = if (uid != 0L) "uid:$uid" else "name:$name"
+
+        fun BackupCategory.wireOrder(): Long = if (uid != 0L) uid else ByteBuffer.wrap(digest(name)).long or Long.MIN_VALUE
+
+        fun List<BackupCategory>.uniqueCategoriesByName(): Map<String, BackupCategory> =
+            groupBy { it.name }.mapNotNull { (name, matches) -> matches.singleOrNull()?.let { name to it } }.toMap()
+
+        fun Backup.rebaseCategoryReferences(categories: List<BackupCategory>): Backup {
+            val byIdentity = categories.associateBy { it.identity() }
+            val byName = categories.uniqueCategoriesByName()
+            val translatedOrders = backupCategories.mapNotNull { category ->
+                val replacement = byIdentity[category.identity()] ?: byName[category.name]
+                replacement?.let { category.order to it.order }
+            }.toMap()
