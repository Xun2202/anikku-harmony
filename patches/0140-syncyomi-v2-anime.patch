+    private fun Database.restoreHistory(id: Long, entry: BackupManga) {
+        entry.history.forEach { history ->
+            val episode = episodesQueries.getEpisodeByUrlAndAnimeId(history.url, id).executeAsList().firstOrNull()
+                ?: return@forEach
+            historyQueries.upsertFromSync(episode._id, Date(history.lastRead), history.readDuration)
+        }
+    }
+
+    private fun Database.restoreReferences(id: Long, entry: BackupManga) {
+        if (entry.mergedMangaReferences.isEmpty()) return
+        val existing = mergedQueries.selectByMergeId(id).executeAsList().associateBy { it.anime_source to it.anime_url }
+        entry.mergedMangaReferences.forEach { reference ->
+            val current = existing[reference.mangaSourceId to reference.mangaUrl]
+            if (current == null) {
+                val anime = animesQueries.getAnimeByUrlAndSource(reference.mangaUrl, reference.mangaSourceId)
+                    .executeAsOneOrNull()
+                mergedQueries.insert(
+                    reference.isInfoManga, reference.getChapterUpdates, reference.chapterSortMode.toLong(),
+                    reference.chapterPriority.toLong(), reference.downloadChapters, id, reference.mergeUrl,
+                    anime?._id, reference.mangaUrl, reference.mangaSourceId,
+                )
+            } else {
+                mergedQueries.updateSettingsById(
+                    reference.getChapterUpdates,
+                    reference.downloadChapters,
+                    reference.isInfoManga,
+                    reference.chapterPriority.toLong(),
+                    reference.chapterSortMode.toLong(),
+                    current._id,
+                )
+            }
+        }
+    }
+
+    private fun BackupManga.customInfo(id: Long): CustomMangaInfo? =
+        if (customTitle == null && customAuthor == null && customArtist == null && customThumbnailUrl == null &&
+            customDescription == null && customGenre == null && customStatus == 0
+        ) {
+            null
+        } else {
+            CustomMangaInfo(
+                id,
+                customTitle,
+                customAuthor,
+                customArtist,
+                customThumbnailUrl,
+                customDescription,
+                customGenre,
+                customStatus.takeIf { it != 0 }?.toLong(),
+            )
+        }
+
+    private fun Database.restoreExcludedScanlators(id: Long, remote: List<String>) {
+        val current = excluded_scanlatorsQueries.getExcludedScanlatorsByAnimeId(id).executeAsList().toSet()
+        val incoming = remote.toSet()
+        val removed = current - incoming
+        if (removed.isNotEmpty()) excluded_scanlatorsQueries.remove(id, removed)
+        (incoming - current).forEach { excluded_scanlatorsQueries.insert(id, it) }
+    }
