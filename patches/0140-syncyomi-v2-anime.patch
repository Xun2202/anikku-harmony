+    private fun Database.restoreTracking(
+        id: Long,
+        entry: BackupManga,
+        current: BackupManga?,
+        sent: BackupManga?,
+        prior: BackupManga?,
+    ) {
+        val currentTracks = current?.tracking.orEmpty().associateBy { it.syncId }
+        val uploadedTracks = sent?.tracking.orEmpty().associateBy { it.syncId }
+        val local = anime_syncQueries.getTracksByAnimeId(id).executeAsList().associateBy { it.sync_id }
+        val remoteIds = entry.tracking.map { it.syncId }.toSet()
+        prior?.tracking.orEmpty().forEach { track ->
+            if (track.syncId !in remoteIds && currentTracks[track.syncId] == track && uploadedTracks[track.syncId] == track) {
+                anime_syncQueries.delete(id, track.syncId.toLong())
+            }
+        }
+        entry.tracking.forEach { incoming ->
+            verifyUnchanged(currentTracks[incoming.syncId], uploadedTracks[incoming.syncId], incoming, "tracking", sent != null)
+            val track = incoming.getTrackImpl()
+            val existing = local[track.trackerId]
+            if (existing == null) {
+                anime_syncQueries.insert(
+                    id, track.trackerId, track.remoteId, track.libraryId, track.title, track.lastChapterRead,
+                    track.totalChapters, track.status, track.score, track.remoteUrl, track.startDate,
+                    track.finishDate, track.private,
+                )
+            } else if (currentTracks[incoming.syncId] != incoming) {
+                anime_syncQueries.update(
+                    id, track.trackerId, track.remoteId, track.libraryId, track.title, track.lastChapterRead,
+                    track.totalChapters, track.status, track.score, track.remoteUrl, track.startDate,
+                    track.finishDate, track.private, existing._id,
+                )
+            }
+        }
+    }
