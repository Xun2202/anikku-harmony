+        // Backup IDs are device-local. Resolve season parents through wire records and then through (source, URL).
+        val parentKeys = remote.backupManga.filter { it.id != null }
+            .groupBy { it.source to it.id }
+            .mapNotNull { (id, entries) -> entries.singleOrNull()?.let { id to (it.source to it.url) } }
