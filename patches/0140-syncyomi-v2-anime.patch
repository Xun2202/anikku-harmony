+            return State(
+                cursor = cursor,
+                fullRequested = fullRequested,
+                lastFullAt = lastFullAt,
+                optionsMask = optionsMask,
+                snapshot = settings.copy(backupManga = mergedWorks, backupCategories = categories),
+            )
+        }
+    }
+
+    private data class PlannedWork(val acknowledged: BackupManga, val upload: BackupManga?)
+
+    private fun categoryUid(category: BackupCategory): Long {
+        val value = ByteBuffer.wrap(digest(deviceId, category.id.toString(), category.name)).long and Long.MAX_VALUE
+        return value.takeUnless { it == 0L } ?: 1L
+    }
