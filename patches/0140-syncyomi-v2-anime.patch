+        const val LIBRARY = 1
+        const val CATEGORIES = 1 shl 1
+        const val EPISODES = 1 shl 2
+        const val TRACKING = 1 shl 3
+        const val HISTORY = 1 shl 4
+        const val APP_SETTINGS = 1 shl 5
+        const val EXTENSION_REPOS = 1 shl 6
+        const val SOURCE_SETTINGS = 1 shl 7
+        const val PRIVATE_SETTINGS = 1 shl 8
+        const val CUSTOM_INFO = 1 shl 9
+        const val SEEN_ENTRIES = 1 shl 10
+        const val SAVED_SEARCHES = 1 shl 11
+        const val SEASONS = 1 shl 12
+
+        fun SyncSettings.mask(): Int {
+            val enabled = listOf(
+                LIBRARY to libraryEntries,
+                CATEGORIES to categories,
+                EPISODES to episodes,
+                TRACKING to tracking,
+                HISTORY to history,
+                APP_SETTINGS to appSettings,
+                EXTENSION_REPOS to extensionRepoSettings,
+                SOURCE_SETTINGS to sourceSettings,
+                PRIVATE_SETTINGS to privateSettings,
+                CUSTOM_INFO to customInfo,
+                SEEN_ENTRIES to seenEntries,
+                SAVED_SEARCHES to savedSearchesFeeds,
+                SEASONS to seasons,
+            )
+            return enabled.fold(0) { mask, (flag, set) -> if (set) mask or flag else mask }
+        }
