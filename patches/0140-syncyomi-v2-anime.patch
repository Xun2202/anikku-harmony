+        fun Backup.select(options: SyncSettings) = copy(
+            backupManga = backupManga.filter { options.libraryEntries },
+            backupCategories = backupCategories.filter { options.categories },
+            backupSources = backupSources.filter { options.libraryEntries }.sortedBy { it.sourceId },
+            backupPreferences = backupPreferences.filter { options.appSettings && !it.key.startsWith("connection_sync_") }
