+    }
+
+    class Plan internal constructor(
+        val local: Backup,
+        val upload: Backup,
+        val full: Boolean,
+        val includeOpaqueSettings: Boolean,
+        val deletedEpisodes: Set<String>,
+        val deletedCategoryUids: Set<Long>,
+        private val acknowledged: Backup,
+        private val optionsMask: Int,
+        private val options: SyncSettings,
+        private val joiningExisting: Boolean,
+        private val lastFullAt: Long,
+    ) {
+        /**
+         * Record the preflight snapshot and what was actually restored, without absorbing
+         * local edits made after the snapshot. Received revisions still provide the floor for
+         * sending those edits on the next run.
+         */
+        fun acknowledge(
+            cursor: Long,
+            fullRequested: Boolean,
+            remote: Backup? = null,
+            applied: Backup? = null,
+            appliedCategories: List<BackupCategory>? = null,
+        ): State {
+            val remoteWorks = remote?.backupManga.orEmpty().associateBy { it.key() }
+            val appliedWorks = applied?.backupManga.orEmpty().associateBy { it.key() }
+            val categories = when {
+                remote != null && !options.categories -> remote.backupCategories.map { it.copy(id = 0L) }
+                else -> mergeAcknowledgedCategories(acknowledged.backupCategories, remote, appliedCategories)
+            }
+            val baseSnapshot = if (remote != null && !options.categories) {
+                acknowledged.rebaseCategoryReferences(categories)
+            } else {
