diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiTransportTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiTransportTest.kt
new file mode 100644
index 000000000..1fcfde262
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiTransportTest.kt
@@ -0,0 +1,90 @@
+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.data.backup.models.BackupManga
+import eu.kanade.tachiyomi.data.backup.models.BackupPreference
+import eu.kanade.tachiyomi.data.backup.models.BackupSourcePreferences
+import eu.kanade.tachiyomi.data.backup.models.StringPreferenceValue
+import eu.kanade.tachiyomi.data.sync.service.SyncYomiFailure
+import eu.kanade.tachiyomi.data.sync.service.SyncYomiProblem
+import eu.kanade.tachiyomi.data.sync.service.SyncYomiTransport
+import eu.kanade.tachiyomi.data.sync.service.withoutSyncConnectionPreferences
+import kotlinx.coroutines.runBlocking
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import okio.Buffer
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.util.zip.GZIPInputStream
+
+class SyncYomiTransportTest {
+
+    @Test
+    fun authenticatesAndStreamsUnderTheConfiguredBasePath() = runBlocking {
+        val fixture = Backup(backupManga = listOf(BackupManga(8, "/anime", title = "Test")))
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setBody("""{"version":2}"""))
+            server.enqueue(
+                MockResponse().setHeader("X-Sync-Cursor", "15").setHeader("X-Sync-Changed", "true")
+                    .setBody(Buffer().write(SyncYomiAnimeWire.encode(fixture))),
+            )
+            val transport = SyncYomiTransport(server.url("/prefix").toString(), "test-only", "phone")
+            assertTrue(transport.supportsV2())
+            val merged = transport.merge(fixture, 0, full = true, opaqueSettings = true, deletedCategoryUids = emptySet())
+            assertEquals(15L, merged.cursor)
+            assertEquals("/anime", merged.backup?.backupManga?.single()?.url)
+            val probe = server.takeRequest()
+            assertEquals("/prefix/api/sync/v2/capabilities", probe.path)
+            assertEquals("test-only", probe.getHeader("X-API-Token"))
+            val upload = server.takeRequest()
+            assertEquals("/prefix/api/sync/v2/merge", upload.path)
+            assertEquals("phone", upload.getHeader("X-Device-ID"))
+            assertEquals("gzip", upload.getHeader("Content-Encoding"))
+            val decoded = GZIPInputStream(upload.body.inputStream()).use { SyncYomiAnimeWire.decode(it.readBytes()) }
+            assertEquals(fixture.backupManga, decoded.backupManga)
+        }
+    }
+
+    @Test
+    fun onlyAnAuthenticatedNotFoundResponseCanSelectTheLegacyProtocol() = runBlocking {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setResponseCode(404))
+            val transport = SyncYomiTransport(server.url("/").toString(), "test-only", "phone")
+            assertFalse(transport.supportsV2())
+            for (code in listOf(200, 302, 401, 500)) {
+                server.enqueue(MockResponse().setResponseCode(code).setHeader("Location", "/other").setBody("invalid"))
+                val error = assertThrows(SyncYomiFailure::class.java) { runBlocking { transport.supportsV2() } }
+                assertEquals(if (code == 200) SyncYomiProblem.RESPONSE else SyncYomiProblem.HTTP, error.problem)
+            }
+            assertEquals(5, server.requestCount)
+        }
+    }
+
+    @Test
+    fun keepsSourceSessionsAndConnectionKeysOnTheDevice() {
+        val settings = listOf("nas_session", "accessToken", "api_key", "resolution").map {
+            BackupPreference(it, StringPreferenceValue("sample"))
+        }
+        val filtered = Backup(
+            backupPreferences = listOf(BackupPreference("connection_sync_client_api_key", StringPreferenceValue("sample"))),
+            backupSourcePreferences = listOf(BackupSourcePreferences("source_1", settings)),
+        ).withoutSyncConnectionPreferences()
+        assertTrue(filtered.backupPreferences.isEmpty())
+        assertEquals(listOf("resolution"), filtered.backupSourcePreferences.single().prefs.map { it.key })
+    }
+
+    @Test
+    fun failedLegacyUploadDoesNotReportSuccess() {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setResponseCode(412))
+            val transport = SyncYomiTransport(server.url("/").toString(), "test-only", "phone")
+            val error = assertThrows(SyncYomiFailure::class.java) {
+                runBlocking { transport.putLegacy(byteArrayOf(1), "previous") }
+            }
+            assertEquals(412, error.status)
+        }
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiV2CheckpointTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiV2CheckpointTest.kt
new file mode 100644
index 000000000..28386bc40
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiV2CheckpointTest.kt
@@ -0,0 +1,256 @@
+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.domain.sync.models.SyncSettings
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.data.backup.models.BackupCategory
+import eu.kanade.tachiyomi.data.backup.models.BackupChapter
+import eu.kanade.tachiyomi.data.backup.models.BackupExtensionRepos
+import eu.kanade.tachiyomi.data.backup.models.BackupHistory
+import eu.kanade.tachiyomi.data.backup.models.BackupManga
+import eu.kanade.tachiyomi.data.backup.models.BackupPreference
+import eu.kanade.tachiyomi.data.backup.models.BackupTracking
+import eu.kanade.tachiyomi.data.backup.models.StringPreferenceValue
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+
+class SyncYomiV2CheckpointTest {
+    @TempDir
+    lateinit var directory: File
+
+    private val options = SyncSettings()
+    private val now = 1_700_000_000_000L
+    private val category = BackupCategory(name = "Watching", id = 10, order = 0)
+    private val first = BackupChapter(url = "/1", name = "First", lastSecondSeen = 45)
+    private val second = BackupChapter(url = "/2", name = "Second", bookmark = true)
+    private val work = BackupManga(
+        source = 42,
+        url = "/show",
+        title = "Show",
+        thumbnailUrl = "/original-cover",
+        categories = listOf(0),
+        episodes = listOf(first, second),
+    )
+
+    @Test
+    fun `checkpoint atomically restores revisions and is isolated by host and key`() {
+        val checkpoint = checkpoint()
+        val input = backup(work).copy(
+            backupPreferences = listOf(
+                BackupPreference("theme", StringPreferenceValue("dim")),
+                BackupPreference("connection_sync_client_api_key", StringPreferenceValue("api-secret-test")),
+            ),
+        )
+        val plan = checkpoint.plan(input, null, options, now)
+        assertEquals(listOf("theme"), plan.upload.backupPreferences.map { it.key })
+        val firstState = plan.acknowledge(8, true)
+        checkpoint.save(firstState)
+        assertEquals(firstState, checkpoint.load())
+        assertEquals(firstState, checkpoint().load())
+        assertNull(checkpoint(host = "https://other.example").load())
+        assertNull(checkpoint(key = "other-api-secret-test").load())
+        val saved = directory.listFiles()!!.single()
+        assertFalse(saved.name.contains("api-secret-test"))
+
+        // A staging file left by an interrupted write does not replace the committed cursor.
+        File(directory, "${saved.name}.new").writeText("interrupted")
+        assertEquals(firstState, checkpoint.load())
+        checkpoint.save(firstState.copy(cursor = 9, fullRequested = false))
+        assertEquals(9L, checkpoint.load()?.cursor)
+        assertEquals(listOf(saved.name), directory.list()!!.toList())
+    }
+
+    @Test
+    fun `delta includes only changed work episodes and history and stamps metadata versions`() {
+        val checkpoint = checkpoint()
+        val before = checkpoint.plan(backup(work), null, options, now).acknowledge(1, false)
+        val initialVersion = before.snapshot.backupManga.single().version
+        val unchanged = checkpoint.plan(backup(work), before, options, now + 1000)
+        assertTrue(unchanged.upload.backupManga.isEmpty())
+        assertFalse(unchanged.full)
+        assertFalse(unchanged.includeOpaqueSettings)
+        assertEquals(1, unchanged.upload.backupCategories.size)
+
+        val newHistory = BackupHistory(first.url, now + 500, 45)
+        val changed = work.copy(
+            thumbnailUrl = "/updated-cover",
+            genre = listOf("Drama"),
+            episodes = listOf(first.copy(lastSecondSeen = 75), second),
+            history = listOf(newHistory),
+        )
+        val delta = checkpoint.plan(backup(changed), before, options, now + 1000)
+        val uploaded = delta.upload.backupManga.single()
+        assertEquals(initialVersion + 1, uploaded.version)
+        assertEquals("/updated-cover", uploaded.thumbnailUrl)
+        assertEquals(listOf("Drama"), uploaded.genre)
+        assertEquals(listOf(first.url), uploaded.episodes.map { it.url })
+        assertEquals(75L, uploaded.episodes.single().lastSecondSeen)
+        assertEquals(listOf(newHistory), uploaded.history)
+    }
+
+    @Test
+    fun `category rename preserves UID and scoped deletions use exact server keys`() {
+        val checkpoint = checkpoint()
+        val before = checkpoint.plan(backup(work), null, options, now).acknowledge(1, false)
+        val previousCategory = before.snapshot.backupCategories.single()
+        assertTrue(previousCategory.uid > 0)
+
+        val renamed = backup(work.copy(episodes = listOf(first))).copy(
+            backupCategories = listOf(category.copy(name = "Watching later")),
+        )
+        val delta = checkpoint.plan(renamed, before, options, now + 1000)
+        val uploadedCategory = delta.upload.backupCategories.single()
+        assertEquals(previousCategory.uid, uploadedCategory.uid)
+        assertEquals(previousCategory.version + 1, uploadedCategory.version)
+        assertEquals(setOf("42|/show\u001f/2"), delta.deletedEpisodes)
+        assertTrue(delta.deletedCategoryUids.isEmpty())
+
+        val absent = checkpoint.plan(Backup(), before, options, now + 1000)
+        assertTrue(absent.deletedEpisodes.isEmpty())
+        assertEquals(setOf(previousCategory.uid), absent.deletedCategoryUids)
+    }
+
+    @Test
+    fun `disabled sections never produce deletions or erase previously known opaque settings`() {
+        val checkpoint = checkpoint()
+        val repo = BackupExtensionRepos("https://extensions.example", "Example", null, "https://example", "test")
+        val original = backup(work).copy(backupExtensionRepo = listOf(repo))
+        val before = checkpoint.plan(original, null, options, now).acknowledge(1, false)
+        val disabled = options.copy(episodes = false, categories = false, extensionRepoSettings = false)
+        val changed = Backup(backupManga = listOf(work.copy(episodes = emptyList(), categories = emptyList())))
+        val plan = checkpoint.plan(changed, before, disabled, now + 1000)
+        assertTrue(plan.full)
+        assertTrue(plan.includeOpaqueSettings)
+        assertEquals(listOf(repo.baseUrl), plan.upload.backupExtensionRepo.map { it.baseUrl })
+        assertTrue(plan.upload.backupManga.single().episodes.isEmpty())
+        assertTrue(plan.deletedEpisodes.isEmpty())
+        assertTrue(plan.deletedCategoryUids.isEmpty())
+
+        val resumed = checkpoint.plan(changed, plan.acknowledge(2, false), options, now + 2000)
+        assertTrue(resumed.full)
+        assertTrue(resumed.deletedEpisodes.isEmpty())
+        assertTrue(resumed.deletedCategoryUids.isEmpty())
+    }
+
+    @Test
+    fun `remote revisions do not acknowledge a concurrent edit in another episode`() {
+        val checkpoint = checkpoint()
+        val initial = checkpoint.plan(backup(work), null, options, now).acknowledge(1, false)
+        val plan = checkpoint.plan(backup(work), initial, options, now + 1000)
+        val remoteFirst = first.copy(lastSecondSeen = 92, version = 7)
+        val remoteWork = work.copy(episodes = listOf(remoteFirst, second.copy(version = 3)), version = 8)
+        val actualSecond = second.copy(lastSecondSeen = 110)
+        val actualWork = remoteWork.copy(episodes = listOf(remoteFirst, actualSecond))
+        val after = plan.acknowledge(2, false, remote = backup(remoteWork), applied = backup(actualWork))
+        val next = checkpoint.plan(backup(actualWork), after, options, now + 2000)
+        val sent = next.upload.backupManga.single().episodes.single()
+        assertEquals(actualSecond.url, sent.url)
+        assertEquals(110L, sent.lastSecondSeen)
+        assertEquals(4L, sent.version)
+    }
+
+    @Test
+    fun `joining a shared key does not replace its settings group`() {
+        val checkpoint = checkpoint()
+        val prefs = listOf(BackupPreference("theme", StringPreferenceValue("dim")))
+        val plan = checkpoint.plan(backup(work).copy(backupPreferences = prefs), null, options, now, joiningExisting = true)
+        assertTrue(plan.full)
+        assertFalse(plan.includeOpaqueSettings)
+        assertTrue(plan.upload.backupPreferences.isEmpty())
+    }
+
+    @Test
+    fun `first write preserves disabled embedded fields using actual remote category order`() {
+        val checkpoint = checkpoint()
+        val partial = options.copy(categories = false, customInfo = false, tracking = false, seasons = false)
+        val remoteCategory = category.copy(id = 91, uid = 5022, order = 5022, syncOrder = 4, version = 5)
+        val tracked = BackupTracking(syncId = 9, libraryId = 16)
+        val serverWork = work.copy(
+            version = 8,
+            categories = listOf(remoteCategory.order),
+            tracking = listOf(tracked),
+            customTitle = "Server title",
+            parentSource = 42,
+            parentUrl = "/parent",
+            seasonFlags = 7,
+            seasonNumber = 2.0,
+        )
+        val local = work.copy(version = 9, thumbnailUrl = "/locally-edited", categories = emptyList(), episodes = listOf(first))
+        val existing = Backup(backupManga = listOf(serverWork), backupCategories = listOf(remoteCategory))
+        val plan = checkpoint.plan(Backup(backupManga = listOf(local)), null, partial, now, true, existing)
+        val uploaded = plan.upload.backupManga.single()
+        assertEquals(9L, uploaded.version)
+        assertEquals("/locally-edited", uploaded.thumbnailUrl)
+        assertEquals(listOf(remoteCategory.order), uploaded.categories)
+        assertEquals(listOf(tracked), uploaded.tracking)
+        assertEquals("Server title", uploaded.customTitle)
+        assertEquals("/parent", uploaded.parentUrl)
+        assertEquals(7L, uploaded.seasonFlags)
+        assertEquals(2.0, uploaded.seasonNumber)
+        assertEquals(remoteCategory.order, plan.upload.backupCategories.single().order)
+        assertTrue(plan.deletedEpisodes.isEmpty())
+        assertTrue(plan.deletedCategoryUids.isEmpty())
+
+        val newCategory = remoteCategory.copy(uid = 7334, order = 7334, name = "Moved elsewhere")
+        val serverChange = existing.copy(
+            backupManga = listOf(uploaded.copy(categories = listOf(newCategory.order))),
+            backupCategories = listOf(newCategory),
+        )
+        val state = plan.acknowledge(3, false, remote = serverChange, applied = backup(local))
+        val next = checkpoint.plan(Backup(backupManga = listOf(local.copy(notes = "Another local edit"))), state, partial, now + 1000)
+        assertEquals(listOf(newCategory.order), next.upload.backupManga.single().categories)
+    }
+
+    @Test
+    fun `first join keeps a same-version work while sending independently newer episodes`() {
+        val checkpoint = checkpoint()
+        val remoteCategory = category.copy(id = 91, uid = 5022, order = 5022, syncOrder = 4, version = 5)
+        val remote = Backup(
+            backupManga = listOf(
+                work.copy(
+                    notes = "Server notes",
+                    version = 8,
+                    categories = listOf(remoteCategory.order),
+                    episodes = listOf(first.copy(version = 5), second.copy(version = 2)),
+                ),
+            ),
+            backupCategories = listOf(remoteCategory),
+        )
+        val local = work.copy(version = 8, episodes = listOf(first.copy(version = 5), second.copy(version = 3)))
+        val plan = checkpoint.plan(backup(local), null, options, now, true, remote)
+        val uploaded = plan.upload.backupManga.single()
+        assertEquals(7L, uploaded.version)
+        assertEquals(listOf(4L, 3L), uploaded.episodes.map { it.version })
+        assertEquals(remoteCategory.uid, plan.upload.backupCategories.single().uid)
+        assertEquals(listOf(remoteCategory.order), uploaded.categories)
+        assertEquals(listOf(category.order), plan.local.backupManga.single().categories)
+        assertTrue(plan.deletedEpisodes.isEmpty())
+        assertTrue(plan.deletedCategoryUids.isEmpty())
+    }
+
+    @Test
+    fun `devices can publish different categories with the same local order`() {
+        val local = checkpoint().plan(backup(work), null, options, now)
+        val other = SyncYomiV2Checkpoint(directory, "https://sync.example", "api-secret-test", "other-device")
+            .plan(backup(work).copy(backupCategories = listOf(category.copy(name = "Later"))), null, options, now)
+        val localCategory = local.upload.backupCategories.single()
+        val otherCategory = other.upload.backupCategories.single()
+        assertTrue(localCategory.order != otherCategory.order)
+        assertEquals(category.order, localCategory.syncOrder)
+        assertEquals(category.order, otherCategory.syncOrder)
+        assertEquals(listOf(localCategory.order), local.upload.backupManga.single().categories)
+        assertEquals(listOf(otherCategory.order), other.upload.backupManga.single().categories)
+        assertEquals(listOf(category.order), local.local.backupManga.single().categories)
+        assertEquals(category.order, local.acknowledge(1, false).snapshot.backupCategories.single().order)
+    }
+
+    private fun checkpoint(host: String = "https://sync.example", key: String = "api-secret-test") =
+        SyncYomiV2Checkpoint(directory, host, key, "local-device")
+
+    private fun backup(vararg manga: BackupManga) =
+        Backup(backupManga = manga.toList(), backupCategories = listOf(category))
+}
