+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.BackupDetector
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.data.backup.models.BackupManga
+import eu.kanade.tachiyomi.data.backup.models.LegacyBackup
+import kotlinx.serialization.SerializationException
+import kotlinx.serialization.protobuf.ProtoBuf
+import okio.Buffer
+import okio.BufferedSink
+
+internal object SyncYomiAnimeWire {
+    private const val CANONICAL_WORK = 1
+    private const val OLD_ANIYOMI_WORK = 3
+    private const val NATIVE_ANIME_MARKER = 500
+    // SyncYomi preserves this unknown field in the root and individual work payloads.
+    private const val V2_ANIME_MARKER = 511
+    private const val V2_ANIME_SIGNATURE = 0x414e4b32L // ANK2
+    private const val VARINT = 0
+    private const val LENGTH_DELIMITED = 2
+
+    private val nativeToCanonical = mapOf(501 to CANONICAL_WORK, 502 to 2, 503 to 101)
+    private val canonicalToNative = nativeToCanonical.entries.associate { (native, canonical) -> canonical to native }
+    private val opaqueSettings = setOf(504, 505, 506, 610)
+    private val videoSignature = Buffer().apply { writeVarintField(V2_ANIME_MARKER, V2_ANIME_SIGNATURE) }.readByteString()
+
+    enum class SnapshotKind { EMPTY, NATIVE_ANIME, V2_ANIME, OTHER }
+
+    fun classifySnapshot(bytes: ByteArray): SnapshotKind {
+        if (bytes.isEmpty()) return SnapshotKind.EMPTY
+        var nativeMarker = false
+        var v2Marker = false
+        var hasCanonicalMedia = false
+        var hasOldAniyomiWork = false
+        for (field in Fields(bytes)) {
+            when {
+                field.number == NATIVE_ANIME_MARKER -> nativeMarker = field.varint == 0L
+                field.number == V2_ANIME_MARKER -> v2Marker = field.varint == V2_ANIME_SIGNATURE
+                field.type == LENGTH_DELIMITED -> when (field.number) {
+                    in canonicalToNative -> hasCanonicalMedia = true
+                    OLD_ANIYOMI_WORK -> hasOldAniyomiWork = true
+                }
+            }
+        }
+        return when {
+            nativeMarker && v2Marker && hasOnlyVideoWorks(bytes) -> SnapshotKind.V2_ANIME
+            // A v1 anime blob can coexist with a canonical manga library on the same
+            // key. Only our explicit v2 signature establishes ownership of canonical media.
+            hasCanonicalMedia || v2Marker -> SnapshotKind.OTHER
+            nativeMarker || hasOldAniyomiWork -> SnapshotKind.NATIVE_ANIME
+            else -> SnapshotKind.OTHER
+        }
+    }
+
+    fun hasOnlyVideoWorks(bytes: ByteArray): Boolean = Fields(bytes).asSequence().all { field ->
+        when (field.number) {
+            CANONICAL_WORK -> field.hasVideoSignature()
+            OLD_ANIYOMI_WORK, in nativeToCanonical -> false
+            else -> true
+        }
+    }
+
+    fun encode(backup: Backup): ByteArray = Buffer().apply {
+        writeTo(backup, this, full = true)
+    }.readByteArray()
+
+    // The server stores unknown root fields together as a single settings item. A delta without
+    // that complete settings group leaves the stored group intact.
+    fun encodeDelta(backup: Backup, includeOpaqueSettings: Boolean = false): ByteArray = Buffer().apply {
+        writeTo(backup, this, full = false, includeOpaqueSettings = includeOpaqueSettings)
+    }.readByteArray()
+
+    fun writeTo(backup: Backup, sink: BufferedSink, full: Boolean, includeOpaqueSettings: Boolean = full) {
+        validateCategoryOrders(backup)
+        for (work in backup.backupManga) {
+            val encoded = ProtoBuf.encodeToByteArray(BackupManga.serializer(), work)
+            sink.writeMessageHeader(CANONICAL_WORK, encoded.size.toLong() + videoSignature.size)
+            sink.write(encoded)
+            sink.write(videoSignature)
+        }
+        val native = ProtoBuf.encodeToByteArray(Backup.serializer(), backup.copy(backupManga = emptyList()))
+        for (field in Fields(native)) {
+            when (field.number) {
+                NATIVE_ANIME_MARKER -> Unit
+                in opaqueSettings -> if (includeOpaqueSettings) field.writeTo(sink)
+                else -> field.writeTo(sink, nativeToCanonical[field.number] ?: field.number)
+            }
+        }
+        if (includeOpaqueSettings) {
+            sink.writeVarintField(NATIVE_ANIME_MARKER, 0)
+            sink.write(videoSignature)
+        }
+    }
+
+    fun decodeLegacySnapshot(bytes: ByteArray): Backup {
+        if (classifySnapshot(bytes) != SnapshotKind.NATIVE_ANIME) {
+            throw SerializationException("Expected a native Anikku snapshot")
+        }
+        val backup = if (BackupDetector.isLegacyBackup(bytes)) {
+            ProtoBuf.decodeFromByteArray(LegacyBackup.serializer(), bytes).toBackup()
+        } else {
+            ProtoBuf.decodeFromByteArray(Backup.serializer(), bytes)
+        }
+        return backup.also(::validateCategoryOrders)
+    }
+
+    fun decode(bytes: ByteArray): Backup {
+        val output = Buffer()
+        output.writeVarintField(NATIVE_ANIME_MARKER, 0)
+        for (field in Fields(bytes)) {
+            val schema = canonicalSchema.children[field.number]
+            when {
+                schema != null -> field.writeMessage(output, canonicalToNative[field.number] ?: field.number, schema)
+                field.number in opaqueSettings -> field.writeTo(output)
+            }
+        }
+        // Stale native 501–503 can still be present after an upgrade. The server's canonical
+        // response is authoritative even if this delta includes zero works.
+        return ProtoBuf.decodeFromByteArray(Backup.serializer(), output.readByteArray()).also(::validateCategoryOrders)
+    }
+
+    private fun validateCategoryOrders(backup: Backup) {
+        val categoryOrders = mutableSetOf<Long>()
+        val duplicateOrders = backup.backupCategories.mapNotNull { category ->
+            category.order.takeUnless { categoryOrders.add(it) }
+        }.toSet()
+        if (duplicateOrders.isNotEmpty() && backup.backupManga.any { work -> work.categories.any { it in duplicateOrders } }) {
+            throw SerializationException("Ambiguous SyncYomi category orders")
+        }
+    }
+
+    // Go omits zero-valued proto3 scalars. Kotlin backup models require some of those fields to
+    // be present, so supply their wire defaults before passing the message to the native model.
+    private class Schema(
+        val varints: Set<Int> = emptySet(),
+        val strings: Set<Int> = emptySet(),
+        val children: Map<Int, Schema> = emptyMap(),
+    )
+
+    private val preference = Schema(strings = setOf(1))
+    private val canonicalSchema = Schema(
+        children = mapOf(
+            CANONICAL_WORK to Schema(
+                varints = setOf(1),
+                strings = setOf(2),
+                children = mapOf(
+                    16 to Schema(strings = setOf(1, 2)), // Episode
+                    18 to Schema(varints = setOf(1, 2)), // Tracking
+                    104 to Schema(varints = setOf(2), strings = setOf(1)), // History
+                    600 to Schema(varints = setOf(1, 2, 3, 4, 5, 8), strings = setOf(6, 7)), // Merged work
+                ),
+            ),
+            2 to Schema(strings = setOf(1)), // Category
+            101 to Schema(varints = setOf(2)), // Source
+            104 to preference,
+            105 to Schema(strings = setOf(1), children = mapOf(2 to preference)),
+            600 to Schema(strings = setOf(1)), // Saved search
+        ),
+    )
+
+    private class Field(
+        private val bytes: ByteArray,
+        val number: Int,
+        val type: Int,
+        val varint: Long?,
+        private val encodedValue: Int,
+        private val payload: Int,
+        private val end: Int,
+    ) {
+        fun hasVideoSignature(): Boolean = type == LENGTH_DELIMITED &&
+            Fields(bytes, payload, end).asSequence().lastOrNull { it.number == V2_ANIME_MARKER }?.varint == V2_ANIME_SIGNATURE
+
+        fun writeTo(output: BufferedSink, target: Int = number) {
+            output.writeVarint((target.toLong() shl 3) or type.toLong())
+            output.write(bytes, encodedValue, end - encodedValue)
+        }
+
+        fun writeMessage(output: BufferedSink, target: Int, schema: Schema) {
+            if (type != LENGTH_DELIMITED) throw SerializationException("Expected a SyncYomi protobuf message")
+            val message = Buffer()
+            val missingVarints = schema.varints.toMutableSet()
+            val missingStrings = schema.strings.toMutableSet()
+            for (field in Fields(bytes, payload, end)) {
+                missingVarints.remove(field.number)
+                missingStrings.remove(field.number)
+                val childSchema = schema.children[field.number]
+                if (childSchema == null) {
+                    field.writeTo(message)
+                } else {
+                    field.writeMessage(message, field.number, childSchema)
+                }
+            }
+            for (number in missingVarints) message.writeVarintField(number, 0)
+            for (number in missingStrings) message.writeMessageHeader(number, 0)
+            output.writeMessageHeader(target, message.size)
+            output.writeAll(message)
+        }
+    }
+
+    private class Fields(
+        private val bytes: ByteArray,
+        private var position: Int = 0,
+        private val end: Int = bytes.size,
+    ) : Iterator<Field> {
+        override fun hasNext(): Boolean = position < end
+
+        override fun next(): Field {
+            val tag = readVarint()
+            if (tag !in 8..0xffffffffL) invalidProtobuf()
+            val number = (tag ushr 3).toInt()
+            val type = (tag and 7).toInt()
+            val encodedValue = position
+            val varint = if (type == VARINT) readVarint() else null
+            val length = when (type) {
+                VARINT -> 0L
+                1 -> 8L
+                LENGTH_DELIMITED -> readVarint()
+                5 -> 4L
+                else -> invalidProtobuf()
+            }
+            if (length !in 0..(end - position).toLong()) invalidProtobuf()
+            val payload = position
+            position += length.toInt()
+            return Field(bytes, number, type, varint, encodedValue, payload, position)
+        }
+
+        private fun readVarint(): Long {
+            var result = 0L
+            for (shift in 0..63 step 7) {
+                if (position >= end) invalidProtobuf()
+                val byte = bytes[position++].toInt() and 0xff
+                if (shift == 63 && byte > 1) invalidProtobuf()
+                result = result or ((byte and 0x7f).toLong() shl shift)
+                if (byte < 0x80) return result
+            }
+            invalidProtobuf()
+        }
+    }
+
+    private fun invalidProtobuf(): Nothing = throw SerializationException("Malformed SyncYomi protobuf")
+
+    private fun BufferedSink.writeMessageHeader(number: Int, length: Long) {
+        writeVarint((number.toLong() shl 3) or LENGTH_DELIMITED.toLong())
+        writeVarint(length)
+    }
+
+    private fun BufferedSink.writeVarintField(number: Int, value: Long) {
+        writeVarint((number.toLong() shl 3) or VARINT.toLong())
+        writeVarint(value)
+    }
+
+    private fun BufferedSink.writeVarint(value: Long) {
+        var remaining = value
+        while (remaining and 0x7fL.inv() != 0L) {
+            writeByte((remaining.toInt() and 0x7f) or 0x80)
+            remaining = remaining ushr 7
+        }
+        writeByte(remaining.toInt())
+    }
+}
