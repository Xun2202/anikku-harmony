+internal enum class SyncYomiProblem { ADDRESS, CLEARTEXT, RESPONSE, HTTP, OTHER_LIBRARY, SERVER_DOWNGRADE, ACCOUNT_CHANGED }
+
+internal class SyncYomiFailure(val problem: SyncYomiProblem, val status: Int = 0) : IOException(problem.name) {
+    val isTransient get() = problem == SyncYomiProblem.HTTP && (status == 408 || status == 429 || status in 500..599)
+
+    fun messageFor(context: Context): String = when (problem) {
+        SyncYomiProblem.ADDRESS -> context.stringResource(AMR.strings.syncyomi_protocol_address)
+        SyncYomiProblem.CLEARTEXT -> context.stringResource(AMR.strings.syncyomi_protocol_https)
+        SyncYomiProblem.OTHER_LIBRARY -> context.stringResource(AMR.strings.syncyomi_protocol_other_library)
+        SyncYomiProblem.SERVER_DOWNGRADE -> context.stringResource(AMR.strings.syncyomi_protocol_downgrade)
+        SyncYomiProblem.ACCOUNT_CHANGED -> context.stringResource(AMR.strings.syncyomi_protocol_account_changed)
+        SyncYomiProblem.RESPONSE -> context.stringResource(AMR.strings.syncyomi_protocol_invalid_reply)
+        SyncYomiProblem.HTTP -> context.stringResource(AMR.strings.syncyomi_protocol_http_error, status)
+    }
+}
+
+internal fun syncYomiAccount(host: String, key: String): String =
+    (host.trim().trimEnd('/').toHttpUrlOrNull().toString() + "\u0000" + key.trim()).encodeUtf8().sha256().hex()
+
+/** Only the configured origin receives the bearer credential. */
+internal class SyncYomiTransport(host: String, private val key: String, private val deviceId: String) {
+    private val base = host.trim().toHttpUrlOrNull()?.takeIf {
+        key.isNotBlank() && it.username.isEmpty() && it.password.isEmpty() && it.query == null && it.fragment == null
+    } ?: throw SyncYomiFailure(SyncYomiProblem.ADDRESS)
+
+    private val client = OkHttpClient.Builder()
+        .followRedirects(false)
+        .followSslRedirects(false)
+        .connectTimeout(30, TimeUnit.SECONDS)
+        .readTimeout(120, TimeUnit.SECONDS)
+        .writeTimeout(120, TimeUnit.SECONDS)
+        .apply {
+            if (!base.isHttps) {
+                // Check the connected address before sending HTTP headers, even with a local DNS alias.
+                proxy(Proxy.NO_PROXY)
+                addNetworkInterceptor { chain ->
+                    val ip = chain.connection()?.socket()?.inetAddress ?: throw SyncYomiFailure(SyncYomiProblem.CLEARTEXT)
+                    val bytes = ip.address
+                    val tailnet = bytes.size == 4 && bytes[0].toInt() == 100 && bytes[1].toInt() and 0xc0 == 0x40
+                    val uniqueLocal = bytes.size == 16 && bytes[0].toInt() and 0xfe == 0xfc
+                    if (!ip.isLoopbackAddress && !ip.isSiteLocalAddress && !ip.isLinkLocalAddress && !tailnet && !uniqueLocal) {
+                        throw SyncYomiFailure(SyncYomiProblem.CLEARTEXT)
+                    }
+                    chain.proceed(chain.request())
+                }
+            }
+        }
+        .build()
+
+    private fun request(path: String): Request.Builder = Request.Builder()
+        .url(base.newBuilder().addPathSegments("api/sync/$path").build())
+        .header("X-API-Token", key.trim())
+        .header("X-Device-ID", deviceId)
+
+    private suspend fun send(builder: Request.Builder): Response = client.newCall(builder.build()).await()
+
+    private fun Response.requireOk() {
+        if (!isSuccessful) throw SyncYomiFailure(SyncYomiProblem.HTTP, code)
+    }
+
+    suspend fun supportsV2(): Boolean = send(request("v2/capabilities")).use { response ->
+        if (response.code == 404) return@use false
+        response.requireOk()
+        val capabilities = runCatching { Json.parseToJsonElement(response.body.string()) }.getOrNull() as? JsonObject
+        if ((capabilities?.get("version") as? JsonPrimitive)?.intOrNull != 2) {
+            throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+        }
+        true
+    }
+
+    suspend fun snapshot(): ByteArray = send(request("v2/snapshot")).use { response ->
+        if (response.code == 404) return@use byteArrayOf()
+        response.requireOk()
+        response.body.bytes()
+    }
+
+    data class Merged(val backup: Backup?, val cursor: Long, val fullRequested: Boolean)
+
+    suspend fun merge(
+        backup: Backup,
+        cursor: Long,
+        full: Boolean,
+        opaqueSettings: Boolean,
+        deletedCategoryUids: Set<Long>,
+    ): Merged {
+        val body = object : RequestBody() {
+            override fun contentType() = BINARY
+            override fun writeTo(sink: BufferedSink) {
+                GzipSink(sink).buffer().use { SyncYomiAnimeWire.writeTo(backup, it, full, opaqueSettings) }
+            }
+        }
+        val req = request("v2/merge")
+            .header("X-Sync-Cursor", cursor.toString())
+            .header("X-Sync-Full", full.toString())
+            .header("Content-Encoding", "gzip")
+            .post(body)
+        if (deletedCategoryUids.isNotEmpty()) req.header("X-Sync-Deleted-Categories", deletedCategoryUids.joinToString(","))
+        return send(req).use { response ->
+            response.requireOk()
+            val nextCursor = response.header("X-Sync-Cursor")?.toLongOrNull()?.takeIf { it >= 0 }
+                ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+            val changed = response.header("X-Sync-Changed")?.toBooleanStrictOrNull()
+                ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+            val fullRequested = response.header("X-Sync-Full-Requested")?.let {
+                it.toBooleanStrictOrNull() ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+            } ?: false
+            if (nextCursor < cursor && !fullRequested) throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+            val remote = if (changed) {
+                val bytes = response.body.bytes()
+                val valid = if (full || cursor == 0L || nextCursor < cursor) {
+                    SyncYomiAnimeWire.classifySnapshot(bytes) == SyncYomiAnimeWire.SnapshotKind.V2_ANIME
+                } else {
+                    SyncYomiAnimeWire.hasOnlyVideoWorks(bytes)
+                }
+                if (!valid) throw SyncYomiFailure(SyncYomiProblem.OTHER_LIBRARY)
+                SyncYomiAnimeWire.decode(bytes)
+            } else {
+                null
+            }
+            Merged(remote, nextCursor, fullRequested)
+        }
+    }
+
+    suspend fun deleteEpisodes(keys: Set<String>) {
+        if (keys.isEmpty()) return
+        val values = JsonArray(keys.map(::JsonPrimitive))
+        val body = JsonObject(mapOf("deletedChapters" to values)).toString().toRequestBody(JSON_TYPE)
+        send(request("v2/deletions").post(body)).use { response ->
+            response.requireOk()
+            val ack = runCatching { Json.parseToJsonElement(response.body.string()) }.getOrNull() as? JsonObject
+            if ((ack?.get("acknowledged") as? JsonPrimitive)?.intOrNull != keys.size) {
+                throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+            }
+        }
+    }
+
+    data class Legacy(val bytes: ByteArray?, val etag: String)
+
+    suspend fun getLegacy(etag: String): Legacy {
+        val req = request("content")
+        if (etag.isNotEmpty()) req.header("If-None-Match", etag)
+        return send(req).use { response ->
+            when (response.code) {
+                304 -> if (etag.isNotEmpty()) Legacy(null, etag) else throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+                404 -> Legacy(null, "")
+                else -> {
+                    response.requireOk()
+                    Legacy(response.body.bytes(), response.etag())
+                }
+            }
+        }
+    }
+
+    suspend fun putLegacy(data: ByteArray, etag: String): String {
+        val req = request("content").put(data.toRequestBody(BINARY))
+        if (etag.isNotEmpty()) req.header("If-Match", etag)
+        return send(req).use { response ->
+            response.requireOk()
+            response.etag()
+        }
+    }
+
+    private fun Response.etag(): String = header("ETag")?.takeIf { it.isNotBlank() }
+        ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+
+    companion object {
+        private val BINARY = "application/octet-stream".toMediaType()
+        private val JSON_TYPE = "application/json; charset=utf-8".toMediaType()
+    }
+}
