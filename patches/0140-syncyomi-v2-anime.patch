+                episodeFlags = entry.episodeFlags.toLong(),
+                dateAdded = entry.dateAdded,
+                updateStrategy = entry.updateStrategy,
+                lastModifiedAt = entry.lastModifiedAt,
+                favoriteModifiedAt = entry.favoriteModifiedAt ?: System.currentTimeMillis() / 1_000,
+                version = entry.version,
+                notes = entry.notes,
+                fetchType = entry.fetchType,
+                seasonFlags = seasonFlags,
