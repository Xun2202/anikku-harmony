+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.BackupCategory
+
+// ANK -->
+internal data class SyncYomiCategoryLayout(
+    val idsByWireOrder: Map<Long, Long>,
+    val categories: List<BackupCategory>,
+)
+
+internal fun arrangeSyncYomiCategories(
+    matched: Collection<Pair<BackupCategory, BackupCategory>>,
+    localOnly: List<BackupCategory>,
+): SyncYomiCategoryLayout {
+    val occupiedOrders = localOnly.mapTo(mutableSetOf()) { it.order }
+    val sorted = matched.map { (wire, local) ->
+        val requested = wire.syncOrder?.takeIf { it in 0..Int.MAX_VALUE.toLong() }
+            ?: wire.order.takeIf { it in 0..Int.MAX_VALUE.toLong() && (wire.uid == 0L || it != wire.uid) }
+            ?: local.order
+        local to requested
+    }.sortedWith(compareBy({ it.second }, { it.first.name }, { it.first.id }))
+
+    var nextOrder = 0L
+    val reordered = sorted.map { (category, requested) ->
+        var order = maxOf(requested, nextOrder)
+        while (order in occupiedOrders) order++
+        nextOrder = order + 1
+        category.copy(order = order, syncOrder = null)
+    }
+    // The decoder rejects ambiguous work assignments. Unassigned wire categories can share a key.
+    val membership = matched.associate { (wire, local) -> wire.order to local.id }
+    return SyncYomiCategoryLayout(membership, (localOnly + reordered).sortedBy { it.order })
+}
