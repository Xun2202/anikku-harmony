+            title = entry.title,
+            status = entry.status.toLong(),
+            thumbnailUrl = entry.thumbnailUrl,
+            favorite = entry.favorite,
+            initialized = entry.initialized,
+            viewerFlags = entry.viewer_flags.toLong(),
+            episodeFlags = entry.episodeFlags.toLong(),
+            dateAdded = entry.dateAdded,
+            updateStrategy = entry.updateStrategy,
+            version = entry.version,
+            notes = entry.notes,
+            fetchType = entry.fetchType,
+            seasonFlags = seasonFlags,
+            seasonNumber = seasonNumber,
+            seasonSourceOrder = seasonSourceOrder,
+            backgroundUrl = entry.backgroundUrl,
+            animeId = existing.id,
+        )
+        return existing.id
+    }
+
+    private fun Database.restoreEpisodes(
+        id: Long,
+        entry: BackupManga,
+        current: BackupManga?,
+        sent: BackupManga?,
+        prior: BackupManga?,
+        includeHistory: Boolean,
+    ) {
+        val episodes = episodesQueries.getEpisodesByAnimeId(
+            id,
+            0,
+            Manga.EPISODE_SHOW_NOT_BOOKMARKED,
+            Manga.EPISODE_SHOW_BOOKMARKED,
+        ).executeAsList().associateBy { it.url }
+        val currentEpisodes = current?.episodes.orEmpty().associateBy { it.url }
+        val sentEpisodes = sent?.episodes.orEmpty().associateBy { it.url }
+        val priorEpisodes = prior?.episodes.orEmpty().associateBy { it.url }
+        val incomingUrls = entry.episodes.map { it.url }.toSet()
+        val protectedHistoryUrls = if (!includeHistory) {
+            val episodesById = episodes.values.associateBy { it._id }
+            historyQueries.getHistoryByAnimeId(id).executeAsList()
+                .mapNotNull { episodesById[it.episode_id]?.url }.toSet()
+        } else {
+            val sentHistory = sent?.history.orEmpty().associateBy { it.url }
+            val priorHistory = prior?.history.orEmpty().associateBy { it.url }
+            current?.history.orEmpty().filter { it != sentHistory[it.url] || it != priorHistory[it.url] }
+                .map { it.url }.toSet()
+        }
+        // Absence is actionable only for an episode we know was on the server and never changed locally since.
+        val deletedIds = episodes.values.filter { episode ->
+            val before = priorEpisodes[episode.url]
+            val currentEpisode = currentEpisodes[episode.url]
+            before != null && currentEpisode != null && episode.url !in incomingUrls &&
+                episode.url !in protectedHistoryUrls && currentEpisode.payload() == before.payload() &&
+                currentEpisode.payload() == sentEpisodes[episode.url]?.payload()
+        }.map { it._id }
+        if (deletedIds.isNotEmpty()) episodesQueries.removeEpisodesWithIds(deletedIds)
+
+        entry.episodes.forEach { chapter ->
+            val local = episodes[chapter.url]
+            val currentChapter = currentEpisodes[chapter.url]
+            val sentChapter = sentEpisodes[chapter.url]
+            verifyUnchanged(currentChapter?.payload(), sentChapter?.payload(), chapter.payload(), "episode", sent != null)
