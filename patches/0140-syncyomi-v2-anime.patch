+    suspend fun apply(
+        backup: Backup,
+        options: SyncSettings,
+        uploaded: Backup? = null,
+        acknowledged: Backup? = null,
+    ): Backup {
+        val remote = backup.withoutSyncConnectionPreferences()
+        val customUpdates = mutableListOf<CustomMangaInfo>()
+        val applied = handler.await(inTransaction = true) {
+            val result = restoreLibrary(remote, options, uploaded, acknowledged, customUpdates)
+            if (options.extensionRepoSettings) {
+                remote.backupExtensionRepo.forEach { extensionRepoRestorer(it, skipExisting = true) }
+            }
