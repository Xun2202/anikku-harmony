+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.BackupCategory
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+
+class SyncYomiCategoryLayoutTest {
+    @Test
+    fun `remote display order reorders categories without changing their membership identities`() {
+        val watching = BackupCategory(name = "Watching", id = 11, order = 0)
+        val finished = BackupCategory(name = "Finished", id = 12, order = 1)
+        val watchingOnWire = watching.copy(id = 30, uid = 101, order = 101, syncOrder = 1)
+        val finishedOnWire = finished.copy(id = 29, uid = 950, order = 950, syncOrder = 0)
+
+        val layout = arrangeSyncYomiCategories(listOf(watchingOnWire to watching, finishedOnWire to finished), emptyList())
+
+        assertEquals(listOf(12L, 11L), layout.categories.map { it.id })
+        assertEquals(listOf(0L, 1L), layout.categories.map { it.order })
+        assertEquals(mapOf(101L to 11L, 950L to 12L), layout.idsByWireOrder)
+        layout.categories.forEach { assertNull(it.syncOrder) }
+    }
+
+    @Test
+    fun `fresh imports preserve remote ordering around concurrently created local categories`() {
+        val first = BackupCategory(name = "First", id = 12, order = 2)
+        val second = BackupCategory(name = "Second", id = 13, order = 3)
+        val local = BackupCategory(name = "Local only", id = 11, order = 1)
+        val firstOnWire = first.copy(id = 29, uid = 950, order = 950, syncOrder = 0)
+        val secondOnWire = second.copy(id = 30, uid = 101, order = 101, syncOrder = 1)
+
+        val layout = arrangeSyncYomiCategories(listOf(secondOnWire to second, firstOnWire to first), listOf(local))
+
+        assertEquals(listOf(12L, 11L, 13L), layout.categories.map { it.id })
+        assertEquals(listOf(0L, 1L, 2L), layout.categories.map { it.order })
+        assertEquals(local, layout.categories[1])
+        assertEquals(mapOf(101L to 13L, 950L to 12L), layout.idsByWireOrder)
+    }
+}
