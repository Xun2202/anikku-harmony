+/** Connection credentials and per-install sync controls must not travel with the library. */
+internal fun Backup.withoutSyncConnectionPreferences(): Backup = copy(
+    backupPreferences = backupPreferences.filterNot {
+        it.key.startsWith("connection_") || it.key.startsWith("sync_") ||
+            Preference.isAppState(it.key) || it.key.isCredentialSetting()
+    },
+    backupSourcePreferences = backupSourcePreferences.mapNotNull { source ->
+        source.copy(prefs = source.prefs.filterNot { it.key.isCredentialSetting() || Preference.isAppState(it.key) })
+            .takeIf { it.prefs.isNotEmpty() }
+    },
+)
+
+private val credentialWordBoundary = Regex("([a-z])([A-Z])")
+private val credentialSeparator = Regex("[^a-z0-9]+")
+private val credentialWords = setOf(
+    "password", "passwd", "passphrase", "secret", "cookie", "cookies", "session", "token", "tokens",
+    "apikey", "authorization", "credential", "credentials",
+)
+
+private fun String.isCredentialSetting(): Boolean {
+    val words = credentialWordBoundary.replace(this, "$1_$2").lowercase().split(credentialSeparator)
+    return words.any { it in credentialWords } || words.zipWithNext().any { (first, second) ->
+        second == "key" && first in setOf("api", "private", "access")
     }
 }
