+                backupCategories = categories,
+                backupManga = backupManga.map { work ->
+                    work.copy(categories = work.categories.mapNotNull(translatedOrders::get))
+                },
+            )
+        }
+
+        fun BackupManga.withPreservedSections(prior: BackupManga?, options: SyncSettings) = copy(
+            categories = if (options.categories) categories else prior?.categories.orEmpty(),
+            tracking = if (options.tracking) tracking else prior?.tracking.orEmpty(),
+            customTitle = if (options.customInfo) customTitle else prior?.customTitle,
+            customArtist = if (options.customInfo) customArtist else prior?.customArtist,
+            customAuthor = if (options.customInfo) customAuthor else prior?.customAuthor,
+            customThumbnailUrl = if (options.customInfo) customThumbnailUrl else prior?.customThumbnailUrl,
+            customDescription = if (options.customInfo) customDescription else prior?.customDescription,
+            customGenre = if (options.customInfo) customGenre else prior?.customGenre,
+            customStatus = if (options.customInfo) customStatus else prior?.customStatus ?: 0,
+            seasonFlags = if (options.seasons) seasonFlags else prior?.seasonFlags ?: 0,
+            seasonNumber = if (options.seasons) seasonNumber else prior?.seasonNumber ?: -1.0,
+            seasonSourceOrder = if (options.seasons) seasonSourceOrder else prior?.seasonSourceOrder ?: 0,
+            fetchType = if (options.seasons || prior == null) fetchType else prior.fetchType,
+            parentId = if (options.seasons || prior == null) parentId else prior.parentId,
+            parentSource = if (options.seasons || prior == null) parentSource else prior.parentSource,
+            parentUrl = if (options.seasons || prior == null) parentUrl else prior.parentUrl,
+            parentSourceUrl = if (options.seasons || prior == null) parentSourceUrl else safeWebpage(prior.parentSourceUrl),
