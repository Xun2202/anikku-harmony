+
+        fun modified(native: Long, prior: Long?, changed: Boolean, nowSeconds: Long): Long = when {
+            prior == null -> native
+            changed -> maxOf(native, prior, nowSeconds)
+            else -> prior
+        }
+
+        fun revision(native: Long, prior: Long?, changed: Boolean): Long = when {
+            prior == null -> native.coerceAtLeast(1L)
+            changed -> maxOf(native, increment(prior))
+            else -> prior
+        }
+
+        fun increment(value: Long): Long = if (value == Long.MAX_VALUE) value else value + 1
+        fun lowerThan(value: Long): Long = if (value == Long.MIN_VALUE) value else value - 1
+
+        fun mergeAcknowledgedCategories(
+            base: List<BackupCategory>,
+            remote: Backup?,
+            applied: List<BackupCategory>?,
+        ): List<BackupCategory> {
+            if (remote == null || applied == null) return base
+            val baseIds = base.mapTo(mutableSetOf()) { it.id }
+            val actualById = applied.associateBy { it.id }
+            val remoteByIdentity = remote.backupCategories.associateBy { it.identity() }
+            val remoteByName = remote.backupCategories.associateBy { it.name }
+
+            fun BackupCategory.remoteMatch(): BackupCategory? = remoteByIdentity[identity()] ?: remoteByName[name]
+
+            val merged = base.mapNotNull { sent ->
+                val actual = actualById[sent.id] ?: return@mapNotNull sent.takeIf { sent.remoteMatch() != null }
+                val incoming = actual.remoteMatch() ?: return@mapNotNull sent
+                val matchesRemote = actual.content() == incoming.content().copy(id = actual.id, order = actual.order)
+                if (matchesRemote) actual else sent
+            } + applied.filter { it.id !in baseIds && it.remoteMatch() != null }
+            return merged.sortedBy { it.order }
+        }
+
+        fun mergeAcknowledgedWork(
+            base: BackupManga?,
+            remote: BackupManga?,
+            applied: BackupManga?,
+            options: SyncSettings,
+        ): BackupManga? {
+            if (remote == null) return base
+            if (base == null && applied == null) return null
+
+            fun BackupManga.restoreMetadata() = workMetadata().withPreservedSections(null, options).copy(
+                parentId = null,
+                sourceUrl = null,
+                parentSourceUrl = null,
+                parentSource = null,
+                parentUrl = null,
+            )
+
+            val appliedMatchesRemote = applied != null && applied.restoreMetadata() == remote.restoreMetadata()
+            val manga = when {
+                applied != null && appliedMatchesRemote -> applied
+                base != null -> base
+                applied != null -> remote.copy(id = applied.id, parentId = applied.parentId, categories = applied.categories)
+                else -> return null
+            }
+            val baseline = base ?: remote
+
+            val baseEpisodes = base?.episodes.orEmpty().associateBy { it.url }
+            val remoteEpisodes = remote.episodes.associateBy { it.url }
+            val actualEpisodes = applied?.episodes.orEmpty().associateBy { it.url }
+            val episodeKeys = baseEpisodes.keys + remoteEpisodes.keys
+            val episodes = if (options.episodes) {
+                episodeKeys.mapNotNull { key ->
+                    val sent = baseEpisodes[key]
+                    val incoming = remoteEpisodes[key]
+                    val actual = actualEpisodes[key]
+                    when {
+                        incoming == null && applied != null && actual == null -> null
+                        incoming == null -> sent
+                        actual != null && incoming.content() == actual.content() ->
+                            actual.copy(version = incoming.version, lastModifiedAt = incoming.lastModifiedAt)
+                        sent != null -> sent.copy(
+                            version = maxOf(sent.version, incoming.version),
+                            lastModifiedAt = maxOf(sent.lastModifiedAt, incoming.lastModifiedAt),
+                        )
+                        else -> null
+                    }
+                }
+            } else {
+                baseline.episodes
+            }
+
+            val history = baseline.history.associateBy { it.url }.toMutableMap()
+            val actualHistory = applied?.history.orEmpty().associateBy { it.url }
+            if (options.history) {
+                remote.history.filter { it == actualHistory[it.url] }.forEach { history[it.url] = it }
+            }
+
+            val preserved = manga.withPreservedSections(remote, options)
+            return preserved.copy(
+                sourceUrl = safeWebpage(manga.sourceUrl, base?.sourceUrl, remote.sourceUrl),
+                parentSourceUrl = if (options.seasons) {
+                    safeWebpage(manga.parentSourceUrl, base?.parentSourceUrl, remote.parentSourceUrl)
+                } else {
+                    preserved.parentSourceUrl
+                },
+                parentSource = if (options.seasons) manga.parentSource ?: base?.parentSource ?: remote.parentSource else preserved.parentSource,
+                parentUrl = if (options.seasons) manga.parentUrl ?: base?.parentUrl ?: remote.parentUrl else preserved.parentUrl,
+                version = maxOf(baseline.version, remote.version),
+                lastModifiedAt = maxOf(baseline.lastModifiedAt, remote.lastModifiedAt),
+                episodes = episodes,
+                history = history.values.toList(),
+            )
+        }
+
+        fun safeWebpage(vararg candidates: String?) = candidates.firstNotNullOfOrNull { it?.let(::safeSyncYomiSourceUrl) }
+
+        fun <T> DataInputStream.readRecord(serializer: KSerializer<T>): T {
+            val size = readInt()
+            check(size in 0..(64 * 1024 * 1024)) { "Invalid SyncYomi checkpoint record" }
+            val bytes = ByteArray(size)
+            readFully(bytes)
+            return ProtoBuf.decodeFromByteArray(serializer, bytes)
+        }
+
+        fun <T> DataOutputStream.writeRecord(serializer: KSerializer<T>, value: T) {
+            val bytes = ProtoBuf.encodeToByteArray(serializer, value)
+            writeInt(bytes.size)
+            write(bytes)
+        }
+
+        fun digest(vararg parts: String): ByteArray {
+            val digest = MessageDigest.getInstance("SHA-256")
+            for (part in parts) {
+                val bytes = part.toByteArray(Charsets.UTF_8)
+                digest.update(ByteBuffer.allocate(Int.SIZE_BYTES).putInt(bytes.size).array())
+                digest.update(bytes)
+            }
+            return digest.digest()
+        }
+    }
+}
