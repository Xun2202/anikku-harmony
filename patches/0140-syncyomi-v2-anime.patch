         private const val TAG_AUTO = "$TAG_JOB:auto"
+        private const val TAG_LIBRARY = "$TAG_JOB:library"
+        private const val TAG_LIBRARY_SECONDARY = "$TAG_LIBRARY:secondary"
+        private const val MAX_LIBRARY_RETRIES = 3
         const val TAG_MANUAL = "$TAG_JOB:manual"
 
+        private val syncMutex = Mutex()
+        private val libraryChanges by lazy {
+            Channel<Unit>(Channel.CONFLATED).also { changes ->
+                CoroutineScope(Dispatchers.IO).launch {
+                    for (change in changes) {
+                        try {
+                            if (libraryTriggerEnabled()) enqueueAfterLibraryChange(Injekt.get<Application>())
+                        } catch (e: CancellationException) {
+                            throw e
+                        } catch (e: Exception) {
+                            logcat(LogPriority.ERROR, e) { "Could not schedule sync after a library change" }
+                        }
+                    }
+                }
+            }
+        }
+
+        fun libraryTriggerEnabled(): Boolean {
+            val preferences = Injekt.get<SyncPreferences>()
+            return preferences.syncService().get() == SyncManager.SyncService.SYNCYOMI.value &&
+                preferences.syncOnLibraryChange().get()
+        }
+
+        fun scheduleAfterLibraryChange() {
+            if (libraryTriggerEnabled()) libraryChanges.trySend(Unit)
+        }
+
+        private fun enqueueAfterLibraryChange(context: Context) {
+            val manager = context.workManager
+            val work = manager.getWorkInfosByTag(TAG_LIBRARY).get()
+            if (work.any { it.state == WorkInfo.State.ENQUEUED || it.state == WorkInfo.State.BLOCKED }) return
+
+            // Give changes during a running sync their own pending request, even if that sync is canceled.
+            val tag = if (work.any { it.state == WorkInfo.State.RUNNING && TAG_LIBRARY_SECONDARY !in it.tags }) {
+                TAG_LIBRARY_SECONDARY
+            } else {
+                TAG_LIBRARY
+            }
+            val request = OneTimeWorkRequestBuilder<SyncDataJob>()
+                .addTag(TAG_JOB)
+                .addTag(TAG_LIBRARY)
+                .addTag(tag)
+                .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build())
+                .setInitialDelay(1, TimeUnit.MINUTES)
+                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, 1, TimeUnit.MINUTES)
+                .build()
+            manager.enqueueUniqueWork(tag, ExistingWorkPolicy.KEEP, request).result.get()
+        }
+
         fun isRunning(context: Context): Boolean {
             return context.workManager.isRunning(TAG_JOB)
         }
