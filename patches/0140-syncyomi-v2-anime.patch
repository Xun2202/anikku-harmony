+@OptIn(ExperimentalSerializationApi::class)
+internal class SyncYomiV2Checkpoint internal constructor(
+    directory: File,
+    host: String,
+    apiKey: String,
+    private val deviceId: String,
+) {
+    constructor(context: Context, host: String, apiKey: String, deviceId: String) :
+        this(File(context.noBackupFilesDir, "syncyomi-v2"), host, apiKey, deviceId)
+
+    private val path = File(directory, digest(host, apiKey).joinToString("") { "%02x".format(Locale.ROOT, it) })
+
+    data class State(
+        val cursor: Long,
+        val fullRequested: Boolean,
+        val lastFullAt: Long,
+        val optionsMask: Int,
+        // Local IDs and values, with the last acknowledged revisions used on the wire.
+        val snapshot: Backup,
+    )
+
+    fun load(): State? {
+        val stream = try {
+            Files.newInputStream(path.toPath())
+        } catch (_: NoSuchFileException) {
+            return null
+        }
+        return stream.use { file ->
+            DataInputStream(GZIPInputStream(file)).use { input ->
+                check(input.readInt() == FORMAT_VERSION) { "Invalid SyncYomi checkpoint format" }
+                val cursor = input.readLong()
+                val fullRequested = input.readBoolean()
+                val lastFullAt = input.readLong()
+                val optionsMask = input.readInt()
+                val header = input.readRecord(Backup.serializer())
+                val mangaCount = input.readInt()
+                check(mangaCount >= 0) { "Invalid SyncYomi checkpoint count" }
+                val manga = ArrayList<BackupManga>()
+                repeat(mangaCount) {
+                    manga += input.readRecord(BackupManga.serializer())
+                }
+                check(input.read() == -1) { "Invalid SyncYomi checkpoint length" }
+                State(cursor, fullRequested, lastFullAt, optionsMask, header.copy(backupManga = manga))
+            }
+        }
+    }
+
+    fun save(state: State) {
+        val directory = checkNotNull(path.parentFile).toPath()
+        Files.createDirectories(directory)
+        val staging = directory.resolve("${path.name}.new")
+        try {
+            DataOutputStream(GZIPOutputStream(Files.newOutputStream(staging))).use { data ->
+                data.writeInt(FORMAT_VERSION)
+                data.writeLong(state.cursor)
+                data.writeBoolean(state.fullRequested)
+                data.writeLong(state.lastFullAt)
+                data.writeInt(state.optionsMask)
+                data.writeRecord(Backup.serializer(), state.snapshot.copy(backupManga = emptyList()))
+                data.writeInt(state.snapshot.backupManga.size)
+                state.snapshot.backupManga.forEach { data.writeRecord(BackupManga.serializer(), it) }
+            }
+            FileChannel.open(staging, StandardOpenOption.WRITE).use { it.force(true) }
+            Files.move(staging, path.toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING)
+        } finally {
+            Files.deleteIfExists(staging)
+        }
+    }
