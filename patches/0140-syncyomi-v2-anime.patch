+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.domain.manga.model.toSManga
+import eu.kanade.tachiyomi.data.backup.models.BackupManga
+import eu.kanade.tachiyomi.source.online.HttpSource
+import eu.kanade.tachiyomi.source.online.getMangaUrl
+import exh.source.MERGED_SOURCE_ID
+import kotlinx.coroutines.CancellationException
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import tachiyomi.data.DatabaseHandler
+import tachiyomi.data.manga.MangaMapper
+import tachiyomi.domain.manga.model.Manga
+import tachiyomi.domain.source.service.SourceManager
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+import java.net.URI
+import java.net.URISyntaxException
+import java.util.Locale
+
+internal suspend fun enrichSyncYomiSourceUrls(
+    backupManga: List<BackupManga>,
+    databaseManga: List<Manga>,
+    sourceManager: SourceManager = Injekt.get(),
+    handler: DatabaseHandler = Injekt.get(),
+) {
+    val worksById = databaseManga.associateBy(Manga::id)
+    val parentLookup = mutableMapOf<Long, Manga?>()
+    val sourceLookup = mutableMapOf<Long, HttpSource?>()
+    val webpageLookup = mutableMapOf<Long, String?>()
+
+    fun webpage(work: Manga): String? {
+        if (webpageLookup.containsKey(work.id)) return webpageLookup[work.id]
+        val sourceId = work.source
+        if (!sourceLookup.containsKey(sourceId)) {
+            sourceLookup[sourceId] = sourceManager.get(sourceId) as? HttpSource
+        }
+        val source = sourceLookup[sourceId]
+        val url = if (source != null && sourceId != MERGED_SOURCE_ID) {
+            try {
+                safeSyncYomiSourceUrl(source.getMangaUrl(work.toSManga()))
+            } catch (e: CancellationException) {
+                throw e
+            } catch (_: Exception) {
+                null
+            } catch (_: LinkageError) {
+                null
+            }
+        } else {
+            null
+        }
+        webpageLookup[work.id] = url
+        return url
+    }
+
+    for (work in backupManga) {
+        val local = worksById[work.id] ?: continue
+        work.sourceUrl = webpage(local)
+
+        val parentId = local.parentId ?: continue
+        if (parentId == local.id) continue
+        val parent = worksById[parentId] ?: run {
+            if (!parentLookup.containsKey(parentId)) {
+                parentLookup[parentId] = handler.awaitOneOrNull {
+                    animesQueries.getAnimeById(parentId, MangaMapper::mapManga)
+                }
+            }
+            parentLookup[parentId]
+        } ?: continue
+
+        work.parentSourceUrl = webpage(parent)
+        if (safeParentPath(parent.url)) {
+            work.parentSource = parent.source
+            work.parentUrl = parent.url
+        }
+    }
+}
+
+internal fun safeSyncYomiSourceUrl(url: String): String? {
+    val uri = parseUri(url) ?: return null
+    if (uri.rawAuthority.isNullOrEmpty() || uri.rawUserInfo != null || uri.rawQuery != null || uri.rawFragment != null) {
+        return null
+    }
+    val httpUrl = url.toHttpUrlOrNull() ?: return null
+    if (httpUrl.username.isNotEmpty() || httpUrl.password.isNotEmpty() || !safeWebpagePath(uri.path)) return null
+    return httpUrl.toString()
+}
+
+private fun safeParentPath(path: String): Boolean {
+    if (path.isBlank()) return false
+    val uri = parseUri(path) ?: return false
+    if (uri.isAbsolute) return safeSyncYomiSourceUrl(path) != null
+    return uri.rawAuthority == null && uri.rawQuery == null && uri.rawFragment == null && safeWebpagePath(uri.path)
+}
+
+private fun parseUri(url: String): URI? {
+    return try {
+        URI(url)
+    } catch (_: URISyntaxException) {
+        null
+    }
+}
+
+private fun safeWebpagePath(path: String?): Boolean {
+    path ?: return false
+    if (path.any { it.isISOControl() || it in "\\;?@#" }) return false
+    val segments = path.lowercase(Locale.ROOT).split('/')
+    return segments.none { segment ->
+        val marker = segment.substringBefore('=').replace('-', '_')
+        marker in sensitiveSegments || segment.substringAfterLast('.', "") in mediaExtensions
+    }
+}
