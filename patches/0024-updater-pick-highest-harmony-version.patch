 // KMK --.
 internal fun List<Release>.getLatest(): Release? {
-    return firstOrNull()
+    // Harmony -->
+    // GitHub does not guarantee the list order (a patch release of an older upstream version can
+    // be listed before a newer one), so order the candidates by their harmony version instead of
+    // taking the first entry. Tags that do not parse sort last.
+    val ordered = sortedWith(
+        compareByDescending<Release> { parseHarmonyVersion(it.version) != null }
+            .thenComparator { a, b ->
+                compareVersions(parseHarmonyVersion(b.version).orEmpty(), parseHarmonyVersion(a.version).orEmpty())
+            },
+    )
+    return ordered.firstOrNull()
+        // Harmony <--
         ?.copy(
-            info = joinToString("\r-----\r") {
+            info = ordered.joinToString("\r-----\r") {
                 "## ${it.version}\r\r" +
                     it.info
             },
         )
 }
 // KMK <--
+
+// Harmony -->
+private val HARMONY_VERSION_REGEX = Regex("""(\d+)\.(\d+)\.(\d+)-harmony(?:-preview)?\.(\d+)""")
+
+/**
+ * Returns `[major, minor, patch, harmonyPatch]` or null when [value] is not an Anikku Harmony
+ * version string or release tag.
+ */
+private fun parseHarmonyVersion(value: String): List<Int>? {
+    val match = HARMONY_VERSION_REGEX.find(value) ?: return null
+    return match.groupValues.drop(1).map { it.toInt() }
+}
+
+private fun compareVersions(a: List<Int>, b: List<Int>): Int {
+    val size = maxOf(a.size, b.size)
+    for (index in 0 until size) {
+        val x = a.getOrElse(index) { 0 }
+        val y = b.getOrElse(index) { 0 }
+        if (x != y) return x.compareTo(y)
+    }
+    return 0
+}
+// Harmony <--
