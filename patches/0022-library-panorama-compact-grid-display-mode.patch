+@Composable
+private fun RelatedMangaSectionHeader(
+    title: String,
+    onClick: () -> Unit,
+    onLongClick: (() -> Unit)?,
+    showArrow: Boolean = true,
+) {
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .background(MaterialTheme.colorScheme.background),
+    ) {
+        HorizontalDivider()
+        RelatedMangaTitle(
+            title = title,
+            showArrow = showArrow,
+            subtitle = null,
+            onClick = onClick,
+            onLongClick = onLongClick,
+            modifier = Modifier
+                .padding(
+                    start = MaterialTheme.padding.small,
+                    end = MaterialTheme.padding.small,
+                ),
+        )
+    }
+}
