+    // Harmony -->
+    // Same two panorama problems as the comfortable browse grid: a shared row height leaves a hole
+    // under a wide cover, and auto columns at 128 dp make that cover cramped.
+    if (usePanoramaCover) {
+        FastScrollLazyVerticalStaggeredGrid(
+            columns = columns.panoramaStaggeredColumns(),
+            contentPadding = contentPadding + PaddingValues(8.dp),
+            topContentPadding = contentPadding.calculateTopPadding(),
+            bottomContentPadding = contentPadding.calculateBottomPadding(),
