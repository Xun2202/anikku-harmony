+                item(span = StaggeredGridItemSpan.FullLine) {
+                    BrowseSourceLoadingItem()
+                }
+            }
+
+            items(count = mangaList.itemCount) { index ->
+                val pair by mangaList[index]?.collectAsState() ?: return@items
+                val manga = pair.first
+                val metadata = pair.second
+
