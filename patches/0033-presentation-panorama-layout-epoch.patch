+/**
+ * High 32 bits are the shape-table version. Low 32 bits are the items-lambda identity.
+ * Lane widths are not included; the layout cache compares them on their own.
+ */
+internal fun panoramaContentEpoch(shapeEpoch: Int, intervals: Any): Long {
+    return (shapeEpoch.toLong() shl 32) xor System.identityHashCode(intervals).toLong().and(0xffffffffL)
+}
