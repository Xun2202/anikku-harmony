+        val first = cache.layout(
+            count = keys.size,
+            contentEpoch = 4L,
+            heightOf = { _, _ ->
+                calls++
+                80
+            },
+            laneWidths = intArrayOf(100, 100),
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+            rtl = false,
+        )
+        state.scrollOffset = first.rects[4].y + 6f
+        measureViewport(state, first, keys, viewport = 100)
+        val offset = state.lastAnchor!!.offsetFromViewportTop
+        calls = 0
+        val second = cache.layout(
+            count = keys.size,
+            contentEpoch = 4L,
+            heightOf = { _, _ ->
+                calls++
+                80
+            },
+            laneWidths = intArrayOf(40, 40, 40, 40),
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+            rtl = false,
+        )
+        assertTrue(cache.structuralChange)
+        assertTrue(calls >= keys.size)
+        assertEquals(4, second.laneCount)
+        measureViewport(state, second, keys, viewport = 100, structural = true)
+        val index = state.lastAnchor!!.index
+        assertEquals(offset, second.rects[index].y - state.scrollOffset.roundToInt())
