     private var horizontalSpacing: Int = Int.MIN_VALUE
     private var rtl: Boolean = false
+    private var contentEpoch: Long = Long.MIN_VALUE
+    private var count: Int = -1
 
     var structuralChange: Boolean = false
         private set
 
     fun layout(
         count: Int,
+        contentEpoch: Long = 0L,
         spanOf: (Int) -> PanoramaSpan = { PanoramaSpan.SingleLane },
         heightOf: (index: Int, widthPx: Int) -> Int,
         laneWidths: IntArray,
@@ -321,15 +332,13 @@ class PanoramaMasonryLayoutCache {
             horizontalSpacing == this.horizontalSpacing &&
             rtl == this.rtl &&
             this.laneWidths.contentEquals(laneWidths)
-        val reusable = sameGeometry &&
-            count >= previous.rects.size &&
-            prefixUnchanged(previous, spanOf, heightOf)
+        val sameEpoch = previous != null && contentEpoch == this.contentEpoch
         val result = when {
-            reusable && count == previous.rects.size -> {
+            previous != null && sameGeometry && sameEpoch && count == this.count -> {
                 structuralChange = false
                 previous
             }
-            reusable -> {
+            previous != null && sameGeometry && sameEpoch && count > previous.rects.size -> {
                 structuralChange = false
                 appendPanoramaMasonry(previous, count, spanOf, heightOf)
             }
@@ -351,22 +360,10 @@ class PanoramaMasonryLayoutCache {
         this.verticalSpacing = verticalSpacing
         this.horizontalSpacing = horizontalSpacing
         this.rtl = rtl
+        this.contentEpoch = contentEpoch
+        this.count = count
         return result
     }
-
-    private fun prefixUnchanged(
-        previous: PanoramaMasonryLayout,
-        spanOf: (Int) -> PanoramaSpan,
-        heightOf: (index: Int, widthPx: Int) -> Int,
-    ): Boolean {
-        for (rect in previous.rects) {
-            // Harmony: tall-to-wide flips the span. Comparing height at the old width can miss that,
-            // so a span change rebuilds from the start instead of appending after a stale prefix.
-            if (spanOf(rect.index) != rect.span) return false
-            if (heightOf(rect.index, rect.width) != rect.height) return false
-        }
-        return true
-    }
