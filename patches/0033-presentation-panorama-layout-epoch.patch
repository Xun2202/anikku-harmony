+    @Test
+    fun `an unchanged epoch does no per item work across 120 frames`() {
+        val widths = intArrayOf(100, 100, 100)
+        for (count in intArrayOf(200, 8000)) {
+            val cache = PanoramaMasonryLayoutCache()
+            var heightCalls = 0
+            var spanCalls = 0
+            fun layout() = cache.layout(
+                count = count,
+                contentEpoch = 7L,
+                spanOf = {
+                    spanCalls++
+                    PanoramaSpan.SingleLane
+                },
+                heightOf = { _, _ ->
+                    heightCalls++
+                    40
+                },
+                laneWidths = widths,
+                verticalSpacing = 4,
+                horizontalSpacing = 4,
+                rtl = false,
+            )
+            layout()
+            heightCalls = 0
+            spanCalls = 0
+            repeat(120) { layout() }
+            assertEquals(0, heightCalls, "count=$count")
+            assertEquals(0, spanCalls, "count=$count")
+            assertFalse(cache.structuralChange)
+        }
+    }
+
+    @Test
+    fun `a new content epoch relayouts and keeps the anchor offset`() {
+        val cache = PanoramaMasonryLayoutCache()
+        val state = PanoramaMasonryState()
+        val keys = List(30) { it.toLong() }
+        val widths = intArrayOf(100, 100)
+        val first = cache.layout(
+            count = keys.size,
+            contentEpoch = 1L,
+            spanOf = { PanoramaSpan.SingleLane },
+            heightOf = { index, _ -> if (index % 2 == 0) 200 else 90 },
+            laneWidths = widths,
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+            rtl = false,
+        )
+        state.scrollOffset = first.rects[10].y + 8f
+        measureViewport(state, first, keys, viewport = 120)
+        val anchor = state.lastAnchor!!
+        val offset = anchor.offsetFromViewportTop
+        assertTrue(anchor.index > 0)
+
+        var heightCalls = 0
+        val second = cache.layout(
+            count = keys.size,
+            contentEpoch = 2L,
+            spanOf = { index ->
+                if (index % 2 == 0) PanoramaSpan.TwoLanesWhenRoomy else PanoramaSpan.SingleLane
+            },
+            heightOf = { index, _ ->
+                heightCalls++
+                if (index % 2 == 0) 80 else 200
+            },
+            laneWidths = widths,
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+            rtl = false,
+        )
+        assertTrue(cache.structuralChange)
+        assertTrue(heightCalls >= keys.size)
+        measureViewport(state, second, keys, viewport = 120, structural = true)
+        val top = second.rects[keys.indexOf(anchor.key)].y
+        assertEquals(offset, top - state.scrollOffset.roundToInt())
+    }
+
+    @Test
+    fun `a lane width change relayouts even when the epoch is unchanged`() {
+        val cache = PanoramaMasonryLayoutCache()
