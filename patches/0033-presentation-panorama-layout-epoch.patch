+        assertNotEquals(first, panoramaContentEpoch(PanoramaMasonryContentEpoch.intValue, intervals))
+        assertNotEquals(first, panoramaContentEpoch(0, Any()))
+        val state = PanoramaMasonryState()
+        val content: PanoramaMasonryScope.() -> Unit = { }
+        val other: PanoramaMasonryScope.() -> Unit = { }
+        val cached = state.intervalsFor(content)
+        assertTrue(cached === state.intervalsFor(content))
+        assertTrue(cached !== state.intervalsFor(other))
+        PanoramaMasonryContentEpoch.intValue = 0
+    }
