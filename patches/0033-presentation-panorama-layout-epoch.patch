+    internal fun intervalsFor(content: PanoramaMasonryScope.() -> Unit): PanoramaIntervalContent {
+        val current = intervalContent
+        if (current != null && intervalLambda === content) return current
+        val created = PanoramaIntervalContent(content)
+        intervalContent = created
+        intervalLambda = content
+        return created
+    }
+
+    /**
+     * The previous key list when [epoch] and [count] are unchanged, otherwise null.
+     * A null result is the only path that may allocate the next list.
+     */
+    internal fun peekCachedKeys(epoch: Long, count: Int): List<Any>? {
+        val cached = keyCache
+        if (cached != null && keyCacheEpoch == epoch && keyCacheCount == count) return cached
+        return null
+    }
+
+    internal fun keysFor(epoch: Long, count: Int, keyAt: (Int) -> Any): List<Any> {
+        peekCachedKeys(epoch, count)?.let { return it }
+        val built = ArrayList<Any>(count)
+        for (index in 0 until count) built.add(keyAt(index))
+        keyCache = built
+        keyCacheEpoch = epoch
+        keyCacheCount = count
+        return built
+    }
+
     internal fun importAnchor(saved: Any) {
         val list = saved as? List<*> ?: return
         val tag = list.getOrNull(0) as? Int ?: return
