From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:47:48 +0000
Subject: [PATCH] presentation: preserve scroll observer registration across
 navigation reset

Shared Mihon and Anikku 0056. Observer lifetime owns the active source; reset cannot erase a registration after first placement. Keep badge assertions tied to visible icon geometry rather than a fixed font-metric estimate.
---
 .../core/components/material/BrowsingScrollInsets.kt   | 10 +++++++++-
 .../core/components/material/NavigationChrome.kt       |  4 ++--
 .../components/material/NavigationChromeLayoutTest.kt  | 10 +++++++++-
 .../components/material/NavigationChromeRefreshTest.kt |  5 ++++-
 4 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/BrowsingScrollInsets.kt b/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/BrowsingScrollInsets.kt
index 295da5620..d008abf76 100644
--- a/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/BrowsingScrollInsets.kt
+++ b/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/BrowsingScrollInsets.kt
@@ -66,7 +66,15 @@ fun Modifier.observeBrowsingLeadingScroll(
         // A programmatic jump may precede any touch. Only a page actually intersecting the
         // clipped window can become the initial owner; precomposed offscreen pages cannot.
         val bounds = coordinates.boundsInWindow()
-        if (chrome.leadingOffset == null && bounds.width > 0f && bounds.height > 0f) activate()
+        val inWindow = bounds.width > 0f && bounds.height > 0f
+        if (!inWindow && chrome.leadingOffset === activeSource) {
+            chrome.leadingOffset = null
+            chrome.trailingRemaining = null
+        }
+        if (chrome.leadingOffset == null && inWindow) activate()
+        // Programmatic jumps finish through layout, without a nested-scroll callback. Commit
+        // the measured boundary here as well: snapshotFlow can dispatch after this layout frame.
+        if (chrome.leadingOffset === activeSource && activeTail() <= 0.5f) chrome.revealAtEnd()
     }.nestedScroll(connection)
 }
 
diff --git a/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/NavigationChrome.kt b/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/NavigationChrome.kt
index 5d0f224c7..3d68c8272 100644
--- a/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/NavigationChrome.kt
+++ b/presentation-core/src/main/java/tachiyomi/presentation/core/components/material/NavigationChrome.kt
@@ -167,8 +167,8 @@ class BrowsingNavigationBarState internal constructor(
 
     fun reset() {
         tracker.reset()
-        leadingOffset = null
-        trailingRemaining = null
+        // Observers own their registration. Clearing it here can race their first placement:
+        // a programmatic child scroll need not place the observer again to restore its source.
         updateVisibility(true)
     }
 
diff --git a/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeLayoutTest.kt b/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeLayoutTest.kt
index e373ccbb7..f4a62c5f6 100644
--- a/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeLayoutTest.kt
+++ b/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeLayoutTest.kt
@@ -405,6 +405,11 @@ class NavigationChromeLayoutTest {
         waitForIdle()
         val viewport = onNodeWithTag("tail-viewport").fetchSemanticsNode().boundsInRoot
         runOnIdle {
+            val registeredLeading = chrome.leadingOffset
+            val registeredTail = chrome.trailingRemaining
+            assertTrue(registeredLeading != null && registeredTail != null, "Initial effects must retain the visible scroll source")
+            chrome.reset()
+            assertTrue(chrome.leadingOffset === registeredLeading && chrome.trailingRemaining === registeredTail)
             chrome.beginGesture()
             chrome.nestedScrollConnection.onPostScroll(Offset(0f, -20f), Offset.Zero, NestedScrollSource.UserInput)
         }
@@ -414,7 +419,10 @@ class NavigationChromeLayoutTest {
         waitForIdle()
         runOnIdle {
             assertFalse(listState.canScrollForward)
-            assertTrue(chrome.visible)
+            assertTrue(
+                chrome.visible,
+                "Measured end must reveal: remaining=${chrome.trailingRemaining?.invoke()}, owner=${chrome.leadingOffset != null}",
+            )
             assertEquals(0f, chrome.hiddenFraction)
             assertEquals(viewport.top, headerY, 1f)
             assertEquals(viewport.bottom, bottomY + bottomHeight, 1f)
diff --git a/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeRefreshTest.kt b/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeRefreshTest.kt
index 5cade6906..760484198 100644
--- a/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeRefreshTest.kt
+++ b/presentation-core/src/test/java/tachiyomi/presentation/core/components/material/NavigationChromeRefreshTest.kt
@@ -120,7 +120,10 @@ class NavigationChromeRefreshTest {
             assertEquals(item.center.x, icons[index].center.x, 1f)
             val label = onNodeWithText("Tab$index", useUnmergedTree = true).fetchSemanticsNode().boundsInRoot
             assertEquals(icons[index].center.x, label.center.x, 1f)
-            assertTrue(badge.bottom <= icons[index].top + 6f * density, "Badge only overlaps the icon's upper corner")
+            assertTrue(
+                badge.bottom <= icons[index].center.y,
+                "Badge $badge must stay above the center of icon ${icons[index]}",
+            )
         }
     }
 
