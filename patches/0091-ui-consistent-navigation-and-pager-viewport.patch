+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeConsistentToolbarTest {
+    @Test
+    fun `regular selection and search keep one main height while only the extra row animates`() = runComposeUiTest {
+        val mode = mutableIntStateOf(0)
+        var mainHeight = 0
+        var headerHeight = 0
+        var childHeight = 0
+        setContent {
+            val config = Configuration(LocalConfiguration.current).apply {
+                screenWidthDp = 400
+                screenHeightDp = 600
+            }
+            CompositionLocalProvider(LocalConfiguration provides config, LocalDensity provides Density(1f)) {
+                MaterialTheme {
+                    val field = rememberTextFieldState("query")
+                    val interaction = remember { MutableInteractionSource() }
+                    Column(Modifier.requiredSize(400.dp, 600.dp)) {
+                        Column(Modifier.onGloballyPositioned { headerHeight = it.size.height }) {
+                            NavigationTopAppBar(
+                                title = {
+                                    if (mode.intValue == 2) {
+                                        BasicTextField(
+                                            state = field,
+                                            lineLimits = TextFieldLineLimits.SingleLine,
+                                            interactionSource = interaction,
+                                            decorator = TextFieldDefaults.decorator(
+                                                state = field,
+                                                enabled = true,
+                                                lineLimits = TextFieldLineLimits.SingleLine,
+                                                outputTransformation = null,
+                                                interactionSource = interaction,
+                                                contentPadding = PaddingValues(0.dp),
+                                                container = {},
+                                            ),
+                                        )
+                                    } else {
+                                        BrowsingTabSelector(
+                                            title = if (mode.intValue == 1) "2" else "Library",
+                                            labels = listOf("Default", "Reading", "Done"),
+                                            selectedIndex = 1,
+                                            onSelect = {},
+                                        )
+                                    }
+                                },
+                                navigationIcon = { if (mode.intValue != 0) IconButton(onClick = {}) { Box(Modifier.size(24.dp)) } },
+                                actions = { repeat(if (mode.intValue == 1) 2 else 3) { IconButton(onClick = {}) { Box(Modifier.size(24.dp)) } } },
+                                colors = TopAppBarDefaults.topAppBarColors(),
+                                scrollBehavior = null,
+                                windowInsets = WindowInsets(0),
+                                modifier = Modifier.onGloballyPositioned { mainHeight = it.size.height },
+                            )
+                            AnimatedNavigationRow(visible = mode.intValue == 2) {
+                                BrowsingTabSelector(
+                                    title = "",
+                                    labels = listOf("Default", "Reading", "Done"),
+                                    selectedIndex = 1,
+                                    onSelect = {},
+                                    modifier = Modifier.onGloballyPositioned { childHeight = it.size.height },
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        mainClock.autoAdvance = false
+        runOnIdle {
+            assertEquals(40, mainHeight)
+            assertEquals(40, headerHeight)
+            mode.intValue = 1
+        }
+        mainClock.advanceTimeByFrame()
+        waitForIdle()
+        runOnIdle {
+            assertEquals(40, mainHeight)
+            assertEquals(40, headerHeight)
+            mode.intValue = 2
+        }
+        mainClock.advanceTimeByFrame()
+        waitForIdle()
+        mainClock.advanceTimeBy(96)
+        runOnIdle {
+            assertEquals(40, mainHeight)
+            assertEquals(40, childHeight)
+            assertTrue(headerHeight in 41..79, "height=$headerHeight")
+        }
+        mainClock.advanceTimeBy(500)
+        runOnIdle {
+            assertEquals(80, headerHeight)
+            mode.intValue = 0
+        }
+        mainClock.advanceTimeByFrame()
+        waitForIdle()
+        mainClock.advanceTimeBy(96)
+        runOnIdle {
+            assertEquals(40, mainHeight)
+            assertTrue(headerHeight in 41..79, "height=$headerHeight")
+        }
+        mainClock.advanceTimeBy(500)
+        runOnIdle { assertEquals(40, headerHeight) }
+    }
+
+    @Test
+    fun `bottom sheet fills its window and applies its own navigation inset exactly once`() = runComposeUiTest {
+        var viewportBottom = 0f
+        var sheetBottom = 0f
+        var contentBottom = 0f
+        var localPadding = 72.dp
+        val home = BrowsingNavigationBarState { true }
+        setContent {
+            CompositionLocalProvider(LocalDensity provides Density(1f), LocalBrowsingBottomPadding provides 72.dp, LocalBrowsingNavigationBarState provides home) {
+                MaterialTheme {
+                    Box(Modifier.requiredSize(400.dp, 600.dp).onGloballyPositioned { viewportBottom = it.positionInRoot().y + it.size.height }) {
+                        NavigationOverlayScope {
+                            localPadding = LocalBrowsingBottomPadding.current
+                            assertNull(LocalBrowsingNavigationBarState.current)
+                            AdaptiveSheet(
+                                isTabletUi = false,
+                                enableImplicitDismiss = true,
+                                onDismissRequest = {},
+                                contentWindowInsets = WindowInsets(0, 0, 0, 24),
+                                modifier = Modifier.onGloballyPositioned { sheetBottom = it.positionInRoot().y + it.size.height },
+                            ) {
+                                Box(Modifier.fillMaxWidth().height(80.dp).onGloballyPositioned { contentBottom = it.positionInRoot().y + it.size.height })
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(0.dp, localPadding)
+            assertEquals(viewportBottom, sheetBottom, 1f)
+            assertEquals(24f, viewportBottom - contentBottom, 1f)
+        }
+    }
+
+    @Test
+    fun `manager navigation stays pinned and resumes collapse when its owner is released`() = runComposeUiTest {
+        val pinned = mutableStateOf(true)
+        val chrome = BrowsingNavigationBarState { true }
+        setContent {
+            CompositionLocalProvider(LocalBrowsingNavigationBarState provides chrome) {
+                rememberBrowsingTopAppBarScrollBehavior(enabled = !pinned.value)
+                Text("management")
+            }
+        }
+        runOnIdle {
+            chrome.nestedScrollConnection.onPostScroll(Offset(0f, -60f), Offset.Zero, NestedScrollSource.UserInput)
+            assertTrue(chrome.visible)
+            pinned.value = false
+        }
+        waitForIdle()
+        runOnIdle {
+            chrome.nestedScrollConnection.onPostScroll(Offset(0f, -60f), Offset.Zero, NestedScrollSource.UserInput)
+            assertFalse(chrome.visible)
+        }
+    }
+}
