+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.requiredSize
+import androidx.compose.foundation.pager.HorizontalPager
+import androidx.compose.foundation.pager.PagerState
+import androidx.compose.foundation.pager.rememberPagerState
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performTouchInput
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.test.swipeLeft
+import androidx.compose.ui.unit.dp
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import kotlin.math.abs
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromePagerViewportTest {
+    @Test
+    fun `held drag is cancelled and aligned after width changes in either direction`() = runComposeUiTest {
+        val width = mutableIntStateOf(320)
+        lateinit var pager: PagerState
+        setContent {
+            pager = rememberPagerState(initialPage = 2) { 8 }
+            HorizontalPager(
+                state = pager,
+                flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(pager),
+                modifier = Modifier.requiredSize(width.intValue.dp, 500.dp)
+                    .settlePagerOnWidthChange(pager).testTag("pager"),
+            ) { Box(Modifier.fillMaxSize()) }
+        }
+        for (nextWidth in listOf(600, 320)) {
+            onNodeWithTag("pager").performTouchInput {
+                down(center)
+                moveBy(Offset(-80f, 0f))
+            }
+            runOnIdle {
+                assertTrue(abs(pager.currentPageOffsetFraction) > 0.03f)
+                width.intValue = nextWidth
+            }
+            waitForIdle()
+            runOnIdle {
+                assertFalse(pager.isScrollInProgress)
+                assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+            }
+            // The old finger remains down across the resize and must not resume the cancelled drag.
+            onNodeWithTag("pager").performTouchInput {
+                moveBy(Offset(-20f, 0f))
+                up()
+            }
+            waitForIdle()
+            runOnIdle { assertEquals(0f, pager.currentPageOffsetFraction, 0.001f) }
+        }
+        val before = pager.currentPage
+        onNodeWithTag("pager").performTouchInput { swipeLeft(durationMillis = 180) }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(pager.currentPage > before)
+            assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+        }
+    }
+
+    @Test
+    fun `extra toolbar height does not cancel a normal horizontal gesture`() = runComposeUiTest {
+        val height = mutableIntStateOf(500)
+        lateinit var pager: PagerState
+        setContent {
+            pager = rememberPagerState(initialPage = 2) { 8 }
+            HorizontalPager(
+                state = pager,
+                flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(pager),
+                modifier = Modifier.requiredSize(400.dp, height.intValue.dp)
+                    .settlePagerOnWidthChange(pager).testTag("pager"),
+            ) { Box(Modifier.fillMaxSize()) }
+        }
+        onNodeWithTag("pager").performTouchInput {
+            down(center)
+            moveBy(Offset(-80f, 0f))
+        }
+        runOnIdle {
+            assertTrue(abs(pager.currentPageOffsetFraction) > 0.03f)
+            height.intValue = 460
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(pager.isScrollInProgress)
+            assertTrue(abs(pager.currentPageOffsetFraction) > 0.03f)
+        }
+        onNodeWithTag("pager").performTouchInput { up() }
+        waitForIdle()
+        runOnIdle {
+            assertFalse(pager.isScrollInProgress)
+            assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+        }
+    }
+
+    @Test
+    fun `restored partial page is aligned on the first viewport`() = runComposeUiTest {
+        lateinit var pager: PagerState
+        setContent {
+            pager = rememberPagerState(initialPage = 2, initialPageOffsetFraction = 0.3f) { 8 }
+            HorizontalPager(
+                state = pager,
+                flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(pager),
+                modifier = Modifier.requiredSize(400.dp, 500.dp).settlePagerOnWidthChange(pager),
+            ) { Box(Modifier.fillMaxSize()) }
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(2, pager.currentPage)
+            assertEquals(0f, pager.currentPageOffsetFraction, 0.001f)
+            assertFalse(pager.isScrollInProgress)
+        }
+    }
+}
