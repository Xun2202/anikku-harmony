+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.PaddingValues
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.width
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.SideEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.saveable.rememberSaveableStateHolder
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.layout.onGloballyPositioned
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class TimelinePanoramaGridTest {
+    @Test
+    fun `wide records span two lanes without composing ten thousand covers or dates`() = runComposeUiTest {
+        val composed = mutableSetOf<Int>()
+        var wideWidth = 0
+        var tallWidth = 0
+        lateinit var state: PanoramaMasonryState
+        lateinit var scope: CoroutineScope
+        setContent {
+            MaterialTheme {
+                state = rememberPanoramaMasonryState()
+                scope = rememberCoroutineScope()
+                Box(Modifier.width(460.dp).height(640.dp)) {
+                    TimelinePanoramaGrid(
+                        count = 10000,
+                        key = { "record-$it" },
+                        fullLine = { it % 25 == 0 },
+                        wide = { it % 4 == 1 },
+                        span = { if (it % 4 == 1) PanoramaSpan.TwoLanesWhenRoomy else PanoramaSpan.SingleLane },
+                        columns = PanoramaColumns.Fixed(3),
+                        contentPadding = PaddingValues(),
+                        state = state,
+                    ) { index ->
+                        SideEffect { composed.add(index) }
+                        Box(
+                            Modifier.fillMaxSize().onGloballyPositioned {
+                                if (index == 1) wideWidth = it.size.width
+                                if (index == 2) tallWidth = it.size.width
+                            },
+                        )
+                    }
+                }
+            }
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(tallWidth > 0 && wideWidth >= tallWidth * 2, "Wide=$wideWidth tall=$tallWidth")
+            assertTrue(composed.size in 1..100, "Initial composition=${composed.size}")
+            scope.launch { state.scrollToItem(8000) }
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(state.firstVisibleItemIndex > 7900)
+            assertTrue(composed.size < 200, "Composed=${composed.size}, including headers")
+        }
+    }
+
+    @Test
+    fun `panorama return keeps the anchor through width changes and deleted history`() = runComposeUiTest {
+        var shown by mutableStateOf(true)
+        var expanded by mutableStateOf(false)
+        var count by mutableIntStateOf(10000)
+        lateinit var state: PanoramaMasonryState
+        lateinit var scope: CoroutineScope
+        setContent {
+            val holder = rememberSaveableStateHolder()
+            MaterialTheme {
+                scope = rememberCoroutineScope()
+                if (shown) {
+                    holder.SaveableStateProvider("panorama-history") {
+                        state = rememberPanoramaMasonryState()
+                        Box(Modifier.width(if (expanded) 700.dp else 460.dp).height(640.dp)) {
+                            TimelinePanoramaGrid(
+                                count,
+                                { "record-$it" },
+                                { it % 25 == 0 },
+                                { it % 4 == 1 },
+                                { if (it % 4 == 1) PanoramaSpan.TwoLanesWhenRoomy else PanoramaSpan.SingleLane },
+                                PanoramaColumns.Adaptive(140.dp),
+                                PaddingValues(),
+                                state = state,
+                            ) { Box(Modifier.fillMaxSize()) }
+                        }
+                    }
+                }
+            }
+        }
+        runOnIdle { scope.launch { state.scrollToItem(8000) } }
+        waitForIdle()
+        runOnIdle { shown = false }
+        waitForIdle()
+        runOnIdle {
+            shown = true
+            expanded = true
+        }
+        waitForIdle()
+        runOnIdle { assertTrue(state.firstVisibleItemIndex in 7900..8100) }
+        runOnIdle { shown = false }
+        waitForIdle()
+        runOnIdle {
+            count = 40
+            shown = true
+            expanded = false
+        }
+        waitForIdle()
+        runOnIdle { assertTrue(state.firstVisibleItemIndex in 0..39) }
+    }
+}
