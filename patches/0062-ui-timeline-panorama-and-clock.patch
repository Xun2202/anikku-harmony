+package eu.kanade.presentation.components
+
+import java.time.Instant
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import java.time.format.DecimalStyle
+import java.util.Locale
+
+private val timelineTimeFormatter = DateTimeFormatter.ofPattern("HH:mm", Locale.ROOT)
+    .withDecimalStyle(DecimalStyle.STANDARD)
+
+/** Local 24-hour time with ASCII digits, independent of the system's 12-hour/locale format. */
+internal fun timelineTime(epochMillis: Long?, zone: ZoneId = ZoneId.systemDefault()): String =
+    epochMillis?.let { timelineTimeFormatter.format(Instant.ofEpochMilli(it).atZone(zone)) }.orEmpty()
