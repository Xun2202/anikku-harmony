+package eu.kanade.tachiyomi.data.download
+
+import eu.kanade.tachiyomi.data.download.model.Download
+import io.mockk.mockk
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class NavigationChromeDownloadProgressEventsTest {
+    @Test
+    fun `bytes refresh a zero percent row and repeated samples produce no extra events`() = runTest {
+        val download = Download(mockk(), mockk(), mockk())
+        var events = 0
+        val observer = launch { download.progressUpdates().collect { events++ } }
+        runCurrent()
+        assertEquals(0, events)
+        download.downloadedBytes = 4096
+        runCurrent()
+        assertEquals(1, events)
+        assertEquals(0, download.progress)
+        download.downloadedBytes = 4096
+        runCurrent()
+        assertEquals(1, events)
+        download.progress = 10
+        runCurrent()
+        assertEquals(2, events)
+        observer.cancelAndJoin()
+    }
+
+    @Test
+    fun `queue observers keep receiving bytes after a retry resets the percentage`() = runTest {
+        val download = Download(mockk(), mockk(), mockk())
+        download.progress = 30
+        val samples = mutableListOf<Pair<Int, Long>>()
+        val observer = launch { download.progressUpdates().collect { samples += download.progress to download.downloadedBytes } }
+        runCurrent()
+        download.progress = 0
+        download.downloadedBytes = 0
+        runCurrent()
+        download.downloadedBytes = 1024
+        runCurrent()
+        assertEquals(0 to 1024L, samples.last())
+        observer.cancelAndJoin()
+    }
+}
