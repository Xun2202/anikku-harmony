@@ -0,0 +1,56 @@
+package eu.kanade.tachiyomi.data.download
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+
+class NavigationChromeDownloadTransferProgressTest {
+    @Test
+    fun `native statistics and file samples count each byte once and never move backwards`() {
+        val progress = DownloadTransferProgress(10_000)
+        assertEquals(DownloadTransferProgress.Snapshot(100, 1000, 10, 100), progress.update(100, 1000))
+        assertEquals(0L, progress.update(100, 1000).addedBytes)
+        assertEquals(DownloadTransferProgress.Snapshot(150, 1000, 10, 50), progress.update(150))
+        assertEquals(DownloadTransferProgress.Snapshot(150, 2000, 20, 0), progress.update(120, 2000))
+        assertEquals(DownloadTransferProgress.Snapshot(150, 2000, 20, 0), progress.update(-1, -1))
+    }
+
+    @Test
+    fun `known duration reserves completion for verified output and handles large timestamps`() {
+        val progress = DownloadTransferProgress(1000)
+        assertEquals(50, progress.update(1, 500).percent)
+        assertEquals(99, progress.update(2, 1000).percent)
+        assertEquals(99, progress.update(3, Long.MAX_VALUE).percent)
+        assertEquals(50, DownloadTransferProgress(Long.MAX_VALUE).update(1, Long.MAX_VALUE / 2).percent)
+    }
+
+    @Test
+    fun `unknown or invalid duration keeps bytes without inventing a percentage`() {
+        listOf(null, 0L, -1L).forEach { duration ->
+            assertEquals(DownloadTransferProgress.Snapshot(1234, 5000, 0, 1234), DownloadTransferProgress(duration).update(1234, 5000))
+        }
+    }
+
+    @Test
+    fun `both FFmpeg time fields use microseconds and modern field takes precedence`() {
+        assertEquals(DownloadTransferProgress.Report(100, 2500), DownloadTransferProgress.parseReport("total_size=100\nout_time_us=2500000\nprogress=continue\n"))
+        assertEquals(DownloadTransferProgress.Report(100, 2500), DownloadTransferProgress.parseReport("total_size=100\nout_time_ms=2500000\nprogress=end\n"))
+        assertEquals(DownloadTransferProgress.Report(0, 2500), DownloadTransferProgress.parseReport("out_time_us=2500000\nout_time_ms=9999999\nprogress=end\n"))
+    }
+
+    @Test
+    fun `last complete report survives an incomplete trailing record`() {
+        val reports = "total_size=100\nout_time_us=1000000\nprogress=continue\ntotal_size=200\nout_time_us=2000000\nprogress=continue\n"
+        val expected = DownloadTransferProgress.Report(200, 2000)
+        assertEquals(expected, DownloadTransferProgress.parseReport(reports + "total_size=300\nout_time_us=3000000\n"))
+        assertEquals(expected, DownloadTransferProgress.parseReport(reports + "total_size=300\nprogress=end"))
+    }
+
+    @Test
+    fun `unknown time preserves bytes and malformed input is ignored`() {
+        assertEquals(DownloadTransferProgress.Report(123, 0), DownloadTransferProgress.parseReport("total_size=123\nout_time_us=N/A\nprogress=end\n"))
+        listOf("", "garbage", "total_size=10\n", "total_size=-1\nout_time_us=N/A\nprogress=end\n", "total_size=999999999999999999999999999\nprogress=end\n").forEach {
+            assertNull(DownloadTransferProgress.parseReport(it))
+        }
+    }
+}
