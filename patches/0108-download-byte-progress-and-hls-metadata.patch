+package eu.kanade.tachiyomi.data.download
+
+/** Merges native statistics and file samples without counting the same bytes twice. */
+internal class DownloadTransferProgress(private val durationMillis: Long?) {
+    private var bytes = 0L
+    private var mediaMillis = 0L
+
+    @Synchronized
+    fun update(bytes: Long, mediaMillis: Long = 0): Snapshot {
+        val previousBytes = this.bytes
+        this.bytes = maxOf(this.bytes, bytes)
+        this.mediaMillis = maxOf(this.mediaMillis, mediaMillis)
+        val percent = durationMillis?.takeIf { it > 0 }?.let {
+            (this.mediaMillis.toDouble() / it.toDouble() * 100).toInt().coerceIn(0, 99)
+        } ?: 0
+        return Snapshot(this.bytes, this.mediaMillis, percent, this.bytes - previousBytes)
+    }
+
+    data class Snapshot(val bytes: Long, val mediaMillis: Long, val percent: Int, val addedBytes: Long)
+
+    data class Report(val bytes: Long, val mediaMillis: Long)
+
+    companion object {
+        /** A report is published only once its newline-terminated progress marker is present. */
+        fun parseReport(text: String): Report? {
+            var result: Report? = null
+            var bytes: Long? = null
+            var micros: Long? = null
+            var legacyMicros: Long? = null
+            text.substringBeforeLast('\n', "").lineSequence().forEach { line ->
+                val key = line.substringBefore('=').trim()
+                val value = line.substringAfter('=', "").trim()
+                val number = value.toLongOrNull()?.takeIf { it >= 0 }
+                when (key) {
+                    "total_size" -> bytes = number ?: bytes
+                    "out_time_us" -> micros = number ?: micros
+                    // FFmpeg's historical out_time_ms field is also measured in microseconds.
+                    "out_time_ms" -> legacyMicros = number ?: legacyMicros
+                    "progress" -> {
+                        if ((value == "continue" || value == "end") && (bytes != null || micros != null || legacyMicros != null)) {
+                            result = Report(bytes ?: 0, (micros ?: legacyMicros ?: 0) / 1000)
+                        }
+                        bytes = null
+                        micros = null
+                        legacyMicros = null
+                    }
+                }
+            }
+            return result
+        }
+    }
+}
