+package eu.kanade.tachiyomi.data.download
+
+import okhttp3.Headers.Companion.headersOf
+import okhttp3.Interceptor
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertSame
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.io.IOException
+
+class NavigationChromeDownloadHlsManifestTest {
+    @Test
+    fun `VOD sums decimal segment times precisely with BOM and CRLF`() {
+        val text = "\uFEFF#EXTM3U\r\n#EXTINF:0.1,one\r\none.ts\r\n#EXTINF:0.2,two\r\ntwo.ts\r\n#EXT-X-ENDLIST\r\n"
+        assertEquals(DownloadHlsManifest.Metadata(300, 2), DownloadHlsManifest.parse(text))
+    }
+
+    @Test
+    fun `live and master playlists never imply a duration`() {
+        assertEquals(DownloadHlsManifest.Metadata(null, 1), DownloadHlsManifest.parse("#EXTM3U\n#EXT-X-TARGETDURATION:10\n#EXTINF:3,\na.ts\n"))
+        assertEquals(DownloadHlsManifest.Metadata(null, 0), DownloadHlsManifest.parse("#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=1000\nchild.m3u8\n#EXT-X-ENDLIST\n"))
+    }
+
+    @Test
+    fun `invalid durations and overflow remain unknown while non HLS is rejected`() {
+        listOf("N/A", "NaN", "Infinity", "-1", "", "999999999999999999999999", "0").forEach {
+            assertEquals(DownloadHlsManifest.Metadata(null, 1), DownloadHlsManifest.parse("#EXTM3U\n#EXTINF:$it,\na.ts\n#EXT-X-ENDLIST\n"))
+        }
+        assertNull(DownloadHlsManifest.parse("<html>not a playlist</html>"))
+        assertNull(DownloadHlsManifest.parse("#EXTM3U forged\n"))
+    }
+
+    @Test
+    fun `input recognition uses the URL path and exact local host`() {
+        listOf("https://cdn.example/movie.M3U8?token=x", "http://localhost:123/m3u8?url=x", "http://127.0.0.1/m3u8", "http://[::1]/m3u8").forEach {
+            assertTrue(DownloadHlsManifest.isHlsInput(it), it)
+        }
+        listOf("https://cdn.example/movie.mp4?url=https://x/a.m3u8", "https://cdn.example/m3u8", "http://localhost.example/m3u8", "http://localhost/segment?url=a.m3u8", "file:///a.m3u8", "not a URL").forEach {
+            assertFalse(DownloadHlsManifest.isHlsInput(it), it)
+        }
+    }
+
+    @Test
+    fun `read fetches only manifest once and forwards headers without requesting key or segments`() {
+        var calls = 0
+        val client = client { chain ->
+            calls++
+            assertEquals("GET", chain.request().method)
+            assertEquals("/index.m3u8", chain.request().url.encodedPath)
+            assertEquals("test-cookie", chain.request().header("Cookie"))
+            assertEquals("test-referer", chain.request().header("Referer"))
+            response(chain, "#EXTM3U\n#EXT-X-KEY:METHOD=AES-128,URI=\"key.bin\"\n#EXTINF:1.25,\nsegment.ts\n#EXT-X-ENDLIST\n")
+        }
+        assertEquals(DownloadHlsManifest.Metadata(1250, 1), DownloadHlsManifest.read(client, URL, headersOf("Cookie", "test-cookie", "Referer", "test-referer")))
+        assertEquals(1, calls)
+    }
+
+    @Test
+    fun `read rejects HTTP errors invalid content and oversized bodies without leaking URL`() {
+        listOf(403 to "denied", 200 to "<html>not HLS</html>", 200 to ("#EXTM3U\n" + "x".repeat(1024 * 1024))).forEach { (code, body) ->
+            var calls = 0
+            val client = client { chain ->
+                calls++
+                response(chain, body, code)
+            }
+            val error = assertThrows(DownloadHlsManifest.InvalidManifestException::class.java) {
+                DownloadHlsManifest.read(client, URL, headersOf())
+            }
+            assertFalse(error.message.orEmpty().contains("private"))
+            assertFalse(error.message.orEmpty().contains("example"))
+            assertEquals(1, calls)
+        }
+    }
+
+    @Test
+    fun `network failure remains available to the caller without wrapping`() {
+        val failure = IOException("network unavailable")
+        val client = client { throw failure }
+        val actual = assertThrows(IOException::class.java) {
+            DownloadHlsManifest.read(client, URL, headersOf())
+        }
+        assertSame(failure, actual)
+    }
+
+    private fun client(interceptor: Interceptor): OkHttpClient = OkHttpClient.Builder().addInterceptor(interceptor).build()
+
+    private fun response(chain: Interceptor.Chain, text: String, code: Int = 200): Response = Response.Builder()
+        .request(chain.request())
+        .protocol(Protocol.HTTP_1_1)
+        .code(code)
+        .message("test")
+        .body(text.toResponseBody())
+        .build()
+
+    private companion object {
+        const val URL = "https://cdn.example/index.m3u8?token=private"
+    }
+}
