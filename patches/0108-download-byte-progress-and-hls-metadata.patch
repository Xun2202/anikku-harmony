@@ -0,0 +1,74 @@
+package eu.kanade.tachiyomi.data.download
+
+import okhttp3.Headers
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.IOException
+import java.math.BigDecimal
+import java.math.RoundingMode
+import java.net.URI
+
+internal object DownloadHlsManifest {
+    data class Metadata(val durationMillis: Long?, val segments: Int)
+
+    class InvalidManifestException(message: String) : IOException(message)
+
+    fun isHlsInput(url: String): Boolean {
+        val uri = runCatching { URI(url) }.getOrNull() ?: return false
+        if (uri.scheme?.lowercase() !in setOf("http", "https")) return false
+        val path = uri.path.orEmpty().lowercase()
+        val host = uri.host?.lowercase()?.removeSurrounding("[", "]")
+        return path.endsWith(".m3u8") ||
+            (host in setOf("localhost", "127.0.0.1", "::1") && path == "/m3u8")
+    }
+
+    fun read(client: OkHttpClient, url: String, headers: Headers): Metadata {
+        val request = Request.Builder().url(url).headers(headers).get().build()
+        return client.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) throw InvalidManifestException("HLS manifest HTTP ${response.code}")
+            val body = response.body
+            if (body.contentLength() > MAX_BYTES) throw InvalidManifestException("HLS manifest exceeds size limit")
+            val source = body.source()
+            source.request(MAX_BYTES + 1)
+            if (source.buffer.size > MAX_BYTES) throw InvalidManifestException("HLS manifest exceeds size limit")
+            parse(source.readUtf8()) ?: throw InvalidManifestException("Invalid HLS manifest header")
+        }
+    }
+
+    fun parse(text: String): Metadata? {
+        val lines = text.removePrefix("\uFEFF").lineSequence().iterator()
+        if (!lines.hasNext() || lines.next().trim() != "#EXTM3U") return null
+        var segments = 0
+        var duration = BigDecimal.ZERO
+        var valid = true
+        var ended = false
+        var master = false
+        lines.forEach { raw ->
+            val line = raw.trim()
+            when {
+                line == "#EXT-X-ENDLIST" -> ended = true
+                line.startsWith("#EXT-X-STREAM-INF:") || line.startsWith("#EXT-X-I-FRAME-STREAM-INF:") -> master = true
+                line == "#EXTINF" || line.startsWith("#EXTINF:") -> {
+                    segments++
+                    val seconds = line.substringAfter(':', "").substringBefore(',').trim()
+                    val value = seconds.takeIf { DECIMAL.matches(it) }?.toBigDecimalOrNull()
+                    if (value == null) {
+                        valid = false
+                    } else {
+                        duration += value
+                    }
+                }
+            }
+        }
+        val millis = if (ended && !master && valid && duration.signum() > 0) {
+            runCatching { duration.movePointRight(3).setScale(0, RoundingMode.HALF_UP).longValueExact() }
+                .getOrNull()?.takeIf { it > 0 }
+        } else {
+            null
+        }
+        return Metadata(millis, segments)
+    }
+
+    private const val MAX_BYTES = 1024L * 1024
+    private val DECIMAL = Regex("[0-9]+(?:\\.[0-9]*)?")
+}
