+private const val SHEET_EXPANDED = 0
+private const val SHEET_HIDDEN = 1
+private val SheetMotion = tween<Float>(260, easing = FastOutSlowInEasing)
+
+@Composable
+internal fun AdaptiveSheetLayout(
+    isTabletUi: Boolean,
+    allowImplicitDismiss: Boolean,
+    onDismissRequest: () -> Unit,
+    modifier: Modifier,
+    contentWindowInsets: WindowInsets,
+    maxWidth: Dp,
+    state: AdaptiveSheetState,
+    content: @Composable () -> Unit,
+) {
+    val dismiss by rememberUpdatedState(onDismissRequest)
+    fun complete() {
+        if (!state.completed) {
+            state.completed = true
+            dismiss()
+        }
+    }
+    val scrim = MaterialTheme.colorScheme.scrim
+    BackHandler(enabled = allowImplicitDismiss && !state.isClosing, onBack = state::dismiss)
+    DisposableEffect(state) { onDispose { state.fractionReader = { 0f } } }
