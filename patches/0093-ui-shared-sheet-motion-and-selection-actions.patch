+                    val end = anchors.positionOf(target)
+                    if (end.isFinite()) {
+                        val start = drag.offset.takeIf { it.isFinite() } ?: end
+                        if (start < end - 0.5f) {
+                            animate(start, end, drag.lastVelocity, SheetMotion) { value, velocity -> dragTo(value, velocity) }
+                        } else {
+                            dragTo(end)
+                        }
+                    }
+                }
+            }
+            complete()
+        } else {
+            try {
+                withFrameTimeProtection { drag.animateTo(SHEET_EXPANDED, SheetMotion) }
+            } finally {
+                entering = false
+            }
+        }
+    }
+    LaunchedEffect(drag, state) {
+        snapshotFlow { !entering && height > 0 && drag.offset.isFinite() && drag.offset >= height - 0.5f }
+            .filter { it }.collect { state.dismiss() }
+    }
+    Box(
+        Modifier.fillMaxSize()
+            .drawBehind { drawRect(scrim.copy(alpha = 0.32f * sheetVisibleFraction(drag.offset, height))) }
+            .clickable(interactionSource = null, indication = null, enabled = allowImplicitDismiss && !state.isClosing, onClick = state::dismiss)
+            .statusBarsPadding(),
+        contentAlignment = Alignment.BottomCenter,
+    ) {
+        Surface(
+            modifier = Modifier.widthIn(max = maxWidth)
+                .nestedScroll(nested)
+                .then(modifier)
+                .blockClosingInput(state.isClosing)
+                .onSizeChanged {
+                    height = it.height
+                    if (height > 0) {
+                        drag.updateAnchors(
+                            DraggableAnchors {
+                                SHEET_EXPANDED at 0f
+                                SHEET_HIDDEN at height.toFloat()
+                            },
+                        )
+                    }
+                }
+                .offset { IntOffset(0, drag.offset.takeIf { it.isFinite() }?.roundToInt() ?: height) }
+                .graphicsLayer { alpha = if (height > 0 && drag.offset.isFinite()) 1f else 0f }
+                .anchoredDraggable(drag, Orientation.Vertical, enabled = allowImplicitDismiss && !state.isClosing, flingBehavior = fling)
+                .clickable(interactionSource = null, indication = null, onClick = {}),
+            shape = MaterialTheme.shapes.extraLarge.copy(bottomStart = CornerSize(0.dp), bottomEnd = CornerSize(0.dp)),
+            color = MaterialTheme.colorScheme.surfaceContainerHigh,
+        ) {
