+    val scope = rememberCoroutineScope()
+    val drag = remember { AnchoredDraggableState(if (state.hasPresented) SHEET_EXPANDED else SHEET_HIDDEN) }
+    var height by remember { mutableIntStateOf(0) }
+    var entering by remember { mutableStateOf(!state.hasPresented) }
+    val reader = remember(drag) { { sheetVisibleFraction(drag.offset, height) } }
+    SideEffect { state.fractionReader = reader }
+    val threshold = remember(density) { { distance: Float -> minOf(with(density) { 56.dp.toPx() }, distance * 0.25f) } }
+    val fling = rememberFrameTimeProtectedFlingBehavior(
+        AnchoredDraggableDefaults.flingBehavior(drag, positionalThreshold = threshold, animationSpec = SheetMotion),
+    )
+    val nested = remember(drag, fling, scope) { SheetNestedScroll(drag, fling, scope) { allowImplicitDismiss && !state.isClosing } }
