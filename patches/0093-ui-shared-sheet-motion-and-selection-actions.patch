+/** Nested content and direct sheet drags use the very same native distance/velocity decision. */
+private class SheetNestedScroll(
+    private val state: AnchoredDraggableState<Int>,
+    private val fling: FlingBehavior,
+    private val scope: CoroutineScope,
+    var allowed: () -> Boolean,
+) : NestedScrollConnection {
+    private var dragJob: Job? = null
+    private var moved = false
+
+    fun cancel() {
+        dragJob?.cancel()
+        dragJob = null
+    }
+
+    private fun consume(delta: Float): Float {
+        if (!allowed()) return 0f
+        val old = state.offset
+        if (!old.isFinite()) return 0f
+        val end = (old + delta).coerceIn(state.anchors.minPosition(), state.anchors.maxPosition())
+        if (end == old) return 0f
+        if (dragJob?.isActive != true) {
+            dragJob = scope.launch(start = CoroutineStart.UNDISPATCHED) {
+                state.anchoredDrag(dragPriority = MutatePriority.UserInput) { awaitCancellation() }
+            }
+        }
+        moved = true
+        return state.dispatchRawDelta(delta)
+    }
+
+    override fun onPreScroll(available: Offset, source: NestedScrollSource): Offset =
+        if (source == NestedScrollSource.UserInput && available.y < 0) Offset(0f, consume(available.y)) else Offset.Zero
+
+    override fun onPostScroll(consumed: Offset, available: Offset, source: NestedScrollSource): Offset =
+        if (source == NestedScrollSource.UserInput) Offset(0f, consume(available.y)) else Offset.Zero
+
+    private suspend fun settle(velocity: Float) {
+        dragJob?.cancelAndJoin()
+        dragJob = null
+        if (!allowed()) return
+        state.anchoredDrag {
+            val scroll = object : ScrollScope {
+                override fun scrollBy(pixels: Float): Float {
+                    val old = state.offset
+                    val next = (old + pixels).coerceIn(state.anchors.minPosition(), state.anchors.maxPosition())
+                    dragTo(next)
+                    return next - old
+                }
+            }
+            with(fling) { scroll.performFling(velocity) }
+        }
+        moved = false
+    }
+
+    override suspend fun onPreFling(available: Velocity): Velocity =
+        if (allowed() && available.y < 0f && state.offset > 0f) {
+            settle(available.y)
+            available
+        } else {
+            Velocity.Zero
+        }
+
+    override suspend fun onPostFling(consumed: Velocity, available: Velocity): Velocity =
+        if (allowed() && (moved || state.offset > 0.5f)) {
+            settle(available.y)
+            available
+        } else {
+            Velocity.Zero
+        }
+}
+
+private fun Modifier.blockClosingInput(closing: Boolean): Modifier = pointerInput(closing) {
+    if (closing) {
+        awaitPointerEventScope {
+            while (true) awaitPointerEvent(PointerEventPass.Initial).changes.forEach { it.consume() }
+        }
+    }
+}
