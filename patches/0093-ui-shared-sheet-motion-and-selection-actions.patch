+package tachiyomi.presentation.core.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.Stable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.runtime.staticCompositionLocalOf
+
+/** One dismissal path for the dialog window, backdrop, back button and content actions. */
+@Stable
+class AdaptiveSheetState internal constructor() {
+    internal var closing by mutableStateOf(false)
+        private set
+    internal var hasPresented = false
+    internal var completed = false
+    internal var fractionReader: () -> Float by mutableStateOf({ 0f })
+
+    val isClosing: Boolean get() = closing
+    val visibleFraction: Float get() = fractionReader().coerceIn(0f, 1f)
+
+    fun dismiss() {
+        closing = true
+    }
+}
+
+@Composable
+fun rememberAdaptiveSheetState(): AdaptiveSheetState = remember { AdaptiveSheetState() }
+
+internal fun sheetVisibleFraction(offset: Float, height: Int): Float =
+    if (height <= 0 || !offset.isFinite()) 0f else (1f - offset / height).coerceIn(0f, 1f)
+
+val LocalAdaptiveSheetDismissRequest = staticCompositionLocalOf<(() -> Unit)?> { null }
