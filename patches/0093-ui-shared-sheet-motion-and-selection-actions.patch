+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeSheetPagerHeightTest {
+    @Test
+    fun `height follows a held swipe both from short to tall and tall to short`() = runComposeUiTest {
+        lateinit var state: PagerState
+        var height = 0
+        setContent {
+            CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                Column(Modifier.requiredSize(400.dp, 600.dp)) {
+                    state = rememberPagerState { 2 }
+                    AdaptiveHeightPager(state, Modifier.testTag("pages").onGloballyPositioned { height = it.size.height }) { page ->
+                        Column(Modifier.fillMaxWidth().verticalScroll(rememberScrollState())) {
+                            Box(Modifier.fillMaxWidth().height(if (page == 0) 140.dp else 420.dp))
+                        }
+                    }
+                }
+            }
+        }
+        runOnIdle { assertEquals(140, height) }
+        onNodeWithTag("pages").performTouchInput {
+            down(Offset(width * 0.85f, center.y))
+            moveBy(Offset(-260f, 0f))
+        }
+        runOnIdle { assertTrue(height in 141..419, "forward=$height offset=${state.currentPageOffsetFraction}") }
+        onNodeWithTag("pages").performTouchInput {
+            advanceEventTime(200)
+            up()
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(1, state.currentPage)
+            assertEquals(420, height)
+        }
+        onNodeWithTag("pages").performTouchInput {
+            down(Offset(width * 0.15f, center.y))
+            moveBy(Offset(260f, 0f))
+        }
+        runOnIdle { assertTrue(height in 141..419, "reverse=$height offset=${state.currentPageOffsetFraction}") }
+        onNodeWithTag("pages").performTouchInput {
+            advanceEventTime(200)
+            up()
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(0, state.currentPage)
+            assertEquals(140, height)
+        }
+    }
+}
