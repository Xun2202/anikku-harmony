@@ -0,0 +1,231 @@
+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertSame
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.io.IOException
+
+class NavigationChromeDownloadForegroundLifecycleTest {
+    @Test
+    fun `already running downloads retain a foreground owner when start returns false`() = runBlocking {
+        var running = true
+        var starts = 0
+        var leases = 0
+        var releases = 0
+        val acquired = CompletableDeferred<Unit>()
+        val owner = launch {
+            assertTrue(
+                DownloadForegroundLifecycle.run(
+                    start = {
+                        starts++
+                        false
+                    },
+                    isRunning = { running },
+                    checkNetwork = { true },
+                    onStarted = {
+                        leases++
+                        acquired.complete(Unit)
+                    },
+                    onFinished = {
+                        leases--
+                        releases++
+                    },
+                    pollIntervalMillis = 1,
+                ),
+            )
+        }
+        try {
+            withTimeout(2000) { acquired.await() }
+            assertTrue(owner.isActive)
+            assertEquals(1, starts)
+            assertEquals(1, leases)
+            assertEquals(0, releases)
+            running = false
+            withTimeout(2000) { owner.join() }
+            assertEquals(0, leases)
+            assertEquals(1, releases)
+        } finally {
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `successful start holds the lease until downloads finish`() = runBlocking {
+        var running = false
+        var leases = 0
+        var releases = 0
+        val acquired = CompletableDeferred<Unit>()
+        val owner = launch {
+            assertTrue(
+                DownloadForegroundLifecycle.run(
+                    start = {
+                        running = true
+                        true
+                    },
+                    isRunning = { running },
+                    checkNetwork = { true },
+                    onStarted = {
+                        leases++
+                        acquired.complete(Unit)
+                    },
+                    onFinished = {
+                        leases--
+                        releases++
+                    },
+                    pollIntervalMillis = 1,
+                ),
+            )
+        }
+        try {
+            withTimeout(2000) { acquired.await() }
+            assertEquals(1, leases)
+            running = false
+            withTimeout(2000) { owner.join() }
+            assertEquals(0, leases)
+            assertEquals(1, releases)
+        } finally {
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `cancellation waits for suspending cleanup and releases exactly once`() = runBlocking {
+        var leases = 0
+        var releases = 0
+        val acquired = CompletableDeferred<Unit>()
+        val cleaning = CompletableDeferred<Unit>()
+        val finishCleanup = CompletableDeferred<Unit>()
+        val owner = launch {
+            DownloadForegroundLifecycle.run(
+                start = { true },
+                isRunning = { true },
+                checkNetwork = { true },
+                onStarted = {
+                    leases++
+                    acquired.complete(Unit)
+                },
+                onFinished = {
+                    cleaning.complete(Unit)
+                    finishCleanup.await()
+                    leases--
+                    releases++
+                },
+                pollIntervalMillis = 1,
+            )
+        }
+        try {
+            withTimeout(2000) { acquired.await() }
+            owner.cancel()
+            withTimeout(2000) { cleaning.await() }
+            assertFalse(owner.isCompleted)
+            assertEquals(1, leases)
+            assertEquals(0, releases)
+            finishCleanup.complete(Unit)
+            withTimeout(2000) { owner.join() }
+            owner.cancelAndJoin()
+            assertEquals(0, leases)
+            assertEquals(1, releases)
+        } finally {
+            finishCleanup.complete(Unit)
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `network loss ends foreground ownership even while downloader still reports running`() = runBlocking {
+        var checks = 0
+        var started = 0
+        var finished = 0
+        val result = withTimeout(2000) {
+            DownloadForegroundLifecycle.run(
+                start = { true },
+                isRunning = { true },
+                checkNetwork = { ++checks == 1 },
+                onStarted = { started++ },
+                onFinished = { finished++ },
+                pollIntervalMillis = 0,
+            )
+        }
+        assertTrue(result)
+        assertEquals(2, checks)
+        assertEquals(1, started)
+        assertEquals(1, finished)
+    }
+
+    @Test
+    fun `initial network failure and an empty queue never acquire or release a lease`() = runBlocking {
+        var starts = 0
+        var acquired = 0
+        var released = 0
+        suspend fun attempt(network: Boolean): Boolean = DownloadForegroundLifecycle.run(
+            start = {
+                starts++
+                false
+            },
+            isRunning = { false },
+            checkNetwork = { network },
+            onStarted = { acquired++ },
+            onFinished = { released++ },
+            pollIntervalMillis = 1,
+        )
+        assertFalse(attempt(false))
+        assertEquals(0, starts)
+        assertFalse(attempt(true))
+        assertEquals(1, starts)
+        assertEquals(0, acquired)
+        assertEquals(0, released)
+    }
+
+    @Test
+    fun `partial foreground acquisition failure still cleans up the lease`() = runBlocking {
+        var leases = 0
+        var releases = 0
+        val failure = IOException("foreground acquisition failed")
+        val actual = runCatching {
+            DownloadForegroundLifecycle.run(
+                start = { true },
+                isRunning = { true },
+                checkNetwork = { true },
+                onStarted = {
+                    leases++
+                    throw failure
+                },
+                onFinished = {
+                    leases--
+                    releases++
+                },
+                pollIntervalMillis = 1,
+            )
+        }.exceptionOrNull()
+        assertSame(failure, actual)
+        assertEquals(0, leases)
+        assertEquals(1, releases)
+    }
+
+    @Test
+    fun `a throwing startup is cleaned up before its exception escapes`() = runBlocking {
+        var finishes = 0
+        var started = 0
+        val failure = IOException("startup failed")
+        val actual = runCatching {
+            DownloadForegroundLifecycle.run(
+                start = { throw failure },
+                isRunning = { false },
+                checkNetwork = { true },
+                onStarted = { started++ },
+                onFinished = { finishes++ },
+                pollIntervalMillis = 1,
+            )
+        }.exceptionOrNull()
+        assertSame(failure, actual)
+        assertEquals(0, started)
+        assertEquals(1, finishes)
+    }
+}
