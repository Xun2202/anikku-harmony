new file mode 100644
index 000000000..b64e24fd1
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/download/NavigationChromeDownloadHlsRecoveryTest.kt
@@ -0,0 +1,91 @@
+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.runBlocking
+import okhttp3.Headers.Companion.headersOf
+import okhttp3.Interceptor
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.io.File
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.io.path.createTempDirectory
+
+class NavigationChromeDownloadHlsRecoveryTest {
+    @Test
+    fun `403 is requested once retains its typed status and preserves completed neighbour cache`() = withCache { cache ->
+        val initial = DownloadHlsSegments.prepare(client(), "MissAV", URL, headersOf(), cache) {}!!
+        val first = File(initial.directory, "00000.ts")
+        assertTrue(File(initial.directory, "00001.ts").delete())
+        val requests = AtomicInteger()
+        val denied = OkHttpClient.Builder().addInterceptor { chain ->
+            if (chain.request().url.encodedPath == "/m3u8") {
+                response(chain, MANIFEST.toByteArray())
+            } else {
+                requests.incrementAndGet()
+                assertEquals("1", chain.request().url.queryParameter("url"))
+                response(chain, byteArrayOf(), 403)
+            }
+        }.build()
+        val failure = runCatching {
+            DownloadHlsSegments.prepare(denied, "MissAV", URL, headersOf(), cache) {}
+        }.exceptionOrNull()
+        assertTrue(failure is DownloadHlsSegments.Failure)
+        assertEquals(403, (failure as DownloadHlsSegments.Failure).httpStatus)
+        assertEquals(1, requests.get())
+        assertTrue(first.readBytes().contentEquals(TS))
+        assertFalse(File(initial.directory, "00001.ts").exists())
+    }
+
+    @Test
+    fun `resume reports the whole cached total once with zero network and writes a local relative HLS playlist`() = withCache { cache ->
+        val initial = DownloadHlsSegments.prepare(client(), "MissAV", URL, headersOf(), cache) {}!!
+        val requests = AtomicInteger()
+        val resumedClient = OkHttpClient.Builder().addInterceptor { chain ->
+            requests.incrementAndGet()
+            assertEquals("/m3u8", chain.request().url.encodedPath)
+            response(chain, MANIFEST.toByteArray())
+        }.build()
+        val snapshots = mutableListOf<DownloadHlsSegments.Progress>()
+        val resumed = DownloadHlsSegments.prepare(resumedClient, "MissAV", URL, headersOf(), cache, snapshots::add)!!
+        assertEquals(initial.directory, resumed.directory)
+        assertEquals(1, requests.get())
+        assertEquals(1, snapshots.size)
+        assertEquals(DownloadHlsSegments.Progress(2L * TS.size, 0, 2500, 2500), snapshots.first())
+        assertEquals("input.m3u8", resumed.input.name)
+        val text = resumed.input.readText()
+        assertTrue(text.startsWith("#EXTM3U\n"))
+        assertTrue(text.trimEnd().endsWith("#EXT-X-ENDLIST"))
+        assertFalse(text.contains("http") || text.contains("private") || text.contains("/segment"))
+        val localPaths = text.lineSequence().filter { it.isNotBlank() && !it.startsWith('#') }.toList()
+        assertEquals(listOf("00000.ts", "00001.ts"), localPaths)
+        assertTrue(localPaths.all { File(resumed.directory, it).isFile && !File(it).isAbsolute })
+    }
+
+    private fun client(): OkHttpClient = OkHttpClient.Builder().addInterceptor { chain ->
+        response(chain, if (chain.request().url.encodedPath == "/m3u8") MANIFEST.toByteArray() else TS)
+    }.build()
+
+    private fun response(chain: Interceptor.Chain, bytes: ByteArray, status: Int = 200): Response = Response.Builder()
+        .request(chain.request()).protocol(Protocol.HTTP_1_1).code(status).message("test")
+        .body(bytes.toResponseBody()).build()
+
+    private fun withCache(block: suspend (File) -> Unit) = runBlocking {
+        val cache = createTempDirectory("hls-recovery-test-").toFile()
+        try {
+            block(cache)
+        } finally {
+            cache.deleteRecursively()
+        }
+    }
+
+    private companion object {
+        const val URL = "http://localhost:1234/m3u8?url=private"
+        const val MANIFEST = "#EXTM3U\n#EXTINF:1.25,\n/segment?url=0\n#EXTINF:1.25,\n/segment?url=1\n#EXT-X-ENDLIST\n"
+        val TS = ByteArray(188 * 4) { if (it % 188 == 0) 0x47 else 0 }
+    }
+}
