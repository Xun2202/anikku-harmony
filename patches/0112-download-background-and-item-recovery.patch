+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+import java.io.Closeable
+import java.io.IOException
+
+/** Feed real PCM writes so that a dead/stalled audio output can be detected and rebuilt. */
+internal object DownloadAudioPump {
+    interface Sink : Closeable {
+        suspend fun write(): Int
+    }
+
+    suspend fun run(
+        create: () -> Sink,
+        onFailure: (Exception) -> Unit,
+        retryDelayMillis: Long = 1000,
+        zeroWriteLimit: Int = 100,
+    ) {
+        var failures = 0
+        while (true) {
+            currentCoroutineContext().ensureActive()
+            var sink: Sink? = null
+            try {
+                sink = create()
+                var zeros = 0
+                var successful = 0
+                while (true) {
+                    currentCoroutineContext().ensureActive()
+                    val count = sink.write()
+                    if (count < 0) throw IOException("Audio write failed: $count")
+                    if (count == 0) {
+                        if (++zeros >= zeroWriteLimit.coerceAtLeast(1)) throw IOException("Audio output stalled")
+                    } else {
+                        zeros = 0
+                        if (++successful >= 50) failures = 0
+                    }
+                    // Even a broken HAL that accepts writes without backpressure must not busy-spin.
+                    delay(if (count == 0) 50L else 5L)
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (error: Exception) {
+                currentCoroutineContext().ensureActive()
+                onFailure(error)
+            } finally {
+                runCatching { sink?.close() }
+            }
+            failures = (failures + 1).coerceAtMost(30)
+            delay(retryDelayMillis.coerceAtLeast(1) * failures)
+        }
+    }
+}
