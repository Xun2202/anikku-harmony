+import tachiyomi.domain.manga.interactor.GetManga
+import tachiyomi.domain.source.service.SourceManager
+
+class NavigationChromeDownloadPausedStoreTest {
+    @Test
+    fun `legacy JSON without paused restores as queued in its stored order`() {
+        val fixture = Fixture()
+        fixture.values["1"] = "{\"mangaId\":1,\"chapterId\":1,\"order\":20}"
+        fixture.values["2"] = "{\"mangaId\":2,\"chapterId\":2,\"order\":10}"
+        val restored = fixture.store.restore()
+        assertEquals(listOf(2L, 1L), restored.map { it.episode.id })
+        assertTrue(restored.all { it.status == Download.State.QUEUE })
+        assertTrue(fixture.values.isEmpty())
+    }
+
+    @Test
+    fun `paused state survives process restore and later resume without changing initial queue order`() {
+        val fixture = Fixture()
+        val first = fixture.download(1).apply { status = Download.State.PAUSED }
+        val second = fixture.download(2)
+        fixture.store.addAll(listOf(first, second))
+        val restored = fixture.store.restore()
+        assertEquals(listOf(1L, 2L), restored.map { it.episode.id })
+        assertEquals(listOf(Download.State.PAUSED, Download.State.QUEUE), restored.map { it.status })
+        fixture.store.addAll(restored)
+        val order = fixture.order("1")
+        restored.first().status = Download.State.QUEUE
+        fixture.store.update(restored.first())
+        assertEquals(order, fixture.order("1"))
+        assertTrue(fixture.store.restore().all { it.status == Download.State.QUEUE })
+    }
+
+    @Test
+    fun `updating a pause preserves order and never revives an entry removed during cancellation`() {
+        val fixture = Fixture()
+        val first = fixture.download(1)
+        val second = fixture.download(2)
+        fixture.store.addAll(listOf(first, second))
+        val originalOrder = fixture.order("1")
+        first.status = Download.State.PAUSED
+        fixture.store.update(first)
+        assertEquals(originalOrder, fixture.order("1"))
+        assertEquals(listOf("1", "2"), fixture.values.keys.toList())
+        fixture.store.remove(first)
+        fixture.store.update(first)
+        assertFalse(fixture.values.containsKey("1"))
+        val restored = fixture.store.restore()
+        assertEquals(listOf(2L), restored.map { it.episode.id })
+    }
+
+    private class Fixture {
+        val values = linkedMapOf<String, String>()
+        private val preferences = mockk<SharedPreferences>()
+        private val editor = mockk<SharedPreferences.Editor>()
+        private val source = mockk<HttpSource>()
+        private val sourceManager = mockk<SourceManager>()
+        private val getManga = mockk<GetManga>()
+        private val getChapter = mockk<GetChapter>()
+        private val mangas = mutableMapOf<Long, Anime>()
+        private val episodes = mutableMapOf<Long, Episode>()
+        val store: DownloadStore
+
+        init {
+            every { preferences.edit() } returns editor
+            every { preferences.all } answers { values.toMap() }
+            every { preferences.getString(any(), any()) } answers { values[firstArg<String>()] ?: secondArg<String?>() }
+            every { editor.putString(any(), any()) } answers {
+                values[firstArg()] = secondArg()
+                editor
+            }
+            every { editor.remove(any()) } answers {
+                values.remove(firstArg<String>())
+                editor
+            }
+            every { editor.clear() } answers {
+                values.clear()
+                editor
+            }
+            every { editor.apply() } just Runs
+            every { sourceManager.get(1L) } returns source
+            coEvery { getManga.await(any<Long>()) } answers { manga(firstArg()) }
+            coEvery { getChapter.await(any<Long>()) } answers { episode(firstArg()) }
+            val context = mockk<Context> {
+                every { getSharedPreferences("active_downloads", Context.MODE_PRIVATE) } returns preferences
+            }
+            store = DownloadStore(context, sourceManager, Json, getManga, getChapter)
+        }
+
+        private fun manga(value: Long): Anime = mangas.getOrPut(value) {
+            mockk<Anime>().also { manga ->
+                every { manga.id } returns value
+                every { manga.source } returns 1L
+            }
+        }
+
+        private fun episode(value: Long): Episode = episodes.getOrPut(value) {
+            mockk<Episode>().also { episode -> every { episode.id } returns value }
+        }
+
+        fun download(id: Long): Download = Download(source, manga(id), episode(id)).apply { status = Download.State.QUEUE }
+
+        fun order(key: String): Int = Json.parseToJsonElement(values.getValue(key)).jsonObject.getValue("order").jsonPrimitive.int
+    }
+}
