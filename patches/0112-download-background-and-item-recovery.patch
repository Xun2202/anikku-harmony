@@ -0,0 +1,166 @@
+package eu.kanade.tachiyomi.data.download
+
+import com.hippo.unifile.UniFile
+import eu.kanade.tachiyomi.data.download.model.Download
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.verify
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import kotlinx.coroutines.yield
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.episode.model.Episode
+import java.io.IOException
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+class NavigationChromeDownloadItemControlTest {
+    @Test
+    fun `stop waits for one writer preserves PAUSED and permits a nonoverlapping resume without stopping its sibling`() = runBlocking {
+        val owner = SupervisorJob()
+        val scope = CoroutineScope(owner + Dispatchers.IO)
+        val workers = DownloadQueueConcurrency.Workers()
+        val first = download(1)
+        val sibling = download(2)
+        val entered = CountDownLatch(1)
+        val resumed = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val starts = AtomicInteger()
+        val writing = AtomicInteger()
+        val maximum = AtomicInteger()
+        lateinit var writer: Job
+        lateinit var siblingJob: Job
+        val start: (Download) -> Job = { item ->
+            if (item === sibling) {
+                scope.launch(start = CoroutineStart.UNDISPATCHED) {
+                    item.status = Download.State.DOWNLOADING
+                    awaitCancellation()
+                }.also { siblingJob = it }
+            } else {
+                val generation = starts.incrementAndGet()
+                scope.launch {
+                    item.status = Download.State.DOWNLOADING
+                    maximum.accumulateAndGet(writing.incrementAndGet()) { old, current -> maxOf(old, current) }
+                    try {
+                        if (generation == 1) {
+                            entered.countDown()
+                            check(release.await(5, TimeUnit.SECONDS))
+                        } else {
+                            resumed.countDown()
+                            awaitCancellation()
+                        }
+                    } finally {
+                        writing.decrementAndGet()
+                    }
+                }.also { if (generation == 1) writer = it }
+            }
+        }
+        try {
+            workers.update(listOf(first, sibling), start)
+            assertTrue(entered.await(3, TimeUnit.SECONDS))
+            first.status = Download.State.PAUSED
+            val stopping = launch { workers.stop(first.episode.id) }
+            withTimeout(3000) { while (!writer.isCancelled) yield() }
+            assertFalse(stopping.isCompleted)
+            assertTrue(siblingJob.isActive)
+            release.countDown()
+            withTimeout(3000) { stopping.join() }
+            assertEquals(Download.State.PAUSED, first.status)
+            assertEquals(0, writing.get())
+            first.status = Download.State.QUEUE
+            workers.update(listOf(first, sibling), start)
+            assertTrue(resumed.await(3, TimeUnit.SECONDS))
+            assertEquals(2, starts.get())
+            assertEquals(1, maximum.get())
+            assertTrue(siblingJob.isActive)
+        } finally {
+            release.countDown()
+            workers.update(emptyList(), start)
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `a candidate paused while reconciliation waits for old IO cannot be launched from a stale active list`() = runBlocking {
+        val owner = SupervisorJob()
+        val scope = CoroutineScope(owner + Dispatchers.IO)
+        val workers = DownloadQueueConcurrency.Workers()
+        val old = download(1)
+        val candidate = download(2)
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val candidateStarts = AtomicInteger()
+        lateinit var oldWriter: Job
+        val start: (Download) -> Job = { item ->
+            if (item === old) {
+                scope.launch {
+                    item.status = Download.State.DOWNLOADING
+                    entered.countDown()
+                    check(release.await(5, TimeUnit.SECONDS))
+                }.also { oldWriter = it }
+            } else {
+                candidateStarts.incrementAndGet()
+                scope.launch { awaitCancellation() }
+            }
+        }
+        try {
+            workers.update(listOf(old), start)
+            assertTrue(entered.await(3, TimeUnit.SECONDS))
+            val reconciling = launch { workers.update(listOf(candidate), start) }
+            withTimeout(3000) { while (!oldWriter.isCancelled) yield() }
+            candidate.status = Download.State.PAUSED
+            release.countDown()
+            withTimeout(3000) { reconciling.join() }
+            assertEquals(0, candidateStarts.get())
+            workers.update(listOf(candidate), start)
+            assertEquals(0, candidateStarts.get())
+            assertEquals(Download.State.PAUSED, candidate.status)
+        } finally {
+            release.countDown()
+            workers.update(emptyList(), start)
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `restart removes only recognized pending videos and copy marker while keeping nomedia`() {
+        val files = listOf("Episode.mkv", "Episode.mkv.anikku", "Episode.mkv (1).anikku", "Episode.tmp", ".nomedia")
+            .associateWith(::file)
+        val directory = mockk<UniFile> { every { listFiles() } returns files.values.toTypedArray() }
+        EpisodeDownloadStorage.discardPending(directory, "Episode")
+        files.filterKeys { it != ".nomedia" }.values.forEach { file -> verify(exactly = 1) { file.delete() } }
+        verify(exactly = 0) { files.getValue(".nomedia").delete() }
+    }
+
+    @Test
+    fun `an unknown pending entry prevents all deletion before restart`() {
+        val files = listOf("Episode.mkv", "Episode.tmp", "notes.txt").associateWith(::file)
+        val directory = mockk<UniFile> { every { listFiles() } returns files.values.toTypedArray() }
+        assertThrows(IOException::class.java) { EpisodeDownloadStorage.discardPending(directory, "Episode") }
+        files.values.forEach { file -> verify(exactly = 0) { file.delete() } }
+    }
+
+    private fun download(id: Long): Download {
+        val episode = mockk<Episode>().also { episode -> every { episode.id } returns id }
+        return Download(mockk(), mockk(), episode).apply { status = Download.State.QUEUE }
+    }
+
+    private fun file(filename: String): UniFile = mockk<UniFile>().also { file ->
+        every { file.name } returns filename
+        every { file.isDirectory } returns false
+        every { file.delete() } returns true
+    }
+}
