@@ -0,0 +1,34 @@
+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withContext
+
+/** Keeps a foreground owner attached to downloads that may already be running. */
+internal object DownloadForegroundLifecycle {
+    suspend fun run(
+        start: () -> Boolean,
+        isRunning: () -> Boolean,
+        checkNetwork: () -> Boolean,
+        onStarted: suspend () -> Unit,
+        onFinished: suspend () -> Unit,
+        pollIntervalMillis: Long = 1000,
+    ): Boolean {
+        if (!checkNetwork()) return false
+        var finishRequired = true
+        try {
+            if (!start() && !isRunning()) {
+                finishRequired = false
+                return false
+            }
+            onStarted()
+            while (isRunning()) {
+                delay(pollIntervalMillis.coerceAtLeast(1))
+                if (!checkNetwork()) break
+            }
+            return true
+        } finally {
+            if (finishRequired) withContext(NonCancellable) { onFinished() }
+        }
+    }
+}
