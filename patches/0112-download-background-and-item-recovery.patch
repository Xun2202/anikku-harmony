diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/download/NavigationChromeDownloadItemControlTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/download/NavigationChromeDownloadItemControlTest.kt
