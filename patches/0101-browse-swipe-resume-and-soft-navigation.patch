+package eu.kanade.tachiyomi.ui.browse.source.browse
+
+import eu.kanade.tachiyomi.source.model.FilterList
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNotSame
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import eu.kanade.tachiyomi.animesource.model.AnimeFilter as Filter
+
+class NavigationChromeSourceFilterSnapshotTest {
+    private fun defaults(): FilterList = FilterList(
+        object : Filter.Text("Title") {},
+        object : Filter.Group<Filter<*>>("Genres", listOf(object : Filter.CheckBox("Adventure") {})) {},
+        object : Filter.Sort("Order", arrayOf("Name", "Date")) {},
+    )
+
+    @Test
+    fun `editing or resetting a sheet cannot mutate the applied paging filters`() {
+        val draft = defaults()
+        (draft[0] as Filter.Text).state = "first"
+        val genre = (draft[1] as Filter.Group<*>).state[0] as Filter.CheckBox
+        genre.state = true
+        (draft[2] as Filter.Sort).state = Filter.Sort.Selection(1, false)
+
+        val applied = draft.copyStateTo(defaults())
+        val reopened = applied.copyStateTo(defaults())
+        assertNotSame(draft[0], applied[0])
+        assertNotSame((draft[1] as Filter.Group<*>).state[0], (applied[1] as Filter.Group<*>).state[0])
+        (reopened[0] as Filter.Text).state = "cancelled edit"
+        ((reopened[1] as Filter.Group<*>).state[0] as Filter.CheckBox).state = false
+        (reopened[2] as Filter.Sort).state = null
+
+        assertEquals("first", (applied[0] as Filter.Text).state)
+        assertTrue(((applied[1] as Filter.Group<*>).state[0] as Filter.CheckBox).state)
+        assertEquals(Filter.Sort.Selection(1, false), (applied[2] as Filter.Sort).state)
+        assertEquals("", (defaults()[0] as Filter.Text).state)
+        assertFalse(((defaults()[1] as Filter.Group<*>).state[0] as Filter.CheckBox).state)
+    }
+}
