+package tachiyomi.presentation.core.components.material
+
+import android.view.ViewGroup
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.calculateEndPadding
+import androidx.compose.foundation.layout.calculateStartPadding
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.navigationBars
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.TopAppBarScrollBehavior
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.platform.LocalLayoutDirection
+import androidx.core.graphics.Insets
+import androidx.core.view.updatePadding
+
+@Composable
+fun SourcePreferencesScaffold(
+    topBar: @Composable (TopAppBarScrollBehavior) -> Unit,
+    content: @Composable (Insets) -> Unit,
+) {
+    Scaffold(
+        topBarScrollBehavior = rememberBrowsingTopAppBarScrollBehavior(enabled = false),
+        topBar = topBar,
+        contentWindowInsets = nativePageContentInsets(),
+    ) { padding ->
+        val direction = LocalLayoutDirection.current
+        val density = LocalDensity.current
+        val safeBottom = padding.calculateBottomPadding()
+        val handle = (WindowInsets.navigationBars.getBottom(density) - with(density) { safeBottom.roundToPx() })
+            .coerceAtLeast(0)
+        Box(
+            Modifier.fillMaxSize().padding(
+                start = padding.calculateStartPadding(direction),
+                end = padding.calculateEndPadding(direction),
+                bottom = safeBottom,
+            ).traceNativePageBounds("source-settings"),
+        ) {
+            content(Insets.of(0, with(density) { padding.calculateTopPadding().roundToPx() }, 0, handle))
+        }
+    }
+}
+
+/** Reserve the first and last scroll positions without clipping rows as they pass under either edge. */
+class SourcePreferenceListPadding(private val list: ViewGroup) {
+    private val initialTop = list.paddingTop
+    private val initialBottom = list.paddingBottom
+
+    fun apply(insets: Insets) {
+        list.clipToPadding = false
+        val top = initialTop + insets.top
+        val bottom = initialBottom + insets.bottom
+        if (list.paddingTop != top || list.paddingBottom != bottom) list.updatePadding(top = top, bottom = bottom)
+    }
+}
