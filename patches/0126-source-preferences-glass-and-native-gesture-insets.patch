+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34], qualifiers = "mdpi")
+class NavigationChromeSourcePreferencesInsetsTest {
+    @Test
+    fun `native rows scroll under the pinned toolbar and end above the gesture handle`() = runComposeUiTest {
+        lateinit var host: View
+        lateinit var list: RecyclerView
+        lateinit var listPadding: SourcePreferenceListPadding
+        var toolbarColor = Color.Unspecified
+        setContent {
+            host = LocalView.current
+            MaterialTheme {
+                Box(Modifier.size(300.dp, 420.dp).testTag("viewport")) {
+                    SourcePreferencesScaffold(topBar = {
+                        toolbarColor = browsingChromeContainerColor()
+                        Box(Modifier.fillMaxWidth().height(56.dp).testTag("toolbar"))
+                    }) { insets ->
+                        AndroidView(
+                            factory = { context ->
+                                RecyclerView(context).apply {
+                                    list = this
+                                    layoutManager = LinearLayoutManager(context)
+                                    adapter = Rows()
+                                    setPadding(2, 3, 4, 5)
+                                    listPadding = SourcePreferenceListPadding(this)
+                                }
+                            },
+                            update = { listPadding.apply(insets) },
+                            modifier = Modifier.fillMaxSize().testTag("list"),
+                        )
+                    }
+                }
+            }
+        }
+        fun bottomBar(height: Int) {
+            val bar = Insets.of(0, 0, 0, height)
+            val insets = WindowInsets.Builder()
+                .setInsets(WindowInsets.Type.navigationBars() or WindowInsets.Type.tappableElement(), bar)
+                .setVisible(WindowInsets.Type.navigationBars() or WindowInsets.Type.tappableElement(), true)
+                .build()
+            runOnIdle { host.dispatchApplyWindowInsets(insets) }
+            waitForIdle()
+        }
+        bottomBar(16)
+        val viewport = onNodeWithTag("viewport").fetchSemanticsNode().boundsInRoot
+        val toolbar = onNodeWithTag("toolbar").fetchSemanticsNode().boundsInRoot
+        fun listBounds() = onNodeWithTag("list").fetchSemanticsNode().boundsInRoot
+        assertEquals(viewport, listBounds())
+        runOnIdle {
+            assertEquals(Color.Transparent, toolbarColor)
+            assertFalse(list.clipToPadding)
+            assertEquals(toolbar.height.toInt() + 3, list.paddingTop)
+            assertEquals(21, list.paddingBottom)
+            assertEquals(list.paddingTop, list.layoutManager!!.findViewByPosition(0)!!.top)
+            list.scrollBy(0, 24)
+            assertTrue(list.layoutManager!!.findViewByPosition(0)!!.top < toolbar.height)
+            list.scrollToPosition(19)
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(list.height - 21, list.layoutManager!!.findViewByPosition(19)!!.bottom)
+        }
+        bottomBar(48)
+        assertEquals(viewport.bottom - 48, listBounds().bottom, 0.5f)
+        runOnIdle { assertEquals(5, list.paddingBottom) }
+        bottomBar(16)
+        assertEquals(viewport, listBounds())
+        runOnIdle {
+            assertEquals(toolbar.height.toInt() + 3, list.paddingTop)
+            assertEquals(21, list.paddingBottom)
+            assertEquals(2, list.paddingLeft)
+            assertEquals(4, list.paddingRight)
+        }
+    }
+
+    private class Row(val label: TextView) : RecyclerView.ViewHolder(label)
+
+    private class Rows : RecyclerView.Adapter<Row>() {
+        override fun getItemCount() = 20
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int) = Row(
+            TextView(parent.context).apply {
+                layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 64)
+            },
+        )
+
+        override fun onBindViewHolder(holder: Row, position: Int) {
+            holder.label.text = position.toString()
+        }
+    }
+}
