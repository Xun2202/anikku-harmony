+package tachiyomi.presentation.core.components.material
+
+import android.os.Build
+import android.view.WindowManager
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.WindowInsetsSides
+import androidx.compose.foundation.layout.displayCutout
+import androidx.compose.foundation.layout.ime
+import androidx.compose.foundation.layout.isImeVisible
+import androidx.compose.foundation.layout.navigationBars
+import androidx.compose.foundation.layout.only
+import androidx.compose.foundation.layout.systemBars
+import androidx.compose.foundation.layout.tappableElement
+import androidx.compose.foundation.layout.union
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.layout.boundsInWindow
+import androidx.compose.ui.layout.onGloballyPositioned
+import androidx.compose.ui.platform.LocalConfiguration
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.dp
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import tachiyomi.presentation.core.components.PanoramaScrollTrace
+import kotlin.math.roundToInt
+
+/** Native scrolling content shares the bottom gesture area, but keeps real buttons, cutouts and the IME clear. */
+@Composable
+fun nativePageContentInsets(): WindowInsets {
+    val navigation = WindowInsets.navigationBars
+    val tappable = WindowInsets.tappableElement
+    val ime = WindowInsets.ime
+    val imeVisible = rememberUpdatedState(WindowInsets.isImeVisible)
+    val resources = LocalView.current.resources
+    val gestureMode = remember(resources, LocalConfiguration.current) {
+        val id = resources.getIdentifier("config_navBarInteractionMode", "integer", "android")
+        id != 0 && resources.getInteger(id) == 2
+    }
+    val controls = remember(navigation, tappable, ime, gestureMode) {
+        object : WindowInsets by tappable {
+            override fun getBottom(density: Density): Int = with(density) {
+                val bar = navigation.getBottom(density)
+                val touch = tappable.getBottom(density)
+                val keyboard = ime.getBottom(density)
+                // Some hosts report the slim gesture strip as tappable and as the hidden keyboard.
+                // Keep a full-height button bar/taskbar, even when the underlying phone uses gestures.
+                val handle = bar > 0 && touch <= bar &&
+                    (bar <= 24.dp.roundToPx() || ((gestureMode || touch == 0) && bar < 48.dp.roundToPx()))
+                val navigationSpace = if (handle) 0 else maxOf(bar, touch)
+                maxOf(navigationSpace, if (imeVisible.value || keyboard > bar) keyboard else 0)
+            }
+        }
+    }
+    return WindowInsets.systemBars.only(WindowInsetsSides.Horizontal + WindowInsetsSides.Top)
+        .union(controls)
+        .union(WindowInsets.displayCutout)
+        .union(ime.only(WindowInsetsSides.Horizontal + WindowInsetsSides.Top))
+}
+
+/** Record layout changes for devices where the system itself may own the bottom strip. */
+@Composable
+fun Modifier.traceNativePageBounds(page: String): Modifier {
+    val view = LocalView.current
+    return this.then(
+        remember(view, page) {
+            var previous = ""
+            Modifier.onGloballyPositioned { coordinates ->
+                val insets = ViewCompat.getRootWindowInsets(view) ?: return@onGloballyPositioned
+                val windowHeight = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                    view.context.getSystemService(WindowManager::class.java)?.currentWindowMetrics?.bounds?.height()
+                } else {
+                    null
+                }
+                val bounds = coordinates.boundsInWindow()
+                val measure = "window=$windowHeight decor=${view.rootView.height} top=${bounds.top.roundToInt()} " +
+                    "bottom=${bounds.bottom.roundToInt()} nav=${insets.getInsets(WindowInsetsCompat.Type.navigationBars()).bottom} " +
+                    "tap=${insets.getInsets(WindowInsetsCompat.Type.tappableElement()).bottom} " +
+                    "ime=${insets.getInsets(WindowInsetsCompat.Type.ime()).bottom} " +
+                    "cutout=${insets.getInsets(WindowInsetsCompat.Type.displayCutout()).bottom}"
+                if (measure != previous) {
+                    previous = measure
+                    PanoramaScrollTrace.log(0, "native page $page $measure")
+                }
+            }
+        },
+    )
+}
