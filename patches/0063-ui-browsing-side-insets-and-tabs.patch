+
+/** Interpolate the real tab widths; scroll offsets are read fresh rather than animated twice. */
+internal fun browsingTabIndicatorBounds(
+    selection: Float,
+    boundsAt: (Int) -> Pair<Float, Float>?,
+): Pair<Float, Float>? {
+    val lower = selection.toInt()
+    val upper = kotlin.math.ceil(selection).toInt()
+    val start = boundsAt(lower) ?: return boundsAt(upper)
+    val end = boundsAt(upper) ?: return start
+    val fraction = selection - lower
+    return (start.first + (end.first - start.first) * fraction) to
+        (start.second + (end.second - start.second) * fraction)
+}
