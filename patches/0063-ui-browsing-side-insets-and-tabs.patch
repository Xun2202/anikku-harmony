+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class NavigationChromeInsetsTest {
+    @Test
+    fun `portrait then either landscape cutout keeps browsing covers at the window edges`() = runComposeUiTest {
+        var safe by mutableStateOf<WindowInsets>(WindowInsets(0, 80, 0, 16))
+        setContent {
+            MaterialTheme {
+                Box(Modifier.size(360.dp, 480.dp).testTag("viewport")) {
+                    Scaffold(
+                        topBarScrollBehavior = rememberBrowsingTopAppBarScrollBehavior(),
+                        contentWindowInsets = browsingContentWindowInsets(safe, WindowInsets(0, 0, 0, 16)),
+                    ) { padding ->
+                        Box(Modifier.fillMaxSize().padding(padding)) { Box(Modifier.fillMaxSize().testTag("covers")) }
+                    }
+                }
+            }
+        }
+        val viewport = onNodeWithTag("viewport").fetchSemanticsNode().boundsInRoot
+        for (insets in listOf(WindowInsets(80, 24, 0, 16), WindowInsets(0, 24, 80, 16), WindowInsets(0, 80, 0, 16))) {
+            runOnIdle { safe = insets }
+            waitForIdle()
+            val covers = onNodeWithTag("covers").fetchSemanticsNode().boundsInRoot
+            assertEquals(viewport.left, covers.left, 0.5f)
+            assertEquals(viewport.right, covers.right, 0.5f)
+            assertEquals(viewport.bottom - 16f, covers.bottom, 0.5f)
+        }
+    }
+
+    @Test
+    fun `real side navigation buttons keep their space while camera inset does not`() = runComposeUiTest {
+        setContent {
+            MaterialTheme {
+                Box(Modifier.size(360.dp, 480.dp).testTag("viewport")) {
+                    Scaffold(
+                        topBarScrollBehavior = rememberBrowsingTopAppBarScrollBehavior(),
+                        contentWindowInsets = browsingContentWindowInsets(WindowInsets(80, 24, 0, 16), WindowInsets(0, 0, 48, 0)),
+                    ) { padding ->
+                        Box(Modifier.fillMaxSize().padding(padding)) { Box(Modifier.fillMaxSize().testTag("covers")) }
+                    }
+                }
+            }
+        }
+        val viewport = onNodeWithTag("viewport").fetchSemanticsNode().boundsInRoot
+        val covers = onNodeWithTag("covers").fetchSemanticsNode().boundsInRoot
+        assertEquals(viewport.left, covers.left, 0.5f)
+        assertEquals(viewport.right - 48f, covers.right, 0.5f)
+    }
+
+    @Test
+    fun `explicit insets remain honored by ordinary detail scaffolds`() = runComposeUiTest {
+        setContent {
+            MaterialTheme {
+                Box(Modifier.size(360.dp, 480.dp).testTag("viewport")) {
+                    Scaffold(contentWindowInsets = WindowInsets(80, 24, 0, 16)) { padding ->
+                        Box(Modifier.fillMaxSize().padding(padding)) { Box(Modifier.fillMaxSize().testTag("detail")) }
+                    }
+                }
+            }
+        }
+        val viewport = onNodeWithTag("viewport").fetchSemanticsNode().boundsInRoot
+        val detail = onNodeWithTag("detail").fetchSemanticsNode().boundsInRoot
+        assertEquals(viewport.left + 80f, detail.left, 0.5f)
+    }
+}
