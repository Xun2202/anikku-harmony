+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.WindowInsetsSides
+import androidx.compose.foundation.layout.navigationBars
+import androidx.compose.foundation.layout.only
+import androidx.compose.foundation.layout.union
+import androidx.compose.material3.ScaffoldDefaults
+import androidx.compose.runtime.Composable
+
+/** Covers draw behind side cutouts; real side navigation controls still reserve their space.
+ * Toolbar controls retain their own safe insets. Explicit Scaffold insets are not changed.
+ */
+@Composable
+internal fun browsingContentWindowInsets(
+    safeInsets: WindowInsets = ScaffoldDefaults.contentWindowInsets,
+    navigationInsets: WindowInsets = WindowInsets.navigationBars,
+): WindowInsets = safeInsets.only(WindowInsetsSides.Vertical)
+    .union(navigationInsets.only(WindowInsetsSides.Horizontal))
