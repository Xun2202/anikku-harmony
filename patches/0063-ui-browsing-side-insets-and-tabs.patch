+package tachiyomi.presentation.core.components.material
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+
+class NavigationChromeTabIndicatorTest {
+    @Test
+    fun `selection passes through intermediate position and width between unequal tabs`() {
+        val bounds = mapOf(0 to (8f to 32f), 1 to (56f to 112f))
+        assertEquals(8f to 32f, browsingTabIndicatorBounds(0f, bounds::get))
+        assertEquals(32f to 72f, browsingTabIndicatorBounds(0.5f, bounds::get))
+        assertEquals(56f to 112f, browsingTabIndicatorBounds(1f, bounds::get))
+        // Scrolling moves the current geometry directly, without another offset animation.
+        assertEquals(
+            12f to 72f,
+            browsingTabIndicatorBounds(0.5f) { index ->
+                bounds[index]?.let { (it.first - 20f) to it.second }
+            },
+        )
+    }
+
+    @Test
+    fun `unmeasured lazy tabs do not crash indicator rendering`() {
+        assertNull(browsingTabIndicatorBounds(0.5f) { null })
+        assertEquals(8f to 32f, browsingTabIndicatorBounds(0.5f) { if (it == 0) 8f to 32f else null })
+    }
+}
