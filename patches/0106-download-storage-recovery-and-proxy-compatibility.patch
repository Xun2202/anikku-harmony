+package eu.kanade.tachiyomi.data.download
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class NavigationChromeDownloadFfmpegPolicyTest {
+    private val hlsHelp = " -extension_picky <boolean> strict extensions\n -seg_max_retry <int> segment retries"
+    private val httpHelp = " -reconnect_max_retries <int>\n -reconnect_delay_total_max <int>"
+
+    @Test
+    fun `local rewritten HLS works without changing remote playlists or local file policy`() {
+        val local = DownloadFfmpegPolicy.inputOptions("http://localhost:1234/m3u8?url=https%3A%2F%2Fcdn.example%2Findex.m3u8", hlsHelp, httpHelp)
+        assertEquals("0", local[local.indexOf("-extension_picky") + 1])
+        assertEquals("3", local[local.indexOf("-seg_max_retry") + 1])
+        assertFalse("-allowed_extensions" in local)
+        listOf("http://127.0.0.1:1234/m3u8", "http://[::1]:1234/m3u8").forEach {
+            assertTrue("-extension_picky" in DownloadFfmpegPolicy.inputOptions(it, hlsHelp, httpHelp))
+        }
+        listOf("https://cdn.example/movie.m3u8", "https://localhost.example/m3u8", "http://127.0.0.1:1234/movie.mp4").forEach {
+            assertFalse("-extension_picky" in DownloadFfmpegPolicy.inputOptions(it, hlsHelp, httpHelp))
+        }
+        assertTrue(DownloadFfmpegPolicy.inputOptions("file:///movie.mkv", hlsHelp, httpHelp).isEmpty())
+    }
+
+    @Test
+    fun `older native builds receive only options their help advertises`() {
+        val old = DownloadFfmpegPolicy.inputOptions("http://localhost:1234/m3u8", "", "")
+        assertFalse("-extension_picky" in old)
+        assertFalse("-seg_max_retry" in old)
+        assertFalse("-reconnect_max_retries" in old)
+        assertFalse("-reconnect_at_eof" in old)
+        assertEquals("2", old[old.indexOf("-reconnect_delay_max") + 1])
+        val fallback = DownloadFfmpegPolicy.inputOptions("http://localhost:1234/m3u8", " -allowed_segment_extensions <string>", "")
+        assertEquals("ALL", fallback[fallback.indexOf("-allowed_segment_extensions") + 1])
+    }
+
+    @Test
+    fun `network retries are bounded and exclude permanent authentication failures`() {
+        val options = DownloadFfmpegPolicy.inputOptions("https://cdn.example/movie.mp4", hlsHelp, httpHelp)
+        assertEquals("3", options[options.indexOf("-reconnect_max_retries") + 1])
+        assertEquals("10", options[options.indexOf("-reconnect_delay_total_max") + 1])
+        val errors = options[options.indexOf("-reconnect_on_http_error") + 1].split(',')
+        assertTrue("503" in errors)
+        assertFalse("401" in errors || "403" in errors || "404" in errors)
+    }
+
+    @Test
+    fun `failure diagnostics preserve the cause without URL credentials or request secrets`() {
+        val detail = DownloadFfmpegPolicy.failureDetail(
+            listOf(
+                "[http @ 0xABC] HTTP error 503 for https://user:password@cdn.example/segment?token=private&expires=123",
+                "Authorization: Bearer private-secret",
+                "Cookie: private-cookie",
+                "Invalid data found when processing input",
+            ),
+            "-1094995529",
+        )
+        assertTrue("HTTP error 503" in detail && "Invalid data" in detail)
+        listOf("password", "private", "expires", "0xABC").forEach { assertFalse(it in detail) }
+        assertEquals("rc=-1", DownloadFfmpegPolicy.failureDetail(emptyList(), "-1"))
+    }
+}
