@@ -0,0 +1,58 @@
+package eu.kanade.tachiyomi.data.download
+
+import java.net.URI
+
+/** Runtime capabilities keep older FFmpeg builds usable without assuming their demuxer options. */
+internal object DownloadFfmpegPolicy {
+    fun inputOptions(url: String, hlsHelp: String, httpHelp: String): List<String> {
+        val uri = runCatching { URI(url) }.getOrNull() ?: return emptyList()
+        if (uri.scheme?.lowercase() !in setOf("http", "https")) return emptyList()
+        return buildList {
+            // Short, bounded retries handle a proxy/CDN hiccup without restarting the whole file.
+            addAll(listOf("-rw_timeout", "30000000", "-reconnect", "1", "-reconnect_streamed", "1"))
+            addAll(listOf("-reconnect_on_network_error", "1", "-reconnect_on_http_error", "408,429,500,502,503,504"))
+            addAll(listOf("-reconnect_delay_max", "2"))
+            if (supports(httpHelp, "reconnect_max_retries")) addAll(listOf("-reconnect_max_retries", "3"))
+            if (supports(httpHelp, "reconnect_delay_total_max")) addAll(listOf("-reconnect_delay_total_max", "10"))
+            if (isLocalHlsProxy(uri)) {
+                // The proxy returns TS bytes at /segment?url=..., without a filename extension.
+                // Leave ordinary remote playlists and the file-protocol allowlist unchanged.
+                if (supports(hlsHelp, "extension_picky")) {
+                    addAll(listOf("-extension_picky", "0"))
+                } else if (supports(hlsHelp, "allowed_segment_extensions")) {
+                    addAll(listOf("-allowed_segment_extensions", "ALL"))
+                }
+                if (supports(hlsHelp, "seg_max_retry")) addAll(listOf("-seg_max_retry", "3"))
+            }
+        }
+    }
+
+    private fun isLocalHlsProxy(uri: URI): Boolean {
+        val host = uri.host?.lowercase()?.removeSurrounding("[", "]")
+        val path = uri.path.orEmpty().trimEnd('/').lowercase()
+        return host in setOf("localhost", "127.0.0.1", "::1") &&
+            (path.substringAfterLast('/') == "m3u8" || path.endsWith(".m3u8"))
+    }
+
+    private fun supports(help: String, option: String): Boolean =
+        Regex("(?:^|\\s)-${Regex.escape(option)}(?:\\s|$)").containsMatchIn(help)
+
+    fun describeInput(url: String): String = runCatching {
+        val uri = URI(url)
+        URI(uri.scheme, null, uri.host, uri.port, uri.path, null, null).toASCIIString()
+    }.getOrDefault("<input>")
+
+    fun failureDetail(lines: Iterable<String>, returnCode: String): String {
+        val clean = lines.flatMap { it.lineSequence().toList() }.map { raw ->
+            raw.replace(URL) { describeInput(it.value) }
+                .replace(SECRET_HEADER, "$1: <redacted>")
+                .replace(CONTEXT_PREFIX, "")
+                .trim()
+        }.filter(String::isNotEmpty).distinct().takeLast(8)
+        return clean.joinToString(" | ").takeLast(1600).ifEmpty { "rc=$returnCode" }
+    }
+
+    private val URL = Regex("https?://[^\\s\\\"'<>]+")
+    private val SECRET_HEADER = Regex("(?im)\\b(authorization|cookie|set-cookie):[^\\r\\n]*")
+    private val CONTEXT_PREFIX = Regex("\\[[^\\]]* @ 0x[0-9a-fA-F]+\\]\\s*")
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/download/DownloadFfmpegRuntime.kt b/app/src/main/java/eu/kanade/tachiyomi/data/download/DownloadFfmpegRuntime.kt
