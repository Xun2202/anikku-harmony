@@ -0,0 +1,30 @@
+package eu.kanade.tachiyomi.data.download
+
+import com.arthenica.ffmpegkit.FFmpegKit
+import com.arthenica.ffmpegkit.FFmpegKitConfig
+import logcat.LogPriority
+import tachiyomi.core.common.util.system.logcat
+
+/** Query the bundled native build once; its supported options can differ from mpv's FFmpeg. */
+internal object DownloadFfmpegRuntime {
+    private val capabilities by lazy {
+        fun help(topic: String): String = runCatching {
+            FFmpegKit.executeWithArguments(arrayOf("-hide_banner", "-loglevel", "info", "-h", topic))
+                .getAllLogsAsString(250)
+        }.getOrDefault("")
+        val hls = help("demuxer=hls")
+        val http = help("protocol=http")
+        logcat(LogPriority.INFO) {
+            "Download FFmpeg ${FFmpegKitConfig.getFFmpegVersion()}: " +
+                "proxyExtensionOption=${hls.contains("-extension_picky") || hls.contains("-allowed_segment_extensions")}, " +
+                "segmentRetry=${hls.contains("-seg_max_retry")}, boundedReconnect=${http.contains("-reconnect_max_retries")}"
+        }
+        hls to http
+    }
+
+    fun inputOptions(url: String): List<String> {
+        if (!url.startsWith("http://", true) && !url.startsWith("https://", true)) return emptyList()
+        val (hls, http) = capabilities
+        return DownloadFfmpegPolicy.inputOptions(url, hls, http)
+    }
+}
