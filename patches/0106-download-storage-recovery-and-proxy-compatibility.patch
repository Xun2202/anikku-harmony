+package eu.kanade.tachiyomi.data.download
+
+import com.hippo.unifile.UniFile
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+
+/** Recovery is confined to this episode's known video names; ambiguous files stay on disk. */
+internal object EpisodeDownloadStorage {
+    private const val NO_MEDIA = ".nomedia"
+
+    private fun entries(directory: UniFile): List<UniFile> = directory.listFiles()?.toList()
+        ?: throw IOException("Cannot list download directory; files were preserved, please retry")
+
+    private fun isVideoName(name: String?, filename: String): Boolean {
+        if (name == null) return false
+        val escaped = Regex.escape(filename)
+        return Regex("""^$escaped(?: \(\d+\))?\.mkv(?: \(\d+\))?(?:\.anikku)?$""").matches(name)
+    }
+
+    private fun videos(directory: UniFile, filename: String): List<UniFile> {
+        val files = entries(directory)
+        if (files.any { it.name != NO_MEDIA && it.name != "$filename.tmp" && (!isVideoName(it.name, filename) || it.isDirectory) }) {
+            throw IOException("Unrecognized download files were preserved; inspect the directory before retrying")
+        }
+        return files.filter { isVideoName(it.name, filename) }.sortedBy {
+            if (it.name == "$filename.mkv" || it.name == "$filename.mkv.anikku") 0 else 1
+        }
+    }
+
+    private fun deleteRequired(file: UniFile) {
+        if (!file.delete()) throw IOException("Cannot remove temporary download file ${file.name}; other files were preserved, please retry")
+    }
+
+    /**
+     * Old duplicate files are reusable only when they are byte-identical, or a marked muxed cache
+     * proves the completed copy. A copy marker without such evidence never proves completion.
+     */
+    fun recover(directory: UniFile, filename: String, muxedCache: File? = null): UniFile? {
+        val files = videos(directory, filename)
+        val marker = entries(directory).firstOrNull { it.name == "$filename.tmp" }
+        if (files.isEmpty()) return null
+        val cache = muxedCache?.takeIf { it.isFile && it.length() > 0L }
+        if (marker != null && cache == null) {
+            if (files.size == 1) return null // redownload into private cache before replacing this partial copy
+            throw IOException("Duplicate downloads still have a copy marker; files were preserved for recovery")
+        }
+        val complete = if (cache != null) {
+            files.firstOrNull { sameContents(it, cache) }
+        } else {
+            files.firstOrNull { it.length() > 0L }
+        }
+        if (complete == null) {
+            if (files.all { it.length() == 0L } || (marker != null && cache != null && files.all { it.length() < cache.length() })) {
+                return null
+            }
+            throw IOException("Existing download does not match the completed cache; files were preserved for recovery")
+        }
+        val duplicates = files.filter { it !== complete }
+        // Validate the entire plan before deleting anything. An interrupted marked copy smaller
+        // than the authoritative cache is disposable; otherwise require exact bytes, not size alone.
+        if (duplicates.any {
+                !sameContents(complete, it) && !(marker != null && cache != null && it.length() in 0L until cache.length())
+            }
+        ) {
+            throw IOException("Download copies have different contents; all files were preserved for recovery")
+        }
+        duplicates.forEach(::deleteRequired)
+        marker?.let(::deleteRequired)
+        return complete
+    }
+
+    fun copy(cache: File, directory: UniFile, filename: String, hideFromGallery: Boolean): UniFile {
+        if (!cache.isFile || cache.length() <= 0L) throw IOException("Completed video cache is empty; refusing to copy it")
+        recover(directory, filename, cache)?.let { return it }
+        // Only zero-byte or marked partial files can reach here. A valid cache is already safe
+        // in private storage; failed deletion stops before createFile can manufacture a '(1)'.
+        val old = videos(directory, filename)
+        val marker = entries(directory).firstOrNull { it.name == "$filename.tmp" }
+        if (old.any { it.length() > 0L && marker == null }) {
+            throw IOException("Existing download cannot be safely replaced; files were preserved for recovery")
+        }
+        old.forEach(::deleteRequired)
+        val copyMarker = marker ?: directory.createFile("$filename.tmp")
+            ?: throw IOException("Cannot create video copy marker")
+        val finalName = "$filename.mkv" + if (hideFromGallery) ".anikku" else ""
+        val target = directory.createFile(finalName) ?: throw IOException("Cannot create video download file")
+        try {
+            if (target.name != finalName) throw IOException("Storage provider created a different filename; refusing to create duplicate downloads")
+            cache.inputStream().use { input -> target.openOutputStream().use { output -> input.copyTo(output) } }
+            if (target.length() <= 0L || target.length() != cache.length()) {
+                throw IOException("Copied video length was not verified; completed cache was preserved for retry")
+            }
+        } catch (failure: Exception) {
+            // Preserve the marker if deleting the failed target is refused. Recovery must never
+            // turn that single partial video into a completed episode.
+            try {
+                deleteRequired(target)
+            } catch (cleanup: Exception) {
+                failure.addSuppressed(cleanup)
+            }
+            throw failure
+        }
+        // If removing the marker fails, keep the verified target and muxed cache. The next attempt
+        // verifies and reuses that target, rather than creating another full copy.
+        deleteRequired(copyMarker)
+        return target
+    }
+
+    fun isComplete(directory: UniFile, filename: String, ready: Boolean, error: String?): Boolean {
+        if (!ready || error != null) return false
+        return try {
+            val files = videos(directory, filename)
+            files.size == 1 && files.single().length() > 0L && entries(directory).none { it.name == "$filename.tmp" }
+        } catch (_: IOException) {
+            false
+        }
+    }
+
+    fun sameContents(first: UniFile, second: UniFile): Boolean =
+        first.length() > 0L && first.length() == second.length() &&
+            first.openInputStream().use { a -> second.openInputStream().use { b -> streamsEqual(a, b) } }
+
+    private fun sameContents(first: UniFile, second: File): Boolean =
+        first.length() > 0L && first.length() == second.length() &&
+            first.openInputStream().use { a -> second.inputStream().use { b -> streamsEqual(a, b) } }
+
+    private fun streamsEqual(first: InputStream, second: InputStream): Boolean {
+        val a = ByteArray(DEFAULT_BUFFER_SIZE)
+        val b = ByteArray(DEFAULT_BUFFER_SIZE)
+        fun readChunk(input: InputStream, buffer: ByteArray): Int {
+            var count = 0
+            while (count < buffer.size) {
+                val read = input.read(buffer, count, buffer.size - count)
+                if (read < 0) break
+                if (read == 0) throw IOException("Download comparison could not read data; please retry")
+                count += read
+            }
+            return count
+        }
+        while (true) {
+            val count = readChunk(first, a)
+            if (count != readChunk(second, b)) return false
+            if (count == 0) return true
+            for (index in 0 until count) if (a[index] != b[index]) return false
+        }
+    }
+}
