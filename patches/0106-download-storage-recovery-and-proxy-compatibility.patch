+        every { source.listFiles() } returns arrayOf(child)
+        every { child.name } returns "Episode.mkv.anikku"
+        every { child.isDirectory } returns false
+        every { child.length() } returns 10L
+        every { target.findFile("Episode.mkv.anikku") } returns existing
+        every { existing.isDirectory } returns false
+        every { existing.length() } returns 5L
+        every { existing.delete() } returns false
+        every { source.filePath } returns "/source"
+        assertThrows(IOException::class.java) { source.renameToOrCopy("episode") }
+        io.mockk.verify(exactly = 0) { target.createFile(any()) }
+        io.mockk.verify(exactly = 0) { source.delete() }
+    }
+
+    @Test
+    fun `shared copy cannot delete a positive source when target metadata still reports zero`() {
+        val parent = mockk<UniFile>()
+        val source = mockk<UniFile>()
+        val target = mockk<UniFile>()
+        every { source.renameTo("video.mkv") } returns false
+        every { source.parentFile } returns parent
+        every { source.isDirectory } returns false
+        every { parent.findFile("video.mkv") } returns null
+        every { parent.createFile("video.mkv") } returns target
+        every { source.openInputStream() } returns ByteArrayInputStream("video".toByteArray())
+        every { target.openOutputStream() } returns ByteArrayOutputStream()
+        every { source.length() } returns 5L
+        every { target.length() } returns 0L
+        every { source.filePath } returns "/source"
+        every { target.filePath } returns "/target"
+        every { target.delete() } returns true
+        assertThrows(IOException::class.java) { source.renameToOrCopy("video.mkv") }
+        io.mockk.verify(exactly = 0) { source.delete() }
+    }
+
+    @Test
+    fun `cancel restart chains wait for structured blocking writes and stale owners cannot stop the new run`() = runBlocking {
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        val sessions = DownloadJobSession(scope)
+        val firstStarted = CountDownLatch(1)
+        val releaseFirst = CountDownLatch(1)
+        val thirdStarted = CountDownLatch(1)
+        val secondRan = AtomicBoolean(false)
+        val staleStopped = AtomicBoolean(false)
+        val active = AtomicInteger()
+        val maximum = AtomicInteger()
+        try {
+            sessions.start { owner ->
+                launch(Dispatchers.IO) {
+                    maximum.accumulateAndGet(active.incrementAndGet()) { a, b -> maxOf(a, b) }
+                    firstStarted.countDown()
+                    try {
+                        check(releaseFirst.await(5, TimeUnit.SECONDS))
+                    } finally {
+                        sessions.ifCurrent(owner) { staleStopped.set(true) }
+                        active.decrementAndGet()
+                    }
+                }
+            }
+            assertTrue(firstStarted.await(2, TimeUnit.SECONDS))
+            sessions.cancel()
+            sessions.start { secondRan.set(true) }
+            sessions.cancel() // cancelling the waiting restart must not break its predecessor chain
+            sessions.start {
+                maximum.accumulateAndGet(active.incrementAndGet()) { a, b -> maxOf(a, b) }
+                thirdStarted.countDown()
+                active.decrementAndGet()
+            }
+            assertFalse(thirdStarted.await(100, TimeUnit.MILLISECONDS))
+            releaseFirst.countDown()
+            withTimeout(5_000) { sessions.job!!.join() }
+            assertFalse(secondRan.get())
+            assertEquals(0L, thirdStarted.count)
+            assertFalse(staleStopped.get())
+            assertEquals(1, maximum.get())
+        } finally {
+            releaseFirst.countDown()
+            scope.cancel()
+        }
+    }
+
+    private fun withCache(block: (File) -> Unit) {
+        val cache = File.createTempFile("episode-recovery-", ".mkv")
+        try {
+            cache.writeBytes("a verified complete video".toByteArray())
+            block(cache)
+        } finally {
+            cache.delete()
+        }
+    }
+
+    private class FakeDirectory {
+        val files = linkedMapOf<String, Entry>()
+        val created = mutableListOf<String>()
+        var createdVideoReportsZero = false
+        val file = mockk<UniFile>()
+
+        init {
+            every { file.listFiles() } answers { files.values.map { it.file }.toTypedArray() }
+            every { file.createFile(any()) } answers {
+                val name = firstArg<String>()
+                created += name
+                check(name !in files) { "Unexpected duplicate creation: $name" }
+                add(name, byteArrayOf()).also { if (name.endsWith(".anikku")) it.reportZero = createdVideoReportsZero }.file
+            }
+        }
+
+        fun add(name: String, bytes: ByteArray, deleteAllowed: Boolean = true): Entry =
+            Entry(name, bytes, deleteAllowed).also { files[name] = it }
+
+        inner class Entry(val name: String, var bytes: ByteArray, var deleteAllowed: Boolean) {
+            var reportZero = false
+            val file = mockk<UniFile>()
+
+            init {
+                every { file.name } returns name
+                every { file.isDirectory } returns false
+                every { file.length() } answers { if (reportZero) 0L else bytes.size.toLong() }
+                every { file.openInputStream() } answers { ByteArrayInputStream(bytes) }
+                every { file.openOutputStream() } answers {
+                    object : ByteArrayOutputStream() {
+                        override fun close() {
+                            bytes = toByteArray()
+                        }
+                    }
+                }
+                every { file.delete() } answers {
+                    if (deleteAllowed) {
+                        files.remove(name)
+                        true
+                    } else {
+                        false
+                    }
+                }
+            }
+        }
+    }
+}
