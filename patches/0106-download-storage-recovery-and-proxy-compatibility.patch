@@ -0,0 +1,45 @@
+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.job
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** Keep cancelled owners until all their blocking writes and structured children have stopped. */
+internal class DownloadJobSession(private val scope: CoroutineScope) {
+    private val lock = Any()
+
+    @Volatile
+    var job: Job? = null
+        private set
+
+    fun start(block: suspend CoroutineScope.(Job) -> Unit): Boolean = synchronized(lock) {
+        if (job?.isActive == true) return@synchronized false
+        val previous = job
+        val installed = CompletableDeferred<Unit>()
+        // Enter the non-cancellable predecessor wait before start() returns. A dispatcher-queued
+        // coroutine cancelled before its first instruction would otherwise break the wait chain.
+        val next = scope.launch(start = CoroutineStart.UNDISPATCHED) {
+            withContext(NonCancellable) {
+                installed.await()
+                previous?.join()
+            }
+            ensureActive()
+            block(coroutineContext.job)
+        }
+        job = next
+        installed.complete(Unit)
+        true
+    }
+
+    fun cancel() = synchronized(lock) { job?.cancel() }
+
+    fun ifCurrent(owner: Job, action: () -> Unit) = synchronized(lock) {
+        if (job === owner && owner.isActive) action()
+    }
+}
