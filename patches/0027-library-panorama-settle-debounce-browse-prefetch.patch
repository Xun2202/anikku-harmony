+
+/**
+ * Settled once the grid has not scrolled for [SETTLE_DELAY_MILLIS]. Dragging the fast-scroll thumb
+ * is a run of short scrollToItem calls with isScrollInProgress false in between, and a fling that
+ * has just stopped is often followed by another; a shape applied in those gaps reads as jitter.
+ */
+@Composable
+fun rememberPanoramaGridSettled(isScrollInProgress: () -> Boolean): () -> Boolean {
+    val settled = remember { mutableStateOf(true) }
+    val scrolling by rememberUpdatedState(isScrollInProgress)
+    LaunchedEffect(Unit) {
+        snapshotFlow { scrolling() }.collectLatest { inProgress ->
+            if (inProgress) {
+                settled.value = false
+            } else {
+                delay(SETTLE_DELAY_MILLIS)
+                settled.value = true
+            }
+        }
+    }
+    return remember { { settled.value } }
+}
+
+/**
+ * Learns the shape of covers that are loaded into the list but not on screen yet, so their cells
+ * are laid out with the final shape when they scroll in. Only a small subsampled image is decoded
+ * and nothing goes to the memory cache; the download lands in the disk cache the cell reads.
+ */
+@Composable
+fun PrefetchPanoramaCoverShapes(itemCount: Int, mangaAt: (Int) -> Manga?) {
+    val context = LocalContext.current
+    val requests = remember { HashMap<Long, Disposable>() }
+    val currentMangaAt by rememberUpdatedState(mangaAt)
+    LaunchedEffect(itemCount) {
+        val loader = context.imageLoader
+        for (index in 0 until itemCount) {
+            val manga = currentMangaAt(index) ?: continue
+            if (manga.thumbnailUrl.isNullOrEmpty()) continue
+            if (manga.id in requests || PanoramaCoverShapes.get(manga.id) != null) continue
+            val mangaId = manga.id
+            requests[mangaId] = loader.enqueue(
+                ImageRequest.Builder(context)
+                    .data(manga.asMangaCover())
+                    .size(PREFETCH_SIZE_PX)
+                    .precision(Precision.INEXACT)
+                    .memoryCachePolicy(CachePolicy.DISABLED)
+                    .listener(
+                        onSuccess = { _, result ->
+                            val image = result.image
+                            if (image.width > 0) {
+                                PanoramaCoverShapes.put(mangaId, image.height.toFloat() / image.width)
+                            }
+                        },
+                    )
+                    .build(),
+            )
+        }
+    }
+    DisposableEffect(Unit) {
+        onDispose {
+            requests.values.forEach { it.dispose() }
+            requests.clear()
+        }
+    }
+}
+
+private const val SETTLE_DELAY_MILLIS = 300L
+private const val PREFETCH_SIZE_PX = 128
 // Harmony <--
