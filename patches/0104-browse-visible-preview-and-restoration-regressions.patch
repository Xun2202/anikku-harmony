+    @Test
+    fun `an unavailable external activity returns from loading instead of stranding detail`() = runComposeUiTest {
+        lateinit var owner: TestLifecycleOwner
+        var continues = 0
+        var detailX = Float.NaN
+        runOnIdle {
+            owner = TestLifecycleOwner()
+            owner.registry.currentState = Lifecycle.State.RESUMED
+        }
+        setContent {
+            DetailContinuePager(
+                enabled = true,
+                onContinue = {
+                    continues++
+                    true
+                },
+                lifecycleOwner = owner,
+                modifier = Modifier.requiredSize(320.dp, 500.dp).testTag("pager"),
+            ) { Box(Modifier.fillMaxSize().onGloballyPositioned { detailX = it.positionInRoot().x }) }
+        }
+        var initialX = 0f
+        runOnIdle { initialX = detailX }
+        onNodeWithTag("pager").performTouchInput {
+            swipe(start = Offset(250f, 250f), end = Offset(45f, 250f), durationMillis = 250)
+        }
+        waitUntil { continues == 1 }
+        mainClock.advanceTimeBy(1100)
+        waitForIdle()
+        runOnIdle {
+            assertEquals(1, continues)
+            assertEquals(initialX, detailX, 1f)
+        }
+    }
+
     private class TestLifecycleOwner : LifecycleOwner {
         val registry = LifecycleRegistry(this)
         override val lifecycle: Lifecycle get() = registry
