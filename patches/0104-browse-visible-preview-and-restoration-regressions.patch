@@ -58,6 +59,9 @@ fun DetailContinuePager(
     BoxWithConstraints(modifier.fillMaxSize().clipToBounds()) {
         // Half-drags are transient: folding and process restoration must not reopen the reader.
         val pager = remember(maxWidth) { PagerState { 2 } }
+        val previewVisible by remember(pager) {
+            derivedStateOf { pager.currentPage > 0 || pager.currentPageOffsetFraction > 0f }
+        }
         val motion = remember(pager) { DetailContinueMotion() }
         val scope = rememberCoroutineScope()
 
@@ -192,7 +196,12 @@ fun DetailContinuePager(
                 }
             },
         ) { page ->
-            if (page == 0) content() else previewContent()
+            if (page == 0) {
+                content()
+            } else if (previewVisible) {
+                // Keep the detail alive for return, without an offscreen infinite spinner.
+                previewContent()
+            }
         }
     }
 }
