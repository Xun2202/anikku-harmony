+import tachiyomi.i18n.MR
+import tachiyomi.presentation.core.i18n.stringResource
+import tachiyomi.presentation.core.util.collectAsState
+import uy.kohesive.injekt.Injekt
+import uy.kohesive.injekt.api.get
+import kotlin.math.roundToInt
+
+internal enum class TimelineDisplayMode { Compact, Panorama, List }
+
+internal class TimelineDisplay(
+    val mode: TimelineDisplayMode,
+    val columns: Int,
+    val modePreference: Preference<Int>,
+    val columnsPreference: Preference<Int>,
+)
+
+@Composable
+internal fun rememberTimelineDisplay(screen: String): TimelineDisplay {
+    val context = LocalContext.current
+    val preferences = remember(context) { Injekt.get<UiPreferences>() }
+    val modePreference = remember(preferences, screen) { preferences.timelineDisplayMode(screen) }
+    val columnsPreference = remember(preferences, screen) { preferences.timelineColumns(screen) }
+    val mode by modePreference.collectAsState()
+    val columns by columnsPreference.collectAsState()
+    return TimelineDisplay(TimelineDisplayMode.entries.getOrElse(mode) { TimelineDisplayMode.Panorama }, columns.coerceIn(0, 6), modePreference, columnsPreference)
+}
+
+@Composable
+internal fun TimelineDisplayAction(display: TimelineDisplay) {
+    var expanded by remember { mutableStateOf(false) }
+    IconButton(onClick = { expanded = true }) {
+        Icon(Icons.Outlined.GridView, stringResource(MR.strings.action_display_mode))
+    }
+    if (expanded) {
+        AlertDialog(
+            onDismissRequest = { expanded = false },
+            title = { Text(stringResource(MR.strings.action_display_mode)) },
+            text = {
+                Column {
+                    val names = listOf(MR.strings.action_display_grid, MR.strings.action_display_grid_panorama, MR.strings.action_display_list)
+                    TimelineDisplayMode.entries.forEachIndexed { index, mode ->
+                        Row(
+                            Modifier.fillMaxWidth().selectable(
+                                selected = display.mode == mode,
+                                role = Role.RadioButton,
+                                onClick = { display.modePreference.set(index) },
+                            ).padding(vertical = 8.dp),
+                            verticalAlignment = Alignment.CenterVertically,
+                        ) {
+                            RadioButton(selected = display.mode == mode, onClick = null)
+                            Text(stringResource(names[index]), Modifier.padding(start = 8.dp))
+                        }
+                    }
+                    if (display.mode != TimelineDisplayMode.List) {
+                        val value = when (display.columns) {
+                            0 -> stringResource(MR.strings.label_auto)
+                            else -> display.columns.toString()
+                        }
+                        Text(stringResource(MR.strings.pref_library_columns) + ": " + value)
+                        Slider(
+                            value = if (display.columns == 0) 1f else display.columns.toFloat(),
+                            onValueChange = { value ->
+                                val count = value.roundToInt()
+                                display.columnsPreference.set(if (count == 1) 0 else count)
+                            },
+                            valueRange = 1f..6f,
+                            steps = 4,
+                        )
+                    }
+                }
+            },
+            confirmButton = { TextButton(onClick = { expanded = false }) { Text(stringResource(MR.strings.action_close)) } },
+        )
+    }
+}
