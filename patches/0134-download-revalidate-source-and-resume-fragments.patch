+package eu.kanade.tachiyomi.data.download
+
+import eu.kanade.tachiyomi.network.interceptor.SourceRevalidationInterceptor
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import okhttp3.Cache
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+import java.util.concurrent.ConcurrentLinkedQueue
+import java.util.concurrent.atomic.AtomicInteger
+
+class NavigationChromeDownloadSourceRevalidationTest {
+    @TempDir
+    lateinit var directory: File
+
+    @Test
+    fun `resumed episode and nested master playlist are both revalidated while ordinary requests stay cached`() = runBlocking {
+        NavigationChromeDownloadQueueConcurrencyTest.LoopbackHttpServer("public, max-age=3600").use { server ->
+            val version = AtomicInteger(1)
+            val origin = ConcurrentLinkedQueue<String>()
+            server.handler = { path ->
+                origin.add(path)
+                when (path) {
+                    "/episode" -> "/master".toByteArray()
+                    else -> version.get().toString().toByteArray()
+                }
+            }
+            server.start()
+            Cache(directory, 1024 * 1024).use { cache ->
+                val client = OkHttpClient.Builder().cache(cache).addInterceptor(SourceRevalidationInterceptor).build()
+                fun get(path: String): String {
+                    val request = Request.Builder().url("http://127.0.0.1:${server.port}$path").build()
+                    return client.newCall(request).execute().use { it.body.string() }
+                }
+                fun lookup(): String = get(get("/episode"))
+
+                assertEquals("1", lookup())
+                assertEquals("1", get("/unrelated"))
+                version.set(2)
+                assertEquals("1", lookup())
+                origin.clear()
+                assertEquals("2", SourceRevalidationInterceptor.revalidate { withContext(Dispatchers.IO) { lookup() } })
+                assertEquals(listOf("/episode", "/master"), origin.toList())
+                origin.clear()
+                assertEquals("2", lookup())
+                assertEquals("1", get("/unrelated"))
+                assertTrue(origin.isEmpty())
+            }
+        }
+    }
+}
