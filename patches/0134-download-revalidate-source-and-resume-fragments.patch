+package eu.kanade.tachiyomi.network.interceptor
+
+import kotlinx.coroutines.asContextElement
+import kotlinx.coroutines.withContext
+import okhttp3.Interceptor
+import okhttp3.Response
+
+/** Revalidate the synchronous episode and playlist GETs made by a source during this lookup. */
+object SourceRevalidationInterceptor : Interceptor {
+    private val active = ThreadLocal<Boolean>()
+
+    suspend fun <T> revalidate(lookup: suspend () -> T): T = withContext(active.asContextElement(true)) { lookup() }
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        if (active.get() != true || request.method != "GET" || request.cacheControl.onlyIfCached || request.cacheControl.noCache) {
+            return chain.proceed(request)
+        }
+        return chain.proceed(request.newBuilder().addHeader("Cache-Control", "no-cache").build())
+    }
+}
