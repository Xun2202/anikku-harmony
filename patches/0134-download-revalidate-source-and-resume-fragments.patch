+class NavigationChromeDownloadHlsChangedPlanTest {
+    @TempDir
+    lateinit var cache: File
+
+    @Test
+    fun `a renewed 1837-fragment playlist fills four holes and refetches a changed neighbour`() = runTest {
+        val holes = setOf(83, 86, 244, 314)
+        val changed = holes + 84
+        val requested = ConcurrentLinkedQueue<Int>()
+        var revision = 0
+        suspend fun fetch(size: Int, header: String = "same"): DownloadHlsSegments.Prepared {
+            val manifest = buildString {
+                appendLine("#EXTM3U")
+                for (number in 1..size) {
+                    val version = if (number in changed) revision else 0
+                    val resource = "https://fixture.invalid/$number/$version"
+                    val url = "http://localhost:1234/segment".toHttpUrl().newBuilder().addQueryParameter("url", resource).build()
+                    appendLine("#EXTINF:4,")
+                    appendLine(url)
+                }
+                appendLine("#EXT-X-ENDLIST")
+            }
+            val client = OkHttpClient.Builder().addInterceptor { chain ->
+                val req = chain.request()
+                val response = Response.Builder().request(req).protocol(Protocol.HTTP_1_1).message("fixture")
+                if (req.url.encodedPath == "/m3u8") {
+                    response.code(200).body(manifest.toResponseBody()).build()
+                } else {
+                    val parts = checkNotNull(req.url.queryParameter("url")).toHttpUrl().pathSegments
+                    val number = parts.first().toInt()
+                    requested.add(number)
+                    val denied = revision == 0 && number in holes
+                    response.code(if (denied) 403 else 200).body(fragment(number, parts.last().toInt()).toResponseBody()).build()
+                }
+            }.build()
+            return checkNotNull(DownloadHlsSegments.prepare(client, "MissAV", "http://localhost:1234/m3u8", headersOf("X-Fixture", header), cache) {})
+        }
+
+        val size = 1837
+        val denied = runCatching { fetch(size) }.exceptionOrNull() as DownloadHlsSegments.Failure
+        assertEquals(4, denied.missingSegments)
+        val old = cache.listFiles()!!.single()
+        assertFalse(File(old, "input.m3u8").exists())
+        assertEquals(1833, old.listFiles()!!.count { it.extension == "ts" })
+
+        // Before this release the exact-plan directory had no per-fragment identity index.
+        assertTrue(File(old, "segments-v1.sha256").delete())
+        requested.clear()
+        val stillDenied = runCatching { fetch(size) }.exceptionOrNull() as DownloadHlsSegments.Failure
+        assertEquals(4, stillDenied.missingSegments)
+        assertEquals(holes.sorted(), requested.sorted())
+        assertFalse(File(old, "input.m3u8").exists())
+
+        revision++
+        requested.clear()
+        val complete = fetch(size)
+        assertEquals(changed.sorted(), requested.sorted())
+        assertTrue(Files.isSameFile(File(old, "00000.ts").toPath(), File(complete.directory, "00000.ts").toPath()))
+        val output = File(cache, "result.ts")
+        DownloadHlsSegments.writeTransportStream(complete, output) {}
+        output.inputStream().buffered().use { input ->
+            val actual = ByteArray(188 * 4)
+            val data = java.io.DataInputStream(input)
+            for (number in 1..size) {
+                data.readFully(actual)
+                assertArrayEquals(fragment(number, if (number in changed) 1 else 0), actual)
+            }
+            assertEquals(-1, data.read())
+        }
+
+        // Matching URL and position alone do not establish identity under different source headers.
+        revision++
+        requested.clear()
+        fetch(size, header = "different")
+        assertEquals((1..size).toList(), requested.sorted())
+    }
+
+    private fun fragment(number: Int, revision: Int): ByteArray =
+        ByteArray(188 * 4) { if (it % 188 == 0) 0x47 else (number + revision).toByte() }
+}
