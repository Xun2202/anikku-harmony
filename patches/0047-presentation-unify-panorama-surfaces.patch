@@ -0,0 +1,52 @@
+package eu.kanade.presentation.library.components
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.presentation.core.components.PanoramaSpan
+import tachiyomi.presentation.core.components.panoramaShapedLaneCount
+
+class PanoramaLayoutPolicyTest {
+    @Test
+    fun `cold recommendation covers use the same two single lanes as a learned wide shelf`() {
+        for (mode in listOf(PanoramaShapeMode.Unknown, PanoramaShapeMode.Wide)) {
+            val columns = panoramaShapedLaneCount(459, 552, 16, 4, panoramaShapeRatio(mode), 1f, true)
+            assertEquals(2, columns)
+            assertEquals(PanoramaSpan.SingleLane, panoramaCoverSpan(wide = true, mode))
+        }
+        // In particular an unlearned wide cover must not occupy two of three book-sized lanes.
+        assertEquals(PanoramaSpan.SingleLane, panoramaCoverSpan(true, PanoramaShapeMode.Unknown))
+    }
+
+    @Test
+    fun `paging more unknown covers cannot indefinitely delay a reliable shape sample`() {
+        for (total in listOf(20, 100, 1000)) {
+            assertEquals(PanoramaShapeMode.Wide, nextPanoramaShapeMode(PanoramaShapeMode.Unknown, total, 8, 8))
+            assertEquals(PanoramaShapeMode.Tall, nextPanoramaShapeMode(PanoramaShapeMode.Unknown, total, 8, 0))
+        }
+        assertEquals(PanoramaShapeMode.Unknown, nextPanoramaShapeMode(PanoramaShapeMode.Unknown, 1000, 7, 7))
+        assertEquals(PanoramaShapeMode.Wide, nextPanoramaShapeMode(PanoramaShapeMode.Unknown, 5, 3, 3))
+    }
+
+    @Test
+    fun `mixed tall lists keep wide spans and shape hysteresis`() {
+        assertEquals(PanoramaSpan.TwoLanesWhenRoomy, panoramaCoverSpan(true, PanoramaShapeMode.Tall))
+        assertEquals(PanoramaSpan.SingleLane, panoramaCoverSpan(false, PanoramaShapeMode.Tall))
+        assertEquals(PanoramaShapeMode.Wide, nextPanoramaShapeMode(PanoramaShapeMode.Wide, 10, 10, 5))
+        assertEquals(PanoramaShapeMode.Tall, nextPanoramaShapeMode(PanoramaShapeMode.Wide, 10, 10, 4))
+    }
+
+    @Test
+    fun `prefetch follows scrolling and stays bounded through refresh and empty lists`() {
+        assertTrue(panoramaPrefetchRange(0, 200).isEmpty())
+        assertEquals(0 until 5, panoramaPrefetchRange(5, 200))
+        assertEquals(0 until 48, panoramaPrefetchRange(1000, 0))
+        assertEquals(80 until 144, panoramaPrefetchRange(1000, 100))
+        for (index in listOf(-10, 0, 100, 999, 10000)) {
+            val range = panoramaPrefetchRange(1000, index)
+            assertTrue(range.first >= 0 && range.last < 1000)
+            assertTrue(range.count() <= 64)
+            assertTrue(index.coerceIn(0, 999) in range)
+        }
+    }
+}
