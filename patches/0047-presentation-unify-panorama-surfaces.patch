+import tachiyomi.presentation.core.util.plus
+
+/** One layout policy for library, source browsing, migration and related works. */
+@Composable
+internal fun HarmonyPanoramaGrid(
+    columns: GridCells,
+    contentPadding: PaddingValues,
+    shapeCount: Int,
+    shapeIdAt: (Int) -> Long?,
+    modifier: Modifier = Modifier,
+    shapeMangaAt: ((Int) -> Manga?)? = null,
+    content: PanoramaMasonryScope.(PanoramaShapeMode) -> Unit,
+) {
+    val state = rememberPanoramaMasonryState()
+    val shapeMode = rememberPanoramaShapeModeState(shapeCount, shapeIdAt)
+    val settled = rememberPanoramaGridSettled { state.isScrollInProgress }
+    if (shapeMangaAt != null) {
+        PrefetchPanoramaCoverShapes(
+            itemCount = shapeCount,
+            firstVisibleIndex = { state.firstVisibleItemIndex },
+            mangaAt = shapeMangaAt,
+        )
+    }
+    val mode = shapeMode.mode
+    CompositionLocalProvider(
+        LocalPanoramaGridSettled provides settled,
+        LocalPanoramaPlaceholderRatio provides if (mode == PanoramaShapeMode.Tall) 1.5f else WIDE_COVER_RATIO,
+    ) {
+        TrackPanoramaCoverShapes(shapeCount, shapeMode, shapeIdAt)
+        FastScrollPanoramaMasonry(
+            columns = columns.panoramaColumns(mode),
+            modifier = modifier,
+            state = state,
+            contentPadding = contentPadding + PaddingValues(8.dp),
+            topContentPadding = contentPadding.calculateTopPadding(),
+            bottomContentPadding = contentPadding.calculateBottomPadding(),
+            verticalSpacing = CommonMangaItemDefaults.GridVerticalSpacer,
+            horizontalSpacing = CommonMangaItemDefaults.GridHorizontalSpacer,
+        ) {
+            content(mode)
+        }
+    }
+}
