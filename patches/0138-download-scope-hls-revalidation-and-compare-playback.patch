+    @Test
+    fun `refresh preserves the sources cache contract and only watches a named original media denial`() = withCache { cache ->
+        val sourcePolicies = listOf(null, "private, max-age=15", "no-store", "no-cache", "only-if-cached")
+        for ((index, policy) in sourcePolicies.withIndex()) {
+            val origin = "https://example.test/media-$index"
+            val denied = mutableListOf<Triple<Int, Long, String>>()
+            val sourceHeaders = if (policy == null) headersOf() else headersOf("Cache-Control", policy)
+            val client = client { chain ->
+                val req = chain.request()
+                if (req.url.encodedPath == "/m3u8") {
+                    assertEquals(policy == "only-if-cached", req.cacheControl.onlyIfCached)
+                    assertEquals(policy != "only-if-cached", req.cacheControl.noCache)
+                    if (policy != null) assertTrue(req.header("Cache-Control")!!.contains(policy))
+                    response(chain, "#EXTM3U\n#EXTINF:4,\n/segment?url=$origin&key=https://example.test/key\n#EXT-X-ENDLIST\n".toByteArray())
+                } else {
+                    assertEquals(sourceHeaders.values("Cache-Control"), req.headers.values("Cache-Control"))
+                    response(chain, "Upstream 403 for $origin\n".toByteArray(), 403)
+                }
+            }
+            val failure = runCatching {
+                DownloadHlsSegments.prepare(
+                    client,
+                    "MissAV",
+                    "http://localhost:1234/m3u8?url=$index",
+                    sourceHeaders,
+                    File(cache, "$index"),
+                    forceNetwork = true,
+                    onOriginalDenied = { n, ms, url -> denied += Triple(n, ms, url.toString()) },
+                ) {}
+            }.exceptionOrNull() as DownloadHlsSegments.Failure
+            assertEquals(403, failure.httpStatus)
+            assertEquals(listOf(Triple(1, 0L, origin)), denied)
+        }
+    }
+
