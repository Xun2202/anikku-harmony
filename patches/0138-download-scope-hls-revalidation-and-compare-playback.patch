+package eu.kanade.tachiyomi.network.interceptor
+
+import okhttp3.HttpUrl
+import okhttp3.Interceptor
+import okhttp3.Response
+import okio.ByteString
+import okio.ByteString.Companion.encodeUtf8
+import java.util.concurrent.TimeUnit
+
+/** Passively compare a denied download with a later online playback request for the exact resource. */
+class HlsPlaybackComparison(private val nanoTime: () -> Long = System::nanoTime) : Interceptor {
+    data class Match(
+        val segment: Int,
+        val startMillis: Long,
+        val status: Int,
+        val networkStatus: Int?,
+        val cached: Boolean,
+        val redirected: Boolean,
+    )
+
+    private data class Track(val episode: Long, val height: Int)
+    private data class Gap(val digest: ByteString, val segment: Int, val startMillis: Long, val recorded: Long)
+    private class Player(val owner: Any, val track: Track, val report: (Match) -> Unit)
+
+    // Only digests of denied upstream media addresses are held in memory. Keep the first few visible gaps.
+    private val gaps = LinkedHashMap<Track, MutableList<Gap>>(4, 0.75f, true)
+
+    @Volatile private var player: Player? = null
+    private var activeDownloads = 0
+    private var generation = 0L
+
+    @Synchronized
+    fun remember(episode: Long, height: Int, segment: Int, startMillis: Long, url: HttpUrl) {
+        val now = nanoTime()
+        val group = gaps.getOrPut(Track(episode, height)) { mutableListOf() }
+        group.removeAll { now - it.recorded >= LIFETIME || it.segment == segment }
+        group += Gap(url.toString().encodeUtf8().sha256(), segment, startMillis, now)
+        group.sortBy { it.segment }
+        if (group.size > 8) group.removeAt(group.lastIndex)
+        if (gaps.size > 4) gaps.remove(gaps.keys.first())
+    }
+
+    @Synchronized
+    fun openPlayer(owner: Any, episode: Long, height: Int, report: (Match) -> Unit): Int {
+        val track = Track(episode, height)
+        player = Player(owner, track, report)
+        return gaps[track].orEmpty().count { nanoTime() - it.recorded < LIFETIME }
+    }
+
+    @Synchronized
+    fun closePlayer(owner: Any) {
+        if (player?.owner === owner) player = null
+    }
+
+    suspend fun <T> duringDownload(read: suspend () -> T): T {
+        synchronized(this) {
+            activeDownloads++
+            generation++
+        }
+        try {
+            return read()
+        } finally {
+            synchronized(this) { activeDownloads-- }
+        }
+    }
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        val session = player
+        if (session == null || request.method != "GET") return chain.proceed(request)
+        val candidate = synchronized(this) {
+            val group = gaps[session.track]
+            if (player !== session || activeDownloads != 0 || group.isNullOrEmpty()) return@synchronized null
+            val hash = request.url.toString().encodeUtf8().sha256()
+            group.firstOrNull { it.digest == hash && nanoTime() - it.recorded < LIFETIME }?.let { it to generation }
+        }
+        val response = chain.proceed(request)
+        if (candidate != null) {
+            val (gap, before) = candidate
+            val matched = synchronized(this) {
+                player === session && generation == before && gaps[session.track]?.remove(gap) == true
+            }
+            if (matched) {
+                val match = Match(
+                    gap.segment,
+                    gap.startMillis,
+                    response.code,
+                    networkStatus = response.networkResponse?.code,
+                    cached = response.cacheResponse != null,
+                    redirected = response.request.url != request.url,
+                )
+                session.report(match)
+            }
+        }
+        return response
+    }
+
+    companion object {
+        val shared = HlsPlaybackComparison()
+        private val LIFETIME = TimeUnit.MINUTES.toNanos(30)
+    }
+}
