+package eu.kanade.tachiyomi.data.download
+
+import eu.kanade.tachiyomi.network.interceptor.HlsPlaybackComparison
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.test.runTest
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.util.concurrent.TimeUnit
+
+class NavigationChromeDownloadHlsPlaybackComparisonTest {
+    @Test
+    fun `only independent playback of the same resource episode and quality reports once`() = runTest {
+        var now = 0L
+        val observer = HlsPlaybackComparison { now }
+        val owner = Any()
+        val original = "https://example.test/media.ts?revision=one".toHttpUrl()
+        val matches = mutableListOf<HlsPlaybackComparison.Match>()
+        var requests = 0
+        var status = 403
+        var beforeResponse: () -> Unit = {}
+        val client = OkHttpClient.Builder().addInterceptor(observer).addInterceptor { chain ->
+            requests++
+            beforeResponse()
+            Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).code(status).message("fixture").body(byteArrayOf(7).toResponseBody()).build()
+        }.build()
+        fun read(url: String = original.toString()) = client.newCall(Request.Builder().url(url).build()).execute().use {
+            assertEquals(status, it.code)
+            assertTrue(it.body.bytes().contentEquals(byteArrayOf(7)))
+        }
+        fun open(episode: Long = 5, height: Int = 1080) = observer.openPlayer(owner, episode, height, matches::add)
+        fun remember() = observer.remember(5, 1080, 3, 8000, original)
+
+        remember()
+        read()
+        open(6)
+        read()
+        open(height = 720)
+        read()
+        open()
+        read("https://example.test/media.ts?revision=two")
+        observer.duringDownload { read() }
+        beforeResponse = { runBlocking { observer.duringDownload { Unit } } }
+        read()
+        beforeResponse = { observer.closePlayer(owner) }
+        read()
+        beforeResponse = {}
+        open()
+        observer.closePlayer(Any())
+        assertTrue(matches.isEmpty())
+        read()
+        read()
+        assertEquals(listOf(403), matches.map { it.status })
+        remember()
+        status = 200
+        read()
+        assertEquals(listOf(403, 200), matches.map { it.status })
+        assertTrue(matches.all { it.segment == 3 && it.startMillis == 8000L })
+        remember()
+        now = TimeUnit.MINUTES.toNanos(31)
+        read()
+        assertEquals(2, matches.size)
+        assertEquals(11, requests)
+    }
+}
