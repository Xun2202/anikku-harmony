+class NavigationChromeDownloadHlsRepairTest {
+    @TempDir
+    lateinit var root: File
+
+    @Test
+    fun `missing windows may span multiple segments in either rendition but cannot consume a retained frame`() {
+        fun match(high: List<Int>, low: List<Int>, gaps: Set<Int>) = DownloadHlsRepairPlan.match(
+            DownloadHlsRepairPlan.boundaries(high.map { it.toBigDecimal() }),
+            DownloadHlsRepairPlan.boundaries(low.map { it.toBigDecimal() }),
+            gaps,
+        )?.map { (index, lower) -> (if (lower) "L" else "H") + index }
+        assertEquals(listOf("L0", "L1", "H1", "L4", "L5"), match(listOf(4, 4, 4), List(6) { 2 }, setOf(0, 2)))
+        assertEquals(listOf("H0", "H1", "L1"), match(List(4) { 2 }, listOf(4, 4), setOf(2, 3)))
+        assertNull(match(listOf(4, 4, 4), listOf(3, 4, 5), setOf(1)))
+        assertNull(match(listOf(4, 4), listOf(4, 5), setOf(0)))
+        assertNull(match(listOf(4, 4), listOf(4, 4), setOf(0, 1)))
+    }
+
+    @Test
+    fun `TS splice keeps payloads and advances counters for payload packets only`() = runTest {
+        fun packet(counter: Int, payload: Boolean = true) = ByteArray(188) { 7 }.apply {
+            this[0] = 0x47
+            this[1] = 1
+            this[2] = 0
+            this[3] = ((if (payload) 0x10 else 0x20) or counter).toByte()
+        }
+        val first = File(root, "original.ts").apply { writeBytes(packet(13) + packet(14) + packet(15)) }
+        val low = File(root, "lower.ts").apply { writeBytes(byteArrayOf(1, 2) + packet(4, false) + packet(5) + packet(5) + packet(6)) }
+        val last = File(root, "return.ts").apply { writeBytes(packet(2) + packet(3) + packet(4)) }
+        val playlist = File(root, "repaired.m3u8").apply {
+            writeText("#EXTM3U\noriginal.ts\n#EXT-X-DISCONTINUITY\nlower.ts\n#EXT-X-DISCONTINUITY\nreturn.ts\n")
+        }
+        val prepared = DownloadHlsSegments.Prepared(
+            playlist,
+            root,
+            first.length() + low.length() + last.length(),
+            6000,
+            3,
+            listOf(DownloadHlsSegments.SwitchSample(low, 2000, lower = true, entry = true)),
+        )
+        val output = File(root, "finished.ts")
+        DownloadHlsRepairTransport.write(prepared, output) {}
+        val expected = first.readBytes() + packet(15, false) + packet(0) + packet(0) + packet(1) + packet(2) + packet(3) + packet(4)
+        assertTrue(expected.contentEquals(output.readBytes()))
+        last.appendBytes(byteArrayOf(0))
+        assertTrue(runCatching { DownloadHlsRepairTransport.write(prepared, output) {} }.isFailure)
+    }
+
+    @Test
+    fun `an alternate needs compatible tracks keyframes and clocks at the splice`() = runTest {
+        val high = File(root, "original.ts")
+        val low = File(root, "lower.ts")
+        val points = listOf(
+            DownloadHlsSegments.SwitchSample(high, 0, lower = false, entry = true),
+            DownloadHlsSegments.SwitchSample(low, 2000, lower = true, entry = true),
+        )
+        suspend fun verify(lowStart: Double = 3.4, flags: String = "K", channels: Int = 2) = DownloadHlsRepairMedia.verify(points) { file ->
+            val start = if (file == high) 1.4 else lowStart
+            val height = if (file == high) 1080 else 720
+            val audioChannels = if (file == high) 2 else channels
+            val packet = if (file == high) "K" else flags
+            """{"streams":[{"codec_type":"video","codec_name":"h264","index":0,"id":"0x100","height":$height,"start_time":$start},
+                {"codec_type":"audio","codec_name":"aac","id":"0x101","sample_rate":"48000","channels":$audioChannels,"start_time":$start}],
+                "packets":[{"stream_index":0,"flags":"$packet"}]}"""
+        }
+        verify()
+        assertTrue(runCatching { verify(lowStart = 5.4) }.isFailure)
+        assertTrue(runCatching { verify(flags = "_") }.isFailure)
+        assertTrue(runCatching { verify(channels = 1) }.isFailure)
+    }
+
+    @Test
+    fun `only one successful plaintext response can repair a locally shortened copy`() = runTest {
+        val url = "https://example.test/ordinary.ts".toHttpUrl()
+        val ts = ByteArray(188 * 20) { i ->
+            when (i % 188) {
+                0 -> 0x47
+                1 -> 1
+                3 -> 0x10
+                else -> (i % 113).toByte()
+            }
+        }
+        var code = 200
+        val client = OkHttpClient.Builder().addInterceptor(HlsRepairResponseInterceptor).addInterceptor { chain ->
+            Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).message("fixture").code(code).body(ts.toResponseBody()).build()
+        }.build()
+        fun read() = client.newCall(Request.Builder().url(url).build()).execute().use { it.body.bytes() }
+        val raw = File(root, "observed.part")
+        val local = File(root, "from-proxy.ts")
+        HlsRepairResponseInterceptor.during(url, raw) { observed ->
+            read()
+            local.writeBytes(ByteArray(ts.size - 8) { -1 })
+            assertFalse(DownloadHlsRepairTransport.restoreIntactResponse(local, observed()))
+            local.writeBytes(ts.copyOfRange(0, 1024) + ts.copyOfRange(1032, ts.size))
+            assertTrue(DownloadHlsRepairTransport.restoreIntactResponse(local, observed()))
+            assertTrue(ts.contentEquals(local.readBytes()))
+        }
+        code = 403
+        HlsRepairResponseInterceptor.during(url, raw) { observed ->
+            read()
+            assertNull(observed())
+        }
+        code = 200
+        HlsRepairResponseInterceptor.during(url, raw) { observed ->
+            read()
+            read()
+            assertNull(observed())
+        }
+        assertFalse(raw.exists())
+    }
+
+    @Test
+    fun `manual alternate fills only holes survives a retry and never enters the original cache`() = runTest {
+        val requests = ConcurrentLinkedQueue<String>()
+        var denyLow = true
+        val client = OkHttpClient.Builder().addInterceptor { chain ->
+            val req = chain.request()
+            val response = Response.Builder().request(req).protocol(Protocol.HTTP_1_1).message("fixture")
+            if (req.url.encodedPath == "/m3u8") {
+                val track = req.url.queryParameter("track")
+                val lines = (0..5).joinToString("\n") { "#EXTINF:2,\n/segment?url=https://example.test/$track/$it" }
+                response.code(200).body("#EXTM3U\n$lines\n#EXT-X-ENDLIST\n".toResponseBody()).build()
+            } else {
+                val resource = req.url.queryParameter("url")!!.toHttpUrl().pathSegments.joinToString("/")
+                requests += resource
+                val low = resource.startsWith("low/")
+                if (low) assertEquals("donor", req.header("X-Track"))
+                val denied = resource in listOf("high/1", "high/4") || (denyLow && resource == "low/4")
+                val ts = ByteArray(188 * 4) {
+                    when (it % 188) {
+                        0 -> 0x47
+                        3 -> 0x10
+                        else -> if (low) 2 else 1
+                    }
+                }
+                response.code(if (denied) 403 else 200).body(ts.toResponseBody()).build()
+            }
+        }.build()
+        var lookups = 0
+        suspend fun prepare(optIn: Boolean) = DownloadHlsSegments.prepare(
+            client,
+            "MissAV",
+            "http://localhost:1234/m3u8?track=high",
+            headersOf(),
+            root,
+            repair = if (!optIn) {
+                null
+            } else {
+                {
+                    lookups++
+                    DownloadHlsSegments.RepairTrack(720, "http://localhost:1234/m3u8?track=low", headersOf("X-Track", "donor"))
+                }
+            },
+        ) {}
+        assertTrue(runCatching { prepare(true) }.isFailure)
+        assertEquals(0, lookups)
+        val original = runCatching { prepare(false) }.exceptionOrNull() as DownloadHlsSegments.Failure
+        assertEquals(2, original.missingSegments)
+        val directory = root.listFiles()!!.single()
+        requests.clear()
+        val error = runCatching { prepare(true) }.exceptionOrNull() as DownloadHlsSegments.Failure
+        assertEquals(720, error.repairHeight, error.message)
+        assertEquals(8000L, error.startMillis)
+        assertEquals(listOf("low/1", "low/4"), requests.sorted())
+        assertFalse(File(directory, "repaired.m3u8").exists())
+        val retried = runCatching {
+            DownloadHlsSegments.withAuthorizationRecovery(transfer = { throw error }, refresh = { throw AssertionError("Unexpected high refresh") })
+        }.exceptionOrNull()
+        assertEquals(error, retried)
+        requests.clear()
+        denyLow = false
+        val done = prepare(true)!!
+        assertEquals(listOf("low/4"), requests.toList())
+        assertEquals(4, done.input.readLines().count { it == "#EXT-X-DISCONTINUITY" })
+        val files = done.input.readLines().filter { !it.startsWith("#") }.map { File(directory, it) }
+        assertEquals(listOf(1, 2, 1, 1, 2, 1), files.map { it.readBytes()[1].toInt() })
+        assertFalse(File(directory, "00001.ts").exists())
+        assertFalse(File(directory, "00004.ts").exists())
+        assertFalse(File(directory, "input.m3u8").exists())
+        // A previously cached original with a truncated packet also needs a replacement. Opting out
+        // must request the genuine original again rather than treating damaged or lower bytes as original.
+        File(directory, "00002.ts").appendBytes(byteArrayOf(0))
+        requests.clear()
+        assertTrue(prepare(true) != null)
+        assertEquals(listOf("low/2"), requests.sorted())
+        requests.clear()
+        assertTrue(runCatching { prepare(false) }.isFailure)
+        assertEquals(listOf("high/1", "high/2", "high/4"), requests.sorted())
+        assertFalse(File(directory, "00002.ts.invalid").exists())
+    }
+}
