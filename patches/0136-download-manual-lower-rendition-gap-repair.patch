diff --git a/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/HlsRepairResponseInterceptor.kt b/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/HlsRepairResponseInterceptor.kt
new file mode 100644
index 0000000..b29ba29
--- /dev/null
+++ b/core/common/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/HlsRepairResponseInterceptor.kt
@@ -0,0 +1,109 @@
+package eu.kanade.tachiyomi.network.interceptor
+
+import okhttp3.HttpUrl
+import okhttp3.Interceptor
+import okhttp3.Response
+import okhttp3.ResponseBody
+import okio.Buffer
+import okio.ForwardingSource
+import okio.buffer
+import okio.sink
+import java.io.File
+import java.io.IOException
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+/** Observe the already successful response used by the local source proxy. Never make a network request. */
+object HlsRepairResponseInterceptor : Interceptor {
+    private const val MAX_BYTES = 16L * 1024 * 1024
+    private class Capture(val file: File) {
+        val responses = AtomicInteger()
+
+        @Volatile var complete = false
+    }
+
+    private val active = ConcurrentHashMap<HttpUrl, Capture>()
+
+    suspend fun <T> during(url: HttpUrl?, temporary: File, read: suspend (original: () -> File?) -> T): T {
+        if (url == null) return read { null }
+        val capture = Capture(temporary)
+        val existing = active.putIfAbsent(url, capture)
+        if (existing != null) {
+            existing.responses.incrementAndGet()
+            return read { null }
+        }
+        try {
+            return read { temporary.takeIf { capture.responses.get() == 1 && capture.complete } }
+        } finally {
+            active.remove(url, capture)
+            temporary.delete()
+        }
+    }
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        val capture = active[request.url]
+        val response = chain.proceed(request)
+        if (capture == null || capture.responses.incrementAndGet() != 1 || request.method != "GET" || response.code != 200) return response
+        val body = response.body
+        val declared = body.contentLength()
+        if (declared > MAX_BYTES || (declared >= 0 && declared % 188 != 0L)) return response
+        val head = try {
+            response.peekBody(377).bytes()
+        } catch (_: IOException) {
+            return response
+        }
+        if (head.size < 377 || listOf(0, 188, 376).any { head[it] != 0x47.toByte() }) return response
+        val file = try {
+            capture.file.sink().buffer()
+        } catch (_: IOException) {
+            return response
+        }
+        val observed = object : ForwardingSource(body.source()) {
+            var copied = 0L
+            var open = true
+            val chunk = Buffer()
+
+            fun finish(complete: Boolean) {
+                if (!open) return
+                open = false
+                try {
+                    file.close()
+                    capture.complete = complete && copied > 0 && (declared < 0 || copied == declared)
+                } catch (_: IOException) {
+                    capture.complete = false
+                }
+            }
+
+            override fun read(sink: Buffer, byteCount: Long): Long {
+                val before = sink.size
+                val count = super.read(sink, byteCount)
+                if (!open) return count
+                if (count < 0 || copied + count > MAX_BYTES) {
+                    finish(count < 0)
+                } else if (count > 0) {
+                    try {
+                        sink.copyTo(chunk, before, count)
+                        file.write(chunk, count)
+                        copied += count
+                    } catch (_: IOException) {
+                        finish(false)
+                    }
+                }
+                return count
+            }
+
+            override fun close() {
+                finish(declared >= 0 && declared == copied)
+                super.close()
+            }
+        }.buffer()
+        return response.newBuilder().body(
+            object : ResponseBody() {
+                override fun contentType() = body.contentType()
+                override fun contentLength() = declared
+                override fun source() = observed
+            },
+        ).build()
+    }
+}
