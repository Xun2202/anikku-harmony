@@ -0,0 +1,46 @@
+package eu.kanade.tachiyomi.data.download
+
+import java.math.BigDecimal
+import java.math.RoundingMode
+import kotlin.math.abs
+
+/** Match whole missing time ranges. Segment numbers can differ between two encodes of the same episode. */
+internal object DownloadHlsRepairPlan {
+    data class Part(val index: Int, val lower: Boolean)
+
+    fun boundaries(durations: List<BigDecimal>): LongArray {
+        var elapsed = BigDecimal.ZERO
+        return LongArray(durations.size + 1) { i ->
+            if (i > 0) elapsed += durations[i - 1]
+            elapsed.movePointRight(3).setScale(0, RoundingMode.HALF_UP).longValueExact()
+        }
+    }
+
+    fun match(original: LongArray, lower: LongArray, missing: Set<Int>): List<Part>? {
+        if (abs(original.last() - lower.last()) > BOUNDARY_TOLERANCE_MS || missing.size >= original.lastIndex) return null
+        val parts = mutableListOf<Part>()
+        var i = 0
+        while (i < original.lastIndex) {
+            if (i !in missing) {
+                parts += Part(i++, lower = false)
+                continue
+            }
+            val first = alignedBoundary(lower, original[i]) ?: return null
+            while (i in missing) i++
+            val end = alignedBoundary(lower, original[i]) ?: return null
+            if (end <= first) return null
+            for (index in first until end) parts += Part(index, lower = true)
+        }
+        return parts
+    }
+
+    private fun alignedBoundary(times: LongArray, at: Long): Int? {
+        val found = times.binarySearch(at)
+        if (found >= 0) return found
+        val after = -found - 1
+        return listOf(after - 1, after).filter { it in times.indices }.minByOrNull { abs(times[it] - at) }
+            ?.takeIf { abs(times[it] - at) <= BOUNDARY_TOLERANCE_MS }
+    }
+
+    private const val BOUNDARY_TOLERANCE_MS = 50L
+}
