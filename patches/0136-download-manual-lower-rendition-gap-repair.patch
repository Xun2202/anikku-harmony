@@ -0,0 +1,76 @@
+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import java.io.File
+import kotlin.math.abs
+import kotlin.math.round
+
+/** Check the encoded tracks at the actual splice, in addition to matching EXTINF times. */
+internal object DownloadHlsRepairMedia {
+    private data class Tracks(
+        val videoCodec: String,
+        val audioCodec: String,
+        val videoPid: String,
+        val audioPid: String,
+        val rate: String,
+        val channels: String,
+    )
+
+    private data class Sample(val tracks: Tracks, val height: Int, val videoStart: Double, val audioStart: Double, val keyframe: Boolean)
+
+    fun probeOptions(file: File) = arrayOf(
+        "-v", "error", "-protocol_whitelist", "file", "-read_intervals", "%+#96", "-show_packets",
+        "-show_entries", "stream=index,id,codec_type,codec_name,height,start_time,sample_rate,channels:packet=stream_index,flags",
+        "-of", "json", file.absolutePath,
+    )
+
+    suspend fun verify(switches: List<DownloadHlsSegments.SwitchSample>, probe: suspend (File) -> String) {
+        var anchor: Sample? = null
+        var lowestOriginal = Int.MAX_VALUE
+        var highestLower = 0
+        for (point in switches) {
+            val text = probe(point.file)
+            val sample = try {
+                parse(text)
+            } catch (_: RuntimeException) {
+                throw DownloadHlsSegments.Failure("无法确认补缺交界处的音视频轨道。已保留分片。")
+            }
+            val first = anchor ?: sample.also { anchor = it }
+            val elapsed = (point.startMillis - switches.first().startMillis) / 1000.0
+            if (sample.tracks != first.tracks || (point.entry && !sample.keyframe) ||
+                !aligned(sample.videoStart - first.videoStart - elapsed) || !aligned(sample.audioStart - first.audioStart - elapsed)
+            ) {
+                throw DownloadHlsSegments.Failure("两档视频在 ${point.startMillis / 1000} 秒处的编码、关键帧或时间戳不匹配。请换一档补缺。")
+            }
+            if (point.lower) highestLower = maxOf(highestLower, sample.height) else lowestOriginal = minOf(lowestOriginal, sample.height)
+        }
+        if (highestLower !in 1 until lowestOriginal) throw DownloadHlsSegments.Failure("补缺片段的实际分辨率与所选档位不符")
+    }
+
+    private fun aligned(difference: Double): Boolean {
+        val wrapSeconds = (1L shl 33) / 90_000.0
+        return abs(difference - round(difference / wrapSeconds) * wrapSeconds) <= 0.25
+    }
+
+    private fun parse(text: String): Sample {
+        val root = Json.parseToJsonElement(text).jsonObject
+        fun JsonObject.field(name: String) = getValue(name).jsonPrimitive.content
+        val streams = root.getValue("streams").jsonArray.map { it.jsonObject }
+        val video = streams.single { it.field("codec_type") == "video" }
+        val audio = streams.single { it.field("codec_type") == "audio" }
+        val videoCodec = video.field("codec_name")
+        require(videoCodec == "h264" || videoCodec == "hevc")
+        val firstVideo = root.getValue("packets").jsonArray.first { it.jsonObject.field("stream_index") == video.field("index") }
+        return Sample(
+            Tracks(videoCodec, audio.field("codec_name"), video.field("id"), audio.field("id"), audio.field("sample_rate"), audio.field("channels")),
+            video.field("height").toInt().also { require(it > 0) },
+            video.field("start_time").toDouble(),
+            audio.field("start_time").toDouble(),
+            'K' in firstVideo.jsonObject.field("flags"),
+        )
+    }
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/download/DownloadHlsRepairPlan.kt b/app/src/main/java/eu/kanade/tachiyomi/data/download/DownloadHlsRepairPlan.kt
