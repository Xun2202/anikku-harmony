+++ b/app/src/main/java/eu/kanade/tachiyomi/data/download/DownloadHlsRepairTransport.kt
@@ -0,0 +1,140 @@
+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import java.io.DataInputStream
+import java.io.File
+import java.io.IOException
+
+/** Join independent, clock-aligned renditions. Keep every PES payload, including in-band decoder configuration. */
+internal object DownloadHlsRepairTransport {
+    private const val PACKET = 188
+
+    suspend fun write(prepared: DownloadHlsSegments.Prepared, target: File, onBytes: (Long) -> Unit) {
+        require(prepared.switches.isNotEmpty())
+        val continuity = Continuity()
+        val buffer = ByteArray(PACKET * 1024)
+        var sourceBytes = 0L
+        var written = 0L
+        var parts = 0
+        target.outputStream().buffered(buffer.size).use { output ->
+            prepared.input.bufferedReader().useLines { lines ->
+                for (line in lines) {
+                    if (line == "#EXT-X-DISCONTINUITY") continuity.beginRendition()
+                    if (line.isEmpty() || line.startsWith('#')) continue
+                    val file = File(prepared.directory, line)
+                    val length = file.length()
+                    readPackets(file, buffer) { size ->
+                        continuity.adjust(buffer, size)
+                        output.write(buffer, 0, size)
+                        written += size
+                    }
+                    sourceBytes += length
+                    parts++
+                    onBytes(sourceBytes)
+                }
+            }
+        }
+        if (parts != prepared.segments || sourceBytes != prepared.bytes || written == 0L || target.length() != written) {
+            throw DownloadHlsSegments.Failure("合成时分片发生变化，请继续下载重试")
+        }
+    }
+
+    suspend fun packetized(file: File, buffer: ByteArray = ByteArray(PACKET * 256)): Boolean {
+        if (!file.isFile || file.length() < 3 * PACKET) return false
+        return try {
+            readPackets(file, buffer) { size ->
+                for (i in 0 until size step PACKET) checkedHeader(buffer, i)
+            }
+            true
+        } catch (_: IOException) {
+            false
+        }
+    }
+
+    /** Only restore bytes if the proxy successfully returned this same payload with bytes removed. */
+    suspend fun restoreIntactResponse(received: File, original: File?): Boolean {
+        if (original == null || original.length() - received.length() !in 1..minOf(65_536L, original.length() / 20) ||
+            !packetized(original)
+        ) {
+            return false
+        }
+        val coroutine = currentCoroutineContext()
+        val matches = received.inputStream().buffered().use { proxy ->
+            original.inputStream().buffered().use { source ->
+                var wanted = proxy.read()
+                var checked = 0
+                while (wanted >= 0) {
+                    if (checked++ % 65_536 == 0) coroutine.ensureActive()
+                    val next = source.read()
+                    if (next < 0) break
+                    if (next == wanted) wanted = proxy.read()
+                }
+                wanted < 0
+            }
+        }
+        return matches && original.renameTo(received)
+    }
+
+    private suspend fun readPackets(file: File, buffer: ByteArray, read: (Int) -> Unit) {
+        val coroutine = currentCoroutineContext()
+        val length = file.length()
+        DataInputStream(file.inputStream().buffered()).use { input ->
+            val head = minOf(length, 4096L, buffer.size.toLong()).toInt()
+            input.mark(head)
+            input.readFully(buffer, 0, head)
+            if (head >= 2 * PACKET + 1 && buffer[0] == 0x47.toByte() && buffer[PACKET] == 0x47.toByte() &&
+                buffer[2 * PACKET] == 0x47.toByte() && length % PACKET != 0L
+            ) {
+                throw DownloadHlsSegments.Failure("TS 分片长度不完整")
+            }
+            val prefix = (0 until head - 2 * PACKET).firstOrNull { i ->
+                (length - i) % PACKET == 0L && buffer[i] == 0x47.toByte() &&
+                    buffer[i + PACKET] == 0x47.toByte() && buffer[i + 2 * PACKET] == 0x47.toByte()
+            } ?: throw DownloadHlsSegments.Failure("补缺视频含有无法对齐的 TS 数据包，已保留分片")
+            input.reset()
+            if (input.skipBytes(prefix) != prefix) throw DownloadHlsSegments.Failure("无法读取分片开头")
+            var remaining = length - prefix
+            while (remaining > 0) {
+                coroutine.ensureActive()
+                val size = minOf(buffer.size.toLong(), remaining).toInt()
+                input.readFully(buffer, 0, size)
+                read(size)
+                remaining -= size
+            }
+        }
+    }
+
+    private fun checkedHeader(bytes: ByteArray, i: Int): Int {
+        val header = bytes[i + 3].toInt() and 0xff
+        if (bytes[i] != 0x47.toByte() || bytes[i + 1].toInt() and 0x80 != 0 || header and 0xc0 != 0 || header and 0x30 == 0) {
+            throw DownloadHlsSegments.Failure("补缺视频包含无效的 TS 数据包，已保留分片")
+        }
+        return header
+    }
+
+    private class Continuity {
+        private val last = IntArray(8192) { -1 }
+        private val adjustment = IntArray(8192) { -1 }
+
+        fun beginRendition() = adjustment.fill(-1)
+
+        fun adjust(bytes: ByteArray, size: Int) {
+            for (i in 0 until size step PACKET) {
+                val header = checkedHeader(bytes, i)
+                val flags = bytes[i + 1].toInt() and 0xff
+                val pid = ((flags and 0x1f) shl 8) or (bytes[i + 2].toInt() and 0xff)
+                if (pid == 0x1fff) continue
+                val source = header and 0x0f
+                if (adjustment[pid] < 0) {
+                    // Only realign at a rendition switch. Preserve duplicates and genuine discontinuities within each input.
+                    val next = if (header and 0x10 != 0) 1 else 0
+                    adjustment[pid] = if (last[pid] < 0) 0 else (last[pid] + next - source) and 0x0f
+                }
+                val counter = (source + adjustment[pid]) and 0x0f
+                last[pid] = counter
+                bytes[i + 3] = ((header and 0xf0) or counter).toByte()
+            }
+        }
+    }
+}
