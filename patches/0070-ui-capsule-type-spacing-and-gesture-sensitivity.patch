+        225
+    } else {
+        val fastFraction = ((speedDpPerSecond - NAVIGATION_CHROME_FAST_FLING_VELOCITY) / 1600f).coerceIn(0f, 1f)
+        (175 - 75 * fastFraction).toInt()
+    }
 
