-        val threshold = if (reveal && continuingFling) intentDistance * 2 else intentDistance
+        val threshold = when {
+            !reveal -> intentDistance * 3
+            continuingFling -> intentDistance * 2
+            else -> intentDistance
+        }
         if (pendingDistance < threshold) return
         visible = reveal
         pendingDistance = 0f
@@ -109,7 +115,12 @@ internal class NavigationChromeScrollTracker(
 
 /** Reveal gently; a fast swipe can dismiss controls more quickly without changing the list motion. */
 internal fun browsingChromeAnimationDuration(visible: Boolean, speedDpPerSecond: Float): Int =
-    if (visible) 225 else (175 - 75 * (speedDpPerSecond / 1600f).coerceIn(0f, 1f)).toInt()
