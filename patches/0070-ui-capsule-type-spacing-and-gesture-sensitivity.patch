+    @Test
+    fun `ordinary short swipes and moderate release speeds do not count as a fast throw`() {
+        for (direction in listOf(-1f, 1f)) {
+            for (speed in listOf(600f, 1000f, 1300f)) {
+                val tracker = NavigationChromeScrollTracker()
+                tracker.beginGesture()
+                assertTrue(tracker.onPreScroll(0f, direction * 10f, true, speed))
+                assertTrue(tracker.onPostScroll(0f, direction * 10f, true, speed))
+                tracker.endGesture()
+                assertTrue(tracker.onPreFling(0f, direction * speed))
+            }
+            val tracker = NavigationChromeScrollTracker()
+            tracker.beginGesture()
+            assertTrue(tracker.onPreScroll(0f, direction * 2f, true, 1600f))
+            assertFalse(tracker.onPostScroll(0f, direction * 2f, true, 1600f))
+        }
+        val tracker = NavigationChromeScrollTracker()
+        tracker.beginGesture()
+        assertTrue(tracker.onPostScroll(0f, -12f, true, 400f))
+        assertFalse(tracker.onPostScroll(0f, -6f, true, 400f), "A deliberate normal scroll still hides after enough travel")
+    }
+
     @Test
