+package eu.kanade.tachiyomi.ui.browse.extension.details
+
+import androidx.fragment.app.FragmentManager
+import androidx.fragment.app.commitNow
+import androidx.preference.EditTextPreference
+import androidx.preference.EditTextPreferenceDialogFragmentCompat
+import androidx.preference.ListPreference
+import androidx.preference.ListPreferenceDialogFragmentCompat
+import androidx.preference.MultiSelectListPreference
+import androidx.preference.MultiSelectListPreferenceDialogFragmentCompat
+import androidx.preference.PreferenceDialogFragmentCompat
+
+// PreferenceFragmentCompat uses this tag for its built-in preference dialogs.
+private const val PREFERENCE_DIALOG_TAG = "androidx.preference.PreferenceFragment.DIALOG"
+
+@Suppress("DEPRECATION")
+internal fun FragmentManager.removeUnavailableSourcePreferenceDialog() {
+    val dialog = findFragmentByTag(PREFERENCE_DIALOG_TAG) as? PreferenceDialogFragmentCompat ?: return
+    if (dialog.targetFragment !is SourcePreferencesFragment) return
+
+    val preferenceAvailable = when (dialog) {
+        is EditTextPreferenceDialogFragmentCompat -> dialog.preference is EditTextPreference
+        is ListPreferenceDialogFragmentCompat -> dialog.preference is ListPreference
+        is MultiSelectListPreferenceDialogFragmentCompat -> dialog.preference is MultiSelectListPreference
+        else -> return
+    }
+    if (!preferenceAvailable) commitNow { remove(dialog) }
+}
