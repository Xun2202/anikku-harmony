+package eu.kanade.presentation.webview
+
+import android.net.http.SslCertificate
+import android.net.http.SslError
+import android.os.Build
+import android.webkit.SslErrorHandler
+import android.webkit.WebView
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okio.ByteString.Companion.toByteString
+import java.security.cert.CertificateException
+import java.security.cert.CertificateFactory
+import java.security.cert.X509Certificate
+
+internal class WebViewCertificateSession(initialUrl: String) {
+    class Notice(val origin: HttpUrl, val fingerprint: String?)
+
+    private val launchOrigin = httpsOrigin(initialUrl)
+    private var owner: WebView? = null
+    private var atLaunchOrigin = false
+    private var approvedFingerprint: String? = null
+    private val pending = mutableListOf<SslErrorHandler>()
+    var notice by mutableStateOf<Notice?>(null)
+        private set
+
+    fun attach(view: WebView) {
+        owner?.let(::detach)
+        owner = view
+        atLaunchOrigin = launchOrigin != null && (view.url == null || httpsOrigin(view.url) == launchOrigin)
+    }
+
+    fun navigating(view: WebView, url: String?) {
+        if (view !== owner) return
+        atLaunchOrigin = launchOrigin != null && httpsOrigin(url) == launchOrigin
+        if (!atLaunchOrigin) reset(view)
+    }
+
+    fun detach(view: WebView) {
+        if (view !== owner) return
+        owner = null
+        atLaunchOrigin = false
+        reset(view)
+    }
+
+    fun received(view: WebView, handler: SslErrorHandler, error: SslError) {
+        val origin = launchOrigin
+        if (view !== owner || !atLaunchOrigin || origin == null || httpsOrigin(error.url) != origin) {
+            handler.cancel()
+            return
+        }
+        val fingerprint = reviewableFingerprint(error, origin.host)
+        if (fingerprint == null || (approvedFingerprint != null && approvedFingerprint != fingerprint)) {
+            handler.cancel()
+            block(view, origin)
+            return
+        }
+        if (approvedFingerprint == fingerprint) {
+            proceed(view, listOf(handler))
+            return
+        }
+        val previous = notice
+        if (previous != null && previous.fingerprint != fingerprint) {
+            handler.cancel()
+            block(view, origin)
+            return
+        }
+        pending.add(handler)
+        if (previous == null) notice = Notice(origin, fingerprint)
+    }
+
+    fun handshakeFailed(view: WebView, url: String) {
+        val origin = launchOrigin ?: return
+        if (view === owner && atLaunchOrigin && httpsOrigin(url) == origin && notice == null) {
+            block(view, origin)
+        }
+    }
+
+    fun accept(expected: Notice) {
+        val view = owner ?: return
+        val fingerprint = expected.fingerprint ?: return
+        if (notice !== expected || !atLaunchOrigin || pending.isEmpty()) return
+        approvedFingerprint = fingerprint
+        proceed(view, takePending())
+    }
+
+    fun dismiss(expected: Notice): Boolean {
+        if (notice !== expected) return false
+        owner?.let(::reset)
+        return true
+    }
+
+    private fun proceed(view: WebView, requests: List<SslErrorHandler>) {
+        try {
+            requests.forEach { it.proceed() }
+        } finally {
+            // Harmony: WebView may cache proceed() across windows. Keep the exception in this session only.
+            view.clearSslPreferences()
+        }
+    }
+
+    private fun takePending(): List<SslErrorHandler> {
+        val requests = pending.toList()
+        pending.clear()
+        notice = null
+        return requests
+    }
+
+    private fun reset(view: WebView) {
+        val wasApproved = approvedFingerprint != null
+        approvedFingerprint = null
+        takePending().forEach { it.cancel() }
+        if (wasApproved) view.clearSslPreferences()
+    }
+
+    private fun block(view: WebView, origin: HttpUrl) {
+        reset(view)
+        notice = Notice(origin, null)
+    }
+}
+
+private fun httpsOrigin(url: String?): HttpUrl? {
+    val parsed = url?.toHttpUrlOrNull() ?: return null
+    if (!parsed.isHttps || parsed.username.isNotEmpty() || parsed.password.isNotEmpty()) return null
+    return parsed.resolve("/")
+}
+
+private fun reviewableFingerprint(error: SslError, host: String): String? {
+    if (error.primaryError != SslError.SSL_UNTRUSTED ||
+        (SslError.SSL_NOTYETVALID..SslError.SSL_INVALID).any { it != SslError.SSL_UNTRUSTED && error.hasError(it) }
+    ) {
+        return null
+    }
+    return try {
+        val certificate = error.certificate?.toX509() ?: return null
+        certificate.checkValidity()
+        val purposes = certificate.extendedKeyUsage
+        if (certificate.hasUnsupportedCriticalExtension() || !certificate.matchesServer(host) ||
+            (purposes != null && purposes.none { it == "1.3.6.1.5.5.7.3.1" || it == "2.5.29.37.0" })
+        ) {
+            return null
+        }
+        certificate.encoded.toByteString().sha256().hex().uppercase().chunked(2).joinToString(":")
+    } catch (_: CertificateException) {
+        null
+    }
+}
+
+private fun SslCertificate.toX509(): X509Certificate? {
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) return x509Certificate
+    val der = SslCertificate.saveState(this)?.getByteArray("x509-certificate") ?: return null
+    return CertificateFactory.getInstance("X.509").generateCertificate(der.inputStream()) as? X509Certificate
+}
+
+private fun X509Certificate.matchesServer(host: String): Boolean {
+    val address = ':' in host || host.all { it in '0'..'9' || it == '.' }
+    val names = subjectAlternativeNames ?: return false
+    return names.any { entry ->
+        val name = entry.getOrNull(1) as? String ?: return@any false
+        when (entry.firstOrNull()) {
+            7 -> address && runCatching { HttpUrl.Builder().scheme("https").host(name).build().host }.getOrNull() == host
+            2 -> !address && matchesDnsName(host, name)
+            else -> false
+        }
+    }
+}
+
+private fun matchesDnsName(host: String, name: String): Boolean {
+    val dnsHost = host.removeSuffix(".")
+    val dnsName = name.removeSuffix(".")
+    if ('*' !in dnsName) return dnsHost.equals(dnsName, ignoreCase = true)
+    val suffix = dnsName.removePrefix("*.")
+    return dnsName.startsWith("*.") && '*' !in suffix && '.' in suffix && '.' in dnsHost &&
+        dnsHost.substringAfter('.').equals(suffix, ignoreCase = true)
+}
