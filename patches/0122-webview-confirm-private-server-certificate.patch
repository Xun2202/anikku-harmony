--- /dev/null
+++ b/app/src/test/java/eu/kanade/presentation/webview/WebViewCertificateSessionTest.kt
@@ -0,0 +1,167 @@
+package eu.kanade.presentation.webview
+
+import android.net.http.SslCertificate
+import android.net.http.SslError
+import android.os.Bundle
+import android.webkit.SslErrorHandler
+import android.webkit.WebView
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.mockkStatic
+import io.mockk.unmockkStatic
+import io.mockk.verify
+import okhttp3.tls.HeldCertificate
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotNull
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import java.security.cert.X509Certificate
+
+class WebViewCertificateSessionTest {
+    private val host = "192.0.2.42"
+    private val address = "https://192.0.2.42:8443/web/"
+    private val leaf = HeldCertificate.Builder().addSubjectAlternativeName(host).build().certificate
+    private val view = mockk<WebView>(relaxUnitFun = true)
+    private val session = WebViewCertificateSession(address)
+
+    @BeforeEach
+    fun open() {
+        mockkStatic(SslCertificate::class)
+        every { view.url } returns null
+        session.attach(view)
+    }
+
+    @AfterEach
+    fun close() {
+        session.detach(view)
+        unmockkStatic(SslCertificate::class)
+    }
+
+    private fun error(
+        target: String = address,
+        certificate: X509Certificate = leaf,
+        errors: Set<Int> = setOf(SslError.SSL_UNTRUSTED),
+    ): SslError {
+        val info = mockk<SslCertificate>()
+        val state = mockk<Bundle>()
+        every { info.x509Certificate } returns certificate
+        every { SslCertificate.saveState(info) } returns state
+        every { state.getByteArray("x509-certificate") } returns certificate.encoded
+        val result = mockk<SslError>()
+        every { result.url } returns target
+        every { result.certificate } returns info
+        every { result.primaryError } returns errors.max()
+        every { result.hasError(any()) } answers { firstArg<Int>() in errors }
+        return result
+    }
+
+    private fun handler(): SslErrorHandler = mockk(relaxUnitFun = true)
+
+    @Test
+    fun `explicit confirmation releases only this sites waiting requests and clears framework decisions`() {
+        val main = handler()
+        val asset = handler()
+        session.received(view, main, error(target = address + "?token=test-only#section"))
+        val notice = requireNotNull(session.notice)
+        session.received(view, asset, error(target = address + "script.js"))
+        assertEquals("https://192.0.2.42:8443/", notice.origin.toString())
+        assertEquals(32, notice.fingerprint?.split(':')?.size)
+        verify(exactly = 0) { main.proceed() }
+        verify(exactly = 0) { asset.proceed() }
+
+        session.accept(notice)
+        verify(exactly = 1) { main.proceed() }
+        verify(exactly = 1) { asset.proceed() }
+        verify(exactly = 1) { view.clearSslPreferences() }
+        val next = handler()
+        session.received(view, next, error())
+        verify(exactly = 1) { next.proceed() }
+        assertNull(session.notice)
+    }
+
+    @Test
+    fun `dismiss and disposal cancel unanswered handlers and invalidate a stale click`() {
+        val first = handler()
+        session.received(view, first, error())
+        val dismissed = requireNotNull(session.notice)
+        assertTrue(session.dismiss(dismissed))
+        val second = handler()
+        session.received(view, second, error())
+        val disposed = requireNotNull(session.notice)
+        session.accept(dismissed)
+        session.detach(view)
+        session.accept(disposed)
+        verify(exactly = 1) { first.cancel() }
+        verify(exactly = 1) { second.cancel() }
+        verify(exactly = 0) { first.proceed() }
+        verify(exactly = 0) { second.proceed() }
+    }
+
+    @Test
+    fun `other hosts ports schemes and popup windows cannot obtain an exception`() {
+        for (target in listOf("https://other.example/", "https://192.0.2.42/", "http://192.0.2.42:8443/")) {
+            val rejected = handler()
+            session.received(view, rejected, error(target))
+            verify(exactly = 1) { rejected.cancel() }
+        }
+        val popup = handler()
+        session.received(mockk(), popup, error())
+        verify(exactly = 1) { popup.cancel() }
+        assertNull(session.notice)
+    }
+
+    @Test
+    fun `leaving the launch origin forgets consent and disallows embedded callbacks there`() {
+        session.received(view, handler(), error())
+        session.accept(requireNotNull(session.notice))
+        session.navigating(view, "https://other.example/")
+        val embedded = handler()
+        session.received(view, embedded, error())
+        verify(exactly = 1) { embedded.cancel() }
+        session.navigating(view, address)
+        val returned = handler()
+        session.received(view, returned, error())
+        assertNotNull(session.notice?.fingerprint)
+        verify(exactly = 0) { returned.proceed() }
+    }
+
+    @Test
+    fun `an expired leaf a different subject name and combined errors cannot be accepted`() {
+        val expired = HeldCertificate.Builder().addSubjectAlternativeName(host).validityInterval(1000L, 2000L)
+            .build().certificate
+        val other = HeldCertificate.Builder().addSubjectAlternativeName("other.example").build().certificate
+        for (failure in listOf(
+            error(certificate = expired),
+            error(certificate = other),
+            error(errors = setOf(SslError.SSL_IDMISMATCH, SslError.SSL_UNTRUSTED)),
+            error(errors = setOf(SslError.SSL_DATE_INVALID)),
+        )) {
+            val rejected = handler()
+            session.received(view, rejected, failure)
+            val blocked = requireNotNull(session.notice)
+            assertNull(blocked.fingerprint)
+            session.accept(blocked)
+            verify(exactly = 1) { rejected.cancel() }
+            verify(exactly = 0) { rejected.proceed() }
+            session.dismiss(blocked)
+        }
+    }
+
+    @Test
+    fun `a changed certificate during an approved visit and a fatal handshake have no continue action`() {
+        session.received(view, handler(), error())
+        session.accept(requireNotNull(session.notice))
+        val changed = HeldCertificate.Builder().addSubjectAlternativeName(host).build().certificate
+        val rejected = handler()
+        session.received(view, rejected, error(certificate = changed))
+        val blocked = requireNotNull(session.notice)
+        assertNull(blocked.fingerprint)
+        verify(exactly = 1) { rejected.cancel() }
+        session.dismiss(blocked)
+        session.handshakeFailed(view, address)
+        assertNull(requireNotNull(session.notice).fingerprint)
+    }
+}
