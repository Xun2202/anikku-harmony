 /** Runtime capabilities keep older FFmpeg builds usable without assuming their demuxer options. */
 internal object DownloadFfmpegPolicy {
@@ -57,12 +62,51 @@ internal object DownloadFfmpegPolicy {
         .replace(CONTEXT_PREFIX, "")
         .trim()
 
-    /** Retry only the explicit native recommendation; generic AAC damage is not repaired by this filter. */
-    fun needsAacAdtsToAsc(text: String): Boolean = text.lineSequence().any {
-        AAC_FILTER_RECOMMENDATION.containsMatchIn(it)
+    /** FFmpegKit can report child-thread mux errors outside the session, leaving only exit 1. */
+    fun shouldRecoverLocalAudio(returnCode: Int?, partialBytes: Long, detail: String): Boolean {
+        if (returnCode != 1 && returnCode != INVALID_DATA) return false
+        if (NON_MEDIA_FAILURE.containsMatchIn(detail)) return false
+        return partialBytes > 0 || AAC_FRAMING_FAILURE.containsMatchIn(detail)
     }
 
-    private val AAC_FILTER_RECOMMENDATION = Regex("(?i)malformed\\s+AAC\\s+bitstream.*\\buse\\b.*\\baac_adtstoasc\\b")
+    /** The fallback must finish with audio and video covering the full local playlist. */
+    fun isCompleteAudioRecovery(probeOutput: String, expectedMillis: Long): Boolean {
+        if (expectedMillis <= 0) return false
+        val tolerance = (expectedMillis / 100).coerceIn(400L, 5000L)
+        fun coversPlaylist(seconds: Double?): Boolean = seconds != null && seconds.isFinite() &&
+            abs(seconds * 1000 - expectedMillis) <= tolerance
+
+        return runCatching {
+            val root = Json.parseToJsonElement(probeOutput).jsonObject
+            val duration = root.getValue("format").jsonObject.getValue("duration").jsonPrimitive.content.toDoubleOrNull()
+            if (!coversPlaylist(duration)) return false
+            val streams = root.getValue("streams").jsonArray.map { it.jsonObject }
+            val video = streams.filter { it.getValue("codec_type").jsonPrimitive.content == "video" }
+            val audio = streams.filter { it.getValue("codec_type").jsonPrimitive.content == "audio" }
+            if (video.isEmpty() || audio.isEmpty()) return false
+            if (audio.any { it.getValue("codec_name").jsonPrimitive.content != "aac" }) return false
+            (video + audio).all { stream ->
+                val timestamp = stream.getValue("tags").jsonObject.getValue("DURATION").jsonPrimitive.content
+                coversPlaylist(timestampSeconds(timestamp))
+            }
+        }.getOrDefault(false)
+    }
+
+    private fun timestampSeconds(value: String): Double? {
+        val parts = value.split(':')
+        if (parts.size != 3) return null
+        val hours = parts[0].toLongOrNull()?.takeIf { it >= 0 } ?: return null
+        val minutes = parts[1].toIntOrNull()?.takeIf { it in 0..59 } ?: return null
+        val seconds = parts[2].toDoubleOrNull()?.takeIf { it >= 0 && it < 60 } ?: return null
+        return hours * 3600.0 + minutes * 60 + seconds
+    }
+
+    private const val INVALID_DATA = -1094995529
+    private val AAC_FRAMING_FAILURE = Regex("(?i)malformed AAC bitstream|error parsing ADTS frame header|aac_adtstoasc")
+    private val NON_MEDIA_FAILURE = Regex(
+        "(?i)no space left|disk quota exceeded|permission denied|read-only file system|input/output error|" +
+            "no such file or directory|operation canceled|unrecognized option|encoder .* not found",
+    )
     private val FAILURE_LINE = Regex(
         "(?i)error|invalid|failed|denied|corrupt|timeout|not found|could not|unable|malformed|ADTS|bitstream|" +
             "non.monoton|timestamp|DTS|PTS|PES packet|not implemented|unsupported",
