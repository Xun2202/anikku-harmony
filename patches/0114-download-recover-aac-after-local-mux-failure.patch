@@ -971,17 +968,42 @@ class Downloader(
         try {
             ffmpegDownloadOnce(download, outputFile, prepared)
         } catch (error: DownloadFfmpegLogs.Failure) {
-            if (prepared == null || !error.needsAdtsConversion) throw error
-            logcat(LogPriority.INFO) { "Download local mux retry episode=${download.episode.id} audioFilter=aac_adtstoasc cache=retained" }
-            ffmpegDownloadOnce(download, outputFile, prepared, convertAdts = true)
+            if (prepared == null || !DownloadFfmpegPolicy.shouldRecoverLocalAudio(error.returnCode, outputFile.length(), error.detail)) throw error
+            localAudioRecovery.withLock {
+                logcat(LogPriority.INFO) { "Download local audio recovery episode=${download.episode.id} firstRc=${error.returnCode} cachedBytes=${prepared.bytes}" }
+                ffmpegDownloadOnce(download, outputFile, prepared, recoverAudio = true)
+                verifyLocalAudioRecovery(outputFile, prepared.durationMillis)
+                logcat(LogPriority.INFO) { "Download local audio recovery verified episode=${download.episode.id}" }
+            }
+        }
+    }
+
+    private suspend fun verifyLocalAudioRecovery(outputFile: File, expectedMillis: Long) {
+        val options = arrayOf(
+            "-v", "error", "-protocol_whitelist", "file",
+            "-show_entries", "format=duration:stream=codec_type,codec_name:stream_tags=DURATION",
+            "-of", "json", outputFile.absolutePath,
+        )
+        val verified = withTimeoutOrNull(10_000) {
+            suspendCancellableCoroutine<Boolean> { continuation ->
+                val session = FFprobeKit.executeWithArgumentsAsync(options) { result ->
+                    if (continuation.isActive) {
+                        val valid = result.returnCode?.value == 0 &&
+                            DownloadFfmpegPolicy.isCompleteAudioRecovery(result.getAllLogsAsString(500), expectedMillis)
+                        continuation.resume(valid)
+                    }
+                }
+                continuation.invokeOnCancellation { session.cancel() }
+            }
         }
+        if (verified != true) throw IOException("Recovered audio and video could not be verified for the full duration")
     }
 
