+    }
+
+    @Test
+    fun `completed recovery requires both streams to cover the playlist rather than just a valid header`() {
+        val output = """
+            {
+              "streams": [
+                {"codec_name":"h264","codec_type":"video","tags":{"DURATION":"00:00:06.021000000"}},
+                {"codec_name":"aac","codec_type":"audio","tags":{"DURATION":"00:00:06.058000000"}}
+              ],
+              "format":{"duration":"6.058000"}
+            }
+        """.trimIndent()
+
+        assertTrue(DownloadFfmpegPolicy.isCompleteAudioRecovery(output, 6000))
+        assertFalse(DownloadFfmpegPolicy.isCompleteAudioRecovery(output.replace("00:00:06.058000000", "00:00:02.837000000"), 6000))
+        assertFalse(DownloadFfmpegPolicy.isCompleteAudioRecovery(output.replace("\"audio\"", "\"data\""), 6000))
+        assertFalse(DownloadFfmpegPolicy.isCompleteAudioRecovery(output.replace("\"6.058000\"", "\"3.121000\""), 6000))
+        assertFalse(DownloadFfmpegPolicy.isCompleteAudioRecovery("{\"streams\": []}", 6000))
     }
