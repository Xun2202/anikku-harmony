+
+internal val LocalNavigationCapsule = staticCompositionLocalOf { false }
+
+/** One glass surface; the selection lens and its brief light are drawn without another blur pass. */
+@Composable
+fun NavigationCapsule(
+    state: BrowsingNavigationBarState,
+    selectedIndex: Int,
+    itemCount: Int,
+    onSelect: (Int) -> Unit,
+    modifier: Modifier = Modifier,
+    windowInsets: WindowInsets = WindowInsets.navigationBars.only(WindowInsetsSides.Bottom),
+    content: @Composable () -> Unit,
+) {
+    if (itemCount <= 0) return
+    val selected = selectedIndex.coerceIn(0, itemCount - 1)
+    val position = remember { Animatable(selected.toFloat()) }
+    var dragPosition by remember { mutableStateOf<Float?>(null) }
+    var width by remember { mutableIntStateOf(0) }
+    val latestSelected by rememberUpdatedState(selected)
+    val latestOnSelect by rememberUpdatedState(onSelect)
+    val scope = rememberCoroutineScope()
+    val rtl = LocalLayoutDirection.current == LayoutDirection.Rtl
+    val shape = RoundedCornerShape(50)
+    val colors = MaterialTheme.colorScheme
+    val motion = spring<Float>(dampingRatio = 0.86f, stiffness = 420f)
+    LaunchedEffect(selected, itemCount) {
+        if (dragPosition == null) position.animateTo(selected.toFloat(), motion)
+    }
+    val light by animateFloatAsState(
+        targetValue = if (dragPosition != null || position.isRunning) 1f else 0f,
+        animationSpec = tween(160),
+        label = "capsuleLight",
+    )
+    fun settle(index: Int, commit: Boolean) {
+        val from = dragPosition ?: position.value
+        scope.launch {
+            position.snapTo(from)
+            dragPosition = null
+            if (commit) latestOnSelect(index)
+            position.animateTo(index.toFloat(), motion)
+        }
+    }
+    Box(
+        modifier = modifier.fillMaxWidth().windowInsetsPadding(windowInsets)
+            .padding(start = 16.dp, top = 4.dp, end = 16.dp, bottom = 8.dp),
+        contentAlignment = Alignment.Center,
+    ) {
+        Box(
+            Modifier.widthIn(max = 640.dp).fillMaxWidth()
+                .shadow(6.dp, shape)
+                .clip(shape)
+                .browsingGlassBackground(state)
+                .border(
+                    BorderStroke(
+                        0.75.dp,
+                        Brush.verticalGradient(
+                            listOf(Color.White.copy(alpha = 0.45f), colors.outlineVariant.copy(alpha = 0.3f)),
+                        ),
+                    ),
+                    shape,
+                )
+                .padding(horizontal = 6.dp)
+                .onSizeChanged { width = it.width }
+                .pointerInput(itemCount, rtl, width) {
+                    fun indexAt(x: Float): Float {
+                        val fraction = (x / width.coerceAtLeast(1)).coerceIn(0f, 1f)
+                        return ((if (rtl) 1f - fraction else fraction) * itemCount - 0.5f)
+                            .coerceIn(0f, (itemCount - 1).toFloat())
+                    }
+                    detectHorizontalDragGestures(
+                        onDragStart = { dragPosition = indexAt(it.x) },
+                        onHorizontalDrag = { change, _ ->
+                            change.consume()
+                            dragPosition = indexAt(change.position.x)
+                        },
+                        onDragEnd = { settle((dragPosition ?: latestSelected.toFloat()).roundToInt(), true) },
+                        onDragCancel = { settle(latestSelected, false) },
+                    )
+                }
+                .drawWithContent {
+                    val index = (dragPosition ?: position.value).coerceIn(0f, (itemCount - 1).toFloat())
+                    val lane = size.width / itemCount
+                    val moving = (1f - abs(index - index.roundToInt()) * 2f).coerceIn(0f, 1f)
+                    val stretch = lane * (1f - moving) * 0.08f
+                    val lensWidth = (lane - 8.dp.toPx() + stretch).coerceAtLeast(0f)
+                    val lensHeight = (size.height - 8.dp.toPx()).coerceAtLeast(0f)
+                    val start = ((index + 0.5f) * lane - lensWidth / 2)
+                        .coerceIn(0f, (size.width - lensWidth).coerceAtLeast(0f))
+                    val x = if (rtl) size.width - start - lensWidth else start
+                    val offset = Offset(x, 4.dp.toPx())
+                    val lensSize = Size(lensWidth, lensHeight)
+                    val radius = CornerRadius(lensHeight / 2)
+                    drawRoundRect(
+                        brush = Brush.linearGradient(
+                            listOf(
+                                colors.primary.copy(alpha = 0.12f + light * 0.08f),
+                                colors.surface.copy(alpha = 0.24f),
+                                colors.primary.copy(alpha = 0.09f),
+                            ),
+                            start = offset,
+                            end = offset + Offset(lensWidth, lensHeight),
+                        ),
+                        topLeft = offset,
+                        size = lensSize,
+                        cornerRadius = radius,
+                    )
+                    drawRoundRect(
+                        brush = Brush.verticalGradient(
+                            listOf(Color.White.copy(alpha = 0.25f + light * 0.25f), Color.Transparent),
+                        ),
+                        topLeft = offset,
+                        size = lensSize,
+                        cornerRadius = radius,
+                        style = Stroke(0.75.dp.toPx()),
+                    )
+                    drawContent()
+                },
+        ) {
+            CompositionLocalProvider(LocalNavigationCapsule provides true) { content() }
+        }
+    }
+}
