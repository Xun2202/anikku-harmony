+    @Test
+    fun `saving after a scroll measure restores that item by key`() {
+        val state = PanoramaMasonryState()
+        val (layout, keys) = uniformGrid(count = 80)
+        measureViewport(state, layout, keys)
+        state.scrollOffset = layout.rects[40].y + 15f
+        measureViewport(state, layout, keys)
+        val anchor = state.lastAnchor!!
+        assertTrue(anchor.index > 0)
+        assertEquals(keys[anchor.index], anchor.key)
+
+        val saved = saveAnchor(state)
+        assertTrue((saved as List<*>).contains(anchor.key))
+        val restored = restoreAnchor(saved)
+        assertEquals(0f, restored.scrollOffset)
+        measureViewport(restored, layout, keys)
+        assertEquals(anchor.key, restored.lastAnchor!!.key)
+        assertEquals(anchor.index, restored.firstVisibleItemIndex)
+        assertEquals(anchor.offsetFromViewportTop, restored.lastAnchor!!.offsetFromViewportTop)
+        assertNotEquals(0, restored.firstVisibleItemIndex)
+        assertNull(restored.pendingRestore)
+    }
+
