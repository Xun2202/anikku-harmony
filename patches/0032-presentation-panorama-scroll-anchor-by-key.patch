+    private fun uniformGrid(count: Int): Pair<PanoramaMasonryLayout, List<Long>> {
+        val layout = layoutPanoramaMasonry(
+            count = count,
+            heightOf = { _, _ -> 100 },
+            laneWidths = intArrayOf(100, 100, 100),
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+        )
+        return layout to List(count) { (it + 1).toLong() }
+    }
+
+    private fun measureViewport(
+        state: PanoramaMasonryState,
+        layout: PanoramaMasonryLayout,
+        keys: List<Any>,
+        viewport: Int = 800,
+    ) {
+        val previous = state.lastKeys
+        var structural = state.layoutCache.structuralChange
+        if (previous != null) {
+            val shared = minOf(previous.size, keys.size)
+            for (index in 0 until shared) {
+                if (previous[index] != keys[index]) {
+                    structural = true
+                    break
+                }
+            }
+        }
+        state.applyMeasuredViewport(
+            rects = layout.rects,
+            keys = keys,
+            topPadding = 0,
+            viewport = viewport,
+            totalHeight = layout.contentHeight,
+            bottomPadding = 0,
+            structural = structural,
+        )
+    }
+
+    private fun saveAnchor(state: PanoramaMasonryState): Any {
+        val scope = object : SaverScope {
+            override fun canBeSaved(value: Any): Boolean {
+                return value is Int || value is Long || value is String
+            }
+        }
+        return with(PanoramaMasonryState.Saver) { scope.save(state) }!!
