+    private fun resolvePendingRestore(
+        rects: List<PanoramaMasonryRect>,
+        keys: List<Any>,
+        topPadding: Int,
+        maxScroll: Int,
+    ): Float? {
+        val pending = pendingRestore ?: return null
+        // Harmony: an empty list is the placeholder before rows arrive. Do not consume the anchor.
+        if (rects.isEmpty()) {
+            restoreSeenKeys = null
+            restoreStableMeasures = 0
+            return null
+        }
+        val key = pending.key
+        if (key != null && key in keys) {
+            val restored = scrollOffsetForAnchor(
+                anchor = PanoramaAnchor(pending.index, key, pending.offsetFromViewportTop),
+                rects = rects,
+                keys = keys,
+                topPadding = topPadding,
+                maxScroll = maxScroll,
+            )
+            clearPendingRestore()
+            return restored.toFloat()
+        }
+        val seen = restoreSeenKeys
+        if (seen != null && sameKeyList(seen, keys)) {
+            restoreStableMeasures += 1
+        } else {
+            restoreSeenKeys = keys
+            restoreStableMeasures = 1
+        }
+        // Harmony: one short page must not clamp the index. Two identical key lists mean it is final.
+        if (restoreStableMeasures < 2) return null
+        val restored = scrollOffsetForAnchor(
+            anchor = PanoramaAnchor(pending.index, RestoreIndexOnly, pending.offsetFromViewportTop),
+            rects = rects,
+            keys = keys,
+            topPadding = topPadding,
+            maxScroll = maxScroll,
+        )
+        clearPendingRestore()
+        return restored.toFloat()
+    }
+
+    private fun clearPendingRestore() {
+        pendingRestore = null
+        restoreSeenKeys = null
+        restoreStableMeasures = 0
+    }
+
+    companion object {
+        /**
+         * Saves the viewport anchor (key, index, offset). [rememberSaveable] calls [Saver.save]
+         * from the registry's performSave, which reads [lastAnchor] after the latest measure.
+         */
+        val Saver: Saver<PanoramaMasonryState, Any> = Saver(
+            save = { state -> state.exportAnchor() },
+            restore = { saved -> PanoramaMasonryState().also { it.importAnchor(saved) } },
+        )
+    }
+}
+
+internal class PanoramaPendingRestore(
+    val index: Int,
+    val offsetFromViewportTop: Int,
+    val key: Any?,
+)
+
+private const val ANCHOR_NONE = 0
+private const val ANCHOR_INDEX = 1
+private const val ANCHOR_LONG = 2
+private const val ANCHOR_INT = 3
+private const val ANCHOR_STRING = 4
+
+/** Key that cannot match a real item, so [scrollOffsetForAnchor] clamps to the saved index. */
+private object RestoreIndexOnly
+
+private fun sameKeyList(left: List<Any>, right: List<Any>): Boolean {
+    if (left === right) return true
+    if (left.size != right.size) return false
+    for (index in left.indices) {
+        if (left[index] != right[index]) return false
+    }
+    return true
+}
+
+@Composable
+fun rememberPanoramaMasonryState(): PanoramaMasonryState {
+    // Harmony: the saver reads lastAnchor at performSave. Do not copy it in a SideEffect.
+    return rememberSaveable(saver = PanoramaMasonryState.Saver) { PanoramaMasonryState() }
 }
 
