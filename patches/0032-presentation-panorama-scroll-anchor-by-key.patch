+    @Test
+    fun `Benchmark unchanged scroll frames`() {
+        assumeTrue(System.getenv("PANORAMA_BENCH") == "1") {
+            "PANORAMA_BENCH=1 times 120 scroll frames"
+        }
+        val count = 2000
+        val lanes = intArrayOf(109, 109, 108)
+        val ratios = HashMap<Long, Float>(count)
+        for (index in 0 until count) {
+            ratios[index.toLong()] = if (index % 5 == 0) 0.5f else 1.5f
+        }
+        val cache = PanoramaMasonryLayoutCache()
+        var heightCalls = 0
+        var spanCalls = 0
+        val spanOf: (Int) -> PanoramaSpan = { index ->
+            spanCalls++
+            if ((ratios[index.toLong()] ?: 1f) <= 0.75f) {
+                PanoramaSpan.TwoLanesWhenRoomy
+            } else {
+                PanoramaSpan.SingleLane
+            }
+        }
+        val heightOf: (Int, Int) -> Int = { index, _ ->
+            heightCalls++
+            val wide = (ratios[index.toLong()] ?: 1f) <= 0.75f
+            // Shelf measure allocates a Cover for every probed index.
+            PanoramaCellHeight.Cover(wide = wide, titleBelow = true)
+            if (wide) 112 else 252
+        }
+        cache.layout(
+            count = count,
+            spanOf = spanOf,
+            heightOf = heightOf,
+            laneWidths = lanes,
+            verticalSpacing = 4,
+            horizontalSpacing = 4,
+            rtl = false,
+        )
+        heightCalls = 0
+        spanCalls = 0
+        // Harmony: android.jar has no com.sun.management, so the counter is reflective and optional.
+        val probe = ThreadAllocationProbe.open()
+        val allocatedBefore = probe?.allocatedBytes()
+        val started = System.nanoTime()
+        val frames = 120
+        var previousKeys: List<Any>? = null
+        repeat(frames) { frame ->
+            cache.layout(
+                count = count,
+                spanOf = spanOf,
+                heightOf = heightOf,
+                laneWidths = lanes,
+                verticalSpacing = 4,
+                horizontalSpacing = 4,
+                rtl = false,
+            )
+            val keys = ArrayList<Any>(count)
+            for (index in 0 until count) keys.add(index.toLong())
+            if (previousKeys != null) {
+                val shared = minOf(previousKeys!!.size, keys.size)
+                for (index in 0 until shared) {
+                    if (previousKeys!![index] != keys[index]) break
+                }
+            }
+            previousKeys = keys
+            if (frame == 0) Unit
+        }
+        val elapsedNanos = System.nanoTime() - started
+        val allocated = if (probe == null || allocatedBefore == null) {
+            null
+        } else {
+            probe.allocatedBytes() - allocatedBefore
+        }
+        val perFrameMs = elapsedNanos / frames.toDouble() / 1_000_000.0
+        val perFrameBytes = allocated?.div(frames)
+        println(
+            "PANORAMA_BENCH count=$count frames=$frames perFrameMs=$perFrameMs " +
+                "perFrameBytes=${perFrameBytes ?: "skipped"} heightCalls=$heightCalls spanCalls=$spanCalls",
+        )
+    }
