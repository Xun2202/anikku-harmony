+    private fun TouchInjectionScope.thumbTrack(state: PanoramaMasonryState): Float =
+        height - state.afterContentPadding - 48.dp.toPx()
+
+    private fun TouchInjectionScope.thumbCenterY(state: PanoramaMasonryState): Float {
+        val proportion = (state.scrollOffset / state.maxScroll).coerceIn(0f, 1f)
+        return thumbTrack(state) * proportion + 24.dp.toPx()
+    }
+
+    /**
+     * Holds a finger 20 dp from the end on the thumb for 200 ms, then drags it down and lifts.
+     * With [coastFirst] the hold lands a few frames into a center fling.
+     */
+    private fun ComposeUiTest.holdBesideThumb(coastFirst: Boolean): Hold {
+        val state = PanoramaMasonryState()
+        setScrollerGrid(state)
+        var coastBeforeDown = 0f
+        if (coastFirst) {
+            val beforeFling = state.scrollOffset
+            onNodeWithTag("grid").performTouchInput {
+                swipe(Offset(centerX, height * 0.5f), Offset(centerX, height * 0.12f), 40)
+            }
+            repeat(3) { mainClock.advanceTimeByFrame() }
+            check(state.isScrollInProgress) { "no coast" }
+            coastBeforeDown = state.scrollOffset - beforeFling
+        }
+        var finger = 0f
+        var expectedThumbJump = 0f
+        onNodeWithTag("grid").performTouchInput {
+            finger = height * 0.2f
+            expectedThumbJump = finger / thumbTrack(state) * state.maxScroll
+            down(Offset(width - 20.dp.toPx(), thumbCenterY(state)))
+        }
+        mainClock.advanceTimeByFrame()
+        val atDown = state.scrollOffset
