+/**
+ * Grabs the thumb from beside it, but only on a hold. See [HarmonyScrollerThumb].
+ *
+ * The node shares pointer input with its siblings, so the content under it is still hit
+ * and gets the same down. Nothing is consumed until the hold succeeds. After that every
+ * change is consumed in the initial pass: the content's drag detector sees consumed moves
+ * and gives up, and the y movement goes to [onDragDelta]. [DragInteraction] start / stop
+ * on [interactionSource] marks the thumb as dragged for the scroll effect and the fade.
+ */
+private fun Modifier.harmonyHoldToGrab(
+    enabled: Boolean,
+    contentScrolling: () -> Boolean,
+    pressState: ThumbPressedState,
+    interactionSource: MutableInteractionSource,
+    onDragDelta: (Float) -> Unit,
+): Modifier {
+    if (!enabled) return this
+    return this then HoldToGrabElement(contentScrolling, pressState, interactionSource, onDragDelta)
+}
+
+private data class HoldToGrabElement(
+    val contentScrolling: () -> Boolean,
+    val pressState: ThumbPressedState,
+    val interactionSource: MutableInteractionSource,
+    val onDragDelta: (Float) -> Unit,
+) : ModifierNodeElement<HoldToGrabNode>() {
+    override fun create() = HoldToGrabNode(contentScrolling, pressState, interactionSource, onDragDelta)
+
+    override fun update(node: HoldToGrabNode) {
+        node.contentScrolling = contentScrolling
+        node.pressState = pressState
+        node.interactionSource = interactionSource
+        node.onDragDelta = onDragDelta
+    }
+}
+
+private class HoldToGrabNode(
+    var contentScrolling: () -> Boolean,
+    var pressState: ThumbPressedState,
+    var interactionSource: MutableInteractionSource,
+    var onDragDelta: (Float) -> Unit,
+) : DelegatingNode(), PointerInputModifierNode {
+    private val input = delegate(SuspendingPointerInputModifierNode { awaitHolds() })
+
+    override fun onPointerEvent(pointerEvent: PointerEvent, pass: PointerEventPass, bounds: IntSize) {
+        input.onPointerEvent(pointerEvent, pass, bounds)
+    }
+
+    override fun onCancelPointerInput() {
+        input.onCancelPointerInput()
+    }
+
+    override fun sharePointerInputWithSiblings() = true
+
+    private suspend fun PointerInputScope.awaitHolds() = awaitEachGesture {
+        val down = awaitFirstDown(requireUnconsumed = false, pass = PointerEventPass.Initial)
+        if (contentScrolling()) return@awaitEachGesture
+        val touchSlop = viewConfiguration.touchSlop
+        val letGo = withTimeoutOrNull(HoldToGrabMillis) {
+            while (true) {
+                val change = awaitPointerEvent(PointerEventPass.Final).changes
+                    .fastFirstOrNull { it.id == down.id }
+                    ?: break
+                // The down itself comes back in this pass; an item's tap detector may have consumed it.
+                if (change.changedToDownIgnoreConsumed()) continue
+                if (!change.pressed || change.isConsumed) break
+                if ((change.position - down.position).getDistance() > touchSlop) break
+            }
+        } != null
+        if (letGo) return@awaitEachGesture
+
+        pressState.pressed = true
+        val start = DragInteraction.Start()
+        interactionSource.tryEmit(start)
+        var released = false
+        try {
+            while (true) {
+                val change = awaitPointerEvent(PointerEventPass.Initial).changes
+                    .fastFirstOrNull { it.id == down.id }
+                    ?: break
+                val deltaY = change.positionChangeIgnoreConsumed().y
+                change.consume()
+                if (!change.pressed) {
+                    released = true
+                    break
+                }
+                if (deltaY != 0f) onDragDelta(deltaY)
+            }
+        } finally {
+            pressState.pressed = false
+            interactionSource.tryEmit(
+                if (released) DragInteraction.Stop(start) else DragInteraction.Cancel(start),
+            )
+        }
+    }
+}
